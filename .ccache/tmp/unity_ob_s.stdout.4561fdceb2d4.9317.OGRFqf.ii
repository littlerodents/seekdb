{
public:
  SimpleItem(): value_(0) {}
  ~SimpleItem() {}
  inline void reset() {value_ = 0;}
  inline SimpleItem &operator+=(const SimpleItem &item)
  {
    this->value_ += item.value_;
    return *this;
  }
  int64_t value_;
};
}
