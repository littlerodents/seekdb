    do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/oblib/lib/utility/utility.h", 726, __FUNCTION__, ret, "fstat %s failed, errno %d", path, (*__errno_location ())); } } } while (false);
    ret = OB_ERROR;
  } else if (__null == (buf = allocator.alloc(st.st_size + 1))) {
    ret = OB_ALLOCATE_MEMORY_FAILED;
  } else if ((size = static_cast<int64_t>(::read(fd, buf, st.st_size))) < 0) {
    do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/oblib/lib/utility/utility.h", 731, __FUNCTION__, ret, "read %s failed, errno %d", path, (*__errno_location ())); } } } while (false);
    ret = OB_ERROR;
  } else {
    buf[size] = '\0';
    str.assign(buf, static_cast<int>(size));
  }
  if (fd >= 0) {
    int tmp_ret = close(fd);
    if (tmp_ret < 0) {
      do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/oblib/lib/utility/utility.h", 740, __FUNCTION__, ret, "close %s failed, errno %d", path, (*__errno_location ())); } } } while (false);
      ret = (OB_SUCCESS == ret) ? tmp_ret : ret;
    }
  }
  return ret;
}
