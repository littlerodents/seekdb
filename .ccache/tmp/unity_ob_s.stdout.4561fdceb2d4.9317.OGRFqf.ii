        if (digits_[i] >= BASE) {
          ret = OB_ERR_UNEXPECTED;
          do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/oblib/common/number/ob_number_v2.h", 215, __FUNCTION__, ret, "Invalid value %u", digits_[i]); } } } while (false);
        } else {
        }
      }
    }
    return ret;
  }
