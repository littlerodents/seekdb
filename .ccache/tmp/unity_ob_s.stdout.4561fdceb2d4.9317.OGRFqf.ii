      if (mb_handle != nullptr && (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (bit_set_.add_member(handle_index_of(mb_handle))))),!!0))) {
        do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 4, "src/share/cache/ob_kvcache_hazard_domain.h", 188, __FUNCTION__, ret, "bit_set_.add_member failed", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
      }
      return ret;
    }

    ObBitSet<>& bit_set_;
  };

