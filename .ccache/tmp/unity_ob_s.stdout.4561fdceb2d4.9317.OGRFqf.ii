int logdata_print_obj(char *buf, const int64_t buf_len, int64_t &pos, T *obj)
{
  int ret = OB_SUCCESS;
  if (__null == obj) {
    ret = logdata_printf(buf, buf_len, pos, "NULL");
  } else {
    ret = logdata_print_point_obj(buf, buf_len, pos, obj, BoolType<oceanbase::common::__has_to_string__<T>::value>());
  }
  return ret;
}
template<class T>
int logdata_print_obj(char *buf, const int64_t buf_len, int64_t &pos, const T *obj)
{
  int ret = OB_SUCCESS;
  if (__null == obj) {
    ret = logdata_printf(buf, buf_len, pos, "NULL");
  } else {
    ret = logdata_print_point_obj(buf, buf_len, pos, obj, BoolType<oceanbase::common::__has_to_string__<T>::value>());
  }
  return ret;
}
