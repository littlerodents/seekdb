    hash_ret = common::murmurhash(&col_id_, sizeof(col_id_), hash_ret);
    return hash_ret;
  }
  bool is_valid() const
  {
    return (grantee_id_ != common::OB_INVALID_ID)
            && (obj_id_ != common::OB_INVALID_ID)
            && (obj_type_ != common::OB_INVALID_ID)
            && (col_id_ != common::OB_INVALID_ID);
  }
