namespace oceanbase {
namespace share {

const uint64_t OB_INVALID_SCN_VAL = (18446744073709551615UL);
const uint64_t OB_MIN_SCN_TS_NS = 0;
const uint64_t OB_BASE_SCN_TS_NS = 1;
