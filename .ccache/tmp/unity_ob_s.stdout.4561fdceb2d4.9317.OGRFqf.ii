  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"version_str", ::oceanbase::common::check_char_array(version_str_), "version_val", ::oceanbase::common::check_char_array(version_val_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
private:
  uint64_t version_val_;
  char version_str_[OB_SERVER_VERSION_LENGTH];
};

