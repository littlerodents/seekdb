uint64_t ObBucketLock::bucket_to_latch_idx(const uint64_t bucket_idx) const
{
  return bucket_idx / 8;
}


uint64_t ObBucketLock::get_bucket_idx(const uint64_t hash_value) const
{
  uint64_t bucket_idx = 0;
  if (0 != bucket_cnt_) {
    bucket_idx = hash_value % bucket_cnt_;
  }
  return bucket_idx;
}
