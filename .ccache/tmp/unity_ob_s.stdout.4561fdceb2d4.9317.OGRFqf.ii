}

inline int64_t ObNumber::get_length() const
{
  return d_.len_;
}

template <typename T>
void ObNumber::normalize_digit_(T digits, int32_t max_idx) const
{
  if (digits[max_idx] >= BASE / 10 * 5) {
    for (int32_t i = max_idx - 1; i >= 0; --i) {
      if (digits[i] + 1 == BASE) {
        digits[i] = 0;
      } else {
        ++digits[i];
        break;
      }
    }
  }
}

inline __attribute__((always_inline)) bool ObNumber::is_negative_number(const ObNumber::Desc &desc)
{
  return NEGATIVE == desc.sign_;
}

inline __attribute__((always_inline)) bool ObNumber::is_zero_number(const ObNumber::Desc &desc)
{
  return 0 == desc.len_;
}

inline __attribute__((always_inline)) int64_t ObNumber::get_number_length(const ObNumber::Desc &desc)
{
  return desc.len_;
}

inline __attribute__((always_inline)) void ObNumber::assign(const uint32_t desc, uint32_t *digits)
{

  d_.desc_ = desc;
  digits_ = digits;
}

inline __attribute__((always_inline)) int64_t ObNumber::get_scale() const
{
  int64_t decimal_count = 0;
  if (!is_zero()) {
    const int64_t expr_value = get_decode_exp(d_);

    const int64_t integer_length = (expr_value >= 0 ? (expr_value + 1) : 0);





    const int64_t valid_decimal_length = (d_.len_ > integer_length ? (d_.len_ - integer_length) : 0);


    const int64_t decimal_length = valid_decimal_length
                                   + (0 == integer_length ? (0 - expr_value - 1) : 0);

    int64_t tail_decimal_zero_count = 0;
    if (valid_decimal_length > 0) {
      remove_back_zero(digits_[d_.len_ - 1], tail_decimal_zero_count);
    }
    decimal_count = decimal_length * DIGIT_LEN - tail_decimal_zero_count;
  }
  return decimal_count;
}

inline __attribute__((always_inline)) bool ObNumber::fast_mul_1d_mul_2d(const uint32_t *multiplicand_digits,
