inline __attribute__((always_inline)) bool CHECK_TRACE_TIMES(uint64_t times, const uint64_t *cur_trace_id)
{
  struct TraceArray {
    uint64_t v_[3];
  };

  thread_local TraceArray buffer;
  uint64_t *trace_id = (&buffer)->v_;
  bool printable = true;
  if ((__builtin_expect(!!(__null == (cur_trace_id)),!!0))) {
  } else if (cur_trace_id[0] == 0) {
  } else if (cur_trace_id[0] == trace_id[0] &&
             cur_trace_id[1] == trace_id[1]) {
    ++trace_id[2];
    if (trace_id[2] > times) {
      printable = false;
    }
  } else {
    trace_id[0] = cur_trace_id[0];
    trace_id[1] = cur_trace_id[1];
    trace_id[2] = 1;
  }
  return printable;
}
