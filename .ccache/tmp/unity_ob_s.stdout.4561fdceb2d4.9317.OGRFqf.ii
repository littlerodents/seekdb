enum ObExtObjType
{

  T_EXT_SQL_ARRAY = 100,

  T_EXT_SQL_END = 200
};


enum ObUDTType
{
  T_OBJ_NOT_SUPPORTED = 0,
  T_OBJ_SDO_POINT = 300027,
  T_OBJ_SDO_GEOMETRY = 300028,
  T_OBJ_SDO_ELEMINFO_ARRAY = 300029,
  T_OBJ_SDO_ORDINATE_ARRAY = 300030,
};


enum ObSystemUDTSqlType
{
  ObMaxSystemUDTSqlType = 16,
  ObInvalidSqlType = 17
};

inline __attribute__((always_inline)) bool is_valid_obj_type(const ObObjType type)
{
  return ObNullType <= type && type < ObMaxType;
}

inline __attribute__((always_inline)) bool is_valid_extended_type(const ObObjOType otype)
{

  return ObONotSupport < otype && otype < ObOMaxType;
}

inline __attribute__((always_inline)) ObObjOType ob_obj_type_to_extended_type(const ObObjType type)
{
  return type < ObMaxType ? OBJ_TYPE_TO_O_TYPE[type] : ObOMaxType;
}

inline __attribute__((always_inline)) ObObjTypeClass ob_extended_type_class(const ObObjType type)
{
  return type < ObMaxType ? OBJ_O_TYPE_TO_CLASS[OBJ_TYPE_TO_O_TYPE[type]] : ObMaxTC;
}

inline __attribute__((always_inline)) ObObjTypeClass ob_extended_type_class(const ObObjOType oType)
{
  return oType < ObOMaxType ? OBJ_O_TYPE_TO_CLASS[oType] : ObMaxTC;
}

inline __attribute__((always_inline)) ImplicitCastDirection ob_extended_implict_cast_direction(const ObObjOType aType, const ObObjOType bType)
{
  if (aType < ObOMaxType && bType < ObOMaxType) {
    return OB_OBJ_IMPLICIT_CAST_DIRECTION_EXTENDED[aType][bType];
  } else {
    return ImplicitCastDirection::IC_NOT_SUPPORT;
  }
}

inline __attribute__((always_inline)) ObObjTypeClass ob_obj_type_class(const ObObjType type)
{
  return __builtin_expect(!!(type < ObMaxType),!!1) ? OBJ_TYPE_TO_CLASS[type] : ObMaxTC;
}

inline __attribute__((always_inline)) ObObjType ob_obj_default_type(const ObObjTypeClass tc)
{
  return __builtin_expect(!!(tc < ObActualMaxTC),!!1) ? OBJ_DEFAULT_TYPE[tc] : ObMaxType;
}

enum VecValueTypeClass: uint16_t {
  VEC_TC_NULL = 0,
  VEC_TC_INTEGER,
  VEC_TC_UINTEGER,
  VEC_TC_FLOAT,
  VEC_TC_DOUBLE,
  VEC_TC_FIXED_DOUBLE,
  VEC_TC_NUMBER,
  VEC_TC_DATETIME,
  VEC_TC_DATE,
  VEC_TC_TIME,
  VEC_TC_YEAR,
  VEC_TC_EXTEND,
  VEC_TC_UNKNOWN,
  VEC_TC_STRING,
  VEC_TC_BIT,
  VEC_TC_ENUM_SET,
  VEC_TC_ENUM_SET_INNER,
  VEC_TC_TIMESTAMP_TZ,
  VEC_TC_TIMESTAMP_TINY,
  VEC_TC_RAW,
  VEC_TC_INTERVAL_YM,
  VEC_TC_INTERVAL_DS,
  VEC_TC_ROWID,
  VEC_TC_LOB,
  VEC_TC_JSON,
  VEC_TC_GEO,

  VEC_TC_UDT,
  VEC_TC_DEC_INT32,
  VEC_TC_DEC_INT64,
  VEC_TC_DEC_INT128,
  VEC_TC_DEC_INT256,
  VEC_TC_DEC_INT512,
  VEC_TC_COLLECTION,
  VEC_TC_MYSQL_DATE,
  VEC_TC_MYSQL_DATETIME,
  MAX_VEC_TC
};

inline bool ob_is_double_type(ObObjType);
inline bool ob_is_decimal_int(ObObjType);

inline __attribute__((always_inline)) VecValueTypeClass get_vec_value_tc(const ObObjType type, const int16_t scale,
                                             const int16_t precision)
{
  ((void)(precision));
  const static VecValueTypeClass maps[] = {
    VEC_TC_NULL,
    VEC_TC_INTEGER,
    VEC_TC_INTEGER,
    VEC_TC_INTEGER,
    VEC_TC_INTEGER,
    VEC_TC_INTEGER,
    VEC_TC_UINTEGER,
    VEC_TC_UINTEGER,
    VEC_TC_UINTEGER,
    VEC_TC_UINTEGER,
    VEC_TC_UINTEGER,
    VEC_TC_FLOAT,
    VEC_TC_DOUBLE,
    VEC_TC_FLOAT,
    VEC_TC_DOUBLE,
    VEC_TC_NUMBER,
    VEC_TC_NUMBER,
    VEC_TC_DATETIME,
    VEC_TC_DATETIME,
    VEC_TC_DATE,
    VEC_TC_TIME,
    VEC_TC_YEAR,
    VEC_TC_STRING,
    VEC_TC_STRING,
    VEC_TC_STRING,
    VEC_TC_EXTEND,
    VEC_TC_UNKNOWN,
    VEC_TC_STRING,
    VEC_TC_LOB,
    VEC_TC_LOB,
    VEC_TC_LOB,
    VEC_TC_BIT,
    VEC_TC_ENUM_SET,
    VEC_TC_ENUM_SET,
    VEC_TC_ENUM_SET_INNER,
    VEC_TC_ENUM_SET_INNER,
    VEC_TC_JSON,
    VEC_TC_GEO,
    VEC_TC_UDT,
    MAX_VEC_TC,
    VEC_TC_COLLECTION,
    VEC_TC_MYSQL_DATE,
    VEC_TC_MYSQL_DATETIME
  };
  VecValueTypeClass t = MAX_VEC_TC;
  if (type < 0 || type >= ObMaxType) {
    do{ if(__builtin_expect(!!(!(false)),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/oblib/common/object/ob_obj_type.h", 1228, __FUNCTION__, ret, "assert fail, exp=%s", "false"); } } } while (false); }; do { if (__builtin_expect(!!(1),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/oblib/common/object/ob_obj_type.h", 1228, __FUNCTION__, ret, "assert fail" " BACKTRACE:%s", oceanbase::common::lbt()); } } } while (false); }; } } while (false); ob_abort(); } } while(false);
  } else {
    if (ob_is_double_type(type) && scale > SCALE_UNKNOWN_YET
        && scale <= OB_MAX_DOUBLE_FLOAT_SCALE) {
      t = VEC_TC_FIXED_DOUBLE;
    } else if (ob_is_decimal_int(type)) {
      if (precision <= MAX_PRECISION_DECIMAL_INT_32) {
        t = VEC_TC_DEC_INT32;
      } else if (precision <= MAX_PRECISION_DECIMAL_INT_64) {
        t = VEC_TC_DEC_INT64;
      } else if (precision <= MAX_PRECISION_DECIMAL_INT_128) {
        t = VEC_TC_DEC_INT128;
      } else if (precision <= MAX_PRECISION_DECIMAL_INT_256) {
        t = VEC_TC_DEC_INT256;
      } else if (precision <= MAX_PRECISION_DECIMAL_INT_512) {
        t = VEC_TC_DEC_INT512;
      }
    } else {
      t = maps[type];
    }
  }
  return t;
}

extern const int64_t INT_MIN_VAL[ObMaxType];
extern const int64_t INT_MAX_VAL[ObMaxType];
extern const uint64_t UINT_MAX_VAL[ObMaxType];
extern const double REAL_MIN_VAL[ObMaxType];
extern const double REAL_MAX_VAL[ObMaxType];


inline __attribute__((always_inline)) bool ob_is_castable_type_class(ObObjTypeClass tc)
{
  return (ObIntTC <= tc && tc <= ObStringTC) || ObLeftTypeTC == tc || ObRightTypeTC == tc
      || ObBitTC == tc || ObEnumSetTC == tc || ObEnumSetInnerTC == tc || ObTextTC == tc
      || ObOTimestampTC == tc || ObRawTC == tc || ObJsonTC == tc || ObGeometryTC == tc
      || ObUserDefinedSQLTC == tc || ObDecimalIntTC == tc || ObCollectionSQLTC == tc
      || ObMySQLDateTimeTC == tc || ObMySQLDateTC == tc;
}


inline __attribute__((always_inline)) bool ob_is_int_uint(ObObjTypeClass left_tc, ObObjTypeClass right_tc)
{
  return (ObIntTC == left_tc && ObUIntTC == right_tc) || (ObIntTC == right_tc && ObUIntTC == left_tc);
}

inline __attribute__((always_inline)) bool ob_is_int_less_than_64(ObObjType type)
{
  return (ObTinyIntType <= type && type <= ObInt32Type)
         || (ObUTinyIntType <= type && type <= ObUInt32Type);
}


