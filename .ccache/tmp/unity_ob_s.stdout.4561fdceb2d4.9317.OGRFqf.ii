template <typename T>
int ObFixedQueue<T>::head_unsafe(T *&ptr)
{
  int ret = common::OB_SUCCESS;
  if ((__builtin_expect(!!(!is_inited_),!!0))) {
    ret = common::OB_NOT_INIT;
  } else {
    uint64_t head = __atomic_load_n((&consumer_), 5);
