public:
  static const int64_t PS_QUESTION_MARK_DEDUCE_LEN = 2000;






  static const ObAccuracy DDL_DEFAULT_ACCURACY[ObMaxType];
  static const ObAccuracy DDL_DEFAULT_ACCURACY2[1][ObMaxType];
  static const ObAccuracy MAX_ACCURACY[ObMaxType];
  static const ObAccuracy MAX_ACCURACY2[1][ObMaxType];
  static const ObAccuracy DML_DEFAULT_ACCURACY[ObMaxType];
public:
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"length", length_, "precision", precision_, "scale", scale_); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };


  int serialize(char* buf, const int64_t buf_len, int64_t& pos) const; int deserialize(const char* buf, const int64_t data_len, int64_t& pos); int64_t get_serialize_size(void) const;

  union
  {
    int64_t accuracy_;
    struct {
      ObLength length_;
      union {
        ObPrecision precision_;
        ObLengthSemantics length_semantics_;
      };
      ObScale scale_;
    };
  };
};

}
