inline int check_stack_overflow(void)
{
  bool overflow = false;
  int ret = check_stack_overflow(overflow);
  return __builtin_expect(!!(OB_SUCCESS == ret),!!1) && __builtin_expect(!!(overflow),!!0) ? OB_SIZE_OVERFLOW : ret;
}





