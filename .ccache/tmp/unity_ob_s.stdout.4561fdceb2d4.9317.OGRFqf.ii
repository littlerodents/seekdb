    typedef int expander[];
    int64_t pos = 0;
    (void)expander{0, (void(fmt(buf_, MAX_LEN + 1, pos, std::forward<Args>(args))), 0)...};
  }
  operator const char*() const { return label_; }
  const char *label_;
private:
  static void fmt(char *buf, int64_t buf_len, int64_t &pos, const char *str);
private:
  char buf_[MAX_LEN + 1];
};

