class ChunkMgr : public IChunkMgr
{
public:
  explicit ChunkMgr(ObCtxAllocator &allocator) : allocator_(allocator) {}
  AChunk *alloc_chunk(const uint64_t size, const ObMemAttr &attr) override
  {
