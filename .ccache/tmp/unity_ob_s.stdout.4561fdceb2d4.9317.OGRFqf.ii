  inline __attribute__((always_inline)) void set_length_semantics(const ObLengthSemantics length_semantics) { length_semantics_ = length_semantics; }
  inline __attribute__((always_inline)) void set_scale(const ObScale scale) { scale_ = scale; }

  inline __attribute__((always_inline)) int64_t get_accuracy() const { return accuracy_; }

  inline __attribute__((always_inline)) ObLength get_length() const { return length_; }
  inline __attribute__((always_inline)) ObPrecision get_precision() const { return precision_; }
  inline __attribute__((always_inline)) ObLengthSemantics get_length_semantics() const { return length_semantics_; }
  inline __attribute__((always_inline)) ObScale get_scale() const { return scale_; }
  inline __attribute__((always_inline)) void reset() { accuracy_ = -1; }
  static bool is_default_number_or_int(const ObAccuracy &accuracy)
  { return -1 == accuracy.get_precision(); }
  static bool is_default_number(const ObAccuracy &accuracy)
  { return -1 == accuracy.get_precision() && 0 != accuracy.get_scale(); }
  static bool is_default_number_int(const ObAccuracy &accuracy)
  { return -1 == accuracy.get_precision() && 0 == accuracy.get_scale(); }


  int64_t get_fixed_number_precision() const {
    int64_t precision = get_precision();
    if (is_default_number_int(*this)) {
      precision = DEFAULT_NUMBER_PRECISION_FOR_INTEGER;
    }
    return precision;
  }


  int64_t get_fixed_number_scale() const {
    int64_t scale = get_scale();
    if (is_default_number_int(*this)) {
      scale = DEFAULT_NUMBER_SCALE_FOR_INTEGER;
    }
    return scale;
  }

public:
  inline __attribute__((always_inline)) ObAccuracy &operator =(const ObAccuracy &other)
  {
    if (this != &other) {
      accuracy_ = other.accuracy_;
    }
    return *this;
  }
  inline __attribute__((always_inline)) bool operator ==(const ObAccuracy &other) const { return accuracy_ == other.accuracy_; }
