static void ob_zlib_free(void *opaque, void *address)
{
  ObIAllocator *allocator = static_cast<ObIAllocator *>(opaque);
  if ((__builtin_expect(!!(__null != (allocator)),!!1))) {
    allocator->free(address);
  }
}
