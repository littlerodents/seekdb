struct EventItem
{
  int64_t no_;
  const char *name_;
  const char *describe_;
  int64_t occur_;
  int64_t trigger_freq_;
  int64_t error_code_;
  int64_t cond_;

  EventItem()
    : no_(-1),
      name_(nullptr),
      describe_(nullptr),
      occur_(0),
      trigger_freq_(0),
      error_code_(0),
      cond_(0) {}

  EventItem(int64_t no, const char *name, const char *describe)
    : no_(no),
      name_(name),
      describe_(describe),
      occur_(0),
      trigger_freq_(0),
      error_code_(0),
      cond_(0) {}

  void set_event(const EventItem& other)
  {
    occur_ = other.occur_;
    trigger_freq_ = other.trigger_freq_;
    error_code_ = other.error_code_;
    cond_ = other.cond_;
  }

