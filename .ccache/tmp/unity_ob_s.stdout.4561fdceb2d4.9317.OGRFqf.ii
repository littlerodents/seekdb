class ObServerRuntimeState : public lib::IRunWrapper
{
public:
  ObServerRuntimeState();
  virtual ~ObServerRuntimeState() = default;

  int init();
  void destroy();
  uint64_t id() const override { return common::OB_SERVER_RUNTIME_ID; }

