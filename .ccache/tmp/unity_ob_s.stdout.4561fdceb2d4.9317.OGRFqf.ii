class ObAddr
{
  public: int serialize(char *buf, const int64_t buf_len, int64_t &pos) const ; int serialize_(char *buf, const int64_t buf_len, int64_t &pos) const; int deserialize(const char *buf, const int64_t data_len, int64_t &pos) ; int deserialize_(const char *buf, const int64_t data_len, int64_t &pos); int64_t get_serialize_size() const ; int64_t get_serialize_size_() const;; private: const static int64_t UNIS_VERSION = 1;

public:
