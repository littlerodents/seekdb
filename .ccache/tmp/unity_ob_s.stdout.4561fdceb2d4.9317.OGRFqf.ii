  inline __attribute__((always_inline)) static bool has_delete_event(uint64_t value) { return 0 != (value & (common::ObDmlEventType::DE_DELETING)); }
  inline __attribute__((always_inline)) static bool is_insert_event(uint64_t value) { return (common::ObDmlEventType::DE_INSERTING) == value; }
  inline __attribute__((always_inline)) static bool is_update_event(uint64_t value) { return (common::ObDmlEventType::DE_UPDATING) == value; }
  inline __attribute__((always_inline)) static bool is_delete_event(uint64_t value) { return (common::ObDmlEventType::DE_DELETING) == value; }
public:
  union {
    uint64_t bit_value_;
    struct {
      uint64_t insert_:1;
      uint64_t update_:1;
      uint64_t delete_:1;
      uint64_t reserved_events_:2;
      uint64_t reserved_:59;
    };
  };



};

class ObTimingPoints
{
public:
  ObTimingPoints()
    : bit_value_(0)
  {}
  inline __attribute__((always_inline)) void reset() { set_value(0); }
  inline __attribute__((always_inline)) void merge(const ObTimingPoints &other) { bit_value_ |= other.get_value(); }
  inline __attribute__((always_inline)) void set_value(uint64_t value) { bit_value_ = value; }
  inline __attribute__((always_inline)) void add_before_row() { before_row_ = 1; }
  inline __attribute__((always_inline)) void add_after_row() { after_row_ = 1; }
  inline __attribute__((always_inline)) void add_when_condition() { when_condition_ = 1; }
  inline __attribute__((always_inline)) uint64_t get_value() const { return bit_value_; }
  inline __attribute__((always_inline)) bool has_before_row() const { return 1 == before_row_; }
  inline __attribute__((always_inline)) bool has_after_row() const { return 1 == after_row_; }
  inline __attribute__((always_inline)) bool has_when_condition() const { return 1 == when_condition_; }
  inline __attribute__((always_inline)) bool has_before_point() const { return 1 == before_row_; }
  inline __attribute__((always_inline)) bool has_after_point() const { return 1 == after_row_; }
  inline __attribute__((always_inline)) bool has_row_point() const { return 1 == before_row_ || 1 == after_row_; }
  inline __attribute__((always_inline)) bool only_before_row() const { return 1 == before_row_ && 0 == after_row_; }
  inline __attribute__((always_inline)) bool only_after_row() const { return 0 == before_row_ && 1 == after_row_; }
  inline __attribute__((always_inline)) void set_before_event() { before_event_ = 1; }
  inline __attribute__((always_inline)) void set_after_event() { after_event_ = 1; }
  inline __attribute__((always_inline)) bool is_before_event() const { return 1 == before_event_; }
  inline __attribute__((always_inline)) bool is_after_event() const { return 1 == after_event_; }
public:
  union
  {
    uint64_t bit_value_;
    struct {
      uint64_t when_condition_:1;
      uint64_t reserved_point1_:1;
      uint64_t before_row_:1;
      uint64_t after_row_:1;
      uint64_t reserved_point2_:2;
      uint64_t before_event_:1;
      uint64_t after_event_:1;
      uint64_t reserved_:56;
    };
  };
};

class ObTriggerFlags
{
public:
  ObTriggerFlags()
    : bit_value_(0)
  {}
  inline __attribute__((always_inline)) void reset() { set_value(0); }
  inline __attribute__((always_inline)) void set_value(uint64_t value) { bit_value_ = value; }
  inline __attribute__((always_inline)) void set_enable() { enable_ = 1; }
  inline __attribute__((always_inline)) void set_disable() { enable_ = 0; }
  inline __attribute__((always_inline)) uint64_t get_value() const { return bit_value_; }
  inline __attribute__((always_inline)) bool is_enable() const { return 1 == enable_; }
public:
  union
  {
    uint64_t bit_value_;
    struct {
      uint64_t enable_:1;
      uint64_t reserved_:63;
    };
  };
};

enum TgTimingEvent
{
  TG_TIMING_EVENT_INVALID = -1,
  TG_BEFORE_INSERT = 0,
  TG_BEFORE_UPDATE,
  TG_BEFORE_DELETE,
  TG_AFTER_INSERT,
  TG_AFTER_UPDATE,
  TG_AFTER_DELETE
};

