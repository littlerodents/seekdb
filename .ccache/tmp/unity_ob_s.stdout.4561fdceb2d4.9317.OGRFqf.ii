using lib::ObMemAttr;
class ObAllocAlign
{
public:
  struct Header
  {
    static const uint32_t MAGIC_CODE = 0XAA22CCE1;
    bool check_magic_code() const { return MAGIC_CODE == magic_code_; }
    void mark_unused() { magic_code_ &= ~0x1; }
