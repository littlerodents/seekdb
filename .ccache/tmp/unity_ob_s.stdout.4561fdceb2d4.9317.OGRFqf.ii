                  const uint64_t obj_id, const uint64_t obj_type,
                  const uint64_t col_id)
    : grantee_id_(grantee_id),
      obj_id_(obj_id), obj_type_(obj_type),
      col_id_(col_id)
  {}
  bool operator==(const ObUrObjId &rhs) const
  {
