}

template <class T>
ObSimpleThreadPoolBase<T>::~ObSimpleThreadPoolBase()
{
  if (is_inited_) {
    destroy();
  }
}

template <class T>
int ObSimpleThreadPoolBase<T>::init(
    const int64_t thread_num, const int64_t task_num_limit,
    const char *name)
{
  int ret = OB_SUCCESS;
  if (is_inited_) {
    ret = OB_INIT_TWICE;
  } else if (thread_num <= 0 || task_num_limit <= 0 || (__builtin_expect(!!(__null == (name)),!!0))) {
    ret = OB_INVALID_ARGUMENT;
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (queue_.init(task_num_limit, name)))),!!0))) {
  } else {
    is_inited_ = true;
    stop_ = false;
    name_ = name;

    if (max_thread_cnt_ < 0) {
      max_thread_cnt_ = thread_num;
    }
    if (min_thread_cnt_ < 0) {
      min_thread_cnt_ = 0;
    }
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ObSimpleThreadPoolDynamicMgr::get_instance().bind(this)))),!!0))) {
    }
  }
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ret))),!!0))) {
    destroy();
  } else {
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 2)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 2, "src/oblib/lib/thread/ob_simple_thread_pool.ipp", 76, __FUNCTION__, 0, "simple thread pool init success", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::ObSzString(name)), std::is_rvalue_reference<decltype((::oceanbase::common::ObSzString(name)))&&>::value>("name", ::oceanbase::common::ObSzString(name)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(thread_num)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(thread_num)))&&>::value>("thread_num", ::oceanbase::common::check_char_array(thread_num)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(task_num_limit)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(task_num_limit)))&&>::value>("task_num_limit", ::oceanbase::common::check_char_array(task_num_limit))); } } } while (false);

  }
  return ret;
}

template <class T>
void ObSimpleThreadPoolBase<T>::destroy()
{
  is_inited_ = false;
  stop_ = true;

  {
    lib::ObMutexGuard g(workers_lock_);
    for (auto wnode = (workers_).get_first(); (true) && wnode != (workers_).get_header() && wnode != __null; wnode = wnode->get_next()) {
      wnode->get_data()->stop();
    }
  }

  {
    lib::ObMutexGuard g(workers_lock_);
    for (auto wnode = (workers_).get_first(), save = wnode->get_next(); (true) && wnode != (workers_).get_header(); wnode = save, save = save->get_next()) {
      Worker *w = wnode->get_data();
      workers_.remove(wnode);
      w->wait();
      w->destroy();
      do{ if (__null != w) { w->~Worker(); ob_free(w); w = __null; } } while(0);
    }
  }
  (void) ObSimpleThreadPoolDynamicMgr::get_instance().unbind(this);
  queue_.destroy();
}

template <class T>
int ObSimpleThreadPoolBase<T>::push(TaskType *task)
{
  int ret = OB_SUCCESS;
  if (!is_inited_) {
    ret = OB_NOT_INIT;
  } else if (__null == task) {
    ret = OB_INVALID_ARGUMENT;
  } else if (stop_) {
    ret = OB_IN_STOP_STATE;
  } else {
    ret = queue_.push(task);
    if (OB_SIZE_OVERFLOW == ret) {
      ret = OB_EAGAIN;
    }
    if (this->idle_count() == 0) {
      this->try_expand_one(max_thread_cnt_);
    }
  }
  return ret;
}

template <class T>
bool ObSimpleThreadPoolBase<T>::do_add_worker()
{
  if (stop_) {
    return false;
  }
  Worker *w = nullptr;
  {
    lib::ObMutexGuard g(workers_lock_);

    w = ({ Worker* ret = __null; void *buf = oceanbase::common::ob_malloc(sizeof(Worker), "QThWker"); if ((__builtin_expect(!!(__null != (buf)),!!1))) { ret = new(buf) Worker(this, static_cast<int64_t>(cur_worker_idx_++)); } ret; });
    if ((__builtin_expect(!!(__null == (w)),!!0))) {
      return false;
    }
    if (run_wrapper_ != nullptr) {
      w->set_run_wrapper(run_wrapper_);
    }
    if (OB_SUCCESS != w->init()) {
      do{ if (__null != w) { w->~Worker(); ob_free(w); w = __null; } } while(0);
      return false;
    }
  }


  if (OB_SUCCESS != w->start()) {
    do{ if (__null != w) { w->~Worker(); ob_free(w); w = __null; } } while(0);
    return false;
  }


  {
    lib::ObMutexGuard g(workers_lock_);
    bool ok = workers_.add_last(&w->worker_node_);
    abort_unless(ok);
  }
  return true;
}

template <class T>
int ObSimpleThreadPoolBase<T>::set_adaptive_thread(
    int64_t min_thread_num, int64_t max_thread_num)
{
  int ret = OB_SUCCESS;
  if (min_thread_num < 0 || max_thread_num <= 0
      || min_thread_num > max_thread_num) {
    ret = OB_INVALID_ARGUMENT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 4, "src/oblib/lib/thread/ob_simple_thread_pool.ipp", 177, __FUNCTION__, ret, "set_adaptive_thread failed", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(reinterpret_cast<const void*>(this)), std::is_rvalue_reference<decltype((reinterpret_cast<const void*>(this)))&&>::value>("this", reinterpret_cast<const void*>(this)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(min_thread_num)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(min_thread_num)))&&>::value>("min_thread_num", ::oceanbase::common::check_char_array(min_thread_num)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(max_thread_num)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(max_thread_num)))&&>::value>("max_thread_num", ::oceanbase::common::check_char_array(max_thread_num))); } } } while (false);

  } else {
    min_thread_cnt_ = min_thread_num;
    max_thread_cnt_ = max_thread_num;
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ObSimpleThreadPoolDynamicMgr::get_instance().bind(this)))),!!0))) {
    }
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 2)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 2, "src/oblib/lib/thread/ob_simple_thread_pool.ipp", 184, __FUNCTION__, 0, "set adaptive thread success", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(reinterpret_cast<const void*>(this)), std::is_rvalue_reference<decltype((reinterpret_cast<const void*>(this)))&&>::value>("this", reinterpret_cast<const void*>(this)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(min_thread_num)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(min_thread_num)))&&>::value>("min_thread_num", ::oceanbase::common::check_char_array(min_thread_num)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(max_thread_num)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(max_thread_num)))&&>::value>("max_thread_num", ::oceanbase::common::check_char_array(max_thread_num))); } } } while (false);

  }
  return ret;
}

template <class T>
int ObSimpleThreadPoolBase<T>::set_thread_count(int64_t n_threads)
{
  int ret = OB_SUCCESS;
  if (n_threads <= 0) {
    ret = OB_INVALID_ARGUMENT;
  } else {
    max_thread_cnt_ = n_threads;
    if (min_thread_cnt_ > max_thread_cnt_) {
      min_thread_cnt_ = max_thread_cnt_;
    }
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ObSimpleThreadPoolDynamicMgr::get_instance().bind(this)))),!!0))) {
    }
  }
  return ret;
}

template <class T>
void ObSimpleThreadPoolBase<T>::stop()
{
  stop_ = true;
  notify_stop();
  lib::ObMutexGuard g(workers_lock_);
  for (auto wnode = (workers_).get_first(); (true) && wnode != (workers_).get_header() && wnode != __null; wnode = wnode->get_next()) {
    wnode->get_data()->stop();
  }
}

template <class T>
void ObSimpleThreadPoolBase<T>::wait()
{
  lib::ObMutexGuard g(workers_lock_);
  for (auto wnode = (workers_).get_first(); (true) && wnode != (workers_).get_header() && wnode != __null; wnode = wnode->get_next()) {
    wnode->get_data()->wait();
  }
}

template <class T>
void ObSimpleThreadPoolBase<T>::reap_workers()
{

  lib::ObMutexGuard g(workers_lock_);
  for (auto wnode = (workers_).get_first(), save = wnode->get_next(); (true) && wnode != (workers_).get_header(); wnode = save, save = save->get_next()) {
    Worker *w = wnode->get_data();
    if (w->has_set_stop()) {
      workers_.remove(wnode);
      w->wait();
      w->destroy();
      do{ if (__null != w) { w->~Worker(); ob_free(w); w = __null; } } while(0);
    }
  }
}

template <class T>
void ObSimpleThreadPoolBase<T>::Worker::run1()
{
  if (__null != pool_->name_) {
    lib::set_thread_name(pool_->name_, idx_);
  }
  pool_->cur_worker_idx_ = idx_;
  pool_->run1();

  this->has_set_stop() = true;
}

template <class T>
void ObSimpleThreadPoolBase<T>::run1()
{
  int64_t idle_since = 0;
  while (!stop_ && !lib::Thread::current().has_set_stop()) {
    QElemType *task = __null;
    bool expand = false;
    int ret = this->pop_with_idle([&]() {
      return queue_.pop(task, QUEUE_WAIT_TIME);
    }, expand);

    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
      if ((__builtin_expect(!!(__null != (task)),!!1))) {
        idle_since = 0;
        if (expand) {
          this->try_expand_one(max_thread_cnt_);
        }
        handle(static_cast<TaskType *>(task));
      }
    } else if (OB_ENTRY_NOT_EXIST == ret) {
      int64_t now = ObTimeUtility::current_time();
      if (idle_since == 0) {
        idle_since = now;
      } else if (now - idle_since >= SHRINK_TIMEOUT_US) {
        if (this->try_shrink_one(min_thread_cnt_)) {
          return;
        }
        idle_since = 0;
      }
    }
  }

  if (stop_) {
    int ret = OB_SUCCESS;
    QElemType *task = __null;
    while ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (queue_.pop(task)))),!!1))) {
      handle_drop(static_cast<TaskType *>(task));
    }
  }
}

}
