template<typename T1, typename T2>
    inline int databuff_encode_element(char *buf, const int64_t buf_len, int64_t &pos, ElementKeyType key, const std::pair<T1,T2> &obj)
{
  int ret = OB_SUCCESS;
  if (__builtin_expect(!!(buf_len-pos < static_cast<int64_t>(sizeof(uint8_t)) + static_cast<int64_t>(sizeof(ElementKeyType)) + static_cast<int64_t>(sizeof(int32_t))),!!0)) {
