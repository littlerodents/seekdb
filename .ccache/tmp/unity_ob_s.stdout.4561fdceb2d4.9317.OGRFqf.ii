inline __attribute__((always_inline)) bool ObNumber::fast_mul_2d_mul_2d(const uint32_t *multiplicand_digits,
                                           const uint32_t *multiplier_digits,
                                           uint32_t multiplicand_desc,
                                           uint32_t multiplier_desc,
