ObStringBufT<PageAllocatorT, PageArenaT> :: ~ObStringBufT()
{
  reset();
}

template <typename PageAllocatorT, typename PageArenaT>
int ObStringBufT<PageAllocatorT, PageArenaT> :: reset()
{
  local_arena_.free();
  return OB_SUCCESS;
}

template <typename PageAllocatorT, typename PageArenaT>
int ObStringBufT<PageAllocatorT, PageArenaT> :: reuse()
{
  local_arena_.reuse();
  return OB_SUCCESS;
}

