  uint64_t hash() const;
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"tz_name", common::ObString(common::OB_MAX_TZ_NAME_LEN, tz_name_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
