          event_code = 0;
          break;
        }
      } while (true);
    } else if (__builtin_expect(!!(trigger_freq == 0),!!1)) {
      event_code = 0;
    } else if (get_tp_switch()) {
      event_code = 0;
    } else if (trigger_freq == 1) {
      event_code = error_code_;

      if (({ bool bret = false; static thread_local int64_t last_time = 0; int64_t cur_time = common::ObClockGenerator::getClock(); if (__builtin_expect(!!((1 * 1000 * 1000 + last_time) < cur_time),!!0)) { last_time = cur_time; bret = true; } bret; }))

