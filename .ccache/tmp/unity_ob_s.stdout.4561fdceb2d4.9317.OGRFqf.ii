template <int64_t N>
int64_t ObFixedBitSet<N>::num_members() const
{
  int64_t num = 0;
  BitSetWord word = 0;

  for (int64_t i = 0; i < MAX_BITSETWORD; i ++) {
    word = bitset_word_array_[i];
    if (0 == word) {

    } else {
      word = (word & 0x55555555U) + ((word >> 1) & 0x55555555U);
      word = (word & 0x33333333U) + ((word >> 2) & 0x33333333U);
      word = (word & 0x0f0f0f0fU) + ((word >> 4) & 0x0f0f0f0fU);
      word = (word & 0x00ff00ffU) + ((word >> 8) & 0x00ff00ffU);
      word = (word & 0x0000ffffU) + ((word >> 16) & 0x0000ffffU);
      num += (int64_t)word;
    }
  }
  return num;
}

template <int64_t N>
bool ObFixedBitSet<N>::is_empty() const
{
