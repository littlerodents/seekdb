class TreeNode
{
public:
  TreeNode(TreeNode *parent,
          const bool with_lock)
    : parent_(parent),
      child_(nullptr),
      prev_(nullptr),
      next_(nullptr),
      with_lock_(with_lock),
      lock_(0)
  {}

  void init()
  {
    if (__builtin_expect(!!(parent_ != nullptr),!!1)) {
      auto *parent = parent_;
      parent_ = nullptr;
      parent->add_child(*this);
    }
  }

  void deinit()
  {
    if (__builtin_expect(!!(parent_ != nullptr),!!1)) {
      parent_->del_child(*this);
    }
  }

  void add_child(TreeNode &node)
  {
    if (__builtin_expect(!!(with_lock_),!!0)) {
      while (({ ((void)(0)); ; __atomic_exchange_n((&lock_), (1), 5); })) {
        ({; asm("yield\n");});
      }
    }
    abort_unless(nullptr == node.parent_ &&
        nullptr == node.prev_ && nullptr == node.next_);
    node.parent_ = this;
    if (nullptr == child_) {
      child_ = &node;
    } else {
      node.next_ = child_->next_;
      if (child_->next_ != nullptr) {
        child_->next_->prev_ = &node;
      }
      child_->next_ = &node;
      node.prev_ = child_;
    }
    if (__builtin_expect(!!(with_lock_),!!0)) {
      ({ __atomic_store_n((&lock_), (0), 5);});
    }
  }

  void del_child(TreeNode &node)
  {
    if (__builtin_expect(!!(with_lock_),!!0)) {
      while (({ ((void)(0)); ; __atomic_exchange_n((&lock_), (1), 5); })) {
        ({; asm("yield\n");});
      }
    }
    abort_unless(node.parent_ == this);
    node.parent_ = nullptr;
    TreeNode *prev = node.prev_;
    TreeNode *next = node.next_;
    if (prev != nullptr) {
      prev->next_ = next;
    }
    if (next != nullptr) {
      next->prev_ = prev;
    }
    node.prev_ = node.next_ = nullptr;
    if (this->child_ == &node) {
      abort_unless(prev == nullptr);
      this->child_ = next;
    }
    if (__builtin_expect(!!(with_lock_),!!0)) {
      ({ __atomic_store_n((&lock_), (0), 5);});
    }
  }

