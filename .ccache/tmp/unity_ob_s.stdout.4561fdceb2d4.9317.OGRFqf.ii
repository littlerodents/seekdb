    }
    return ret;
  }
  static inline bool is_negative(const ObDecimalInt *decint, const int32_t int_bytes)
  {
    bool ret = false;
    switch (int_bytes) {
    case 4: ret = *(reinterpret_cast<const int32_t *>(decint)) < 0; break;
