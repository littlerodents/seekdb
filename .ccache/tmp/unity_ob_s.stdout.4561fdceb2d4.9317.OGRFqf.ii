inline int64_t ObObj::get_data_length() const
{
  int64_t ret = sizeof(v_);
  if (ob_is_string_type(get_type()) ||
      ob_is_json(get_type()) ||
      ob_is_geometry(get_type()) ||
      ob_is_collection_sql_type(get_type())) {
    ret = val_len_;
  } else if (ob_is_number_tc(get_type())) {
    ret = nmb_desc_.len_ * sizeof(uint32_t);
  }
  return ret;
};

inline int64_t ObObj::get_tight_data_len() const
{
  int64 len = 0;
  const ObObjType obj_type = get_type();
  if (ob_is_var_len_type(obj_type)) {
    len = val_len_;
  } else if (ob_is_number_tc(obj_type)) {
    len = nmb_desc_.len_ * sizeof(uint32_t);
  } else {
    switch(obj_type) {
      case ObNullType:
      case ObTinyIntType:
      case ObUTinyIntType:
      case ObYearType:
        len = 1;
        break;
      case ObSmallIntType:
      case ObUSmallIntType:
        len = 2;
        break;
      case ObMediumIntType:
      case ObUMediumIntType:
      case ObInt32Type:
      case ObUInt32Type:
      case ObFloatType:
      case ObUFloatType:
      case ObDateType:
      case ObMySQLDateType:
        len = 4;
        break;
      case ObIntType:
      case ObUInt64Type:
      case ObDoubleType:
      case ObUDoubleType:
      case ObDateTimeType:
      case ObTimestampType:
      case ObTimeType:
      case ObBitType:
      case ObEnumType:
      case ObSetType:
      case ObMySQLDateTimeType:
        len = 8;
        break;
      default:
        do{ if(__builtin_expect(!!(!(0)),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/oblib/common/object/ob_object.h", 3459, __FUNCTION__, ret, "assert fail, exp=%s", "0"); } } } while (false); }; do { if (__builtin_expect(!!(1),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/oblib/common/object/ob_object.h", 3459, __FUNCTION__, ret, "assert fail" " BACKTRACE:%s", oceanbase::common::lbt()); } } } while (false); }; } } while (false); ob_abort(); } } while(false);
        break;
