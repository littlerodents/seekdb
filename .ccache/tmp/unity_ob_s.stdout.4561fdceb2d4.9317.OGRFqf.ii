namespace oceanbase
{
namespace common
{
namespace hash
{


template <typename ItemArray, typename Item, uint64_t N = 1031>
class ObArrayIndexHashSet
{
public:
  typedef uint32_t IndexType;
  static const IndexType INVALID_INDEX = (4294967295U);

public:
  ObArrayIndexHashSet()
      : array_(__null),
        collision_count_(0),
        index_base_(INVALID_INDEX)
  {
  }
  explicit ObArrayIndexHashSet(const ItemArray &array)
      : array_(&array),
        index_base_(INVALID_INDEX)
  {
    reset();
  }

  void init(const ItemArray &array)
  {
    array_ = &array;
  }




  inline int set_index(const uint64_t idx)
  {
    int ret = OB_SUCCESS;
    if (idx >= N) {
      ret = OB_INVALID_ARGUMENT;
    } else {
      const Item &item = (*array_)[idx];
      uint64_t pos = anchor_idx(item);
      uint64_t i = 0;

      for (; i < N; ++i) {
        if (__builtin_expect(!!(!has_member(index_[pos])),!!1)) {
          index_[pos] = static_cast<IndexType>(idx + index_base_);
          break;
        } else if (__builtin_expect(!!((*array_)[(index_[pos] - index_base_)] == item),!!1)) {
          if (__builtin_expect(!!(idx != (index_[pos] - index_base_)),!!0)) {
            do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/oblib/lib/hash/ob_array_index_hash_set.h", 80, __FUNCTION__, ret, "idx %ld, exist idx %lu", idx, static_cast<uint64_t>((index_[pos] - index_base_))); } } } while (false);

            ret = OB_ENTRY_EXIST;
          }
          break;
        } else if (__builtin_expect(!!(N == ++pos),!!0)) {
          pos = 0;
        }
        collision_count_++;
      }

      if (__builtin_expect(!!(N == i),!!0)) {
        ret = OB_HASH_FULL;
        do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/oblib/lib/hash/ob_array_index_hash_set.h", 92, __FUNCTION__, ret, "hash bucket are full, N %lu, ret %d", N, ret); } } } while (false);
      }
    }
    return ret;
  }


  inline int get_index(const Item &item, uint64_t &idx) const
  {
    int ret = OB_ENTRY_NOT_EXIST;
    uint64_t pos = anchor_idx(item);
    uint64_t i = 0;
    idx = static_cast<uint64_t>(OB_INVALID_INDEX);

    for (; i < N; ++i) {
      if (__builtin_expect(!!(!has_member(index_[pos])),!!0)) {
        break;
      } else if (__builtin_expect(!!((*array_)[(index_[pos] - index_base_)] == item),!!1)) {
        ret = OB_SUCCESS;
        idx = (index_[pos] - index_base_);
        break;
      } else if (__builtin_expect(!!(N == ++pos),!!0)) {
        pos = 0;
      }
    }
    return ret;
  }

  inline uint64_t get_collision_count() const
  {
    return collision_count_;
  }

  inline void reset()
  {
    if (__builtin_expect(!!(index_base_ >= INVALID_INDEX - N),!!0)) {
      memset(index_, 0xff, sizeof(IndexType) * N);
      index_base_ = 0;
    } else {
      index_base_ += N;
    }
    collision_count_ = 0;
  }

  inline uint64_t anchor_idx(const Item &item) const
  {
    return do_hash(item) % N;
  }

  inline bool has_member(const IndexType index) const
  {
    return (index >= index_base_ && index < index_base_ + N);
  }

private:
  static_assert(N < (4294967295U), "unsupport N more than UINT32_MAX");

  const ItemArray *array_;
  IndexType index_[N];
  uint64_t collision_count_;
  uint64_t index_base_;

  ObArrayIndexHashSet(const ObArrayIndexHashSet&); void operator=(const ObArrayIndexHashSet&);
};
};
};
};
