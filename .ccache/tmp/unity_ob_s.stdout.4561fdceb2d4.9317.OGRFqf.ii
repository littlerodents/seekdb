template <class T>
ObSimpleThreadPoolBase<T>::ObSimpleThreadPoolBase()
    : ObSimpleDynamicThreadPool(),
      is_inited_(false), stop_(false),
      run_wrapper_(nullptr),
      cur_worker_idx_(0)
