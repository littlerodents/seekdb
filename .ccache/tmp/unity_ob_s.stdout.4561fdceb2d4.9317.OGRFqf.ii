using oceanbase::common::ObIAllocator;
static void *ob_zstd_malloc(void *opaque, size_t size)
{
  void *buf = __null;
  if (__null != opaque) {
    ObIAllocator *allocator = reinterpret_cast<ObIAllocator*> (opaque);
    buf = allocator->alloc(size);
