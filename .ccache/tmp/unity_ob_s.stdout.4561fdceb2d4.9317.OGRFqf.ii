  common::ObString table_;
  ObPrivLevel priv_level_;
  ObPrivSet priv_set_;
  bool is_sys_table_;
  share::schema::ObObjectType obj_type_;
  bool is_for_update_;
  ObPrivCheckType priv_check_type_;
  ObSEArray<ObString, 4> columns_;


  bool check_any_column_priv_;

  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"db", ::oceanbase::common::check_char_array(db_), "table", ::oceanbase::common::check_char_array(table_), "columns", ::oceanbase::common::check_char_array(columns_), "priv_set", ::oceanbase::common::check_char_array(priv_set_), "priv_level", ::oceanbase::common::check_char_array(priv_level_), "is_sys_table", ::oceanbase::common::check_char_array(is_sys_table_), "is_for_update", ::oceanbase::common::check_char_array(is_for_update_), "priv_check_type", ::oceanbase::common::check_char_array(priv_check_type_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };

