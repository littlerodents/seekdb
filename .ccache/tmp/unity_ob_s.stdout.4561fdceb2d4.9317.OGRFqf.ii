  void unlock() const;
  bool will_unlock() const;

private:

  ObUtilMutex(const ObUtilMutex&);
  ObUtilMutex& operator=(const ObUtilMutex&);

  struct LockState
  {
    pthread_mutex_t* mutex;
  };

  void unlock(LockState&) const;
