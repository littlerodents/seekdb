class ObTimerUtil
{
public:
    static void copy_buff(char *buf, int64_t buf_len, const char *value)
    {
      if (nullptr != buf && nullptr != value && '\0' != value[0] && buf_len > 0) {
        strncpy(buf, value, buf_len);
        buf[buf_len - 1] = '\0';
      }
    }
};

class ObTimerTask
{
public:
