namespace oceanbase {
namespace share {

class ObServerRole
{
  public: int serialize(char *buf, const int64_t buf_len, int64_t &pos) const ; int serialize_(char *buf, const int64_t buf_len, int64_t &pos) const; int deserialize(const char *buf, const int64_t data_len, int64_t &pos) ; int deserialize_(const char *buf, const int64_t data_len, int64_t &pos); int64_t get_serialize_size() const ; int64_t get_serialize_size_() const;; private: const static int64_t UNIS_VERSION = 1;
public:
  enum Role
  {
    INVALID_ROLE = 0,
    PRIMARY_ROLE = 1,
    STANDBY_ROLE = 2,
    RESTORE_ROLE = 3,
    MAX_ROLE = 4,
  };
public:
  ObServerRole() : value_(INVALID_ROLE) {}
  explicit ObServerRole(const Role value) : value_(value) {}
  explicit ObServerRole(const ObString &str);
  ~ObServerRole() { reset(); }

public:
  void reset() { value_ = INVALID_ROLE; }
  bool is_valid() const { return INVALID_ROLE != value_; }
  Role value() const { return value_; }
  const char* to_str() const;


  ObServerRole &operator=(const Role value) { value_ = value; return *this; }


  bool operator == (const ObServerRole &other) const { return value_ == other.value_; }
  bool operator != (const ObServerRole &other) const { return value_ != other.value_; }


  bool is_invalid() const { return INVALID_ROLE == value_; }
  bool is_primary() const { return PRIMARY_ROLE == value_; }
  bool is_standby() const { return STANDBY_ROLE == value_; }
  bool is_restore() const { return RESTORE_ROLE == value_; }

  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"server_role", to_str(), "value", ::oceanbase::common::check_char_array(value_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
  int to_yson(char *buf, const int64_t buf_len, int64_t &pos) const;
private:
  Role value_;
};




bool is_invalid_role(const ObServerRole::Role value);
bool is_primary_role(const ObServerRole::Role value);
bool is_standby_role(const ObServerRole::Role value);
bool is_restore_role(const ObServerRole::Role value);


static const ObServerRole INVALID_SERVER_ROLE(ObServerRole::INVALID_ROLE);
static const ObServerRole PRIMARY_SERVER_ROLE(ObServerRole::PRIMARY_ROLE);
static const ObServerRole STANDBY_SERVER_ROLE(ObServerRole::STANDBY_ROLE);
static const ObServerRole RESTORE_SERVER_ROLE(ObServerRole::RESTORE_ROLE);

}
}
