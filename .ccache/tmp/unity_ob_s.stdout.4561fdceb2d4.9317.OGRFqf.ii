  ObWideInteger<Bits>::_impl::bitwise_and(rhs, lhs, res);
  return res;
}

template <unsigned Bits1, unsigned Bits2>
ObWideInteger<Bits1 >= Bits2 ? Bits1 : Bits2> operator&(const ObWideInteger<Bits1> &lhs,
