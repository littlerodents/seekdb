template <typename Allocator>
int load_file_to_string(const char *path, Allocator &allocator, ObString &str)
{
  int ret = OB_SUCCESS;
  struct stat st;
  char *buf = __null;
  int fd = -1;
  int64_t size = 0;

  if (__null == path || strlen(path) == 0) {
    ret = OB_INVALID_ARGUMENT;
  } else if ((fd = ::open(path, 00)) < 0) {
    do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/oblib/lib/utility/utility.h", 723, __FUNCTION__, ret, "open file %s failed, errno %d", path, (*__errno_location ())); } } } while (false);
    ret = OB_ERROR;
