        }
        for (unsigned i = op_items; i < ITEM_COUNT; i++) { res.items_[i] = lhs.items_[i]; }
        for (unsigned i = 1; i < ITEM_COUNT; i++) {
          if (overflows[i - 1]) {
            res.items_[i]++;
