    }
    return ret;
  }
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"user_id", ::oceanbase::common::check_char_array(user_id_), "db", ::oceanbase::common::check_char_array(db_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };

  uint64_t user_id_;
  common::ObString db_;
};

