        }
      }
    } else {
      using calc_type = typename CommonType<ObWideInteger<Bits, Signed>, T>::type;
      calc_type xres;
      ret = calc_type::_impl::bitwise_and(calc_type(self), rhs, xres);
      res = xres;
    }
    return ret;
  }
