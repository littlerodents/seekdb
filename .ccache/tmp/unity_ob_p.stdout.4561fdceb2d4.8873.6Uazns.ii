    } else if ((__builtin_expect(!!(__null == (package_spec)),!!0))){
      ret = OB_ERR_PACKAGE_DOSE_NOT_EXIST;
    } else {
      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (package_spec->get_var(var_name, var, var_idx)))),!!0))) {
      }
    }
  }
  return ret;
}

