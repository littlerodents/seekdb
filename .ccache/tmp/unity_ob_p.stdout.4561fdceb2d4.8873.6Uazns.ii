struct ObStmtLevelRefSet: public common::ObBitSet<common::OB_DEFAULT_STATEMEMT_LEVEL_COUNT>
{
  virtual int64_t to_string(char* buf, const int64_t buf_len) const
  {
    int64_t pos = 0;
    ::oceanbase::common::databuff_printf(buf, buf_len, pos,"[");
    int32_t num = 0;
    for (int32_t i = 0; i < bit_count(); ++i) {
      if (has_member(i)) {
        if (num != 0) {
          ::oceanbase::common::databuff_printf(buf, buf_len, pos,", ");
        }
        (void)::oceanbase::common::databuff_print_obj(buf, buf_len, pos, i);
        ++num;
      }
    }
    ::oceanbase::common::databuff_printf(buf, buf_len, pos,"]");
    return pos;
  }
};

