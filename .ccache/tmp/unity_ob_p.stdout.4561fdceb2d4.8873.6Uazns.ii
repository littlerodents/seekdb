inline __attribute__((always_inline)) int ObDtlMsgHeader::serialize(char* buf, const int64_t buf_len, int64_t& pos) const
{
  using namespace common;
  using namespace common::serialization;

  int ret = OB_SUCCESS;
  if (buf_len - pos < static_cast<int64_t>(sizeof (*this))) {
    ret = OB_SIZE_OVERFLOW;
  } else {
    (void) encode_i16(buf, buf_len, pos, hlen_);
    (void) encode_i16(buf, buf_len, pos, type_);
    (void) encode_i32(buf, buf_len, pos, nbody_);
    (void) encode_i64(buf, buf_len, pos, checksum_);
  }
  return ret;
}

inline __attribute__((always_inline)) int ObDtlMsgHeader::deserialize(const char* buf, const int64_t data_len, int64_t& pos)
{
  using namespace common;
  using namespace common::serialization;

  int ret = OB_SUCCESS;
  if (data_len - pos < static_cast<int64_t>(sizeof (*this))) {
    ret = OB_SIZE_OVERFLOW;
  } else {
    (void) decode_i16(buf, data_len, pos, (int16_t*)&hlen_);
    (void) decode_i16(buf, data_len, pos, (int16_t*)&type_);
    (void) decode_i32(buf, data_len, pos, &nbody_);
    (void) decode_i64(buf, data_len, pos, &checksum_);
  }
  return ret;
}

inline __attribute__((always_inline)) int64_t ObDtlMsgHeader::get_serialize_size(void) const
{
  return sizeof (*this);
}

class ObDtlMsg {
