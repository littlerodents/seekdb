inline __attribute__((always_inline)) void CordzInfo::MaybeTrackCord(
    InlineData& cord, MethodIdentifier method) {
  if ((__builtin_expect(false || (cordz_should_profile()), false))) {
    TrackCord(cord, method);
  }
}

inline __attribute__((always_inline)) void CordzInfo::MaybeTrackCord(
    InlineData& cord, const InlineData& src, MethodIdentifier method) {
  if ((__builtin_expect(false || (InlineData::is_either_profiled(cord, src)), false))) {
    MaybeTrackCordImpl(cord, src, method);
  }
}

inline __attribute__((always_inline)) void CordzInfo::MaybeUntrackCord(
    CordzInfo* info) {
  if ((__builtin_expect(false || (info), false))) {
    info->Untrack();
  }
}

inline void CordzInfo::AssertHeld() __attribute__((assert_exclusive_lock(mutex_))) {



}

inline void CordzInfo::SetCordRep(CordRep* rep) {
  AssertHeld();
  rep_ = rep;
}

inline void CordzInfo::UnsafeSetCordRep(CordRep* rep) { rep_ = rep; }

inline CordRep* CordzInfo::RefCordRep() const __attribute__((locks_excluded(mutex_))) {
  MutexLock lock(&mutex_);
  return rep_ ? CordRep::Ref(rep_) : nullptr;
}

