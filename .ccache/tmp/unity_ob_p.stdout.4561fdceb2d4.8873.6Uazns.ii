  bool operator == (const ObServerRole &other) const { return value_ == other.value_; }
  bool operator != (const ObServerRole &other) const { return value_ != other.value_; }


  bool is_invalid() const { return INVALID_ROLE == value_; }
  bool is_primary() const { return PRIMARY_ROLE == value_; }
  bool is_standby() const { return STANDBY_ROLE == value_; }
  bool is_restore() const { return RESTORE_ROLE == value_; }

  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"server_role", to_str(), "value", ::oceanbase::common::check_char_array(value_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
  int to_yson(char *buf, const int64_t buf_len, int64_t &pos) const;
private:
  Role value_;
};




