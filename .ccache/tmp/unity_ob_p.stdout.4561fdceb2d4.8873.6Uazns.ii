template <typename T, typename = void>
struct has_to_string : std::false_type
{};
template <typename T>
struct has_to_string<T,
                     std::void_t<decltype(std::declval<const T &>().to_string(
                         std::declval<char *>(), std::declval<int64_t>()))>>
    : std::true_type
{};


template <typename T>
class ObIArray : public ObIArrayWrap<T>
{
public:
  using ObIArrayWrap<T>::at;
  using ObIArrayWrap<T>::count;
  ObIArray() : ObIArrayWrap<T>() {}
  ObIArray(T *data, const int64_t count) : ObIArrayWrap<T>(data, count) {}

  virtual ~ObIArray() {}
  virtual int push_back(const T &obj) = 0;
  virtual void pop_back() = 0;
  virtual int pop_back(T &obj) = 0;
  virtual int remove(int64_t idx) = 0;

  virtual int at(int64_t idx, T &obj) const = 0;


  virtual void reset() = 0;
  virtual void reuse() = 0;
  virtual void destroy() = 0;
  virtual int reserve(int64_t capacity) = 0;
  virtual int assign(const ObIArray &other) = 0;
  virtual int prepare_allocate(int64_t capacity) = 0;
  virtual T *alloc_place_holder()
  { { int __ret__ = OB_NOT_SUPPORTED; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::OB_PRINT("", 4, "src/oblib/lib/container/ob_iarray.h", 66, __FUNCTION__, ret, "Not supported", "placeholder" ); } } } while (false); }; return __null; }

  virtual int64_t to_string(char* buf, int64_t buf_len) const
  {
    int64_t pos = 0;
    ::oceanbase::common::databuff_printf(buf, buf_len, pos,"[");
    int64_t N = count();
    ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"cnt", N);
    if constexpr (has_to_string<T>::value) {
      for (int64_t index = 0; index < N - 1; ++index) {
        ::oceanbase::common::databuff_printf(buf, buf_len, pos,", ");
        (void)::oceanbase::common::databuff_print_obj(buf, buf_len, pos, at(index));
      }
      if (0 < N) {
        ::oceanbase::common::databuff_printf(buf, buf_len, pos,", ");
        (void)::oceanbase::common::databuff_print_obj(buf, buf_len, pos, at(N - 1));
      }
    }
    ::oceanbase::common::databuff_printf(buf, buf_len, pos,"]");
    return pos;
  }
protected:
  using ObIArrayWrap<T>::data_;
  using ObIArrayWrap<T>::count_;
  ObIArray(const ObIArray&); void operator=(const ObIArray&);
};

template<typename T>
bool is_contain(const ObIArray<T> &arr, const T &item)
{
  bool bret = false;
  for (int64_t i = 0; i < arr.count(); ++i) {
    bret = (arr.at(i) == item);
    if (bret) {
      break;
    }
  }
  return bret;
}

template<typename T>
int get_difference(const ObIArray<T> &a, const ObIArray<T> &b, ObIArray<T> &dest)
{
  int ret = OB_SUCCESS;
  dest.reset();
  for (int64_t i = 0; OB_SUCCESS == ret && i < a.count(); i++) {
    if (!is_contain(b, a.at(i))) {
      ret = dest.push_back(a.at(i));
    }
  }
  return ret;
}

template<typename DstArrayT, typename SrcArrayT>
int append(DstArrayT &dst, const SrcArrayT &src)
{
  int ret = OB_SUCCESS;
  int64_t N = src.count();
  for (int64_t i = 0; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && i < N; ++i) {
    ret = dst.push_back(src.at(i));
  }
  return ret;
}

template<typename DstArrayT, typename SrcArrayT>
bool is_array_equal(DstArrayT &left, const SrcArrayT &right)
{
  int bret = true;

  if (&left == &right) {

  } else if (left.count() != right.count()) {
    bret = false;
  } else {
    for (int64_t i = 0; bret && i < left.count(); ++i) {
      bret = left.at(i) == right.at(i);
    }
  }
  return bret;
}

}
}
