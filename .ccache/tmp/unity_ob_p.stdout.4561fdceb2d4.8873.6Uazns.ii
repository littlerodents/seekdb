struct ObCounterSlotPickerByCPUNonAtomic
{
  static inline int64_t get_my_id() { return ::oceanbase::common::icpu_id(); }
  static inline int64_t get_max_id() { return ::oceanbase::common::get_max_icpu_id(); }
