  }
  virtual ~ObReserveArenaAllocator()
  {
    reset();
  }
  virtual void *alloc(const int64_t size, const ObMemAttr &attr) override
  {
    ((void)(attr));
    return alloc(size);
  }
  virtual void* alloc(const int64_t size) override
  {
