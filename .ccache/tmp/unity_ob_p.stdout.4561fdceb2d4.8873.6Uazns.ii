template <typename PARTITION>
int ObDDLResolver::create_name_for_empty_partition(ObIArray<PARTITION> &partitions)
{
  int ret = OB_SUCCESS;
  int64_t max_part_id = OB_MAX_PARTITION_NUM_MYSQL;
  common::ObString part_name_str;
  for (int64_t i = 0; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && i < partitions.count(); ++i) {
    PARTITION &part = partitions.at(i);
    bool is_valid = !part.is_empty_partition_name();
    while (!is_valid) {
      char part_name[OB_MAX_PARTITION_NAME_LENGTH];
      int64_t pos = 0;
      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (databuff_printf(part_name, OB_MAX_PARTITION_NAME_LENGTH, pos, "P%ld", max_part_id)))),!!0))) {

      } else if (({ (part_name_str.assign(part_name, static_cast<int32_t>(pos))); false; })) {

