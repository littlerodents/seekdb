struct StmtStat
{
  int64_t memory_used_;
  int64_t last_active_timestamp_;
  int64_t execute_average_time_;
  int64_t execute_slowest_time_;
  int64_t execute_slowest_timestamp_;
  int64_t execute_count_;
  int64_t execute_slow_count_;
  int64_t ps_count_;
  bool to_delete_;
  StmtStat()
      : memory_used_(0),
        last_active_timestamp_(0),
        execute_average_time_(0),
        execute_slowest_time_(0),
        execute_slowest_timestamp_(0),
        execute_count_(0),
        execute_slow_count_(0),
        ps_count_(0),
        to_delete_(false)
  {
  }

  void reset()
  {
    memory_used_ = 0;
    last_active_timestamp_ = 0;
    execute_average_time_ = 0;
    execute_slowest_time_ = 0;
    execute_slowest_timestamp_ = 0;
    execute_count_ = 0;
    execute_slow_count_ = 0;
    ps_count_ = 0;
    to_delete_ = false;
  }

  double weight()
  {
    int64_t time_interval = common::ObTimeUtility::current_time() - last_active_timestamp_;
    double weight = common::OB_PC_WEIGHT_NUMERATOR / static_cast<double>(time_interval);
    return weight;
  }

  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"memory_used", ::oceanbase::common::check_char_array(memory_used_), "last_active_timestamp", ::oceanbase::common::check_char_array(last_active_timestamp_), "execute_average_time", ::oceanbase::common::check_char_array(execute_average_time_), "execute_slowest_time", ::oceanbase::common::check_char_array(execute_slowest_time_), "execute_slowest_timestamp", ::oceanbase::common::check_char_array(execute_slowest_timestamp_), "execute_count", ::oceanbase::common::check_char_array(execute_count_), "execute_slow_count", ::oceanbase::common::check_char_array(execute_slow_count_), "ps_count", ::oceanbase::common::check_char_array(ps_count_), "to_delete", ::oceanbase::common::check_char_array(to_delete_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
