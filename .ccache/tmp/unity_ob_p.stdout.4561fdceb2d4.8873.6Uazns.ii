int ObPLPackageState::check_version(const ObPackageStateVersion &state_version,
                                    const ObPackageStateVersion &cur_state_version,
                                    ObSchemaGetterGuard &schema_guard,
                                    const ObPLPackage &spec,
                                    const ObPLPackage *body,
                                    bool &match)
{
