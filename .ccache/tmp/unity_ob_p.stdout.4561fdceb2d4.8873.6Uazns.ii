ObPLExecutableUnit::ObPLExecutableUnit(sql::ObLibCacheNameSpace ns,
                                 lib::MemoryContext &mem_context)
    : ObPLCacheObject(ns, mem_context), routine_table_(allocator_),
      type_table_(), enum_set_ctx_(allocator_),
      can_cached_(true),
      has_incomplete_rt_dep_error_(false),
      exec_env_()
{
}


int ObPLFunction::set_variables(const ObPLSymbolTable &symbol_table)
{
  int ret = OB_SUCCESS;
  variables_.set_capacity(static_cast<uint32_t>(symbol_table.get_count()));
  default_idxs_.set_capacity(static_cast<uint32_t>(symbol_table.get_count()));
  for (int64_t i = 0; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && i < symbol_table.get_count(); ++i) {
    ObPLDataType type;
    if ((__builtin_expect(!!(__null == (symbol_table.get_symbol(i))),!!0))) {
      ret = OB_ERR_UNEXPECTED;
    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (type.deep_copy(enum_set_ctx_, symbol_table.get_symbol(i)->get_type())))),!!0))) {
    } else {
      if (type.get_meta_type() != __null && type.get_meta_type()->is_lob_storage()) {
        type.get_data_type()->meta_.set_has_lob_header();
      }
      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (variables_.push_back(type)))),!!0))) {
      } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (default_idxs_.push_back(symbol_table.get_symbol(i)->get_default())))),!!0))) {
      }
    }
  }
  return ret;
}



int ObPLFunction::set_types(const ObPLUserTypeTable &type_table)
{
  int ret = OB_SUCCESS;
  ret = ObPLBuilder::compile_type_table(type_table, *this);
  return ret;
}

int ObPLFunction::get_subprogram(const ObIArray<int64_t> &path, ObPLFunction *&routine) const
{
  int ret = OB_SUCCESS;
  routine = __null;
  ObPLFunction *parent = const_cast<ObPLFunction*>(this);
  for (int64_t i = 0; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && i < path.count(); ++i) {
    if ((__builtin_expect(!!(__null == (parent)),!!0))) {
      ret = OB_ERR_UNEXPECTED;
    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (parent->get_routine(path.at(i), parent)))),!!0))) {
    } else { }
  }
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
    routine = parent;
  }
  return ret;
}

