inline S1ChordAngle::S1ChordAngle(const S2Point& x, const S2Point& y) {
  while (false && (S2::IsUnitLength(x))) S2NullStream();
  while (false && (S2::IsUnitLength(y))) S2NullStream();


  length2_ = std::min(4.0, (x - y).Norm2());
  while (false && (is_valid())) S2NullStream();
}

