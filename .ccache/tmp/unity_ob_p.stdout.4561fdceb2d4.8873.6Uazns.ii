class ObSzString
{
public:
  explicit ObSzString(const char *s) : str_(s)
  {}
  ~ObSzString()
  {}

  int64_t to_string(char *buf, const int64_t len) const
  {
    int64_t pos = 0;
    if ((__builtin_expect(!!(__null == (str_)),!!0))) {
      (void)logdata_printf(buf, len, pos, "NULL");
    } else {
      (void)logdata_printf(buf, len, pos, "%s", str_);
    }
    return pos;
  }
private:
  const char *str_;
};

