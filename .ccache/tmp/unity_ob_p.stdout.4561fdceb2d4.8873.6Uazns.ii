  inline __attribute__((always_inline)) void set_deterministic() { flag_ |= SP_FLAG_DETERMINISTIC; }
  inline __attribute__((always_inline)) void set_invoker_right() { flag_ |= SP_FLAG_INVOKER_RIGHT; }
  inline __attribute__((always_inline)) void clear_invoker_right() { flag_ &= (~((uint64_t)SP_FLAG_INVOKER_RIGHT)); }
  inline __attribute__((always_inline)) void set_accessible_by_clause() { flag_ |= SP_FLAG_ACCESSIBLE_BY; }
  inline __attribute__((always_inline)) void set_is_aggregate() { flag_ |= SP_FLAG_AGGREGATE; }
