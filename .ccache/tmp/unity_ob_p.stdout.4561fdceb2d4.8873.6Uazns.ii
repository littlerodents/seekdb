template <bool RANGE_CHECK, bool SUPPORT_MB4>
static __attribute__((always_inline)) inline int ob_mb_wc_utf8_prototype(ulong *pwc, const unsigned char *s,
                                                 const unsigned char *e) {
  if (RANGE_CHECK && s >= e) return -101;

  unsigned char c = s[0];
  if (c < 0x80) {
    *pwc = c;
    return 1;
  }

  if (c < 0xe0) {
    if (c < 0xc2)
      return 0;

    if (RANGE_CHECK && s + 2 > e) return -102;

    if ((s[1] & 0xc0) != 0x80)
      return 0;

    *pwc = ((ulong)(c & 0x1f) << 6) + (ulong)(s[1] & 0x3f);
    return 2;
  }

  if (c < 0xf0) {
    if (RANGE_CHECK && s + 3 > e) return -103;


    uint16 two_bytes;
    memcpy(&two_bytes, s + 1, sizeof(two_bytes));
    if ((two_bytes & 0xc0c0) != 0x8080)
      return 0;

    *pwc = ((ulong)(c & 0x0f) << 12) + ((ulong)(s[1] & 0x3f) << 6) +
           (ulong)(s[2] & 0x3f);
    if (*pwc < 0x800) return 0;





    if (*pwc >= 0xd800 && *pwc <= 0xdfff) return 0;
    return 3;
  }

  if (SUPPORT_MB4) {
    if (RANGE_CHECK && s + 4 > e)
      return -104;





    uint32 four_bytes;
    memcpy(&four_bytes, s, sizeof(four_bytes));



    if ((four_bytes & 0xc0c0c0f8) != 0x808080f0)

      return 0;

    *pwc = ((ulong)(c & 0x07) << 18) + ((ulong)(s[1] & 0x3f) << 12) +
           ((ulong)(s[2] & 0x3f) << 6) + (ulong)(s[3] & 0x3f);
    if (*pwc < 0x10000 || *pwc > 0x10ffff) return 0;
    return 4;
  }

  return 0;
}

