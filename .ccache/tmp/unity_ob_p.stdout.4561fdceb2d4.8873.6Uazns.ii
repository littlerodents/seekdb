template<ObCharsetType cs_type>
inline int ob_charset_char_len(const unsigned char *s, const unsigned char *e)
{
  return __builtin_expect(!!(s < e),!!1) ? 1 : -101;
}

template<>
inline int ob_charset_char_len<CHARSET_UTF8MB4>(const unsigned char *s, const unsigned char *e)
{
  int mb_len = -101;
  if (__builtin_expect(!!(s < e),!!1)) {
    unsigned char c = *s;
    if (c < 0x80) {
      mb_len = 1;
    } else if (c < 0xc2) {
      mb_len = 1;
    } else if (c < 0xe0) {
      mb_len = 2;
    } else if (c < 0xf0) {
      mb_len = 3;
    } else if (c < 0xf8) {
      mb_len = 4;
    } else {
      mb_len = 1;
    }
    if (s + mb_len > e) {
      mb_len = -101;
    }
  }
  return mb_len;
}

template<ObCharsetType cs_type>
inline int ob_charset_decode_unicode(const unsigned char *s, const unsigned char *e, ulong &unicode_value)
{
  unicode_value = 0;
  return ob_charset_char_len<CHARSET_BINARY>(s, e);
}

template<ObCharsetType cs_type>
inline int ob_charset_encode_unicode(ulong unicode_value, unsigned char *buf, unsigned char *buf_end)
{
