inline S1Interval::S1Interval(double lo, double hi) : bounds_(lo, hi) {
  if (lo == -3.14159265358979323846 && hi != 3.14159265358979323846) set_lo(3.14159265358979323846);
  if (hi == -3.14159265358979323846 && lo != 3.14159265358979323846) set_hi(3.14159265358979323846);
  while (false && (is_valid())) S2NullStream();
}

inline S1Interval::S1Interval(double lo, double hi, ArgsChecked dummy)
  : bounds_(lo, hi) {
  while (false && (is_valid())) S2NullStream();
}

inline S1Interval::S1Interval() : bounds_(3.14159265358979323846, -3.14159265358979323846) {
}

inline S1Interval S1Interval::Empty() {
  return S1Interval();
}

inline S1Interval S1Interval::Full() {
  return S1Interval(-3.14159265358979323846, 3.14159265358979323846, ARGS_CHECKED);
}

inline bool S1Interval::is_valid() const {
  return (std::fabs(lo()) <= 3.14159265358979323846 && std::fabs(hi()) <= 3.14159265358979323846 &&
          !(lo() == -3.14159265358979323846 && hi() != 3.14159265358979323846) &&
          !(hi() == -3.14159265358979323846 && lo() != 3.14159265358979323846));
}

inline bool S1Interval::operator==(const S1Interval& y) const {
  return lo() == y.lo() && hi() == y.hi();
}

inline bool S1Interval::operator!=(const S1Interval& y) const {
  return !operator==(y);
}

inline void S1Interval::set_lo(double p) {
  bounds_[0] = p;
  while (false && (is_valid())) S2NullStream();
}

inline void S1Interval::set_hi(double p) {
  bounds_[1] = p;
  while (false && (is_valid())) S2NullStream();
}

inline std::ostream& operator<<(std::ostream& os, const S1Interval& x) {
  return os << "[" << x.lo() << ", " << x.hi() << "]";
}
