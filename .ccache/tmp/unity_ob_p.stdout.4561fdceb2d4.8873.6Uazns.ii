    }
    void set_offset_min(const int32_t value)
    {
      int32_t tmp_value = value;
      if (value < 0) {
        tmp_value = 0 - value;
        is_neg_offset_ = 1;
      } else {
        is_neg_offset_ = 0;
      }
      offset_min_ = static_cast<int16_t>(tmp_value & MAX_BIT_OF_OFFSET_MIN);
    }


    union {
      uint32_t desc_;
      struct {
        union {
          uint16_t time_desc_;
          struct {
            uint16_t tail_nsec_ : 10;
            uint16_t version_ : 2;
            uint16_t store_tz_id_ : 1;
            uint16_t is_null_ : 1;
            uint16_t time_reserved_ : 2;
          };
        };
        union {
          uint16_t tz_desc_;
