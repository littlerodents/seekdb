private:
  static const uint64_t LATCH_MAP_BUCKET_CNT = 3079;
  ObLatchBucket wait_map_[LATCH_MAP_BUCKET_CNT];

private:
  ObLatchWaitQueue(const ObLatchWaitQueue&); void operator=(const ObLatchWaitQueue&);
};

