int ObPLInto::set_into(const common::ObIArray<int64_t> &idxs, ObPLBlockNS &ns, const common::ObIArray<ObRawExpr*> &exprs)
{
  int ret = OB_SUCCESS;
  if (idxs.count() != exprs.count()) {
    ret = OB_ERR_UNEXPECTED;
  } else {
    for (int64_t i = 0; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && i < idxs.count(); ++i) {
      if ((__builtin_expect(!!(__null == (exprs.at(i))),!!0))) {
        ret = OB_ERR_UNEXPECTED;
      } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (add_into(idxs.at(i), ns, *exprs.at(i))))),!!0))) {
      } else { }
    }
  }
  return ret;
}

int ObPLDeclareHandlerStmt::DeclareHandler::compare_condition(ObPLConditionType type1, int64_t level1, ObPLConditionType type2, int64_t level2)
{
  int ret = 0;
  if (level1 > level2) {
    ret = 1;
  } else if (level1 < level2) {
    ret = -1;
  } else {
    if (type1 > type2) {
      ret = -1;
    } else if (type1 < type2) {
      ret = 1;
    } else {
      ret = 0;
    }
  }
  return ret;
}

