class ObGlobalReqTimeService
{
public:
  ObGlobalReqTimeService()
    : lock_(common::ObLatchIds::OB_REQ_TIMEINFO_LIST_LOCK),
      time_info_list_() {}

  static ObGlobalReqTimeService &get_instance()
