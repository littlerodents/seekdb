class ObStmt
{
public:

public:
  ObStmt()
      : stmt_type_(stmt::T_NONE),
        query_ctx_(__null),
        stmt_id_(OB_INVALID_STMT_ID)
  {
  }
  explicit ObStmt(const stmt::StmtType stmt_type)
      : stmt_type_(stmt_type),
        query_ctx_(__null),
