template <class T>
int ObRawExprResolverImpl::process_node_with_children(const ParseNode *node,
                                                      int64_t children_num,
                                                      T *&raw_expr,
                                                      bool is_root_expr)
{
  int ret = common::OB_SUCCESS;
  if ((__builtin_expect(!!(__null == (node)),!!0)) || (__builtin_expect(!!(__null == (node->children_)),!!0))
      || children_num <= 0) {
    ret = common::OB_INVALID_ARGUMENT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SQL, ::oceanbase::common::OB_LOG_SQL::M_RESV, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SQL"".""RESV""] ", 4, "src/sql/resolver/expr/ob_raw_expr_resolver_impl.h", 225, __FUNCTION__, ret, "invalid argument", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(node)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(node)))&&>::value>("node", ::oceanbase::common::check_char_array(node)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(children_num)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(children_num)))&&>::value>("children_num", ::oceanbase::common::check_char_array(children_num))); } } } while (false);
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ctx_.expr_factory_.create_raw_expr(node->type_, raw_expr)))),!!0))) {
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (raw_expr->init_param_exprs(children_num)))),!!0))) {
  } else {
    for (int64_t i = 0; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && i < children_num; i++) {
      ObRawExpr *sub_expr = __null;
