  template <class Unit2>
  constexpr PhysicalUnit(PhysicalUnit<Float, Base, Unit2> other)
      : value_(UnitConverter<Unit2, Unit, Float>::Convert(other.value())) {}


  template <class Unit2>
  Type& operator=(PhysicalUnit<Float, Base, Unit2> other) {
    value_ = UnitConverter<Unit2, Unit, Float>::Convert(other.value());
    return *this;
  }
