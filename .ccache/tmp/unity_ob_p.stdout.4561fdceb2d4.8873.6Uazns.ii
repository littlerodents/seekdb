  common::ObDatum *datum = nullptr;
  size = DATUM_SIZE * exprs.count();
  for (int64_t i = 0; i < exprs.count() && (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)); ++i) {
