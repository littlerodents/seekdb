  iter.owner_->get_sub_addr(iter.diff_info_.last_addr_,
                            iter.diff_info_.last_idx_,
                            iter.idx_, iter.offsets_ptr_, data);

  iter.diff_info_.last_addr_ = data;
  iter.diff_info_.last_idx_ = iter.idx_;
}




