template <typename AllocatorT>
int ob_write_string(AllocatorT &allocator, const ObString &src, ObString &dst, bool c_style = false)
{
  int ret = OB_SUCCESS;
  const ObString::obstr_size_t src_len = src.length();
  char *ptr = __null;
  if ((__builtin_expect(!!(__null == (src.ptr())),!!0)) || __builtin_expect(!!(0 >= src_len),!!0)) {
    dst.assign(__null, 0);
  } else if (__null == (ptr = static_cast<char *>(allocator.alloc(src_len + (c_style ? 1 : 0))))) {
