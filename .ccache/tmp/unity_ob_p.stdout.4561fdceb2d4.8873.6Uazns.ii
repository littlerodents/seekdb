    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 4, "src/share/schema/ob_table_schema.h", 2064, __FUNCTION__, ret, "buf is not large enough", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(buf_size)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(buf_size)))&&>::value>("buf_size", ::oceanbase::common::check_char_array(buf_size)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(data_table_id)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(data_table_id)))&&>::value>("data_table_id", ::oceanbase::common::check_char_array(data_table_id)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
  } else {
    common::ObString table_id_str = common::ObString::make_string(buf);
    int32_t src_len = table_id_str.length() + index_name.length()
        + static_cast<int32_t>(strlen(common::OB_INDEX_PREFIX)) + 1;
    char *ptr = __null;

    if (__builtin_expect(!!(0 >= src_len),!!0)) {
      index_table_name.assign(__null, 0);
    } else if (__null == (ptr = static_cast<char *>(allocator.alloc(src_len)))) {
      ret = common::OB_ALLOCATE_MEMORY_FAILED;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 4, "src/share/schema/ob_table_schema.h", 2075, __FUNCTION__, ret, "alloc memory failed", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(src_len), std::is_rvalue_reference<decltype((src_len))&&>::value>("size", src_len)); } } } while (false);
    } else {
      int64_t pos = 0;
      memcpy(ptr + pos, common::OB_INDEX_PREFIX, strlen(common::OB_INDEX_PREFIX));
      pos += strlen(common::OB_INDEX_PREFIX);
      memcpy(ptr + pos, table_id_str.ptr(), table_id_str.length());
      pos += table_id_str.length();
      memcpy(ptr + pos, "_", 1);
      pos += 1;
      memcpy(ptr + pos, index_name.ptr(), index_name.length());
      pos += index_name.length();
