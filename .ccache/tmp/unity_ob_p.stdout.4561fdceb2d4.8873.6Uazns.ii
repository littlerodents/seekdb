    } else {
      memset(label_, '\0', AOBJECT_LABEL_SIZE + 1);
    }
  }


  union {
    const uint16_t MAGIC_CODE_;
    struct {
      uint16_t in_use_ : 1;
      uint16_t is_large_ : 1;
    };
