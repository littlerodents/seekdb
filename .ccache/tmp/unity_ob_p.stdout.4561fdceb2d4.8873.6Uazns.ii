  ObExplainDisplayOpt display_opt_;
  ObDMLStmt *explain_query_stmt_;
  common::ObString into_table_;
  common::ObString statement_id_;
  ObExplainStmt(const ObExplainStmt&); void operator=(const ObExplainStmt&);
};

