  {
    if (__builtin_expect(!!(with_lock_),!!0)) {
      while (({ ((void)(0)); ; __atomic_exchange_n((&lock_), (1), 5); })) {
        ({; asm("yield\n");});
      }
    }
    abort_unless(node.parent_ == this);
    node.parent_ = nullptr;
    TreeNode *prev = node.prev_;
    TreeNode *next = node.next_;
    if (prev != nullptr) {
      prev->next_ = next;
    }
    if (next != nullptr) {
      next->prev_ = prev;
    }
    node.prev_ = node.next_ = nullptr;
    if (this->child_ == &node) {
      abort_unless(prev == nullptr);
      this->child_ = next;
    }
    if (__builtin_expect(!!(with_lock_),!!0)) {
      ({ __atomic_store_n((&lock_), (0), 5);});
    }
