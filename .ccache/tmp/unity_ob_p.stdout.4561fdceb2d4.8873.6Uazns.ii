private:
  T* instance_;
};

template <class T, size_t tag>
const char* ObDITls<T, tag>::get_label() {
  const char* cxxname = typeid(T).name();
  const char* ret = "DITls";
  static char buf[MAX_TNAME_LENGTH];
  if (nullptr == cxxname || strlen(cxxname) > MAX_TNAME_LENGTH - 5) {

