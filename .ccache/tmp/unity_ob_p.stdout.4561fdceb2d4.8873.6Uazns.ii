inline void ObExprOperator::reset()
{
  common::ObDLinkBase<ObExprOperator>::reset();
  row_dimension_ = NOT_ROW_DIMENSION;
  result_type_.set_type(common::ObMaxType);
  result_type_.reset();
  input_types_.reset();
  is_called_in_sql_ = true;
}


inline bool ObExprOperator::is_type_valid(const common::ObObjType &type)
{
  common::ObObjTypeClass type_class = ob_obj_type_class(type);
  return (common::ob_is_castable_type_class(type_class) || common::ObUnknownTC == type_class);
}

inline bool ObExprOperator::is_type_valid_regexp(const common::ObObjType &type)
{
  return is_type_valid(type);
}

inline void ObExprOperator::calc_result_flag1(ObExprResType &type,
                                              const ObExprResType &type1)
{
  if (type1.has_result_flag(1)) {
    type.set_result_flag(1);
  }
}

inline void ObExprOperator::calc_result_flag2(ObExprResType &type,
                                              const ObExprResType &type1,
                                              const ObExprResType &type2)
{
  if (type1.has_result_flag(1) && type2.has_result_flag(1)) {
    type.set_result_flag(1);
  }
}

inline void ObExprOperator::calc_result_flag3(ObExprResType &type,
                                              const ObExprResType &type1,
                                              const ObExprResType &type2,
                                              const ObExprResType &type3)
{
  if (type1.has_result_flag(1) &&
      type2.has_result_flag(1) &&
      type3.has_result_flag(1)) {
    type.set_result_flag(1);
  }
}

inline void ObExprOperator::calc_result_flagN(ObExprResType &type,
                                              const ObExprResType *types,
                                              int64_t param_num)
{

  bool not_null = true;
  if ((__builtin_expect(!!(__null == (types)),!!0)) || __builtin_expect(!!(param_num < 0),!!0)) {
    { int __ret__ = common::OB_INVALID_ARGUMENT; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SQL, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""SQL""] ", 3, "src/query/api/query/engine/expr/ob_expr_operator.h", 1048, __FUNCTION__, ret, "null types or the wrong param_num", "placeholder" ); } } } while (false); };
  } else {
    for (int64_t i = 0; i < param_num; ++i) {
      if (!types[i].has_result_flag(1)) {
        not_null = false;
        break;
      }
    }
    if (not_null) {
      type.set_result_flag(1);
    }
  }
}


