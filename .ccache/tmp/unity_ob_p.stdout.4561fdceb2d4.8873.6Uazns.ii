class ObEndTransCbPacketParam
{
public:
  ObEndTransCbPacketParam() :
      affected_rows_(0),
      last_insert_id_to_client_(0),
      trace_id_(),
      is_valid_(false)
  {
    message_[0] = '\0';
  }
  virtual ~ObEndTransCbPacketParam() {}

  ObEndTransCbPacketParam &operator=(const ObEndTransCbPacketParam& other);

  void reset()
  {
    message_[0] = '\0';
    affected_rows_ = 0;
    last_insert_id_to_client_ = 0;
    trace_id_.reset();
    is_valid_ = false;
  }

  const ObEndTransCbPacketParam &fill(ObResultSet &rs,
                                      ObSQLSessionInfo &session,
                                      const common::ObCurTraceId::TraceId &trace_id);

  const ObEndTransCbPacketParam &fill(const char *message,
                                      int64_t affected_rows,
                                      uint64_t last_insert_id_to_client,
                                      const ObCurTraceId::TraceId &trace_id);



  bool is_valid() const { return is_valid_; }

  const char *get_message() const { return message_; }
  int64_t get_affected_rows() const { return affected_rows_; }
  uint64_t get_last_insert_id_to_client() const { return last_insert_id_to_client_; }
  const common::ObCurTraceId::TraceId &get_trace_id() const { return trace_id_; }

  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"message", ::oceanbase::common::check_char_array(message_), "affected_rows", ::oceanbase::common::check_char_array(affected_rows_), "last_insert_id_to_client", ::oceanbase::common::check_char_array(last_insert_id_to_client_), "trace_id", ::oceanbase::common::check_char_array(trace_id_), "is_valid", ::oceanbase::common::check_char_array(is_valid_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };





private:

  char message_[common::MSG_SIZE];
  int64_t affected_rows_;
  uint64_t last_insert_id_to_client_;
  common::ObCurTraceId::TraceId trace_id_;
  bool is_valid_;
};
}
