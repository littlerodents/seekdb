      ObGetOutlineKeyV3, 128> OutlineNameMap;
  typedef common::hash::ObPointerHashMap<ObOutlineSignatureHashWrapper, ObSimpleOutlineSchema *,
      ObGetOutlineKeyV3, 128> SignatureMap;
