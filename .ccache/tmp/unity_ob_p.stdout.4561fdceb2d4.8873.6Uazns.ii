    } else {
      *(reinterpret_cast<int32_t *>(decint)) = 0;
      int_bytes = sizeof(int32_t);
    }
  } else {
    if (res <= wide::Limits<int32_t>::max() && res >= wide::Limits<int32_t>::min()) {
      int_bytes = sizeof(int32_t);
    } else if (res <= wide::Limits<int64_t>::max() && res >= wide::Limits<int64_t>::min()) {
      int_bytes = sizeof(int64_t);
    } else if (res <= wide::Limits<int128_t>::max() && res >= wide::Limits<int128_t>::min()) {
      int_bytes = sizeof(int128_t);
    } else if (res <= wide::Limits<int256_t>::max() && res >= wide::Limits<int256_t>::min()) {
      int_bytes = sizeof(int256_t);
    } else {
      int_bytes = sizeof(int512_t);
    }
    if ((__builtin_expect(!!(__null == (cp_data = allocator.alloc(int_bytes))),!!0))) {
      ret = OB_ALLOCATE_MEMORY_FAILED;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 4, "src/oblib/common/wide_integer/ob_wide_integer_impl.h", 1117, __FUNCTION__, ret, "allocate memory failed", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
    } else {
      memcpy(cp_data, res.items_, int_bytes);
      decint = reinterpret_cast<ObDecimalInt *>(cp_data);
    }
  }
  return ret;
}

