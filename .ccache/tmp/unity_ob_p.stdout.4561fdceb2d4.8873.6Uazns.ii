enum class Ctrl { NORMAL, RETURNING, LEAVING, ITERATING, EXITING };

struct CtrlState
{
  CtrlState() : flow(Ctrl::NORMAL), label(), exit_handler(__null) {}
  Ctrl flow;
  ObString label;


