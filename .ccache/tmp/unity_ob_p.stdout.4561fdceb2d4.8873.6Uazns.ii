    ret = OB_INVALID_ARGUMENT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 4, "src/share/cache/ob_kv_storecache.h", 382, __FUNCTION__, ret, "Invalid argument, ", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(reinterpret_cast<const void*>(cache_name)), std::is_rvalue_reference<decltype((reinterpret_cast<const void*>(cache_name)))&&>::value>("cache_name", reinterpret_cast<const void*>(cache_name)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ObKVGlobalCache::get_instance().register_cache(cache_name, mem_limit_pct, cache_id_)))),!!0))) {
  } else {
