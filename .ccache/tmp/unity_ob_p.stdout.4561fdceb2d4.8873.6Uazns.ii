      uint64_t routine_count = routine_table->get_count();
      ObProcType search_routine_type = BLOCK_ROUTINE != get_block_type() ?
          (ROUTINE_PROCEDURE_TYPE == routine_type ? PACKAGE_PROCEDURE : PACKAGE_FUNCTION) :
          (ROUTINE_PROCEDURE_TYPE == routine_type ? NESTED_PROCEDURE : NESTED_FUNCTION);
      int64_t routine_idx = BLOCK_ROUTINE != get_block_type() ?
                            ObPLRoutineTable::NORMAL_ROUTINE_START_IDX : 0;
      for (; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && !exists && routine_idx < routine_count; ++routine_idx) {
        const ObPLRoutineInfo *pl_routine_info = __null;
        if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (routine_table->get_routine_info(routine_idx, pl_routine_info)))),!!0))) {
        } else if ((__builtin_expect(!!(__null != (pl_routine_info)),!!1))) {
          if (ObCharset::case_insensitive_equal(routine_name, pl_routine_info->get_name())
              && search_routine_type == pl_routine_info->get_type()) {
            exists = true;
            proc_type = search_routine_type;
          }
        } else { }
      }
    }
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && !exists) {
      if ((__builtin_expect(!!(__null != (pre_ns_)),!!1))) {
        if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (pre_ns_->check_routine_exists(db_name, package_name, routine_name, routine_type, exists, proc_type)))),!!0))) {

        }
      }
    }
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && !exists) {
      if ((__builtin_expect(!!(__null != (external_ns_)),!!1))) {
        if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (external_ns_->check_routine_exists(db_name, package_name, routine_name, routine_type, exists, proc_type)))),!!0))) {

        }
      }
    }
  }
  return ret;
}


