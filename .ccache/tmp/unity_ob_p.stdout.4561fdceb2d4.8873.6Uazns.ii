struct ObOptOSGSampleHelper
{
  public: int serialize(char *buf, const int64_t buf_len, int64_t &pos) const ; int serialize_(char *buf, const int64_t buf_len, int64_t &pos) const; int deserialize(const char *buf, const int64_t data_len, int64_t &pos) ; int deserialize_(const char *buf, const int64_t data_len, int64_t &pos); int64_t get_serialize_size() const ; int64_t get_serialize_size_() const;; private: const static int64_t UNIS_VERSION = 1;
public:
  ObOptOSGSampleHelper() :
    sample_value_(0),
    k_(0),
    sample_rate_(1),
    sample_step_(100) {}

  ~ObOptOSGSampleHelper() {}

  inline __attribute__((always_inline)) uint64_t gcd(uint64_t a, uint64_t b)
  {
    uint64_t c = 0;
    while (b != 0) {
      c = a % b;
      a = b;
      b = c;
    }
    return a;
 }

  inline __attribute__((always_inline)) void init(double sample_rate)
  {
    const static uint64_t RATE_BASE = 100000;
    const static uint64_t RATE_BASE100 = 10000000;
    k_ = 0;
    uint64_t rate = static_cast<uint64_t>(floor(sample_rate * RATE_BASE));
    uint64_t divisor = gcd(rate, RATE_BASE100);
    sample_rate_ = rate / divisor;
    sample_step_ = RATE_BASE100 / divisor;
  }

  inline __attribute__((always_inline)) int sample_row(bool &ignore)
  {
    int ret = OB_SUCCESS;
    ignore = false;
    if (sample_value_ < SAMPLING_BOUNDARY) {
      ignore = false;
    } else if (k_ <= sample_rate_) {
      ignore = false;
    } else {
      ignore = true;
    }
    if (!ignore) {
      ++sample_value_;
    }
    if (++k_ > sample_step_) {
      k_ = 1;
    }

    return ret;
  }

  inline __attribute__((always_inline)) void reset()
  {
    sample_value_ = 0;
    k_ = 0;
  }

  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"sample_value", ::oceanbase::common::check_char_array(sample_value_), "sample_rate", ::oceanbase::common::check_char_array(sample_rate_), "sample_step", ::oceanbase::common::check_char_array(sample_step_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };



  uint64_t sample_value_;
  uint64_t k_;
  uint64_t sample_rate_;
  uint64_t sample_step_;
  const static int SAMPLING_BOUNDARY = 10000;
  ObOptOSGSampleHelper(const ObOptOSGSampleHelper&); void operator=(const ObOptOSGSampleHelper&);
};

}
