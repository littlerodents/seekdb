class ObIWaiter
{
public:
  virtual ~ObIWaiter() {};
  virtual void wait() = 0;
};

template <class T,
          int64_t SIZE>
class ObWaitablePool
{
  struct Node
  {
    T data;
    Node *next;
  };
public:
  ObWaitablePool();
  ~ObWaitablePool();
public:
  int alloc_obj(T *&obj, ObIWaiter &waiter);
  void free_obj(T *obj);
  int64_t used() const {return used_;};
private:
  Node *objs_;
  Node *list_;
  int64_t used_;
};

template <class T, int64_t SIZE>
ObWaitablePool<T, SIZE>::ObWaitablePool() : list_(__null),
                                            used_(0)
{
  ObMemAttr memattr;
  memattr.label_ = ObModIds::OB_WAITABLE_POOL;
  if (__null == (objs_ = (Node *)ob_malloc(sizeof(Node) * SIZE, memattr))) {
    { int __ret__ = common::OB_ALLOCATE_MEMORY_FAILED; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/oblib/lib/file/ob_file.h", 459, __FUNCTION__, ret, "alloc obj array fail"); } } } while (false); };
  } else {
    for (int64_t i = 0; i < SIZE; i++) {
      new(&objs_[i].data) T();
      objs_[i].next = list_;
      list_ = &objs_[i];
    }
  }
}

template <class T, int64_t SIZE>
ObWaitablePool<T, SIZE>::~ObWaitablePool()
{
  Node *iter = list_;
  int64_t counter = 0;
  while (__null != iter) {
    Node *next = iter->next;
    iter->data.~T();
    iter = next;
    counter++;
  }
  if (__null != objs_) {
    if (SIZE != counter) {
      { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/oblib/lib/file/ob_file.h", 482, __FUNCTION__, ret, "still have %ld node not been free, memory=%p will leek", SIZE - counter, objs_); } } } while (false); };
    } else {
      ob_free(objs_);
    }
  }
}

template <class T, int64_t SIZE>
int ObWaitablePool<T, SIZE>::alloc_obj(T *&obj, ObIWaiter &waiter)
{
  int ret = OB_SUCCESS;
  if (__null == objs_) {
    ret = OB_NOT_INIT;
  } else {
    if (__null == list_) {
      waiter.wait();
    }
    if (__null == list_) {
      ret = OB_TIMEOUT;
    } else {
      obj = &list_->data;
      list_ = list_->next;
      used_ += 1;
    }
  }
  return ret;
}

template <class T, int64_t SIZE>
void ObWaitablePool<T, SIZE>::free_obj(T *obj)
{
  if (__null != objs_
      && __null != obj) {
    Node *node = (Node *)(obj);
    node->next = list_;
    list_ = node;
    used_ -= 1;
  }
}

class ObFileAsyncAppender : public ObIFileAppender, ObIWaiter
{
  struct AIOCB
  {
    AIOCB() : buffer_pos(0),
          buffer(__null)
    {
      memset(&cb, 0, sizeof(cb));
    };
    ~AIOCB()
    {
      if (__null != buffer) {
        free(buffer);
        buffer = __null;
      }
    };
    struct iocb cb;
    int64_t buffer_pos;
    char *buffer;
  };
  struct OpenParam
  {
    OpenParam(const bool dio,
              const bool is_create,
              const bool is_trunc,
              const bool is_excl) : flag(02),
                    mode(0400 | 0200 | (0400 >> 3) | ((0400 >> 3) >> 3))
    {
      flag |= dio ? 0200000 : 0;
      flag |= is_create ? 0100 : 0;
      flag |= is_trunc ? 01000 : 0;
      flag |= is_excl ? 0200 : 0;
    };
    int get_open_flags() const
    {
      return flag;
    };
    int get_open_mode() const
    {
      return mode;
    };
    int flag;
    int mode;
  };
  static const int64_t AIO_BUFFER_SIZE = 16L << 20;
  static const int AIO_MAXEVENTS = 8;
  static const int64_t AIO_WAIT_TIME_US = 1000000;
  typedef ObWaitablePool<AIOCB, AIO_MAXEVENTS> Pool;
public:
  ObFileAsyncAppender();
  ~ObFileAsyncAppender();
public:
  int open(const ObString &fname,
           const bool dio,
           const bool is_create,
           const bool is_trunc = false,
           const int64_t align_size = FileComponent::DirectFileAppender::DEFAULT_ALIGN_SIZE);
  int create(const ObString &fname,
             const bool dio,
             const int64_t align_size = FileComponent::DirectFileAppender::DEFAULT_ALIGN_SIZE);
  void close();
  int64_t get_file_pos() const;
  int append(const void *buf,
             const int64_t count,
             const bool is_fsync);
  int fsync();
public:
  void wait();
private:
  int submit_iocb_(AIOCB *iocb);
  AIOCB *get_iocb_();
private:
  Pool pool_;
  int fd_;
  int64_t file_pos_;
  int64_t align_size_;
  AIOCB *cur_iocb_;
  io_context_t ctx_;
};

}
