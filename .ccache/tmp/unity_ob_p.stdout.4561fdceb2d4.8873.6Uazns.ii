int ObPLLabelTable::add_label(const common::ObString &name,
                              const ObPLLabelTable::ObPLLabelType &type,
                              ObPLStmt *stmt)
{
  int ret = OB_SUCCESS;
  if (count_ < 0 || count_ >= FUNC_MAX_LABELS) {
    ret = OB_NOT_SUPPORTED;
    do { static_assert(__builtin_constant_p(OB_NOT_SUPPORTED) == 1, "LOG_USER_XX(errcode..)/LOG_DBA_XXX(errcoce) need use const errcode instead of vairable ret"); do { ::oceanbase::common::ObLogger::get_logger().log_user_message(::oceanbase::common::ObLogger::USER_ERROR, OB_NOT_SUPPORTED, "%s not supported", "label count greater than 1024"); if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/pl/ob_pl_stmt.cpp", 163, __FUNCTION__, OB_NOT_SUPPORTED, "%s not supported", "label count greater than 1024"); } } while(0); } while(0);
  } else {
    labels_[count_].label_ = name;
    labels_[count_].type_ = type;
    labels_[count_].next_stmt_ = stmt;
    count_++;
  }
  return ret;
}

