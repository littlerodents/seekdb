          } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (resolve_stmt_list(parse_tree->children_[1], body_block, func, true, true )))),!!0))) {




          } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (handler_analyzer_.reset_handlers(current_level_)))),!!0))) {
          } else {
            --current_level_;
            handler_analyzer_.reset_notfound_and_warning(current_level_);
            handler_analyzer_.set_continue(top_continue);
