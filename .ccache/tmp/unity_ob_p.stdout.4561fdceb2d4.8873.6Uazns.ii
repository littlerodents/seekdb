struct ObBoolMask
{
  ObBoolMask()
    : bmt_(ObBoolMaskType::PROBABILISTIC) {};
  ObBoolMask(ObBoolMaskType bmt)
    : bmt_(bmt) {};
  inline __attribute__((always_inline)) ObBoolMask operator &(const ObBoolMask &m) const
  {
    if (m.bmt_ == ObBoolMaskType::ALWAYS_TRUE) {
      return {bmt_};
    } else if (bmt_ == ObBoolMaskType::ALWAYS_TRUE) {
      return {m.bmt_};
    } else if (m.bmt_ == ObBoolMaskType::ALWAYS_FALSE
                || bmt_ == ObBoolMaskType::ALWAYS_FALSE) {
      return {ObBoolMaskType::ALWAYS_FALSE};
    } else {
      return {ObBoolMaskType::PROBABILISTIC};
    }
  }
  inline __attribute__((always_inline)) ObBoolMask operator |(const ObBoolMask &m) const
  {
    if (m.bmt_ == ObBoolMaskType::ALWAYS_FALSE) {
      return {bmt_};
    } else if (bmt_ == ObBoolMaskType::ALWAYS_FALSE) {
      return {m.bmt_};
    } else if (m.bmt_ == ObBoolMaskType::ALWAYS_TRUE
                || bmt_ == ObBoolMaskType::ALWAYS_TRUE) {
      return {ObBoolMaskType::ALWAYS_TRUE};
    } else {
      return {ObBoolMaskType::PROBABILISTIC};
    }
  }
  inline __attribute__((always_inline)) bool is_always_true() const
  {
    return ObBoolMaskType::ALWAYS_TRUE == bmt_;
  }
  inline __attribute__((always_inline)) bool is_always_false() const
  {
    return ObBoolMaskType::ALWAYS_FALSE == bmt_;
  }
  inline __attribute__((always_inline)) bool is_uncertain() const
  {
    return ObBoolMaskType::PROBABILISTIC == bmt_;
  }
  inline __attribute__((always_inline)) bool is_constant() const
  {
    return ObBoolMaskType::ALWAYS_TRUE == bmt_ ||
        ObBoolMaskType::ALWAYS_FALSE == bmt_;
  }
  inline __attribute__((always_inline)) void set_always_true()
  {
    bmt_ = ObBoolMaskType::ALWAYS_TRUE;
  }
  inline __attribute__((always_inline)) void set_always_false()
  {
    bmt_ = ObBoolMaskType::ALWAYS_FALSE;
  }
  inline __attribute__((always_inline)) void set_uncertain()
  {
    bmt_ = ObBoolMaskType::PROBABILISTIC;
  }
  inline __attribute__((always_inline)) void set(ObBoolMaskType bmt)
  {
    bmt_ = bmt;
  }
