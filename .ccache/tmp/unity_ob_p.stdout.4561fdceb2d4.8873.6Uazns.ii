template <typename T>
int ObPartitionUtils::get_start_(
    const T *const *partition_array,
    const int64_t partition_num,
    const T &start_part,
    int64_t &start_pos)
{
  int ret = common::OB_SUCCESS;
  if ((__builtin_expect(!!(__null == (partition_array)),!!0))) {
    ret = common::OB_ERR_UNEXPECTED;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 4, "src/share/schema/ob_schema_struct.h", 3056, __FUNCTION__, ret, "Partition array should not be NULL", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
  } else {
    const T * const*result = std::upper_bound(partition_array,
                                              partition_array + partition_num,
                                              &start_part,
                                              T::less_than);
    start_pos = result - partition_array;
    if (start_pos < 0) {
      ret = common::OB_ERR_UNEXPECTED;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 4, "src/share/schema/ob_schema_struct.h", 3065, __FUNCTION__, ret, "Start pos error", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(partition_num)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(partition_num)))&&>::value>("partition_num", ::oceanbase::common::check_char_array(partition_num)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
    }
  }
  return ret;
}

template <typename T>
int ObPartitionUtils::get_end_(
    const T *const*partition_array,
    const int64_t partition_num,
    const common::ObBorderFlag &border_flag,
    const T &end_part,
    int64_t &end_pos)
{
  int ret = common::OB_SUCCESS;
  if ((__builtin_expect(!!(__null == (partition_array)),!!0))) {
    ret = common::OB_ERR_UNEXPECTED;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 4, "src/share/schema/ob_schema_struct.h", 3082, __FUNCTION__, ret, "Input partition array should not be NULL", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
  } else {
    const T *const*result = std::lower_bound(partition_array,
                                             partition_array + partition_num,
                                             &end_part,
                                             T::less_than);
    int64_t pos = result - partition_array;
    if (pos >= partition_num) {
      end_pos = partition_num - 1;
    } else if ((__builtin_expect(!!(__null == (result)),!!0)) || (__builtin_expect(!!(__null == (*result)),!!0))) {
      ret = common::OB_ERR_UNEXPECTED;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 4, "src/share/schema/ob_schema_struct.h", 3093, __FUNCTION__, ret, "result should not be NULL", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(result)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(result)))&&>::value>("result", ::oceanbase::common::check_char_array(result))); } } } while (false);
    } else {
      common::ObNewRow lrow;
      lrow.cells_ = const_cast<common::ObObj*>((*result)->high_bound_val_.get_obj_ptr());
      lrow.count_ = (*result)->high_bound_val_.get_obj_cnt();
      lrow.projector_ = (*result)->projector_;
      lrow.projector_size_ = (*result)->projector_size_;
      common::ObNewRow rrow;
      rrow.cells_ = const_cast<common::ObObj*>(end_part.high_bound_val_.get_obj_ptr());
      rrow.count_ = end_part.high_bound_val_.get_obj_cnt();
      rrow.projector_ = end_part.projector_;
      rrow.projector_size_ = end_part.projector_size_;
      int cmp = 0;
      if (common::OB_SUCCESS != common::ObRowUtil::compare_row(lrow, rrow, cmp)) {
      }
      if (0 == cmp) {
        if (pos == partition_num - 1) {
          end_pos = partition_num - 1;
        } else {
          if (border_flag.inclusive_end()) {
            end_pos = pos + 1;
          } else {
            end_pos = pos;
          }
        }
      } else {
        end_pos = pos;
      }
    }
  }
  if (0 < partition_array[end_pos]->low_bound_val_.get_obj_cnt()) {
    ObNewRow lrow;
    lrow.cells_ = const_cast<ObObj*>(end_part.high_bound_val_.get_obj_ptr());
    lrow.count_ = end_part.high_bound_val_.get_obj_cnt();
    lrow.projector_ = end_part.projector_;
    lrow.projector_size_ = end_part.projector_size_;
    ObNewRow rrow;
    rrow.cells_ = const_cast<ObObj*>(partition_array[end_pos]->low_bound_val_.get_obj_ptr());
    rrow.count_ = partition_array[end_pos]->low_bound_val_.get_obj_cnt();
    rrow.projector_ = partition_array[end_pos]->projector_;
    rrow.projector_size_ = partition_array[end_pos]->projector_size_;
    int cmp = 0;
    if (OB_SUCCESS != ObRowUtil::compare_row(lrow, rrow, cmp)) {
    } else if (cmp < 0) {
      end_pos--;
    }
  }
  return ret;
}

