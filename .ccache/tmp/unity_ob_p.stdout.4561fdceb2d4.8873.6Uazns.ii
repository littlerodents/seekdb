    do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/oblib/lib/utility/utility.h", 731, __FUNCTION__, ret, "read %s failed, errno %d", path, (*__errno_location ())); } } } while (false);
    ret = OB_ERROR;
  } else {
