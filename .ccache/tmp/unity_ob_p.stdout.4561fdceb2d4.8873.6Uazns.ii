                                        int32_t &offset_sec, int32_t &tran_type_id) const;
  virtual int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"lower_time", ::oceanbase::common::check_char_array(lower_time_), "info", ::oceanbase::common::check_char_array(info_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
private:
  ObTZTransitionTypeInfo(const ObTZTransitionTypeInfo&); void operator=(const ObTZTransitionTypeInfo&);
public:
