  {
    bucket.lock_.lock(ObLatchIds::LATCH_WAIT_QUEUE_LOCK, (9223372036854775807L) , false );



  }

  inline void unlock_bucket(ObLatchBucket &bucket)
  {
    bucket.lock_.unlock();
  }

