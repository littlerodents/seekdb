inline char* GetDataImpl(std::string& s,
                         int) noexcept {
  return &s[0];
}

template <typename C>
constexpr auto GetData(C& c) noexcept
    -> decltype(GetDataImpl(c, 0)) {
  return GetDataImpl(c, 0);
