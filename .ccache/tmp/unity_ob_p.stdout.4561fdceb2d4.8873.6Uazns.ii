ObPLBuilderEnvGuard::~ObPLBuilderEnvGuard()
{
  int ret = OB_SUCCESS;
  if (need_reset_exec_env_) {
    if ((ret = old_exec_env_.store(session_info_)) != OB_SUCCESS) {
      ret_ = OB_SUCCESS == ret_ ? ret : ret_;
