template <typename T, int64_t MAX_CLASS_NUM, const char *LABEL>
class ObGlobalFactory;

template<typename T, int64_t MAX_CLASS_NUM, const char *LABEL>
class ObGlobalFreeList
{
  typedef typename ObGlobalFactory<T, MAX_CLASS_NUM, LABEL>::create_method_t create_method_t;
public:
  ObGlobalFreeList()
    : lock_(ObLatchIds::OB_GLOBAL_FREE_LIST_LOCK),
      next_cache_line_(0),
      objs_cache_(),
      empty_blocks_(),
      nonempty_blocks_()
  {
  }
  virtual ~ObGlobalFreeList() {}

  void push_range(common::ObDList<T> &range, int32_t num_to_move)
  {
    int32_t num = range.get_size();
    while (num >= num_to_move) {
      common::ObDList<T> subrange;
      range.pop_range(num_to_move, subrange);
      num -= num_to_move;
      ObRecursiveMutexGuard guard(lock_);
      if (next_cache_line_ < CACHE_SIZE) {
        objs_cache_[next_cache_line_++].push_range(subrange);
      } else {

        release_objs(subrange);
        break;
      }
    }
    if (0 < num) {
      ObRecursiveMutexGuard guard(lock_);
      release_objs(range);
    }
  }

  int pop_range(int32_t num, int32_t num_to_move,
                int32_t obj_size, create_method_t creator,
                common::ObDList<T> &range)
  {
    int ret = OB_SUCCESS;
    if (__builtin_expect(!!(range.get_size() > num_to_move),!!0)) {
      ret = OB_ERR_UNEXPECTED;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 245, __FUNCTION__, ret, "range size is larger than number to move", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(range.get_size())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(range.get_size())))&&>::value>("range.get_size()", ::oceanbase::common::check_char_array(range.get_size())) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(num_to_move)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(num_to_move)))&&>::value>("num_to_move", ::oceanbase::common::check_char_array(num_to_move))); } } } while (false);

    } else {
      ObRecursiveMutexGuard guard(lock_);
      if (num == num_to_move) {
        if (next_cache_line_ > 0) {
          range.push_range(objs_cache_[--next_cache_line_]);
        } else {

          ret = create_objs(num, obj_size, creator, range);
        }
      } else {

        ret = create_objs(num, obj_size, creator, range);
      }
    }
    return ret;
  }

  void stat()
  {
    ObRecursiveMutexGuard guard(lock_);
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 2)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 2, "src/oblib/lib/objectpool/ob_global_factory.h", 267, __FUNCTION__, 0, "[GFACTORY_STAT] freelist next_cache_line", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(next_cache_line_), std::is_rvalue_reference<decltype((next_cache_line_))&&>::value>("next_cache_line", next_cache_line_)); } } } while (false);

    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 2)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 2, "src/oblib/lib/objectpool/ob_global_factory.h", 269, __FUNCTION__, 0, "[GFACTORY_STAT] freelist empty_blocks_num", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(empty_blocks_.get_size()), std::is_rvalue_reference<decltype((empty_blocks_.get_size()))&&>::value>("empty_blocks_num", empty_blocks_.get_size())); } } } while (false);

    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 2)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 2, "src/oblib/lib/objectpool/ob_global_factory.h", 271, __FUNCTION__, 0, "[GFACTORY_STAT] freelist nonempty_blocks_num", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(nonempty_blocks_.get_size()), std::is_rvalue_reference<decltype((nonempty_blocks_.get_size()))&&>::value>("nonempty_blocks_num", nonempty_blocks_.get_size())); } } } while (false);

    for (auto blk = (nonempty_blocks_).get_first(); (true) && blk != (nonempty_blocks_).get_header() && blk != __null; blk = blk->get_next()) {
      if ((__builtin_expect(!!(__null == (blk)),!!0))) {
        { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 274, __FUNCTION__, ret, "nonempty_block is NULL", "placeholder" ); } } } while (false); };
      } else {
        const int32_t obj_size = blk->get_obj_size();
        do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 2)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 2, "src/oblib/lib/objectpool/ob_global_factory.h", 279, __FUNCTION__, 0, "[GFACTORY_STAT] nonempty_block", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(obj_size)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(obj_size)))&&>::value>("obj_size", ::oceanbase::common::check_char_array(obj_size)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(blk->get_in_use_count()), std::is_rvalue_reference<decltype((blk->get_in_use_count()))&&>::value>("in_use_count", blk->get_in_use_count()) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(blk->get_obj_num_by_obj_size(obj_size)), std::is_rvalue_reference<decltype((blk->get_obj_num_by_obj_size(obj_size)))&&>::value>("total", blk->get_obj_num_by_obj_size(obj_size))); } } } while (false);


      }
    }
  }
private:

  static const int64_t CACHE_SIZE = 64;
private:

  void release_objs(common::ObDList<T> &range)
  {
    for (auto ptr = (range).remove_first(); (true) && __null != ptr && ptr != (range).get_header(); ptr = (range).remove_first()) {
      ObTCBlock *blk = __null;
      if ((__builtin_expect(!!(__null == (ptr)),!!0))) {
        { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 293, __FUNCTION__, ret, "obj ptr is NULL", "placeholder" ); } } } while (false); };
      } else if ((__builtin_expect(!!(__null == (blk = ObTCBlock::get_block_by_obj(ptr))),!!0))) {
        { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 295, __FUNCTION__, ret, "block is NULL", "placeholder" ); } } } while (false); };
      } else {
        if (blk->is_empty()) {

          empty_blocks_.remove(blk);
          if (__builtin_expect(!!(false == nonempty_blocks_.add_last(blk)),!!0)) {
            { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 301, __FUNCTION__, ret, "fail to add block to nonempty_blocks_'s tail", "placeholder" ); } } } while (false); };
          }
        } else {}
        ptr->~T();
        blk->free(ptr);
        if (blk->can_delete()) {
          nonempty_blocks_.remove(blk);
          ObTCBlock::delete_block(blk);
        } else {}
      }
    }
  }

  int create_objs(int32_t num,
                  int32_t obj_size,
                  create_method_t creator,
                  common::ObDList<T> &range)
  {
    int ret = OB_SUCCESS;
    for (int32_t i = 0; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && i < num; ++i) {
      if (nonempty_blocks_.get_size() <= 0) {

        ObTCBlock *blk = ObTCBlock::new_block(obj_size, LABEL);
        if ((__builtin_expect(!!(__null == (blk)),!!0))) {
          ret = OB_ALLOCATE_MEMORY_FAILED;
          do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 326, __FUNCTION__, ret, "fail to alloc block", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
        } else {
          void *ptr = blk->alloc();
          if ((__builtin_expect(!!(__null == (ptr)),!!0))) {
            ret = OB_ALLOCATE_MEMORY_FAILED;
            do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 331, __FUNCTION__, ret, "fail to alloc memory from block", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
          } else {
            T *obj = creator(ptr);
            if (__builtin_expect(!!(false == range.add_first(obj)),!!0)) {
              ret = OB_ERR_UNEXPECTED;
              do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 336, __FUNCTION__, ret, "fail to add obj to range list head", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
            } else {
              if (blk->is_empty()) {
                if (__builtin_expect(!!(false == empty_blocks_.add_last(blk)),!!0)) {
                  ret = OB_ERR_UNEXPECTED;
                  do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 341, __FUNCTION__, ret, "fail to add block to empty block list tail", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
                }
              } else {
                if (__builtin_expect(!!(false == nonempty_blocks_.add_last(blk)),!!0)) {
                  ret = OB_ERR_UNEXPECTED;
                  do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 346, __FUNCTION__, ret, "fail to add block to nonempty block list tail", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
                }
              }
            }
          }
        }
      } else {
        ObTCBlock *blk = nonempty_blocks_.get_first();
        if ((__builtin_expect(!!(__null == (blk)),!!0))) {
          ret = OB_ALLOCATE_MEMORY_FAILED;
          do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 356, __FUNCTION__, ret, "fail to alloc block", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
        } else {
