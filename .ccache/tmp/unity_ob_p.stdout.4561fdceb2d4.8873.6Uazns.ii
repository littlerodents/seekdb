namespace oceanbase
{
namespace storage
{

constexpr int64_t OB_FT_PARSER_NAME_LENGTH = 64;

class ObFTParserName final
{
public:
  ObFTParserName() { memset(name_, 0, sizeof(name_)); }
  explicit ObFTParserName(const char *name)
  {
    memset(name_, 0, sizeof(name_));
    do{ if(__builtin_expect(!!(!(common::OB_SUCCESS == set_name(name))),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/data_plane/api/data_plane/fts/ob_fts_parser_name.h", 38, __FUNCTION__, ret, "assert fail, exp=%s", "common::OB_SUCCESS == set_name(name)"); } } } while (false); }; do { if (__builtin_expect(!!(1),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/data_plane/api/data_plane/fts/ob_fts_parser_name.h", 38, __FUNCTION__, ret, "assert fail" " BACKTRACE:%s", oceanbase::common::lbt()); } } } while (false); }; } } while (false); ob_abort(); } } while(false);
  }
  ~ObFTParserName() = default;

  int set_name(const char *name);
  int set_name(const common::ObString &name);

  inline __attribute__((always_inline)) bool is_valid() const { return strlen(name_) > 0; }
  inline __attribute__((always_inline)) int64_t len() const { return strlen(name_); }
  inline __attribute__((always_inline)) char *str() { return name_; }
  inline __attribute__((always_inline)) const char *str() const { return name_; }
  inline __attribute__((always_inline)) int hash(uint64_t &value) const
  {
    value = murmurhash(name_, static_cast<int32_t>(strlen(name_)), 0);
    return common::OB_SUCCESS;
  }

  inline __attribute__((always_inline)) bool operator==(const ObFTParserName &other) const
  {
    return 0 == strcmp(name_, other.name_);
  }
  inline __attribute__((always_inline)) bool operator!=(const ObFTParserName &other) const { return !(*this == other); }
  inline __attribute__((always_inline)) bool operator<(const ObFTParserName &other) const
  {
    return strcmp(name_, other.name_) < 0;
  }
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"name", ::oceanbase::common::check_char_array(name_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };

private:
  char name_[OB_FT_PARSER_NAME_LENGTH];
};

}
}
