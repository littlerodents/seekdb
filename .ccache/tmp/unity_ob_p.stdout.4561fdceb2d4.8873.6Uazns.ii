  ObPushdownWhiteFilterNode(common::ObIAllocator &alloc)
      : ObPushdownFilterNode(alloc, PushdownFilterType::WHITE_FILTER),
      expr_(nullptr), op_type_(WHITE_OP_MAX) , column_exprs_(alloc)
  {}
  ~ObPushdownWhiteFilterNode() {}
