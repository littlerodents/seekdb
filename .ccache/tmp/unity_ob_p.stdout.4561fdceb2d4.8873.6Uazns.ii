}

inline const char* CordRepBtree::EdgeDataPtr(const CordRep* r) {
  (static_cast<void> (0));
  size_t offset = 0;
  if (r->tag == SUBSTRING) {
    offset = r->substring()->start;
    r = r->substring()->child;
  }
  return (r->tag >= FLAT ? r->flat()->Data() : r->external()->base) + offset;
}

inline absl::string_view CordRepBtree::EdgeData(const CordRep* r) {
