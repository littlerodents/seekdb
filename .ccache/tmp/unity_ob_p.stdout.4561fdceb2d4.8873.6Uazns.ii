template <typename Key, typename Value, typename HashFunc>
int ObFixedHashMap<Key, Value, HashFunc>::erase(const Key &key)
{
  int ret = common::OB_ENTRY_NOT_EXIST;
  uint64_t hash_val = 0;
  if (!inited_) {
    ret = common::OB_NOT_INIT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE""] ", 4, "src/share/cache/ob_cache_utils.h", 333, __FUNCTION__, ret, "not init", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (hash_func_(key, hash_val)))),!!0))) {
  } else {
    ret = common::OB_ENTRY_NOT_EXIST;
    const int64_t pos = hash_val % bucket_num_;
    Node *node = buckets_[pos];
    Node *prev = __null;
    while (__null != node && OB_ENTRY_NOT_EXIST == ret) {
      if (node->pair_.first == key) {
        if (__null == prev) {
          buckets_[pos] = node->next_;
        } else {
          prev->next_ = node->next_;
        }
        push_free_node(node);
        --size_;
        ret = common::OB_SUCCESS;
        break;
      } else {
        prev = node;
        node = node->next_;
      }
    }
  }
  return ret;
}

template <typename Key, typename Value, typename HashFunc>
void ObFixedHashMap<Key, Value, HashFunc>::push_free_node(Node *node)
{
  node->next_ = free_nodes_;
  free_nodes_ = node;
}

template <typename Key, typename Value, typename HashFunc>
typename ObFixedHashMap<Key, Value, HashFunc>::Node *ObFixedHashMap<Key, Value, HashFunc>::pop_free_node()
{
  Node *node = free_nodes_;
  if (__null != node) {
    free_nodes_ = node->next_;
  }
  return node;
}


template <typename T>
class ObFreeHeap
{
public:
  ObFreeHeap();
  virtual ~ObFreeHeap();
  int init(const int64_t count, const char *label);
  void destroy();

  int sbrk(T *&buf);
  int sbrk(const int64_t count, T *&buf);
  void reuse();
private:
  bool inited_;
  common::ObArenaAllocator allocator_;
  T *buf_;
  int64_t free_cnt_;
  int64_t total_cnt_;
};

template <typename T>
ObFreeHeap<T>::ObFreeHeap()
  : inited_(false), allocator_(),
    buf_(__null), free_cnt_(0), total_cnt_(0)
{
}

template <typename T>
ObFreeHeap<T>::~ObFreeHeap()
{
  destroy();
}

template <typename T>
int ObFreeHeap<T>::init(const int64_t count, const char *label)
{
  int ret = common::OB_SUCCESS;
  if (inited_) {
    ret = common::OB_INIT_TWICE;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE""] ", 4, "src/share/cache/ob_cache_utils.h", 417, __FUNCTION__, ret, "init twice", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
  } else if (count <= 0 || nullptr == label) {
    ret = common::OB_INVALID_ARGUMENT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE""] ", 4, "src/share/cache/ob_cache_utils.h", 420, __FUNCTION__, ret, "invalid arguments", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(count)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(count)))&&>::value>("count", ::oceanbase::common::check_char_array(count)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(label)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(label)))&&>::value>("label", ::oceanbase::common::check_char_array(label))); } } } while (false);
  } else {
    allocator_.set_label(label);
    buf_ = static_cast<T *>(allocator_.alloc(sizeof(T) * count));
    if (__null == buf_) {
      ret = common::OB_ALLOCATE_MEMORY_FAILED;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE""] ", 4, "src/share/cache/ob_cache_utils.h", 426, __FUNCTION__, ret, "alloc memory failed", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(count)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(count)))&&>::value>("count", ::oceanbase::common::check_char_array(count))); } } } while (false);
    } else {
      for (int64_t i = 0; i < count; ++i) {
        new (&buf_[i]) T();
      }
      free_cnt_ = count;
      total_cnt_ = count;
      inited_ = true;
    }
  }
  return ret;
}

template <typename T>
void ObFreeHeap<T>::destroy()
{
  if (inited_) {
    for (int64_t i = 0; i < total_cnt_; ++i) {
      buf_[i].~T();
    }
    free_cnt_ = 0;
    total_cnt_ = 0;
    allocator_.free(buf_);
    buf_ = __null;
    inited_ = false;
  }
}

template <typename T>
int ObFreeHeap<T>::sbrk(T *&buf)
{
  const int64_t count = 1;
  return sbrk(count, buf);
}

template <typename T>
int ObFreeHeap<T>::sbrk(const int64_t count, T *&buf)
{
  int ret = common::OB_SUCCESS;
  if (!inited_) {
    ret = common::OB_NOT_INIT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE""] ", 4, "src/share/cache/ob_cache_utils.h", 467, __FUNCTION__, ret, "not init", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
  } else if (count <= 0) {
    ret = common::OB_INVALID_ARGUMENT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE""] ", 4, "src/share/cache/ob_cache_utils.h", 470, __FUNCTION__, ret, "invalid arguments", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(count)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(count)))&&>::value>("count", ::oceanbase::common::check_char_array(count))); } } } while (false);
  } else if (free_cnt_ < count) {
    ret = common::OB_BUF_NOT_ENOUGH;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE""] ", 4, "src/share/cache/ob_cache_utils.h", 473, __FUNCTION__, ret, "buffer not enough", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(free_cnt_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(free_cnt_)))&&>::value>("free_cnt", ::oceanbase::common::check_char_array(free_cnt_)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(count)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(count)))&&>::value>("count", ::oceanbase::common::check_char_array(count))); } } } while (false);
  } else {
    free_cnt_ -= count;
    buf = buf_ + free_cnt_;
  }
  return ret;
}

template <typename T>
void ObFreeHeap<T>::reuse()
{
  if (inited_) {
    for (int64_t i = 0; i < total_cnt_; ++i) {
      buf_[i].reuse();
    }
    free_cnt_ = total_cnt_;
  }
}

template <typename T>
class ObSimpleFixedArray final : public common::ObFixedArrayImpl<T, common::ObArenaAllocator>
{
public:
