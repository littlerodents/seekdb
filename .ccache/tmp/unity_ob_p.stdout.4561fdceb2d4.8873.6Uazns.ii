class ObIntWarp
{
public:
  ObIntWarp() : v_(0) {}
  explicit ObIntWarp(const uint64_t v) : v_(v) {}
  ~ObIntWarp() { reset(); }
  void reset() { v_ = 0; }
  uint64_t hash() const { return v_; }
  int hash(uint64_t &hash_val) const { hash_val = hash(); return OB_SUCCESS; }
  uint64_t get_value() const { return v_; }
  int compare(const ObIntWarp &other) const
  {
    int ret = 0;
    if (v_ == other.v_) {
      ret = 0;
    } else if (v_ > other.v_) {
      ret = 1;
    } else {
      ret = -1;
    }
    return ret;
  }
  bool operator==(const ObIntWarp &other) const
  {
    return 0 == compare(other);
  }
  bool operator!=(const ObIntWarp &other) const
  {
    return !operator==(other);
  }
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"v", ::oceanbase::common::check_char_array(v_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
private:
