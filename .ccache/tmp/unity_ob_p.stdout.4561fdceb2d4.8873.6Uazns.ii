    if (sz > block_pool_.get_obj_size()) {
      { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_pool.h", 127, __FUNCTION__, ret, "Wrong block size", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(sz)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(sz)))&&>::value>("sz", ::oceanbase::common::check_char_array(sz)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(block_pool_.get_obj_size())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(block_pool_.get_obj_size())))&&>::value>("block_pool_.get_obj_size()", ::oceanbase::common::check_char_array(block_pool_.get_obj_size()))); } } } while (false); };
    } else {
