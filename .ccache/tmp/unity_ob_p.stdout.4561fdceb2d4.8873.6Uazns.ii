    for (int i = right->start(); i <= right->finish() - to_move; ++i) {
      (static_cast<void> (0));
      right->init_child(i, right->child(i + to_move));
      right->clear_child(i + to_move);
    }
  }


  set_finish(finish() + to_move);
  right->set_finish(right->finish() - to_move);
}

