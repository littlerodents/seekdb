  ObIndexTableStat(const uint64_t index_id, const share::schema::ObIndexStatus index_status,
      const bool is_drop_schema)
    : index_id_(index_id), index_status_(index_status), is_drop_schema_(is_drop_schema)
  {}
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"index_id", ::oceanbase::common::check_char_array(index_id_), "index_status", ::oceanbase::common::check_char_array(index_status_), "is_drop_schema", ::oceanbase::common::check_char_array(is_drop_schema_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
