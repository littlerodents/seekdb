    __attribute__((always_inline)) void put_varint32_inline(uint32 v) {
      p = Varint::Encode32Inline(p, v);
    }
    __attribute__((always_inline)) void put_varint64(uint64 v) {
      p = Varint::Encode64(p, v);
    }
  };

