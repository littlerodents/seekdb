};

enum TgTimingEvent
{
  TG_TIMING_EVENT_INVALID = -1,
  TG_BEFORE_INSERT = 0,
  TG_BEFORE_UPDATE,
  TG_BEFORE_DELETE,
  TG_AFTER_INSERT,
  TG_AFTER_UPDATE,
  TG_AFTER_DELETE
};

