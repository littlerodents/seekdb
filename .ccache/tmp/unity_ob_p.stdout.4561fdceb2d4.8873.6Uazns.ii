template <class T>
class UniqueSetWrapAllocer
{
public:
  UniqueSetWrapAllocer() : allocator_(__null) {}
  UniqueSetWrapAllocer(ObIAllocator &alloc) : allocator_(&alloc) {}

  T *alloc()
  {
    T *ret = static_cast<T *>(allocator_->alloc(sizeof(T)));
    if (__null != ret) {
      new(ret) T();
    }

    return ret;
  }
  void free(T *data)
  {
    if (__null == data || __null == allocator_) {
      { int __ret__ = common::OB_INVALID_ARGUMENT; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SQL, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SQL""] ", 4, "src/sql/resolver/expr/ob_raw_expr_util.h", 99, __FUNCTION__, ret, "invalid param null pointer", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(reinterpret_cast<const void*>(data)), std::is_rvalue_reference<decltype((reinterpret_cast<const void*>(data)))&&>::value>("data", reinterpret_cast<const void*>(data)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(reinterpret_cast<const void*>(allocator_)), std::is_rvalue_reference<decltype((reinterpret_cast<const void*>(allocator_)))&&>::value>("allocator_", reinterpret_cast<const void*>(allocator_))); } } } while (false); };
    } else {
      data->~T();
      allocator_->free(data);
    }
  }
  void inc_ref() {}
  void dec_ref() {}

private:
  ObIAllocator *allocator_;
};

