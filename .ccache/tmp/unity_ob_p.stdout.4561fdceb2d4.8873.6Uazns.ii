template <class T>
int ObNumber::from(const char *str,
                   const int64_t length,
                   T &allocator,
                   int16_t *precision,
                   int16_t *scale,
                   const bool do_rounding)
{
  int ret = OB_SUCCESS;
  int warning = OB_SUCCESS;
  TAllocator<T> ta(allocator);
  ret = from_(str, length, ta, warning, precision, scale, __null, do_rounding);
  if (OB_SUCCESS == ret && OB_SUCCESS != warning) {
    ret = warning;
  }
  return ret;
}

