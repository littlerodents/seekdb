    POLYGON_EMPTY_LOOP = 202,
    POLYGON_EXCESS_FULL_LOOP = 203,


    POLYGON_INCONSISTENT_LOOP_ORIENTATIONS = 204,


    POLYGON_INVALID_LOOP_DEPTH = 205,



    POLYGON_INVALID_LOOP_NESTING = 206,






