  inline __attribute__((always_inline)) uint64_t hold(uint64_t *payload=nullptr) const;
  inline __attribute__((always_inline)) uint64_t aligned();
  inline __attribute__((always_inline)) static uint64_t calc_hold(int64_t size, int64_t washed_size=0, uint64_t *payload=nullptr);
  inline __attribute__((always_inline)) static uint64_t aligned(int64_t size);
  inline __attribute__((always_inline)) static AChunk *ptr2chunk(const void *ptr);
  inline __attribute__((always_inline)) ABlock *ptr2blk(const void *ptr) const;
  inline __attribute__((always_inline)) void mark_blk_offset_bit(int offset);
  inline __attribute__((always_inline)) void unmark_blk_offset_bit(int offset);
  inline __attribute__((always_inline)) ABlock *offset2blk(int offset) const;
  inline __attribute__((always_inline)) bool is_first_blk_offset(int offset, int *prev_offset=nullptr) const;
  inline __attribute__((always_inline)) bool is_last_blk_offset(int offset, int *next_offset=nullptr) const;
  inline __attribute__((always_inline)) int max_blk_offset_le(int offset) const;
  inline __attribute__((always_inline)) int min_blk_offset_ge(int offset) const;
  inline __attribute__((always_inline)) int blk_offset(const ABlock *block) const;
  inline __attribute__((always_inline)) int blk_nblocks(const ABlock *block) const;
  inline __attribute__((always_inline)) char *blk_data(const ABlock *block) const;
  uint32_t MAGIC_CODE_;
  int32_t using_cnt_;
  BlockSet *block_set_;
  uint64_t washed_blks_;
  uint64_t washed_size_;
  uint64_t alloc_bytes_;
  AChunk *prev_, *next_;
  AChunk *prev2_, *next2_;
  ASimpleBitSet<MAX_BLOCKS_CNT> blk_bs_;
  char data_[0];
} __attribute__ ((aligned (16)));

struct ABlock {
  inline __attribute__((always_inline)) ABlock();
  inline __attribute__((always_inline)) AChunk *chunk() const;
  inline __attribute__((always_inline)) void clear_magic_code();
  inline __attribute__((always_inline)) bool is_valid() const;
  inline __attribute__((always_inline)) uint64_t hold(uint64_t *payload=nullptr) const;
  inline __attribute__((always_inline)) char *data() const;

  union {
    uint32_t MAGIC_CODE_;
    struct {
      struct {
        uint8_t in_use_ : 1;
        uint8_t is_large_ : 1;
        uint8_t is_washed_ : 1;
      };
    };
  };

  union {
    uint64_t alloc_bytes_;
    int64_t free_time_us_;
  };
  uint32_t ablock_size_;
  ObjectSet *obj_set_;
  ABlock *prev_, *next_;
};

struct AObject {
  inline __attribute__((always_inline)) AObject();
  inline __attribute__((always_inline)) AObject *phy_next(int32_t steps) const;
  inline __attribute__((always_inline)) bool is_valid() const;
  inline __attribute__((always_inline)) bool is_first() const;
  inline __attribute__((always_inline)) bool is_last(uint32_t cells_per_block) const;
  inline __attribute__((always_inline)) ABlock *block() const;
  inline __attribute__((always_inline)) uint64_t hold(uint32_t cells_per_block) const;
  inline __attribute__((always_inline)) ObLabel label() const;
  inline __attribute__((always_inline)) char *bt();
  inline __attribute__((always_inline)) void set_label(const char* label)
