        { int __ret__ = OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::OB_PRINT("", 3, "src/oblib/lib/allocator/ob_allocator_v2.h", 93, __FUNCTION__, ret, "context allocator is null", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ctx_id_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ctx_id_)))&&>::value>("ctx_id_", ::oceanbase::common::check_char_array(ctx_id_))); } } } while (false); };
