inline int ObRARowStore::ShrinkBuffer::compact()
{
  int ret = common::OB_SUCCESS;
  if (!is_inited()) {
    ret = common::OB_NOT_INIT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SQL, ::oceanbase::common::OB_LOG_SQL::M_ENG, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SQL"".""ENG""] ", 4, "src/sql/engine/basic/ob_ra_row_store.h", 355, __FUNCTION__, ret, "not inited", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
  } else {
    memmove(head(), tail(), tail_size());
    head_ += tail_size();
    tail_ = cap_;
  }
  return ret;
}

inline bool ObRARowStore::IndexBlock::row_in_pos(const int64_t row_id, const int64_t pos)
{
  bool in_pos = false;
  if (cnt_ > 0 && pos >= 0 && pos < cnt_) {
    if (pos + 1 == cnt_) {
      in_pos = block_indexes_[pos].row_id_ == row_id;
    } else {
      in_pos = block_indexes_[pos].row_id_ <= row_id && row_id < block_indexes_[pos + 1].row_id_;
    }
  }
  return in_pos;
}


