      { int __ret__ = OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/oblib/lib/utility/utility.h", 533, __FUNCTION__, ret, "%s=%ld:%ld:%ld\n", id_, count, 1000000 * (count - last_report_count_) / (cur_ts - last_report_time_), (total_cost_time - last_cost_time_)/report_mod_); } } } while (false); };


      last_report_count_ = count;
      last_report_time_ = cur_ts;
      last_cost_time_ = total_cost_time;
