inline int32_t ObTCBlock::get_batch_count_by_obj_size(int32_t obj_size)
{

  if (__builtin_expect(!!(obj_size < 0),!!0)) {
    { int __ret__ = common::OB_INVALID_ARGUMENT; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 93, __FUNCTION__, ret, "obj_size < 0, is invalid", "placeholder" ); } } } while (false); };
  } else {}
  int32_t batch_count = static_cast<int32_t>(BLOCK_SIZE) / obj_size;
  if (batch_count < 2) {
    batch_count = 2;
  } else if (batch_count > 32) {
    batch_count = 32;
  } else {}
  return batch_count;
}

inline ObTCBlock *ObTCBlock::get_block_by_obj(void *obj)
{
  return *reinterpret_cast<ObTCBlock **>(reinterpret_cast<char *>(obj) - sizeof(void *));
}

inline void ObTCBlock::freelist_push(void *ptr)
{
  if ((__builtin_expect(!!(__null == (ptr)),!!0))) {
    { int __ret__ = common::OB_INVALID_ARGUMENT; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 112, __FUNCTION__, ret, "invalid argument, ptr is NULL", "placeholder" ); } } } while (false); };
  } else {
    FreeNode *node = reinterpret_cast<FreeNode *>(ptr);
    node->next_ = freelist_;
    freelist_ = node;
  }
}

inline void *ObTCBlock::freelist_pop()
{
  void *ptr_ret = __null;
  if (__null != freelist_) {
    ptr_ret = freelist_;
    freelist_ = freelist_->next_;
  } else {}
  return ptr_ret;
}

inline int32_t ObTCBlock::get_aligned_obj_size(int32_t obj_size)
{

  int32_t aligned_obj_size = static_cast<int32_t>(obj_size + sizeof(void *));
  if (0 != (aligned_obj_size % OBJ_SIZE_ALIGN_SHIFT)) {
    aligned_obj_size = (aligned_obj_size + OBJ_SIZE_ALIGN_SHIFT) & OBJ_SIZE_ALIGN_MASK;
  } else {}
  return aligned_obj_size;
}

inline int32_t ObTCBlock::get_obj_num_by_aligned_obj_size(int32_t aligned_obj_size)
{
  return static_cast<int32_t>((BLOCK_SIZE - sizeof(ObTCBlock)) / aligned_obj_size);
}

inline int32_t ObTCBlock::get_obj_num_by_obj_size(int32_t obj_size)
{
  return get_obj_num_by_aligned_obj_size(get_aligned_obj_size(obj_size));
}

inline ObTCBlock::ObTCBlock(int32_t obj_size)
    : obj_size_(obj_size),
      in_use_count_(0),
      freelist_(__null),
      data_()
{
  int ret = OB_SUCCESS;
  int32_t aligned_obj_size = get_aligned_obj_size(obj_size);
  int32_t obj_count = get_obj_num_by_aligned_obj_size(aligned_obj_size);
  for (int32_t i = 0; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && i < obj_count; ++i) {
    char *ptr = &data_[i * aligned_obj_size];
    *reinterpret_cast<void **>(ptr) = this;
    ptr += sizeof(void *);
    freelist_push(ptr);
  }
  if (__builtin_expect(!!(0 == obj_count),!!0)) {
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 166, __FUNCTION__, ret, "object too large", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(obj_size)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(obj_size)))&&>::value>("obj_size", ::oceanbase::common::check_char_array(obj_size)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(aligned_obj_size)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(aligned_obj_size)))&&>::value>("aligned_obj_size", ::oceanbase::common::check_char_array(aligned_obj_size))); } } } while (false);
  } else {}
}

inline bool ObTCBlock::can_delete() const
{
  return (0 == in_use_count_);
}

inline void *ObTCBlock::alloc()
{
  void *ptr_ret = freelist_pop();
  if (__null != ptr_ret) {
    ++in_use_count_;
  }
  return ptr_ret;
}

inline void ObTCBlock::free(void *ptr)
{
  if ((__builtin_expect(!!(__null == (ptr)),!!0))) {
    { int __ret__ = common::OB_INVALID_ARGUMENT; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 187, __FUNCTION__, ret, "ptr is NULL", "placeholder" ); } } } while (false); };
  } else if (__builtin_expect(!!((char *)ptr - (char *)this >= BLOCK_SIZE),!!0)) {
    { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 190, __FUNCTION__, ret, "size is larger than BLOCK_SIZE", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ptr)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ptr)))&&>::value>("ptr", ::oceanbase::common::check_char_array(ptr)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(this)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(this)))&&>::value>("this", ::oceanbase::common::check_char_array(this)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(((char *)ptr - (char *)this))), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(((char *)ptr - (char *)this))))&&>::value>("((char *)ptr - (char *)this)", ::oceanbase::common::check_char_array(((char *)ptr - (char *)this))) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(static_cast<__typeof__(BLOCK_SIZE)>(BLOCK_SIZE)), std::is_rvalue_reference<decltype((static_cast<__typeof__(BLOCK_SIZE)>(BLOCK_SIZE)))&&>::value>("BLOCK_SIZE", static_cast<__typeof__(BLOCK_SIZE)>(BLOCK_SIZE))); } } } while (false); };

  } else {
