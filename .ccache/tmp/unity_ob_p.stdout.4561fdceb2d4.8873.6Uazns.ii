template<typename DSTSCHEMA>
int ObSchema::set_charset_and_collation_options(common::ObCharsetType src_charset_type,
                                                common::ObCollationType src_collation_type,
                                                DSTSCHEMA &dst)
{
  int ret = common::OB_SUCCESS;
  if (dst.get_charset_type() == common::CHARSET_INVALID
      && dst.get_collation_type() == common::CS_TYPE_INVALID) {

    if (src_charset_type == common::CHARSET_INVALID
        || src_collation_type == common::CS_TYPE_INVALID) {
      ret = common::OB_ERR_UNEXPECTED;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 4, "src/share/schema/ob_schema_struct.h", 1578, __FUNCTION__, ret, "charset type or collation type is invalid ", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
    } else {
      dst.set_charset_type(src_charset_type);
      dst.set_collation_type(src_collation_type);
    }
  } else {
    common::ObCharsetType charset_type = dst.get_charset_type();
    common::ObCollationType collation_type = dst.get_collation_type();
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (common::ObCharset::check_and_fill_info(charset_type, collation_type)))),!!0))) {
    } else {
      dst.set_charset_type(charset_type);
      dst.set_collation_type(collation_type);
    }
  }
  if (common::OB_SUCCESS == ret &&
      !common::ObCharset::is_valid_collation(dst.get_charset_type(),
                                             dst.get_collation_type())) {
    ret = common::OB_ERR_UNEXPECTED;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 4, "src/share/schema/ob_schema_struct.h", 1597, __FUNCTION__, ret, "invalid collation!", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(dst.get_charset_type())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(dst.get_charset_type())))&&>::value>("dst.get_charset_type()", ::oceanbase::common::check_char_array(dst.get_charset_type())) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(dst.get_collation_type())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(dst.get_collation_type())))&&>::value>("dst.get_collation_type()", ::oceanbase::common::check_char_array(dst.get_collation_type())) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);

  }
  return ret;
}

struct SchemaObj
{
  SchemaObj()
  : schema_type_(OB_MAX_SCHEMA),
    schema_id_(common::OB_INVALID_ID),
    schema_(__null),
    handle_()
  {}
  int assign(const SchemaObj& other)
  {
    int ret = OB_SUCCESS;
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (this->handle_.assign(other.handle_)))),!!0))) {
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 4, "src/share/schema/ob_schema_struct.h", 1614, __FUNCTION__, ret, "fail to assign handle", "placeholder" ); } } } while (false);
      this->schema_type_ = OB_MAX_SCHEMA;

      this->schema_id_ = common::OB_INVALID_ID;
      this->schema_ = __null;
    } else {
      this->schema_type_ = other.schema_type_;

      this->schema_id_ = other.schema_id_;
      this->schema_ = other.schema_;
    }
    return ret;
  }
  ObSchemaType schema_type_;

  uint64_t schema_id_;
  ObSchema *schema_;
  common::ObKVCacheHandle handle_;
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"schema_type", ::oceanbase::common::check_char_array(schema_type_), "schema_id", ::oceanbase::common::check_char_array(schema_id_), "schema", reinterpret_cast<const void*>(schema_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
};

class ObSysVarSchema : public ObSchema
{
  public: int serialize(char *buf, const int64_t buf_len, int64_t &pos) const ; int serialize_(char *buf, const int64_t buf_len, int64_t &pos) const; int deserialize(const char *buf, const int64_t data_len, int64_t &pos) ; int deserialize_(const char *buf, const int64_t data_len, int64_t &pos); int64_t get_serialize_size() const ; int64_t get_serialize_size_() const;; private: const static int64_t UNIS_VERSION = 1;
public:
  ObSysVarSchema() : ObSchema() { reset(); }
  ~ObSysVarSchema() {}
  explicit ObSysVarSchema(common::ObIAllocator *allocator);
  ObSysVarSchema(const ObSysVarSchema &) = delete; ObSysVarSchema &operator=(const ObSysVarSchema &) = delete;
  int assign(const ObSysVarSchema &src_schema);
  virtual bool is_valid() const { return ObSchema::is_valid() && !name_.empty(); }
  void reset();
  int64_t get_convert_size() const;
  bool is_equal_except_value(const ObSysVarSchema &other) const;
  bool is_equal_for_add(const ObSysVarSchema &other) const;


  const common::ObString &get_name() const { return name_; }
  int set_name(const common::ObString &name) { return deep_copy_str(name, name_); }
  common::ObObjType get_data_type() const { return data_type_; }
  void set_data_type(common::ObObjType data_type) { data_type_ = data_type; }
  const common::ObString &get_value() const { return value_; }
  int get_value(common::ObIAllocator *allocator, const common::ObDataTypeCastParams &dtc_params, common::ObObj &value) const;
