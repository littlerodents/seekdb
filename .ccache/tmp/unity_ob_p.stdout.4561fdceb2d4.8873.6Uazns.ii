public:
  ObInterruptibleTaskID() : first_(0), last_(0) {}


  ObInterruptibleTaskID(uint64_t first, uint64_t last = 0) : first_(first), last_(last) {}


  template<class T>
  ObInterruptibleTaskID(const T &t) : first_(0), last_(0)
  {

    (static_cast<void> (0));
