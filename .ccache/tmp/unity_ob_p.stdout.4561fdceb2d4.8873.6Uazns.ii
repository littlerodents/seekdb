int ObPLResolver::check_and_record_stmt_type(ObPLFunctionAST &func,
                                             sql::ObSPIService::ObSPIPrepareResult &prepare_result)
{

  int ret = OB_SUCCESS;
  stmt::StmtType type = prepare_result.type_;
  bool in_tg = resolve_ctx_.session_info_.is_for_trigger_package();
  switch (type) {
    case stmt::T_PREPARE:
    case stmt::T_EXECUTE:
    case stmt::T_DEALLOCATE: {
      if (func.is_function() || in_tg) {
        ret = OB_ER_STMT_NOT_ALLOWED_IN_SF_OR_TRG;
        do { static_assert(__builtin_constant_p(OB_ER_STMT_NOT_ALLOWED_IN_SF_OR_TRG) == 1, "LOG_USER_XX(errcode..)/LOG_DBA_XXX(errcoce) need use const errcode instead of vairable ret"); do { ::oceanbase::common::ObLogger::get_logger().log_user_message(::oceanbase::common::ObLogger::USER_ERROR, OB_ER_STMT_NOT_ALLOWED_IN_SF_OR_TRG, "%s is not allowed in stored function or trigger", "Dynamic SQL"); if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/pl/ob_pl_resolver.cpp", 2755, __FUNCTION__, OB_ER_STMT_NOT_ALLOWED_IN_SF_OR_TRG, "%s is not allowed in stored function or trigger", "Dynamic SQL"); } } while(0); } while(0);
      } else {
        func.set_contain_dynamic_sql();
      }
      break;
    }
    case stmt::T_SELECT:
    case stmt::T_EXPLAIN:
    case stmt::T_SHOW_COLUMNS:
    case stmt::T_SHOW_TABLES:
    case stmt::T_SHOW_DATABASES:
    case stmt::T_SHOW_TABLE_STATUS:
    case stmt::T_SHOW_SERVER_STATUS:
    case stmt::T_SHOW_VARIABLES:
    case stmt::T_SHOW_SCHEMA:
    case stmt::T_SHOW_CREATE_DATABASE:
    case stmt::T_SHOW_CREATE_TABLE:
    case stmt::T_SHOW_CREATE_VIEW:
    case stmt::T_SHOW_WARNINGS:
    case stmt::T_SHOW_ERRORS:
    case stmt::T_SHOW_GRANTS:
    case stmt::T_SHOW_CHARSET:
    case stmt::T_SHOW_COLLATION:
    case stmt::T_SHOW_PARAMETERS:
    case stmt::T_SHOW_INDEXES:
    case stmt::T_SHOW_PROCESSLIST:
    case stmt::T_SHOW_RECYCLEBIN:
    case stmt::T_SHOW_STATUS:
    case stmt::T_SHOW_TRACE:
    case stmt::T_SHOW_ENGINES:
    case stmt::T_SHOW_PROFILE:
    case stmt::T_SHOW_ENGINE:
    case stmt::T_SHOW_OPEN_TABLES:
    case stmt::T_SHOW_PRIVILEGES:
    case stmt::T_SHOW_CREATE_PROCEDURE:
    case stmt::T_SHOW_CREATE_FUNCTION:
    case stmt::T_SHOW_PROCEDURE_STATUS:
    case stmt::T_SHOW_FUNCTION_STATUS:
    case stmt::T_SHOW_CREATE_TRIGGER:
    case stmt::T_SHOW_TRIGGERS:
    case stmt::T_SHOW_CREATE_USER: {
      if (0 == prepare_result.into_exprs_.count()) {
        if (func.is_function() || in_tg) {
          ret = OB_ER_SP_NO_RETSET;
          if (in_tg) {
            do { static_assert(__builtin_constant_p(OB_ER_SP_NO_RETSET) == 1, "LOG_USER_XX(errcode..)/LOG_DBA_XXX(errcoce) need use const errcode instead of vairable ret"); do { ::oceanbase::common::ObLogger::get_logger().log_user_message(::oceanbase::common::ObLogger::USER_ERROR, OB_ER_SP_NO_RETSET, "Not allowed to return a result set from a %s", "trigger"); if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/pl/ob_pl_resolver.cpp", 2800, __FUNCTION__, OB_ER_SP_NO_RETSET, "Not allowed to return a result set from a %s", "trigger"); } } while(0); } while(0);
          } else {
            do { static_assert(__builtin_constant_p(OB_ER_SP_NO_RETSET) == 1, "LOG_USER_XX(errcode..)/LOG_DBA_XXX(errcoce) need use const errcode instead of vairable ret"); do { ::oceanbase::common::ObLogger::get_logger().log_user_message(::oceanbase::common::ObLogger::USER_ERROR, OB_ER_SP_NO_RETSET, "Not allowed to return a result set from a %s", "function"); if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/pl/ob_pl_resolver.cpp", 2802, __FUNCTION__, OB_ER_SP_NO_RETSET, "Not allowed to return a result set from a %s", "function"); } } while(0); } while(0);
          }
        } else {
          func.set_multi_results();
        }
      }
      break;
    }
    default: {
      if (ObStmt::is_ddl_stmt(type, false)
          || ObStmt::is_dcl_stmt(type)
          || ObStmt::is_tcl_stmt(type)) {
        if (func.is_function() || in_tg) {
          ret = OB_ER_COMMIT_NOT_ALLOWED_IN_SF_OR_TRG;
          do { static_assert(__builtin_constant_p(OB_ER_COMMIT_NOT_ALLOWED_IN_SF_OR_TRG) == 1, "LOG_USER_XX(errcode..)/LOG_DBA_XXX(errcoce) need use const errcode instead of vairable ret"); do { ::oceanbase::common::ObLogger::get_logger().log_user_message(::oceanbase::common::ObLogger::USER_ERROR, OB_ER_COMMIT_NOT_ALLOWED_IN_SF_OR_TRG, "Explicit or implicit commit is not allowed in stored function or trigger."); if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/pl/ob_pl_resolver.cpp", 2816, __FUNCTION__, OB_ER_COMMIT_NOT_ALLOWED_IN_SF_OR_TRG, "Explicit or implicit commit is not allowed in stored function or trigger."); } } while(0); } while(0);
        } else {
          func.set_has_commit_or_rollback();
        }
      }
    }
    break;
  }
  return ret;
}

