  template <typename Visitor>
  int visit_ps_session_info(const ObPsStmtId stmt_id,
                          Visitor &visitor)
  {
    int ret = OB_SUCCESS;
    if (__builtin_expect(!!(!ps_session_info_map_.created()),!!0)) {
      ret = OB_HASH_NOT_EXIST;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SQL, ::oceanbase::common::OB_LOG_SQL::M_ENG, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SQL"".""ENG""] ", 4, "src/sql/session/ob_sql_session_info.h", 516, __FUNCTION__, ret, "map not created before insert any element", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ps_session_info_map_.read_atomic<Visitor>(stmt_id, visitor)))),!!0))) {
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SQL, ::oceanbase::common::OB_LOG_SQL::M_ENG, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SQL"".""ENG""] ", 4, "src/sql/session/ob_sql_session_info.h", 518, __FUNCTION__, ret, "get ps session info failed", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(stmt_id)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(stmt_id)))&&>::value>("stmt_id", ::oceanbase::common::check_char_array(stmt_id)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(get_server_sid())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(get_server_sid())))&&>::value>("get_server_sid()", ::oceanbase::common::check_char_array(get_server_sid()))); } } } while (false);
      if (ret == OB_HASH_NOT_EXIST) {
        ret = OB_EER_UNKNOWN_STMT_HANDLER;
      }
    }
    return ret;
  }
  template <typename T>
  int update_ps_session_info_safety(const ObPsStmtId stmt_id, T &update)
  {
    int ret = OB_SUCCESS;
    if (__builtin_expect(!!(!ps_session_info_map_.created()),!!0)) {
      ret = OB_HASH_NOT_EXIST;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SQL, ::oceanbase::common::OB_LOG_SQL::M_ENG, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SQL"".""ENG""] ", 4, "src/sql/session/ob_sql_session_info.h", 531, __FUNCTION__, ret, "map not created before insert any element", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ps_session_info_map_.atomic_refactored<T>(stmt_id, update)))),!!0))) {
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SQL, ::oceanbase::common::OB_LOG_SQL::M_ENG, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SQL"".""ENG""] ", 4, "src/sql/session/ob_sql_session_info.h", 533, __FUNCTION__, ret, "get ps session info failed", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(stmt_id)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(stmt_id)))&&>::value>("stmt_id", ::oceanbase::common::check_char_array(stmt_id)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(get_server_sid())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(get_server_sid())))&&>::value>("get_server_sid()", ::oceanbase::common::check_char_array(get_server_sid()))); } } } while (false);
      if (ret == OB_HASH_NOT_EXIST) {
        ret = OB_EER_UNKNOWN_STMT_HANDLER;
