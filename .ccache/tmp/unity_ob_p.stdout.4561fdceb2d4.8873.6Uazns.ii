  ((void)(buf));
  ((void)(buf_end));
  return 0;
}

template<>
inline int ob_charset_decode_unicode<CHARSET_BINARY>(
    const unsigned char *s,
    const unsigned char *e,
    ulong &unicode_value)
{
  if (s >= e) {
    unicode_value = 0;
    return -101;
  } else {
    unicode_value = *s;
    return 1;
  }
}

template<>
inline int ob_charset_decode_unicode<CHARSET_UTF8MB4>(
    const unsigned char *s,
    const unsigned char *e,
    ulong &unicode_value)
{
