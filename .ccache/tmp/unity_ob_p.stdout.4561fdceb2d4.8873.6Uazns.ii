int ObPLDataType::obj_is_null(ObObj& obj, bool &is_null)
{
  int ret = OB_SUCCESS;

  is_null = false;

  if (obj.is_null()) {
    is_null = true;
  } else if (obj.is_ext()) {
    uint64_t ext = obj.get_ext();
    switch (obj.get_meta().get_extend_type()) {
      case pl::PL_RECORD_TYPE: {
        pl::ObPLRecord *rec = reinterpret_cast<pl::ObPLRecord *>(ext);
        is_null = rec->is_null();
        break;
      }
      default: {
        ret = OB_NOT_SUPPORTED;
        do { static_assert(__builtin_constant_p(OB_NOT_SUPPORTED) == 1, "LOG_USER_XX(errcode..)/LOG_DBA_XXX(errcoce) need use const errcode instead of vairable ret"); do { ::oceanbase::common::ObLogger::get_logger().log_user_message(::oceanbase::common::ObLogger::USER_ERROR, OB_NOT_SUPPORTED, "%s not supported", "check complex is null"); if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/pl/ob_pl_type.cpp", 637, __FUNCTION__, OB_NOT_SUPPORTED, "%s not supported", "check complex is null"); } } while(0); } while(0);
        break;
      }
    }
  } else {
    ret = OB_ERR_UNEXPECTED;
  }
  return ret;
}

