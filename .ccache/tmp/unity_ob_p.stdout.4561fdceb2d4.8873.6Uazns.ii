  virtual int judge_greater_or_less(blocksstable::ObStorageDatum &datum,
                                   const sql::ObBitVector &skip_bit,
                                   const bool is_greater,
                                   bool &ret_val);
  inline __attribute__((always_inline)) bool is_monotonic() const { return filter_.is_monotonic(); }
  inline __attribute__((always_inline)) PushdownFilterMonotonicity get_monotonicity() const { return filter_.mono_; }
private:
  int eval_exprs_batch(ObBitVector &skip, const int64_t bsize);

private:
