    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && match
        && cur_state_version.body_merge_version_ != state_version.body_merge_version_
        && (__builtin_expect(!!(__null != (body)),!!1))) {
      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ObPLDependencyUtil::check_dep_schema(schema_guard, body->get_dependency_table(), cur_state_version.body_merge_version_, match)))),!!0))) {



      }
    }
  }

  return ret;
}

}
