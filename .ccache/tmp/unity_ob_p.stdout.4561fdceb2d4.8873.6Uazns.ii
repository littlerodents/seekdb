  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"into", ::oceanbase::common::check_char_array(into_), "not_null_flags", ::oceanbase::common::check_char_array(not_null_flags_), "pl_integer_ranges", ::oceanbase::common::check_char_array(pl_integer_ranges_), "data_type", ::oceanbase::common::check_char_array(data_type_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };

