      } else {
        if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) { const_cast<ObPLBlockNS &>(routine_ast.get_body()->get_namespace()).set_external_ns(__null); };
