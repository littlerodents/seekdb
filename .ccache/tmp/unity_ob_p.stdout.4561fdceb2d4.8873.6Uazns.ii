struct SampleInfo
{
  SampleInfo() { reset(); }
  enum SampleMethod
  {
    NO_SAMPLE = 0,
    ROW_SAMPLE = 1,
    BLOCK_SAMPLE = 2,
    HYBRID_SAMPLE = 3,
    DDL_BLOCK_SAMPLE = 4
  };
  enum SampleScope
  {
    SAMPLE_ALL_DATA = 0,
    SAMPLE_BASE_DATA = 1,
    SAMPLE_INCR_DATA = 2
  };
  inline __attribute__((always_inline)) bool is_trival_sample() const { return ROW_SAMPLE == method_; }
  inline __attribute__((always_inline)) bool is_hybrid_sample() const { return HYBRID_SAMPLE == method_; }
  inline __attribute__((always_inline)) bool is_block_sample() const { return BLOCK_SAMPLE == method_; }
  inline __attribute__((always_inline)) bool is_no_sample() const { return NO_SAMPLE == method_; }
  inline __attribute__((always_inline)) bool is_row_sample() const { return is_trival_sample() || is_hybrid_sample(); }
  inline __attribute__((always_inline)) bool is_ddl_block_sample() const { return DDL_BLOCK_SAMPLE == method_; }
  uint64_t hash(uint64_t seed) const;
  void reset()
  {
    table_id_ = OB_INVALID_ID;
    method_ = NO_SAMPLE;
    scope_ = SAMPLE_ALL_DATA;
    percent_ = 100;
    seed_ = -1;
    force_block_ = false;
  }

  bool same_as(const SampleInfo &oth) const {
    return table_id_ == oth.table_id_
           && method_ == oth.method_
           && scope_ == oth.scope_
           && percent_ == oth.percent_
           && seed_ == oth.seed_
           && force_block_ == oth.force_block_
           && seed_ != -1;
  }

  uint64_t table_id_;
  SampleMethod method_;
  SampleScope scope_;
  double percent_;
  int64_t seed_;
  bool force_block_;
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"method", ::oceanbase::common::check_char_array(method_), "percent", ::oceanbase::common::check_char_array(percent_), "seed", ::oceanbase::common::check_char_array(seed_), "table_id", ::oceanbase::common::check_char_array(table_id_), "scope", ::oceanbase::common::check_char_array(scope_), "force_block", ::oceanbase::common::check_char_array(force_block_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
  public: int serialize(char *buf, const int64_t buf_len, int64_t &pos) const ; int serialize_(char *buf, const int64_t buf_len, int64_t &pos) const; int deserialize(const char *buf, const int64_t data_len, int64_t &pos) ; int deserialize_(const char *buf, const int64_t data_len, int64_t &pos); int64_t get_serialize_size() const ; int64_t get_serialize_size_() const;; private: const static int64_t UNIS_VERSION = 1;
};

