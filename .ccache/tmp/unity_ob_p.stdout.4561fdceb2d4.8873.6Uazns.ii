                          resolve_ctx_.params_.pl_engine_,
                          resolve_ctx_.params_.srs_provider_,
                          resolve_ctx_.params_.lob_read_service_, expr_factory_,
                          &current_block_->get_namespace(), resolve_ctx_.is_prepare_protocol_,
                          false , false ,
