    BUILDER_MISSING_EXPECTED_SIBLING_EDGES = 301,



    BUILDER_UNEXPECTED_DEGENERATE_EDGE = 302,



    BUILDER_EDGES_DO_NOT_FORM_LOOPS = 303,


    BUILDER_EDGES_DO_NOT_FORM_POLYLINE = 304,





    BUILDER_IS_FULL_PREDICATE_NOT_SPECIFIED = 305,
