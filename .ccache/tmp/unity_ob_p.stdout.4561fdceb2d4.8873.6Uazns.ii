inline void SanitizerPoisonMemoryRegion(const void* m, size_t s) {






  (void)m;
  (void)s;
}

inline void SanitizerUnpoisonMemoryRegion(const void* m, size_t s) {






  (void)m;
  (void)s;
}

template <typename T>
