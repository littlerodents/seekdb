struct ObOptTableStatHandle
{
  const ObOptTableStat *stat_;
  ObOptTableStatCache *cache_;
  ObKVCacheHandle handle_;

  ObOptTableStatHandle()
    : stat_(nullptr), cache_(nullptr), handle_() {}
