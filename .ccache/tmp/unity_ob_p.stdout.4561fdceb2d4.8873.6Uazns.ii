class ObUDFParamDesc
{
public:
  enum OutType {
    NOT_OUT,
    OBJ_ACCESS_OUT,
    LOCAL_OUT,
    PACKAGE_VAR_OUT,
    SUBPROGRAM_VAR_OUT,
    OBJ_ACCESS_INOUT
  };

  OutType type_;
  int64_t id1_;
  int64_t id2_;
  int64_t id3_;

  ObUDFParamDesc()
    : type_(OutType::NOT_OUT), id1_(OB_INVALID_ID), id2_(OB_INVALID_ID), id3_(OB_INVALID_ID) {}
  ObUDFParamDesc(OutType type,
                 int64_t id1 = OB_INVALID_ID,
                 int64_t id2 = OB_INVALID_ID,
                 int64_t id3 = OB_INVALID_ID)
    : type_(type), id1_(id1), id2_(id2), id3_(id3) {}
  inline __attribute__((always_inline)) bool operator==(const ObUDFParamDesc &other) const {
    return type_ == other.type_ && id1_ == other.id1_ &&
           id2_ == other.id2_ && id3_ == other.id3_; }
  inline __attribute__((always_inline)) bool is_out() const { return type_ != NOT_OUT; }
  inline __attribute__((always_inline)) bool is_local_out() const { return OutType::LOCAL_OUT == type_; }
  inline __attribute__((always_inline)) bool is_package_var_out() const { return OutType::PACKAGE_VAR_OUT == type_; }
  inline __attribute__((always_inline)) bool is_subprogram_var_out() const { return OutType::SUBPROGRAM_VAR_OUT == type_; }
  inline __attribute__((always_inline)) bool is_obj_access_out() const { return OutType::OBJ_ACCESS_OUT == type_ || OutType::OBJ_ACCESS_INOUT == type_; }
  inline __attribute__((always_inline)) bool is_obj_access_pure_out() const { return OutType::OBJ_ACCESS_OUT == type_; }

  inline __attribute__((always_inline)) int64_t get_index() const { return id1_; }
  inline __attribute__((always_inline)) int64_t get_subprogram_id() const { return id2_; }
  inline __attribute__((always_inline)) int64_t get_package_id() const { return id3_; }

  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"type", ::oceanbase::common::check_char_array(type_), "id1", ::oceanbase::common::check_char_array(id1_), "id2", ::oceanbase::common::check_char_array(id2_), "id3", ::oceanbase::common::check_char_array(id3_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
  int serialize(char* buf, const int64_t buf_len, int64_t& pos) const; int deserialize(const char* buf, const int64_t data_len, int64_t& pos); int64_t get_serialize_size(void) const;
};
