          } else {
            T *obj = creator(ptr);
            if (__builtin_expect(!!(false == range.add_first(obj)),!!0)) {
              ret = OB_ERR_UNEXPECTED;
              do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 366, __FUNCTION__, ret, "fail to add obj to range list head", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
            } else {
              if (blk->is_empty()) {
                nonempty_blocks_.remove(blk);
                if (__builtin_expect(!!(false == empty_blocks_.add_last(blk)),!!0)) {
                  ret = OB_ERR_UNEXPECTED;
                  do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_global_factory.h", 372, __FUNCTION__, ret, "fail to add block to empty block list tail", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
