  inline __attribute__((always_inline)) common::ObObjType get_calc_type() const { return calc_type_.get_type(); }
  inline __attribute__((always_inline)) common::ObObjTypeClass get_calc_type_class() const
  {
    return calc_type_.get_type_class();
  }

  inline __attribute__((always_inline)) void set_calc_collation_level(common::ObCollationLevel cs_level)
  {
    calc_type_.set_collation_level(cs_level);
  }
  inline __attribute__((always_inline)) void set_calc_collation_type(common::ObCollationType cs_type)
  {
    calc_type_.set_collation_type(cs_type);
  }
  inline __attribute__((always_inline)) void set_calc_collation(const ObExprResType &type)
  {
    calc_type_.set_collation_type(type.get_calc_collation_type());
    calc_type_.set_collation_level(type.get_calc_collation_level());
  }
  inline __attribute__((always_inline)) common::ObCollationType get_calc_collation_type() const
  {
    return calc_type_.get_collation_type();
  }
  inline __attribute__((always_inline)) common::ObCollationLevel get_calc_collation_level() const
  {
    return calc_type_.get_collation_level();
  }

  inline __attribute__((always_inline)) void set_param(const common::ObObj &param) { param_ = param; }
  inline __attribute__((always_inline)) const common::ObObj &get_param() const { return param_; }
  inline __attribute__((always_inline)) bool is_column() const { return !is_literal(); }
  inline __attribute__((always_inline)) bool is_literal() const { return get_param().get_type() == get_type()
                                             && get_param().get_collation_type() == get_collation_type(); }
  void add_decimal_int_cast_mode(uint64_t cm)
  {
    cast_mode_ = cast_mode_ | (cm & ((1ULL << 18) |
                                     (1ULL << 19) |
                                     (1ULL << 21)));
  }
  uint64_t get_cast_mode() const { return cast_mode_; }
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"%s", ("RawExprResType")); ::oceanbase::common::databuff_printf(buf, buf_len, pos,":"); pos += ObRawExprResType::to_string(buf + pos, buf_len - pos); ::oceanbase::common::databuff_printf(buf, buf_len, pos,", "); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"calc_type", calc_type_, "calc_accuracy", ::oceanbase::common::check_char_array(calc_accuracy_), "param", ::oceanbase::common::check_char_array(param_), "cast_mode", ::oceanbase::common::check_char_array(cast_mode_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };





protected:
  ObExprCalcType calc_type_;
  common::ObAccuracy calc_accuracy_;
  common::ObObj param_;
  uint64_t cast_mode_;
};

