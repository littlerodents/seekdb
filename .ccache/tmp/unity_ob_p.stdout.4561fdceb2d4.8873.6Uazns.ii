inline CordRepRing::index_type CordRepRing::retreat(index_type index,
                                                    index_type n) const {
  (static_cast<void> (0));
  return index >= n ? index - n : capacity_ - n + index;
}

inline absl::string_view CordRepRing::entry_data(index_type index) const {
