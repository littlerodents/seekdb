        if (__builtin_expect(!!(idx <= 0),!!0)) {
          ret = OB_ERROR_OUT_OF_RANGE;
          do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 4, "src/oblib/common/wide_integer/ob_wide_integer_impl.h", 1208, __FUNCTION__, ret, "out of number range", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
        } else {
          ObWideInteger<Bits, unsigned>::_impl::template divide<IgnoreOverFlow>(numerator, nmb_base,
                                                                                quo, rem);
          digits[--idx] = (uint32_t)rem.items_[0];
          numerator = quo;
          calc_exp++;
        }
      }
      if((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
        exp = 0x7F & (uint8_t)(number::ObNumber::EXP_ZERO + calc_exp);
        digit_len = (uint8_t)(number::ObNumber::MAX_STORE_LEN - idx);
