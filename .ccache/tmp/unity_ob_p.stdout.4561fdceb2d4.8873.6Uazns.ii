enum ObWhiteFilterOperatorType
{
  WHITE_OP_EQ = 0,
  WHITE_OP_LE,
  WHITE_OP_LT,
  WHITE_OP_GE,
  WHITE_OP_GT,
  WHITE_OP_NE,
  WHITE_OP_BT,
  WHITE_OP_IN,
  WHITE_OP_NU,
  WHITE_OP_NN,

  WHITE_OP_MAX,
};
class ObPushdownWhiteFilterNode : public ObPushdownFilterNode
