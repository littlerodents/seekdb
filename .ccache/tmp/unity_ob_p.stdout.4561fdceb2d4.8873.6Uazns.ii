}


int ObPLBlockNS::find_sub_attr_by_name(const ObUserDefinedType &user_type,
                                       const ObObjAccessIdent &access_ident,
                                       ObSQLSessionInfo &session_info,
                                       ObRawExprFactory &expr_factory,
                                       ObPLAstUnit &func,
