      }
      length -= 2;
      buf[length] = '[';
      buf[length + 1] = 'T';
      buf[length + 2] = ']';
      ret = buf + length;
    }




  }
  return ret;
}

template <class T, size_t tag>
ObDITls<T, tag>::~ObDITls()
