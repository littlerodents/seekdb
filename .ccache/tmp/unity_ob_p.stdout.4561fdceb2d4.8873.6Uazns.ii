      if (ObPLBlockNS::BlockType::BLOCK_PACKAGE_BODY
            == current_block_->get_namespace().get_block_type()
          && (__builtin_expect(!!(__null != (external_ns_.get_parent_ns())),!!1))
          && ObPLBlockNS::BlockType::BLOCK_PACKAGE_SPEC
              == external_ns_.get_parent_ns()->get_block_type()) {
        do { if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) { if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (external_ns_.get_parent_ns()->get_routine_info(&routine_info, parent_routine_info)))),!!0))) { do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_PL, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""PL""] ", 4, "src/pl/ob_pl_resolver.cpp", 10550, __FUNCTION__, ret, "fail to exec ""external_ns_.get_parent_ns()->get_routine_info(&routine_info, parent_routine_info)", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false); } } } while(0);
      }
