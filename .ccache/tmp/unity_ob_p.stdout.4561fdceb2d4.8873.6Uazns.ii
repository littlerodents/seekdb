  inline void set_all_close() { data_ = INCLUSIVE_START | INCLUSIVE_END; }
  inline int8_t get_data() const { return data_; }
  inline void set_inclusive(const int8_t data)
  {
    data_ &= MIN_VALUE + MAX_VALUE;
