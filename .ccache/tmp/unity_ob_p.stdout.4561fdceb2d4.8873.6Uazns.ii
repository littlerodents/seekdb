    table = new_table;
    num_buckets = new_num_buckets;
    (static_cast<void> (0));
    num_elements -= num_deleted;
    num_deleted = 0;
    settings.reset_thresholds(bucket_count());
    settings.inc_num_ht_copies();
  }


