  } else if ((__builtin_expect(!!(__null != (src.ptr())),!!1)) && 0 < src_len) {
    int copy_len = src_len > len ? len : src_len;
    memcpy(ptr, src.ptr(), copy_len);
    if (len > copy_len) {
      memset(ptr + copy_len, padding, len - copy_len);
    }
    if (c_style) {
      ptr[len] = 0;
    }
    dst.assign_ptr(ptr, len);
