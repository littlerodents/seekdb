                               bool is_trans_plan,
                               bool& is_valid);
  int update_trans_ctx(ObDMLStmt *stmt);
  int update_max_table_num(ObDMLStmt *stmt);

  bool skip_move_trans_loc() const
  {
    return TEMP_TABLE_OPTIMIZATION == transformer_type_
           || POST_PROCESS == transformer_type_
           || PRE_PROCESS == transformer_type_
           || AGGR_SUBQUERY == transformer_type_;
