    bool operator()(const T *left, const T *right) const
    {
      return left->*member_ts != right->*member_ts ? left->*member_ts > right->*member_ts
             : (left->*list).get_size() != (right->*list).get_size()
                 ? (left->*list).get_size() < (right->*list).get_size()
