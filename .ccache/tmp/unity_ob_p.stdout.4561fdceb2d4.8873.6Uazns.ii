  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) { if (!((__builtin_expect(!!(__null != (block_ns = &(caller->get_namespace()))),!!1)))) { if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) { ret = OB_ERR_UNEXPECTED; } do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_PL, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""PL""] ", 4, "src/pl/ob_pl_resolver.cpp", 7391, __FUNCTION__, ret, "invalid arguments", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype((__builtin_expect(!!(__null != (block_ns = &(caller->get_namespace()))),!!1))), std::is_rvalue_reference<decltype(((__builtin_expect(!!(__null != (block_ns = &(caller->get_namespace()))),!!1))))&&>::value>("(__builtin_expect(!!(__null != (block_ns = &(caller->get_namespace()))),!!1))", (__builtin_expect(!!(__null != (block_ns = &(caller->get_namespace()))),!!1)))); } } } while (false); } };
