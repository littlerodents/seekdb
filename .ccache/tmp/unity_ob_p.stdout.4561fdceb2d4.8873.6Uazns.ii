};

struct ObBatchRescanCtl
{
  ObBatchRescanCtl() : cur_idx_(0), params_(), param_version_()
  {
  }

  void reset()
  {
    cur_idx_ = 0;
    params_.reset();
    param_version_ += 1;
  }

  void reuse()
  {
    cur_idx_ = 0;
    params_.reuse();
    param_version_ += 1;
  }

  int64_t cur_idx_;
  ObBatchRescanParams params_;

  int64_t param_version_;
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"cur_idx", ::oceanbase::common::check_char_array(cur_idx_), "params", ::oceanbase::common::check_char_array(params_), "param_version", ::oceanbase::common::check_char_array(param_version_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
};



