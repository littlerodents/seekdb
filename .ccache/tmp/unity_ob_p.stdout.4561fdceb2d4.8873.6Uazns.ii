    Node *node = buckets_[pos];
    while (__null != node) {
      if (node->pair_.first == key) {
        value = node->pair_.second;
        ret = common::OB_SUCCESS;
        break;
      } else {
        node = node->next_;
      }
    }
  }
  return ret;
}

