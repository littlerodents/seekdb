struct ParseResult {

    typedef bool (ParseResult::*BooleanType)() const;
public:

    ParseResult() : code_(kParseErrorNone), offset_(0) {}

    ParseResult(ParseErrorCode code, size_t offset) : code_(code), offset_(offset) {}


