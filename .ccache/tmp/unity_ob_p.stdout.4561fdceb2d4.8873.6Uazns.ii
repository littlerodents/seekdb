struct MemoryStream {
    typedef char Ch;

    MemoryStream(const Ch *src, size_t size) : src_(src), begin_(src), end_(src + size), size_(size) {}

    Ch Peek() const { return __builtin_expect(!!(src_ == end_), 0) ? '\0' : *src_; }
    Ch Take() { return __builtin_expect(!!(src_ == end_), 0) ? '\0' : *src_++; }
    size_t Tell() const { return static_cast<size_t>(src_ - begin_); }

    Ch* PutBegin() { (static_cast<void> (0)); return 0; }
    void Put(Ch) { (static_cast<void> (0)); }
    void Flush() { (static_cast<void> (0)); }
    size_t PutEnd(Ch*) { (static_cast<void> (0)); return 0; }


    const Ch* Peek4() const {
        return Tell() + 4 <= size_ ? src_ : 0;
    }

    const Ch* src_;
    const Ch* begin_;
    const Ch* end_;
    size_t size_;
};

