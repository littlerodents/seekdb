    ::oceanbase::common::databuff_printf(buf, buf_len, pos,"[");
    int64_t num = num_members();
    int64_t count = 0;
    for (int64_t i = 0; i < bit_count(); i++) {
      if (has_member(i)) {
        if (count != 0 && count < num) {
