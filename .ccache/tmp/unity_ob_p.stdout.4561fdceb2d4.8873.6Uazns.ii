inline const char* tp_basename(const char* path)
{
  const char* ret = (__builtin_expect(!!(__null == (path)),!!0)) ? __null : strrchr(path, '/');
  return (__null == ret) ? path: ++ret;
}

inline const char* refine_tp_key(const char* s1, const char* s2, const char* s3)
{
  constexpr int64_t BUFFER_SIZE = 256;
  typedef struct {
    char buffer_[BUFFER_SIZE];
  } BUFFER;
  thread_local BUFFER co_buffer;
  char *buffer = (&co_buffer)->buffer_;
  const char *cret = nullptr;
  if ((__builtin_expect(!!(__null == (s1)),!!0)) || (__builtin_expect(!!(__null == (s2)),!!0)) || (__builtin_expect(!!(__null == (s3)),!!0))) {
  } else {
    s1 = tp_basename(s1);
    snprintf(buffer, BUFFER_SIZE, "%s:%s:%s", s1, s2, s3);
    cret = buffer;
  }
  return cret;
}

template<const int err>
int tp_const_error()
{
  return err;
