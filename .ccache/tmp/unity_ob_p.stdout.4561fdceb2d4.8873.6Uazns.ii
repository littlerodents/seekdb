inline bool ObSQLSessionInfo::is_terminate(int &ret) const
{
  bool bret = false;
  if (QUERY_KILLED == get_session_state()) {
    bret = true;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SQL, ::oceanbase::common::OB_LOG_SQL::M_ENG, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SQL"".""ENG""] ", 4, "src/sql/session/ob_sql_session_info.h", 1043, __FUNCTION__, ret, "query interrupted session", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(get_current_query_string()), std::is_rvalue_reference<decltype((get_current_query_string()))&&>::value>("query", get_current_query_string()) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(get_server_sid()), std::is_rvalue_reference<decltype((get_server_sid()))&&>::value>("key", get_server_sid())); } } } while (false);


    ret = common::OB_ERR_QUERY_INTERRUPTED;
  } else if (QUERY_DEADLOCKED == get_session_state()) {
    bret = true;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SQL, ::oceanbase::common::OB_LOG_SQL::M_ENG, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""SQL"".""ENG""] ", 3, "src/sql/session/ob_sql_session_info.h", 1049, __FUNCTION__, ret, "query deadlocked", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(get_current_query_string()), std::is_rvalue_reference<decltype((get_current_query_string()))&&>::value>("query", get_current_query_string()) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(get_server_sid()), std::is_rvalue_reference<decltype((get_server_sid()))&&>::value>("key", get_server_sid())); } } } while (false);


    ret = common::OB_DEAD_LOCK;
  } else if (SESSION_KILLED == get_session_state()) {
    bret = true;
    ret = common::OB_ERR_SESSION_INTERRUPTED;
  }
  return bret;
}


