}

void ExecCtxBak::restore(sql::ObExecContext &ctx)
{

  ctx.phy_plan_ctx_ = phy_plan_ctx_; ctx.expr_op_ctx_store_ = expr_op_ctx_store_; ctx.expr_op_size_ = expr_op_size_; ctx.has_non_trivial_expr_op_ctx_ = has_non_trivial_expr_op_ctx_; ctx.frames_ = frames_; ctx.frame_cnt_ = frame_cnt_; ctx.pl_expr_allocator_ = pl_expr_allocator_; ctx.resource_limit_calculator_ = resource_limit_calculator_;

}

