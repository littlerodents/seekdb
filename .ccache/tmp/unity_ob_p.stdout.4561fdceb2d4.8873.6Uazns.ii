class ObGlobalAvglenEval
{
public:
  ObGlobalAvglenEval() : global_avglen_(0), part_cnt_(0)
  {}

  void add(int64_t avg_len)
  {
    global_avglen_ += avg_len;
    ++part_cnt_;
  }

  int64_t get() const
  {
    return part_cnt_ > 0 ? global_avglen_ / part_cnt_ : 0;
  }

private:
  int64_t global_avglen_;
  int64_t part_cnt_;
};

