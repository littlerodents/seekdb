template <class T>
int ObSchemaUtils::alloc_schema(common::ObIAllocator &allocator,
                                const T &schema,
                                T * &allocated_schema)
{
  int ret = common::OB_SUCCESS;
  allocated_schema = __null;
  void *buf = __null;
