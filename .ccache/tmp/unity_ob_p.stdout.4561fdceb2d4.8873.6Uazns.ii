constexpr static inline uint64_t
cal_version(const uint64_t major, const uint64_t minor, const uint64_t major_patch, const uint64_t minor_patch)
{
  return (((major) << 32) + ((minor) << 16) + ((major_patch) << 8) + ((minor_patch)));
