template <typename T>
inline int ObExprOperatorFactory::alloc(ObExprOperatorType type, T *&phy_op)
{
  int ret = common::OB_SUCCESS;
  void *ptr = __null;
  if ((__builtin_expect(!!(__null == (ptr = alloc_.alloc(sizeof(T)))),!!0))) {
    ret = common::OB_ALLOCATE_MEMORY_FAILED;
    do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::OB_PRINT("", 3, "src/sql/engine/expr/ob_expr_operator_factory.h", 70, __FUNCTION__, ret, "fail to alloc expr_op", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(type)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(type)))&&>::value>("type", ::oceanbase::common::check_char_array(type))); } } } while (false);
  } else {
    phy_op = new(ptr) T();
    phy_op->set_expr_type(type);
  }
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && __null != next_expr_id_) {
    phy_op->set_expr_id((*next_expr_id_)++);
  }
  return ret;
}

template <typename T>
inline int ObExprOperatorFactory::create_fast_expr(ObExprOperatorType type, T *&fast_op)
{
  int ret = common::OB_SUCCESS;
  ObFastExprOperator *op = __null;
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (alloc_fast_expr(type, op)))),!!1))) {
    fast_op = static_cast<T *>(op);
  }
  return ret;
}
}
