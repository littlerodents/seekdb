template <class T>
static T *copy_stat_item(ObIAllocator &allocator, const T &src)
{
  T *ret = __null;
  void *ptr = allocator.alloc(sizeof(T));
  if (__null != ptr) {
    ret = new (ptr) T() ;
    *ret = src;
  }
  return ret;
}

