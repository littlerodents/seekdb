{
  bool bret = false;
  meta_tid = OB_INVALID_ID;
  piece_tid = OB_INVALID_ID;
  if (OB_ALL_CORE_TABLE_TID == tid) {

  } else if (is_system_table(tid)) {
    bret = true;
    meta_tid = tid + OB_MIN_SYS_LOB_META_TABLE_ID;
    piece_tid = tid + OB_MIN_SYS_LOB_PIECE_TABLE_ID;
  }
  return bret;
}

