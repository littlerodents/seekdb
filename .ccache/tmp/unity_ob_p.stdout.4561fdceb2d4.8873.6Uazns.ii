class ObOptColumnStatHandle
{
public:
  friend class ObOptColumnStatCache;
  ObOptColumnStatHandle() : stat_(nullptr), cache_(nullptr) {}
  ~ObOptColumnStatHandle() { stat_ = nullptr; cache_ = nullptr; }
  int assign(const ObOptColumnStatHandle& other)
  {
    int ret = OB_SUCCESS;
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (handle_.assign(other.handle_)))),!!0))) {
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 4, "src/sql/optimizer/stat/ob_opt_column_stat_cache.h", 65, __FUNCTION__, ret, "fail to assign handle", "placeholder" ); } } } while (false);
      this->stat_ = nullptr;
      this->cache_ = nullptr;
    } else {
      this->stat_ = other.stat_;
      this->cache_ = other.cache_;
    }
    return ret;
  }
  void move_from(ObOptColumnStatHandle& other)
  {
    this->stat_ = other.stat_;
    this->cache_ = other.cache_;
    this->handle_.move_from(other.handle_);
    other.reset();
  }
  void reset() { stat_ = nullptr; cache_ = nullptr; handle_.reset(); }
  const ObOptColumnStat *stat_;
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"stat_", ::oceanbase::common::check_char_array(stat_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
private:
  ObOptColumnStatCache *cache_;
  ObKVCacheHandle handle_;
};

}
