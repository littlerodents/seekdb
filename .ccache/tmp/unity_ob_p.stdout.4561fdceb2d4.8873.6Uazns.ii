    return current_flow().ref_context_;
  }
  Flow &parent()
  {
    abort_unless(prev_ != nullptr);
    return *prev_;
  }
private:
  static Flow *&g_flow()
  {
    thread_local Flow* g_flow;
    return g_flow;
  }
private:
  MemoryContext ref_context_;
  Flow *prev_;
  Flow *next_;
  bool is_inited_;
};

