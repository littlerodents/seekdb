inline __attribute__((always_inline)) uint64_t ob_popcount64(uint64_t v)
{
  int64_t cnt = 0;





  if (0 != v) {
    v -= ((v >> 1) & 0x5555555555555555UL);
    v = (v & 0x3333333333333333UL) + ((v >> 2) & 0x3333333333333333UL);
    cnt = (((v + (v >> 4)) & 0xF0F0F0F0F0F0F0FUL) * 0x101010101010101UL) >> 56;
  }

  return cnt;
}

