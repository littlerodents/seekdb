    uint64_t size = element_count();
    ObJsonNode *child_node = __null;
    for (uint64_t i = 0; i < size; i++) {
      child_node = node_vector_[i];
      if ((__builtin_expect(!!(__null != (child_node)),!!1))) {
        max_child = max(max_child, child_node->depth());
