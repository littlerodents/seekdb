namespace oceanbase
{
namespace lib
{
class ObCtxAllocator;
struct AChunk;
struct ABlock;
struct ObMemAttr;
class IChunkMgr
{
public:
  virtual AChunk *alloc_chunk(const uint64_t size, const ObMemAttr &attr) = 0;
  virtual void free_chunk(AChunk *chunk, const ObMemAttr &attr) = 0;
};

class IBlockMgr
{
public:
  IBlockMgr() {}
  IBlockMgr(int64_t ctx_id)
    : ctx_id_(ctx_id) {}
  virtual ABlock *alloc_block(uint64_t size, const ObMemAttr &attr) = 0;
  virtual void free_block(ABlock *block) = 0;

  virtual int64_t get_ctx_id() { return ctx_id_; }

  void set_ctx_id(const int64_t ctx_id) { ctx_id_ = ctx_id; }
protected:

  int64_t ctx_id_;
};

class ISetLocker
{
public:
  virtual int lock(const int64_t abs_timeout_us = (9223372036854775807L)) = 0;
  virtual void unlock() = 0;
  virtual bool trylock() = 0;
};

class SetDoNothingLocker : public ISetLocker
{
public:
  int lock(const int64_t abs_timeout_us = (9223372036854775807L)) override { return OB_SUCCESS; }
  void unlock() override {}
  bool trylock() override { return true; }
};

template<typename t_lock>
class SetLocker : public ISetLocker
{
public:
  SetLocker(t_lock &mutex)
    : mutex_(mutex) {}
  int lock(const int64_t abs_timeout_us = (9223372036854775807L)) override
  {
    return mutex_.lock(abs_timeout_us);
  }
  void unlock() override
  {
    mutex_.unlock();
  }
  bool trylock() override
  {
    return 0 == mutex_.trylock();
  }
private:
  t_lock &mutex_;
};

template<typename t_lock>
class SetLockerNoLog : public ISetLocker
{
public:
  SetLockerNoLog(t_lock &mutex)
    : mutex_(mutex), is_disable_(false) {}
  int lock(const int64_t abs_timeout_us = (9223372036854775807L)) override
  {
    int ret = mutex_.lock(abs_timeout_us);
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
      is_disable_ = !::oceanbase::common::ObLogger::get_logger().is_enable_logging();
      ::oceanbase::common::ObLogger::get_logger().set_disable_logging(true);
    }
    return ret;
  }
  void unlock() override
  {
    ::oceanbase::common::ObLogger::get_logger().set_disable_logging(is_disable_);
    mutex_.unlock();
  }
  bool trylock() override
  {
    bool succ = 0 == mutex_.trylock();
    if (succ) {
      is_disable_ = !::oceanbase::common::ObLogger::get_logger().is_enable_logging();
      ::oceanbase::common::ObLogger::get_logger().set_disable_logging(true);
    }
    return succ;
  }
private:
  t_lock &mutex_;
  bool is_disable_;
};

}
}
