template <typename AllocatorT>
int ob_strip_space(AllocatorT &allocator, const ObString &src, ObString &dst)
{
  int ret = OB_SUCCESS;
  const ObString::obstr_size_t src_len_without_blank = src.length_without_blank();
  char *ptr = __null;
  if ((__builtin_expect(!!(__null == (src.ptr())),!!0)) || __builtin_expect(!!(0 >= src_len_without_blank),!!0)) {
    dst.assign(__null, 0);
  } else if (__null == (ptr = static_cast<char *>(allocator.alloc(src_len_without_blank)))) {
    dst.assign(__null, 0);
    ret = OB_ALLOCATE_MEMORY_FAILED;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/string/ob_string.h", 865, __FUNCTION__, ret, "allocate memory failed", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(src_len_without_blank), std::is_rvalue_reference<decltype((src_len_without_blank))&&>::value>("size", src_len_without_blank)); } } } while (false);
