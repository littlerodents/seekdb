    session_info_->set_user_priv_set(old_user_priv_set_);

    session_info_->set_db_priv_set(old_db_priv_set_);
    need_reset_role_id_array_ = false;
    ret = OB_SUCCESS == ret ? tmp_ret : ret;
  }
}

