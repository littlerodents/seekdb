class ObPLGetCursorAttrInfo
{
public:
  ObPLGetCursorAttrInfo() :
    type_(PL_CURSOR_INVALID),
    is_explicit_(false) {}
  inline void set_type(int64_t type)
  {
    switch (type)
    {





      case T_SP_CURSOR_ISOPEN: { type_ = PL_CURSOR_ISOPEN; break; };
      case T_SP_CURSOR_FOUND: { type_ = PL_CURSOR_FOUND; break; };
      case T_SP_CURSOR_NOTFOUND: { type_ = PL_CURSOR_NOTFOUND; break; };
      case T_SP_CURSOR_ROWCOUNT: { type_ = PL_CURSOR_ROWCOUNT; break; };
      default: {
        type_ = PL_CURSOR_INVALID;
      }

    }
  }
  inline bool is_valid() const { return type_ != PL_CURSOR_INVALID; }
  inline void set_is_explicit(bool is_explicit) { is_explicit_ = is_explicit; }
  inline bool is_explicit_cursor() const { return is_explicit_; }
  inline bool is_isopen() const { return PL_CURSOR_ISOPEN == type_; }
  inline bool is_found() const { return PL_CURSOR_FOUND == type_; }
  inline bool is_notfound() const { return PL_CURSOR_NOTFOUND == type_; }
  inline bool is_rowcount() const { return PL_CURSOR_ROWCOUNT == type_; }
  inline int64_t get_type() const { return type_; }

  enum Type
  {
    PL_CURSOR_INVALID,
    PL_CURSOR_ISOPEN,
    PL_CURSOR_FOUND,
    PL_CURSOR_NOTFOUND,
    PL_CURSOR_ROWCOUNT,
  };

  int64_t type_;
  bool is_explicit_;

  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"type", ::oceanbase::common::check_char_array(type_), "is_explicit", ::oceanbase::common::check_char_array(is_explicit_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
