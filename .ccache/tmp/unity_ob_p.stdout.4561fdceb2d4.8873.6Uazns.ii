    }
    pos_ = 0;
    buf_[0] = '\0';
  }

  virtual void set_attr(const ObMemAttr &attr) { ((void)(attr)); }
private:
  char buf_[MAX_RESERVE_SIZE];
  int64_t pos_;
  common::ObArenaAllocator allocator_;
};
