  if (n > 0) {
    memcpy(dest, begin, n * sizeof(value_type));
  }
  return dest + n;
}

template <typename T, typename Allocator>
typename ObVector<T, Allocator>::iterator ObVector<T, Allocator>::find(const_value_type value)
{
