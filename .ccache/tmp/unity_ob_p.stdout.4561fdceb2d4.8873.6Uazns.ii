  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"ObString(name_len_, name_def_)", ::oceanbase::common::check_char_array(ObString(name_len_, name_def_))); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };

private:
