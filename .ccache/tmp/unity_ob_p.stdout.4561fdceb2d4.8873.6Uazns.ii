class ObPLLoop : public ObPLStmt
{
public:
  ObPLLoop(ObPLStmtType type) : ObPLStmt(type), body_(__null) {}
  virtual ~ObPLLoop() {
    if (__null != body_) {
      body_->~ObPLStmtBlock();
      body_ = __null;
