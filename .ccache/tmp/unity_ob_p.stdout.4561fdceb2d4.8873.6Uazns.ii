template <uint32_t LEN>
struct AssignFixedLenDatumValue
{
  static void assign_datum_value(void *dst, const char *src, uint32_t len)
  {
    ((void)(len));
    memcpy(dst, src, LEN);
  }
};

struct AssignNumberDatumValue
{
  static void assign_datum_value(void *dst, const char *src, uint32_t len)
  {
    if (4 == len) {
      memcpy(dst, src, 4);
    } else if (8 == len) {
      memcpy(dst, src, 8);
    } else if (12 == len){
      memcpy(dst, src, 12);
    } else {
      memcpy(dst, src, len);
    }
  }
};

struct AssignDefaultDatumValue
{
  static void assign_datum_value(void *dst, const char *src, uint32_t len)
  {
    memcpy(dst, src, len);
  }
};



