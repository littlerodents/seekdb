    ObExecContext &exec_ctx,
    ObExprJoinFilter::ObExprJoinFilterContext *join_filter_ctx);

private:
  static const int64_t CHECK_TIMES = 127;
private:
  ObExprJoinFilter(const ObExprJoinFilter&); void operator=(const ObExprJoinFilter&);
};

