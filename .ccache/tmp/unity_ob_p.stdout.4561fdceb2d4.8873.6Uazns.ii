            { do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/oblib/lib/hash/ob_hashtable.h", 1316, __FUNCTION__, ret, "hash key failed, ret = %d", ret); } } } while (false); };
          } else {
            int64_t bucket_pos = hash_value % bucket_num_;
