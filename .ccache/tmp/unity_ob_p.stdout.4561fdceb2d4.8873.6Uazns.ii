  struct GenColumnExprInfo {
    GenColumnExprInfo():
      dependent_expr_(__null),
      stmt_(__null),
      table_item_(__null),
      column_name_() {}
    int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"dependent_expr", ::oceanbase::common::check_char_array(dependent_expr_), "stmt", ::oceanbase::common::check_char_array(stmt_), "table_item", ::oceanbase::common::check_char_array(table_item_), "column_name", ::oceanbase::common::check_char_array(column_name_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };





    ObRawExpr* dependent_expr_;
    ObDMLStmt* stmt_;
    TableItem* table_item_;
    common::ObString column_name_;
  };
