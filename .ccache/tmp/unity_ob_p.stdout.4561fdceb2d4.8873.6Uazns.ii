}

template <class T> inline bool
ObMonitor<T>::timed_wait(const ObSysTime& timeout) const
{
  notify_impl(nnotify_);

  const bool rc = cond_.timed_wait_impl(mutex_, timeout);
  nnotify_ = 0;
  return rc;
# 139 "/work/src/oblib/lib/lock/ob_monitor.h"
}

template <class T> inline void
ObMonitor<T>::notify()
{
  if(nnotify_ != -1) {
    ++nnotify_;
  }
}

template <class T> inline void
ObMonitor<T>::notify_all()
{
  nnotify_ = -1;
}


template <class T> inline void
ObMonitor<T>::notify_impl(int nnotify) const
{
  if (nnotify == 0) {
  } else if (nnotify == -1) {
    cond_.broadcast();
  } else {
    while(nnotify > 0) {
      cond_.signal();
      --nnotify;
    }
  }
}
