class SubObjectMgr : public IBlockMgr
{
  friend class ObCtxAllocator;
public:
  SubObjectMgr(ObCtxAllocator &ctx_allocator,
               const bool enable_no_log,
               const uint32_t ablock_size,
               const bool enable_dirty_list,
               IBlockMgr *blk_mgr);
  virtual ~SubObjectMgr() {}
  inline __attribute__((always_inline)) int lock(const int64_t abs_timeout_us = (9223372036854775807L)) { return locker_.lock(abs_timeout_us); }
  inline __attribute__((always_inline)) void unlock() { locker_.unlock(); }
  inline __attribute__((always_inline)) bool trylock() { return locker_.trylock(); }
  inline __attribute__((always_inline)) AObject *alloc_object(uint64_t size, const ObMemAttr &attr)
  {
    return os_.alloc_object(size, attr);
  }
  inline __attribute__((always_inline)) AObject *realloc_object(AObject *obj, const uint64_t size, const ObMemAttr &attr)
  {
    return os_.realloc_object(obj, size, attr);
  }
  void free_object(AObject *object);
  inline __attribute__((always_inline)) ABlock *alloc_block(uint64_t size, const ObMemAttr &attr) override
  {
    return bs_.alloc_block(size, attr);
  }
  void free_block(ABlock *block) override;
  inline __attribute__((always_inline)) int64_t get_hold() { return bs_.get_total_hold(); }
  inline __attribute__((always_inline)) int64_t get_payload() { return bs_.get_total_payload(); }
  inline __attribute__((always_inline)) int64_t get_used() { return bs_.get_total_used(); }
  inline __attribute__((always_inline)) bool check_has_unfree()
  {
    return bs_.check_has_unfree();
  }
  inline __attribute__((always_inline)) bool check_has_unfree(char *first_label, char *first_bt)
  {
    return os_.check_has_unfree(first_label, first_bt);
  }
private:
  ObCtxAllocator &ctx_allocator_;
  lib::ObMutex mutex_;
  SetLocker<decltype(mutex_)> normal_locker_;
  SetLockerNoLog<decltype(mutex_)> no_log_locker_;
  ISetLocker &locker_;
  BlockSet bs_;
  ObjectSet os_;
};

class ObjectMgr final : public IBlockMgr
{
  static const int N = 32;
  static const int64_t ALLOC_LOCK_TIMEOUT_US = 1000;
  friend class SubObjectMgr;
public:
  struct Stat
  {
    int64_t hold_;
    int64_t payload_;
    int64_t used_;
  };
public:
  ObjectMgr(ObCtxAllocator &ctx_allocator,
            bool enable_no_log,
            uint32_t ablock_size,
            int parallel,
            bool enable_dirty_list,
            IBlockMgr *blk_mgr);
  ~ObjectMgr();
  void reset();

  AObject *alloc_object(uint64_t size, const ObMemAttr &attr);
  AObject *realloc_object(
      AObject *obj, const uint64_t size, const ObMemAttr &attr);

  void free_object(AObject *obj);

  ABlock *alloc_block(uint64_t size, const ObMemAttr &attr) override;
  void free_block(ABlock *block) override;

  void print_usage() const;
  Stat get_stat();
  bool check_has_unfree();
  bool check_has_unfree(char *first_label, char *first_bt);
private:
  SubObjectMgr *create_sub_mgr();
  void destroy_sub_mgr(SubObjectMgr *sub_mgr);

public:
  ObCtxAllocator &ctx_allocator_;
  bool enable_no_log_;
  uint32_t ablock_size_;
  int parallel_;
  bool enable_dirty_list_;
  IBlockMgr *blk_mgr_;
  int sub_cnt_;
  SubObjectMgr root_mgr_;
  SubObjectMgr *sub_mgrs_[N];
};
}
