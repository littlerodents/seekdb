      if (__null == new_node) {
        ret = common::OB_ERR_UNEXPECTED;
        do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE""] ", 4, "src/share/cache/ob_cache_utils.h", 313, __FUNCTION__, ret, "pop_free_node return null", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
      } else {
        new_node->pair_.first = key;
        new_node->pair_.second = value;
        new_node->next_ = buckets_[pos];
        buckets_[pos] = new_node;
        ++size_;
