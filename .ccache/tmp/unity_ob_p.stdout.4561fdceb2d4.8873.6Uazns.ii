  enum ObParallelDDLType {
    TRUNCATE_TABLE = 0,
    SET_COMMENT = 1,
    CREATE_INDEX = 2,
    CREATE_VIEW = 3,
    DROP_TABLE = 4,
    MAX_TYPE
  };

  static constexpr uint64_t MASK_SIZE = 2;
  static constexpr uint64_t MASK = 0x03;
