        inout_mode_(0)
  {}

  int64_t to_string(char *buffer, int64_t len) const;
public:
  common::ObString dname_;
  common::ObString tname_;
  common::ObString org_tname_;
  common::ObString cname_;
  common::ObString org_cname_;
  common::ObAccuracy accuracy_;
  EMySQLFieldType type_;
  common::ObString type_owner_;
