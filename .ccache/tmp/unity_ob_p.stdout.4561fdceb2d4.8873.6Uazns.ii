    if (cur_state_version.header_merge_version_ != state_version.header_merge_version_) {
      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ObPLDependencyUtil::check_dep_schema(schema_guard, spec.get_dependency_table(), cur_state_version.header_merge_version_, match)))),!!0))) {



