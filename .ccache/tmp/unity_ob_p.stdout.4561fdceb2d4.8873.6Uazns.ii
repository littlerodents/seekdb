    }
  }
  if (ret != OB_SUCCESS && obj_node != __null) {
    allocator_.free(obj_node);
    obj_node = __null;
    ptr = __null;
  }
  return ret;
}

template<typename T, typename BlockAllocatorT, bool auto_free>
inline void ObObjStore<T, BlockAllocatorT, auto_free>::destroy()
{
  for (auto node = (obj_list_).remove_first(); (true) && __null != node && node != (obj_list_).get_header(); node = (obj_list_).remove_first()) {
    if (node != __null) {
      node->~ObObjNode<T>();
      allocator_.free(node);
      node = __null;
    }
  }
}
}
