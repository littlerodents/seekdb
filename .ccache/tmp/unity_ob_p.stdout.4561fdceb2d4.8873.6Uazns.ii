namespace lib
{
enum AllocFailedReason
{
  UNKNOWN = 0,
  INVALID_ALLOC_SIZE,
  SINGLE_ALLOC_SIZE_OVERFLOW,
  CTX_HOLD_REACH_LIMIT,
  MEMORY_HOLD_REACH_LIMIT,
  SERVER_HOLD_REACH_LIMIT,
  PHYSICAL_MEMORY_EXHAUST,
  ERRSIM_INJECTION
};

struct AllocFailedCtx
{
public:
  int reason_;
  int64_t alloc_size_;
  union
  {
    int errno_;
    struct {
      int64_t ctx_id_;
      int64_t ctx_hold_;
      int64_t ctx_limit_;
    };
    struct {

      int64_t memory_hold_;
      int64_t memory_limit_;
    };
    struct {
      int64_t server_hold_;
      int64_t server_limit_;
    };
  };
  bool need_wash_chunk() const
  {
    return reason_ == lib::PHYSICAL_MEMORY_EXHAUST;

  }
};

char *alloc_failed_msg();

AllocFailedCtx &g_alloc_failed_ctx();
void print_alloc_failed_msg(uint64_t ctx_id,
                            int64_t ctx_hold, int64_t ctx_limit,
                            int64_t allocator_hold, int64_t allocator_limit);

}
