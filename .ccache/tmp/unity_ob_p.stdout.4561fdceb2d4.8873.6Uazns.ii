  inline __attribute__((always_inline)) static common::ObCmpOp get_cmp_op(const ObExprOperatorType type) {





    common::ObCmpOp cmp_op = common::CO_MAX;
    switch (type) {
      case T_FUN_SYS_NULLIF:
      case T_OP_EQ:
      case T_OP_NSEQ:
      case T_OP_SQ_EQ:
      case T_OP_SQ_NSEQ:
      case T_OP_IN: {
        cmp_op = common::CO_EQ;
        break;
      }
      case T_OP_BTW:

      case T_OP_LE:
      case T_OP_SQ_LE: {
        cmp_op = common::CO_LE;
        break;
      }
      case T_OP_NOT_BTW:

      case T_OP_LT:
      case T_OP_SQ_LT: {
        cmp_op = common::CO_LT;
        break;
      }
      case T_OP_GE:
      case T_OP_SQ_GE: {
        cmp_op = common::CO_GE;
        break;
      }
      case T_OP_GT:
      case T_OP_SQ_GT: {
        cmp_op = common::CO_GT;
        break;
      }
      case T_OP_NE:
      case T_OP_SQ_NE: {
        cmp_op = common::CO_NE;
        break;
      }
      case T_FUN_SYS_STRCMP: {
        cmp_op = common::CO_CMP;
      }
      default: {

        break;
      }
    }
    return cmp_op;
  }

  static bool can_cmp_without_cast(ObExprResType type1, ObExprResType type2,
                                   common::ObCmpOp cmp_op);
  static int deduce_decimalint_cmp_calc_type(const bool left_is_const, const bool right_is_const,
                                             const bool need_no_cast,
                                             const ObExprOperatorType expr_type,
                                             ObExprResType &type1, ObExprResType &type2);
protected:
  inline __attribute__((always_inline)) static bool is_expected_cmp_ret(const common::ObCmpOp cmp_op,
                                            const int cmp_ret)
  {
    bool ret_bool = false;
    switch (cmp_ret) {
    case 0: {
      ret_bool = (cmp_op == common::CO_EQ || cmp_op == common::CO_GE || cmp_op == common::CO_LE);
    } break;
    case 1: {
      ret_bool = (cmp_op == common::CO_GT || cmp_op == common::CO_GE || cmp_op == common::CO_NE);
    } break;
    case -1: {
      ret_bool = (cmp_op == common::CO_LT || cmp_op == common::CO_LE || cmp_op == common::CO_NE);
    } break;
    default: {
      ret_bool = false;
    }
    }
    return ret_bool;
  }




  inline __attribute__((always_inline)) static int compare_nocast(common::ObObj &result,
                                      const common::ObObj &obj1,
                                      const common::ObObj &obj2,
                                      const common::ObCompareCtx &cmp_ctx,
                                      common::ObCmpOp cmp_op,
                                      const common::obj_cmp_func cmp_func)
  {
    return common::ObObjCmpFuncs::compare(result, obj1, obj2, cmp_ctx, cmp_op, cmp_func);
  }

    protected :




    common::obj_cmp_func cmp_op_func2_;
};

