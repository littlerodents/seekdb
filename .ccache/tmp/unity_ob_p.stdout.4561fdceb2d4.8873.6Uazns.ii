inline __attribute__((always_inline)) bool is_valid_term(const char *begin, const char *term, const char escape) {
  int64_t escape_num = 0;
  const char *curr = term;
  while (curr > begin && __builtin_expect(!!(*(curr - 1) == escape),!!0)) {
    curr = curr - 1;
    ++escape_num;
  }
  return escape_num == 0 || (escape_num % 2) == 0;
}

