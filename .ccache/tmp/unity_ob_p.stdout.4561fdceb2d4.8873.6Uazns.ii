  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"name", ::oceanbase::common::check_char_array(name_), "type", ::oceanbase::common::check_char_array(type_), "model_name", ::oceanbase::common::check_char_array(model_name_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };


private:
  ObString name_;
  EndpointType::TYPE type_;
  ObString model_name_;
};

