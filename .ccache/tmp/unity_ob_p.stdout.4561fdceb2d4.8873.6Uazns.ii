enum ObHistType
{
  INVALID_TYPE,
  FREQUENCY,
  HEIGHT_BALANCED,
  TOP_FREQUENCY,
  HYBIRD,
};

struct ObHistBucket
{
public:
  ObHistBucket()
    : endpoint_repeat_count_(0), endpoint_num_(-1)
  {}
  ObHistBucket(int64_t repeat_count, int64_t endpoint_num)
