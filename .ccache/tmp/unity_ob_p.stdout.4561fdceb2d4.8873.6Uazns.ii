      } else {
        new(&access_idx)ObObjAccessIdx(*record_type.get_record_member_type(member_index),
            ObObjAccessIdx::IS_CONST, attr_name, *record_type.get_record_member_type(member_index),
            member_index);
      }
    } else {
      ret = OB_ERR_SP_UNDECLARED_VAR;
      do { static_assert(__builtin_constant_p(OB_ERR_SP_UNDECLARED_VAR) == 1, "LOG_USER_XX(errcode..)/LOG_DBA_XXX(errcoce) need use const errcode instead of vairable ret"); do { ::oceanbase::common::ObLogger::get_logger().log_user_message(::oceanbase::common::ObLogger::USER_ERROR, OB_ERR_SP_UNDECLARED_VAR, "Undeclared variable: %.*s", attr_name.length(), attr_name.ptr()); if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/pl/ob_pl_stmt.cpp", 1679, __FUNCTION__, OB_ERR_SP_UNDECLARED_VAR, "Undeclared variable: %.*s", attr_name.length(), attr_name.ptr()); } } while(0); } while(0);
