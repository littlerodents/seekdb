};

enum ObCommonFilterTreeStatus : uint8_t
{
  NONE_FILTER = 0,
  WHITE = 1,
  SINGLE_BLACK = 2,
  MULTI_BLACK = 3,
  MAX_STATUS = 4
};




class ObPushdownFilterExecutor
{
private:
  struct FilterRealTimeStatistics {
    FilterRealTimeStatistics()
    : filter_cost_time_(0)
    , filtered_row_cnt_(0)
    , skip_index_skip_mb_cnt_(0)
    {};

    void reset() {
      filter_cost_time_ = 0;
      filtered_row_cnt_ = 0;
      skip_index_skip_mb_cnt_ = 0;
    }

    inline __attribute__((always_inline)) uint64_t get_filter_cost_time() const {return filter_cost_time_;}
    inline __attribute__((always_inline)) void add_filter_cost_time(uint64_t filter_cost_time) { filter_cost_time_ += filter_cost_time; };
    inline __attribute__((always_inline)) uint64_t get_filtered_row_cnt() {return filtered_row_cnt_; }
    inline __attribute__((always_inline)) void add_filtered_row_cnt(uint64_t filtered_row_cnt) { filtered_row_cnt_ += filtered_row_cnt; };
    inline __attribute__((always_inline)) uint64_t get_skip_index_skip_mb_cnt() { return skip_index_skip_mb_cnt_; };
    inline __attribute__((always_inline)) void add_skip_index_skip_mb_cnt(uint64_t skip_index_skip_mb_cnt) { skip_index_skip_mb_cnt_ += skip_index_skip_mb_cnt; }
    int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"filter_cost_time", ::oceanbase::common::check_char_array(filter_cost_time_), "filtered_row_cnt", ::oceanbase::common::check_char_array(filtered_row_cnt_), "skip_index_skip_mb_cnt", ::oceanbase::common::check_char_array(skip_index_skip_mb_cnt_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };

    uint64_t filter_cost_time_;
    uint64_t filtered_row_cnt_;
    uint64_t skip_index_skip_mb_cnt_;
  };
public:
  ObPushdownFilterExecutor(common::ObIAllocator &alloc,
                           ObPushdownOperator &op,
                           PushdownExecutorType type = PushdownExecutorType::MAX_EXECUTOR_TYPE);
  virtual ~ObPushdownFilterExecutor();


  virtual inline __attribute__((always_inline)) bool is_filter_black_node() const
  {
    return type_ == BLACK_FILTER_EXECUTOR;
  }
  virtual inline __attribute__((always_inline)) bool is_filter_white_node() const
  {
    return type_ == WHITE_FILTER_EXECUTOR || type_ == DYNAMIC_FILTER_EXECUTOR || type_ == SEMISTRUCT_FILTER_EXECUTOR;
  }
  virtual inline __attribute__((always_inline)) bool is_sample_node() const { return type_ == HYBRID_SAMPLE_FILTER_EXECUTOR || type_ == TRIVAL_SAMPLE_FILTER_EXECUTOR; }
  virtual inline __attribute__((always_inline)) bool is_semistruct_filter_node() const { return type_ == SEMISTRUCT_FILTER_EXECUTOR; }
  virtual inline __attribute__((always_inline)) bool is_external_filter_node() const { return type_ == EXTERNAL_FILTER_EXECUTOR; }
  virtual inline __attribute__((always_inline)) bool is_filter_node() const { return is_filter_black_node() || is_filter_white_node() || is_sample_node(); }
  virtual inline __attribute__((always_inline)) bool is_logic_and_node() const { return type_ == AND_FILTER_EXECUTOR; }
  virtual inline __attribute__((always_inline)) bool is_logic_or_node() const { return type_ == OR_FILTER_EXECUTOR; }
  virtual inline __attribute__((always_inline)) bool is_logic_op_node() const { return is_logic_and_node() || is_logic_or_node(); }
  inline __attribute__((always_inline)) bool is_filter_dynamic_node() const { return type_ == DYNAMIC_FILTER_EXECUTOR; }
  virtual inline __attribute__((always_inline)) bool filter_can_continuous_filter() const { return true; }
  int prepare_skip_filter(bool disable_bypass);
  inline __attribute__((always_inline)) bool can_skip_filter(int64_t row) const
  {
    bool fast_skip = false;
    if (__builtin_expect(!!(need_check_row_filter_ && nullptr != filter_bitmap_),!!1)) {
      if (PushdownExecutorType::AND_FILTER_EXECUTOR == type_) {
        fast_skip = !filter_bitmap_->test(row);
      } else if (PushdownExecutorType::OR_FILTER_EXECUTOR == type_) {
        fast_skip = filter_bitmap_->test(row);
      }
    }
    skipped_rows_ += fast_skip;
    return fast_skip;
  }
  inline __attribute__((always_inline)) bool can_skip_filter(int64_t start, int64_t end) const
  {
    bool fast_skip = false;
    if (__builtin_expect(!!(need_check_row_filter_ && nullptr != filter_bitmap_),!!1)) {
      if (PushdownExecutorType::AND_FILTER_EXECUTOR == type_) {
        fast_skip = filter_bitmap_->is_all_false(start, end);
      } else if (PushdownExecutorType::OR_FILTER_EXECUTOR == type_) {
        fast_skip = filter_bitmap_->is_all_true(start, end);
      }
    }
    return fast_skip;
  }
  inline __attribute__((always_inline)) bool need_check_row_filter() const { return need_check_row_filter_; }
  void set_type(PushdownExecutorType type) { type_ = type; }
  inline __attribute__((always_inline)) PushdownExecutorType get_type() const { return type_; }
  inline __attribute__((always_inline)) void set_status(ObCommonFilterTreeStatus filter_tree_status) { filter_tree_status_ = filter_tree_status; }
  inline __attribute__((always_inline)) ObCommonFilterTreeStatus get_status() const { return filter_tree_status_; }
  virtual common::ObIArray<uint64_t> &get_col_ids() = 0;
  inline __attribute__((always_inline)) int64_t get_col_count() const { return n_cols_; }
  inline __attribute__((always_inline)) virtual ObPushdownOperator & get_op() { return op_; }
  inline __attribute__((always_inline)) const common::ObIArray<int32_t> &get_col_offsets() const { return col_offsets_; }
