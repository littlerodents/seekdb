template<typename T>
typename T::size_type ObWkbUtils::sum_sub_size(const T& obj) {
  typename T::size_type s = 0;
  typename T::const_iterator iter = obj.begin();
  typename T::const_iterator ei = obj.end();
  for (; iter != ei; ++iter) {
    s += obj.get_sub_size(iter.operator->());
  }
  return s;
}

