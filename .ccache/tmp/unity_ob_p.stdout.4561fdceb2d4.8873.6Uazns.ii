        if (pl_cursor_map_.size() != 0) {
          ret = OB_ERR_UNEXPECTED;
          do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SQL, ::oceanbase::common::OB_LOG_SQL::M_ENG, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""SQL"".""ENG""] ", 3, "src/sql/session/ob_sql_session_info.h", 309, __FUNCTION__, ret, "session cursor map not empty, cursor leaked", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(pl_cursor_map_.size())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(pl_cursor_map_.size())))&&>::value>("pl_cursor_map_.size()", ::oceanbase::common::check_char_array(pl_cursor_map_.size()))); } } } while (false);
        }
        pl_cursor_map_.reuse();
        pl_non_session_cursor_map_.reuse();
