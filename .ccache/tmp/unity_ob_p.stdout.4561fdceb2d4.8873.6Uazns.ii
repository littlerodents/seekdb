  int init_block_allocator()
  {
    int ret = OB_SUCCESS;
    if (is_buf_allocated()) {
      ret = OB_INIT_TWICE;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SQL, ::oceanbase::common::OB_LOG_SQL::M_RESV, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SQL"".""RESV""] ", 4, "src/sql/resolver/expr/ob_raw_expr.h", 1006, __FUNCTION__, ret, "init twice", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
