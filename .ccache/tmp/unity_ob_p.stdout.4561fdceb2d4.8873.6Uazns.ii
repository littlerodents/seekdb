inline bool ObSimpleTableSchemaV2::is_no_need_rebuild_index() const
{
  return (is_built_in_index() && !is_vec_index_snapshot_data_type()) || is_vec_delta_buffer_type() || is_hybrid_vec_index_log_type();
}

