namespace oceanbase
{
namespace common
{

int ObCachedGeoLinestring::init()
{
  int ret = OB_SUCCESS;
  if (!is_inited()) {
    ObGeoSegmentCollectVisitor seg_visitor(&line_segments_);
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ObCachedGeomBase::init()))),!!0))) {
    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (get_cached_geom()->do_visit(seg_visitor)))),!!0))) {
    } else if ((__builtin_expect(!!(__null == (lAnalyzer_)),!!0))) {
      ObLineIntersectionAnalyzer *buf = static_cast<ObLineIntersectionAnalyzer *>(allocator_->alloc(sizeof(ObLineIntersectionAnalyzer)));
      if ((__builtin_expect(!!(__null == (buf)),!!0))) {
        ret = OB_ALLOCATE_MEMORY_FAILED;
      } else {
        lAnalyzer_ = new(buf) ObLineIntersectionAnalyzer(this, rtree_);
      }
    }
  }
  return ret;
}

int ObCachedGeoLinestring::intersects(ObGeometry& geo, ObGeoEvalCtx& gis_context, bool &res)
{
  int ret = OB_SUCCESS;
  res = false;
  ObGeoDimension dim = ObGeoDimension::MAX_DIMENSION;
  bool has_dimension = false;
  if (!is_inited() && (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (init()))),!!0))) {
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ObGeoTypeUtil::get_geo_dimension(&geo, dim)))),!!0))) {
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (lAnalyzer_->segment_intersection_query(&geo)))),!!0))) {
  } else if (lAnalyzer_->is_intersects()) {
    res = lAnalyzer_->is_intersects();
  } else if (dim == ObGeoDimension::TWO_DIMENSION) {

    for (uint32_t i = 0; i < get_vertexes().size() && (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && !res; i++) {
      ObGeoPointLocationVisitor point_loc_visitor(get_vertexes()[i]);
      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (geo.do_visit(point_loc_visitor)))),!!0))) {
      } else if (point_loc_visitor.get_point_location() == ObPointLocation::INTERIOR
                || point_loc_visitor.get_point_location() == ObPointLocation::BOUNDARY) {
        res = true;
      }
    }
  }
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ret))),!!0)) || res) {
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ObGeoTypeUtil::has_dimension(geo, ObGeoDimension::ZERO_DIMENSION, has_dimension)))),!!1)) && has_dimension) {

    input_vertexes_.reset();
    ObGeoVertexCollectVisitor vertex_visitor(input_vertexes_);
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (geo.do_visit(vertex_visitor)))),!!0))) {
    } else {
      for (uint32_t i = 0; i < input_vertexes_.size() && (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && !res; i++) {
        ObGeoPointLocationVisitor point_loc_visitor(input_vertexes_[i]);
        if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (get_cached_geom()->do_visit(point_loc_visitor)))),!!0))) {
        } else if (point_loc_visitor.get_point_location() == ObPointLocation::INTERIOR
                  || point_loc_visitor.get_point_location() == ObPointLocation::BOUNDARY) {
          res = true;
        }
      }
    }
  }
  return ret;
}

}
