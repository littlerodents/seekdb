inline __attribute__((always_inline)) bool is_oceanbase_sys_database_id(const uint64_t database_id)
{
  return OB_SYS_DATABASE_ID == database_id;
}

inline __attribute__((always_inline)) bool is_information_schema_database_id(const uint64_t database_id)
{
  return OB_INFORMATION_SCHEMA_ID == database_id;
}

inline __attribute__((always_inline)) bool is_mysql_database_id(const uint64_t database_id)
{
  return OB_MYSQL_SCHEMA_ID == database_id;
}

inline __attribute__((always_inline)) bool is_extended_sys_database_id(const int64_t database_id)
{
  return OB_EXTENDED_SYS_DATABASE_ID == database_id;
}

inline __attribute__((always_inline)) bool is_recyclebin_database_id(const uint64_t database_id)
{
  return OB_RECYCLEBIN_SCHEMA_ID == database_id;
}

inline __attribute__((always_inline)) bool is_public_database_id(const uint64_t database_id)
{
  return OB_PUBLIC_SCHEMA_ID == database_id;
}

inline __attribute__((always_inline)) bool is_outline_database_id(const uint64_t database_id)
{
  return OB_MOCK_DEFAULT_DATABASE_ID == database_id;
}

inline __attribute__((always_inline)) bool is_inner_db(const uint64_t db_id)
{
  return (db_id > OB_MIN_INNER_DATABASE_ID && db_id < OB_MAX_INNER_DATABASE_ID);
}

inline __attribute__((always_inline)) bool is_mysql_sys_database_id(const uint64_t database_id)
{
  return is_oceanbase_sys_database_id(database_id)
          || is_information_schema_database_id(database_id)
          || is_mysql_database_id(database_id);
}

inline __attribute__((always_inline)) bool is_sys_database_id(const uint64_t database_id)
{
  return is_mysql_sys_database_id(database_id)
         || is_extended_sys_database_id(database_id);
}
