struct ObLobScale
{
  static const uint8_t LOB_SCALE_MASK = 0xF;
  enum StorageType
  {
    STORE_IN_ROW = 0,
    STORE_OUT_ROW,
    STORE_HAS_LOB_HEADER,
  };
  union
  {
    int8_t scale_;
    struct
    {
      uint8_t reserve_: 4;
      uint8_t type_: 4;
    };
  };
  ObLobScale() : scale_(0) {}
  ObLobScale(const ObScale scale) : scale_(static_cast<const int8_t>(scale)) { reserve_ = 0; }
  inline __attribute__((always_inline)) void reset() { scale_ = -1; }
  inline __attribute__((always_inline)) bool is_valid() { return STORE_IN_ROW == type_ || STORE_OUT_ROW == type_ || STORE_HAS_LOB_HEADER == type_; }
  inline __attribute__((always_inline)) void set_in_row() { reserve_ = 0; type_ = STORE_IN_ROW; }
  inline __attribute__((always_inline)) void set_out_row() { reserve_ = 0; type_ = STORE_OUT_ROW; }
  inline __attribute__((always_inline)) void set_has_lob_header() { reserve_ = 0; type_ = STORE_HAS_LOB_HEADER; }
  inline __attribute__((always_inline)) bool is_in_row() const { return type_ == STORE_IN_ROW; }
  inline __attribute__((always_inline)) bool is_out_row() const { return type_ == STORE_OUT_ROW; }
  inline __attribute__((always_inline)) bool has_lob_header() const { return type_ == STORE_HAS_LOB_HEADER; }
  inline __attribute__((always_inline)) ObScale get_scale() const { return static_cast<ObScale>(scale_); }
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"scale", ::oceanbase::common::check_char_array(scale_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
};

class ObObjMeta
{
public:
  ObObjMeta()
      :type_(ObNullType),
       cs_level_(CS_LEVEL_INVALID),
       cs_type_(CS_TYPE_INVALID),
       scale_(-1)
  {}

  inline __attribute__((always_inline)) bool operator ==(const ObObjMeta &other) const
  {
    return (type_ == other.type_ && cs_level_ == other.cs_level_ && cs_type_ == other.cs_type_);
  }
  inline __attribute__((always_inline)) bool operator !=(const ObObjMeta &other) const { return !this->operator ==(other); }

  inline __attribute__((always_inline)) void set_type(const ObObjType &type)
  {
    type_ = static_cast<uint8_t>(type);
    if (ObNullType == type_) {
      set_collation_level(CS_LEVEL_IGNORABLE);
      set_collation_type(CS_TYPE_BINARY);
    } else if (ObUnknownType == type_
               || ObExtendType == type_) {
      set_collation_level(CS_LEVEL_INVALID);
      set_collation_type(CS_TYPE_INVALID);
    } else if (ObHexStringType == type_) {
      set_collation_type(CS_TYPE_BINARY);
    } else if (ObJsonType == type_) {
      set_collation_type(CS_TYPE_UTF8MB4_BIN);
    } else if (ObUserDefinedSQLType == type_ ||
               ObCollectionSQLType == type_) {
