  inline __attribute__((always_inline)) int blk_offset(const ABlock *block) const;
  inline __attribute__((always_inline)) int blk_nblocks(const ABlock *block) const;
  inline __attribute__((always_inline)) char *blk_data(const ABlock *block) const;
  uint32_t MAGIC_CODE_;
  int32_t using_cnt_;
