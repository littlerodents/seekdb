struct Array_less
{
  bool operator() (const ObIJsonBase *idx1, const ObIJsonBase *idx2) const
  {
    int result;
    idx1->compare(*idx2, result);
    return result < 0;
  }
};

struct Array_equal
{
  bool operator() (const ObIJsonBase *idx1, const ObIJsonBase *idx2) const
  {
    int result;
    idx1->compare(*idx2, result);
    return result == 0;
  }
};

