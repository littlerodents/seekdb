      quotient = 0;
      remain = lhs;
    } else {
      ObWideInteger<Bits, unsigned> numerator = make_positive(lhs);
      dw_type denominator;
      if (rhs < 0) {
        denominator = -rhs;
      } else {
        denominator = rhs;
