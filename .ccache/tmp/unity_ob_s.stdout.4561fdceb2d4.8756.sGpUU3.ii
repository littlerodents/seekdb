      while (({ ((void)(0)); ; __atomic_exchange_n((&lock_), (1), 5); })) {
        ({; asm("yield\n");});
      }
    }
    abort_unless(nullptr == node.parent_ &&
        nullptr == node.prev_ && nullptr == node.next_);
    node.parent_ = this;
    if (nullptr == child_) {
      child_ = &node;
    } else {
      node.next_ = child_->next_;
      if (child_->next_ != nullptr) {
        child_->next_->prev_ = &node;
      }
      child_->next_ = &node;
      node.prev_ = child_;
    }
    if (__builtin_expect(!!(with_lock_),!!0)) {
      ({ __atomic_store_n((&lock_), (0), 5);});
    }
  }

  void del_child(TreeNode &node)
  {
    if (__builtin_expect(!!(with_lock_),!!0)) {
      while (({ ((void)(0)); ; __atomic_exchange_n((&lock_), (1), 5); })) {
        ({; asm("yield\n");});
      }
    }
    abort_unless(node.parent_ == this);
    node.parent_ = nullptr;
    TreeNode *prev = node.prev_;
    TreeNode *next = node.next_;
    if (prev != nullptr) {
      prev->next_ = next;
    }
    if (next != nullptr) {
      next->prev_ = prev;
    }
    node.prev_ = node.next_ = nullptr;
    if (this->child_ == &node) {
      abort_unless(prev == nullptr);
      this->child_ = next;
    }
    if (__builtin_expect(!!(with_lock_),!!0)) {
      ({ __atomic_store_n((&lock_), (0), 5);});
    }
  }

  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"parent_", reinterpret_cast<const void*>(parent_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };

  TreeNode *parent_;
  TreeNode *child_;
  TreeNode *prev_;
  TreeNode *next_;
  const bool with_lock_;
  int64_t lock_;
};

