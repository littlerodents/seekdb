struct ObJsonBinCtx
{
public:
  ObJsonBinCtx():
    extend_seg_offset_(0),
    update_ctx_(nullptr),
    is_update_ctx_alloc_(false),
    use_lexicographical_order_(false)
  {}

  ~ObJsonBinCtx();

  void reset()
  {
    extend_seg_offset_ = 0;
    update_ctx_ = nullptr;
    is_update_ctx_alloc_ = false;
