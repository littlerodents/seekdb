void ObGeoElevationCell::add_z(double z)
{
  ++z_num_;
  z_sum_ += z;
}

double ObGeoElevationCell::get_avg_z()
{
  if (z_num_ > 0) {
    z_avg_ = z_sum_ / z_num_;
  }
  return z_avg_;
}

ObGeoElevationExtent::ObGeoElevationExtent(
    const ObGeogBox *extent, int32_t cell_num_x , int32_t cell_num_y )
