const uint64_t OB_MAX_CORE_TABLE_ID = 100;
const uint64_t OB_MAX_SCHEMA_FETCH_DEP_TABLE_ID = 1000;
const uint64_t OB_MAX_SYS_TABLE_ID = 10000;

