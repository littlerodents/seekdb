      cur_page_->page_end_ = traced_page_end;


      pages_ = tc_->pages_;
      total_ = tc_->total_;
      used_ = tc_->used_;
    } else {




      free();
    }
    return bret;
  }

  void fast_reuse()
  {
    if (memory_sanity_enabled()) {
