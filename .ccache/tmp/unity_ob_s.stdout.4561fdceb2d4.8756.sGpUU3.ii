{
  T *next = __null;
  prev = start;
  while (__null != (next = (T *)link_next(prev))
         && next->compare(key) <= 0) {
    prev = next;
  }
  return next;
}

template<typename T>
int ol_get(T *start, T *key, T *&target)
{
