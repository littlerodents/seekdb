                           this->m_proj_parm.cosph0 * cosphi * coslam < - epsilon10) {
                            ::boost::throw_exception(projection_exception(error_tolerance_condition), ::boost::source_location("deps/3rd/usr/local/oceanbase/deps/devel/include/boost/geometry/srs/projections/proj/ortho.hpp", 103, __PRETTY_FUNCTION__));
                        }
                        xy_y = this->m_proj_parm.cosph0 * sinphi - this->m_proj_parm.sinph0 * cosphi * coslam;
                        break;
                    case n_pole:
                        coslam = - coslam;
                        [[clang::fallthrough]];
