  void pop_front() override { points_.pop_front(); }
  bool empty() const override { return points_.empty(); }
  bool is_empty() const override {
    for (uint64_t i = 0; i < size(); i++) {
      if (!(std::isnan(points_[i].get<0>()) || std::isnan(points_[i].get<1>()))) {
        return false;
      }
    }
    return true;
  }
