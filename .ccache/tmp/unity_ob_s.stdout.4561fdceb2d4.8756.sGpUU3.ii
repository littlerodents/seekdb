int ObCachedGeomBase::init()
{
  int ret = OB_SUCCESS;
  if ((__builtin_expect(!!(__null == (origin_geo_)),!!0)) || (__builtin_expect(!!(__null == (allocator_)),!!0))) {
    ret = OB_BAD_NULL_ERROR;
  } else if (!is_inited_) {
