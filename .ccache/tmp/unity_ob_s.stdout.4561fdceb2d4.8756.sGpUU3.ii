      } else if (line_type == ObLineType::Line && nums < 2) {
        ret = OB_ERR_GIS_INVALID_DATA;
      } else if (cur_pos + nums * 3 * WKB_GEO_DOUBLE_STORED_SIZE > geo->length()) {
