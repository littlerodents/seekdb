            enum face_type {
                face_front = 0,
                face_right = 1,
                face_back = 2,
                face_left = 3,
                face_top = 4,
                face_bottom = 5
            };

            template <typename T>
            struct par_qsc
            {
                T a_squared;
                T b;
                T one_minus_f;
                T one_minus_f_squared;
                face_type face;
