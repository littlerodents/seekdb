        if (n == SteinDomain(0))
            return m;

        unsigned d_m = gcd_traits<SteinDomain>::make_odd(m);
        unsigned d_n = gcd_traits<SteinDomain>::make_odd(n);

        while (m != n)
        {
            if (n > m)
