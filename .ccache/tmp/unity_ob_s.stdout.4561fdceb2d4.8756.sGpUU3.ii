namespace oceanbase
{
namespace common
{

typedef int32_t ObLength;
typedef int16_t ObPrecision;
typedef int16_t ObScale;






typedef int16_t ObLengthSemantics;


const static int16_t LS_DEFAULT = 0;
const static int16_t LS_CHAR = 1;
const static int16_t LS_BYTE = 2;
const static int16_t LS_INVALIED = -1;

const char *get_length_semantics_str(const ObLengthSemantics type);
ObLengthSemantics get_length_semantics(const ObString &str);


inline const char *get_length_semantics_str(const ObLengthSemantics value)
{
  const char *ret_str = __null;
  const static char *const_value_str[] = {
      "",
      "CHAR",
      "BYTE"
  };

  if (value < LS_DEFAULT || value > LS_BYTE) {
    ret_str = const_value_str[LS_DEFAULT];
  } else {
    ret_str = const_value_str[value];
  }
  return ret_str;
}

inline ObLengthSemantics get_length_semantics(const ObString &str)
{
  ObLengthSemantics ret_ls = LS_INVALIED;
  if (0 == str.case_compare("BYTE")) {
    ret_ls = LS_BYTE;
  } else if (0 == str.case_compare("CHAR")) {
    ret_ls = LS_CHAR;
  }
  return ret_ls;
}

class ObAccuracy
{
public:
  ObAccuracy() { reset(); }
  ~ObAccuracy() {}
  explicit ObAccuracy(ObLength length) { set_length(length); set_precision(0); set_scale(0);}
  ObAccuracy(ObPrecision precision, ObScale scale) { set_length(0); set_precision(precision); set_scale(scale); }
  ObAccuracy(const ObAccuracy &other) { accuracy_ = other.accuracy_; }
  inline __attribute__((always_inline)) void set_accuracy(const ObAccuracy &accuracy) { accuracy_ = accuracy.accuracy_; }
  inline __attribute__((always_inline)) void set_accuracy(const int64_t &accuracy) { accuracy_ = accuracy; }
  inline __attribute__((always_inline)) void set_length(const ObLength length) { length_ = length; }


  inline __attribute__((always_inline)) void set_full_length(const ObLength length, const ObLengthSemantics length_semantics)
  {
    length_ = length;
  }
  inline __attribute__((always_inline)) void set_precision(const ObPrecision precision) { precision_ = precision; }
  inline __attribute__((always_inline)) void set_length_semantics(const ObLengthSemantics length_semantics) { length_semantics_ = length_semantics; }
  inline __attribute__((always_inline)) void set_scale(const ObScale scale) { scale_ = scale; }

  inline __attribute__((always_inline)) int64_t get_accuracy() const { return accuracy_; }

  inline __attribute__((always_inline)) ObLength get_length() const { return length_; }
  inline __attribute__((always_inline)) ObPrecision get_precision() const { return precision_; }
  inline __attribute__((always_inline)) ObLengthSemantics get_length_semantics() const { return length_semantics_; }
  inline __attribute__((always_inline)) ObScale get_scale() const { return scale_; }
  inline __attribute__((always_inline)) void reset() { accuracy_ = -1; }
  static bool is_default_number_or_int(const ObAccuracy &accuracy)
  { return -1 == accuracy.get_precision(); }
  static bool is_default_number(const ObAccuracy &accuracy)
  { return -1 == accuracy.get_precision() && 0 != accuracy.get_scale(); }
  static bool is_default_number_int(const ObAccuracy &accuracy)
  { return -1 == accuracy.get_precision() && 0 == accuracy.get_scale(); }


  int64_t get_fixed_number_precision() const {
    int64_t precision = get_precision();
    if (is_default_number_int(*this)) {
      precision = DEFAULT_NUMBER_PRECISION_FOR_INTEGER;
    }
    return precision;
  }


  int64_t get_fixed_number_scale() const {
    int64_t scale = get_scale();
    if (is_default_number_int(*this)) {
      scale = DEFAULT_NUMBER_SCALE_FOR_INTEGER;
    }
    return scale;
  }

public:
  inline __attribute__((always_inline)) ObAccuracy &operator =(const ObAccuracy &other)
  {
    if (this != &other) {
      accuracy_ = other.accuracy_;
    }
    return *this;
  }
  inline __attribute__((always_inline)) bool operator ==(const ObAccuracy &other) const { return accuracy_ == other.accuracy_; }
  inline __attribute__((always_inline)) bool operator !=(const ObAccuracy &other) const { return accuracy_ != other.accuracy_; }
public:
  static const int64_t PS_QUESTION_MARK_DEDUCE_LEN = 2000;






  static const ObAccuracy DDL_DEFAULT_ACCURACY[ObMaxType];
  static const ObAccuracy DDL_DEFAULT_ACCURACY2[1][ObMaxType];
  static const ObAccuracy MAX_ACCURACY[ObMaxType];
  static const ObAccuracy MAX_ACCURACY2[1][ObMaxType];
  static const ObAccuracy DML_DEFAULT_ACCURACY[ObMaxType];
public:
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"length", length_, "precision", precision_, "scale", scale_); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };


  int serialize(char* buf, const int64_t buf_len, int64_t& pos) const; int deserialize(const char* buf, const int64_t data_len, int64_t& pos); int64_t get_serialize_size(void) const;

  union
  {
    int64_t accuracy_;
    struct {
      ObLength length_;
      union {
        ObPrecision precision_;
        ObLengthSemantics length_semantics_;
      };
      ObScale scale_;
    };
  };
};

}
}
