inline __attribute__((always_inline)) bool is_inner_user_or_role(const uint64_t uid)
{
  return (uid > OB_MIN_INNER_USER_ID && uid < OB_MAX_INNER_USER_ID);
}

inline __attribute__((always_inline)) bool is_root_user(const uint64_t uid)
{
  return (uid == OB_SYS_USER_ID);
}

inline __attribute__((always_inline)) bool is_empty_user(const uint64_t uid)
{
  return (uid == OB_EMPTY_USER_ID);
}

inline __attribute__((always_inline)) bool is_extended_sys_user(const uint64_t uid)
{
  return (uid == OB_EXTENDED_SYS_USER_ID);
}






