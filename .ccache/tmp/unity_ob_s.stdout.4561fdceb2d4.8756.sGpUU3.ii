                cos_arg_r = cos(arg_r);
                sinh_arg_i = sinh(arg_i);
                cosh_arg_i = cosh(arg_i);
                r = 2*cos_arg_r*cosh_arg_i;
                i = -2*sin_arg_r*sinh_arg_i;

                for (hi1 = hr1 = hi = 0, hr = *--p; a - p;) {
                    hr2 = hr1;
                    hi2 = hi1;
                    hr1 = hr;
                    hi1 = hi;
                    hr = -hr2 + r*hr1 - i*hi1 + *--p;
                    hi = -hi2 + i*hr1 + r*hi1;
