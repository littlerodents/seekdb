  bool is_inited() { return inited_; }
private:
  static const int64_t CONTEXT_MEMORY_LIMIT = 512 << 10;
  lib::MemoryContext mem_context_;
  bool inited_;
  lib::ObMallocHookAttrGuard malloc_guard_;

};


