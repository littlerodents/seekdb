namespace boost { namespace geometry { namespace projections {

namespace detail {


template <typename T>
inline T SIXTH() { return .1666666666666666667; }
template <typename T>
inline T RA4() { return .04722222222222222222; }
template <typename T>
inline T RA6() { return .02215608465608465608; }
template <typename T>
inline T RV4() { return .06944444444444444444; }
template <typename T>
inline T RV6() { return .04243827160493827160; }

template <typename T>
inline T pj_ell_b_to_es(T const& a, T const& b)
{
    return 1. - (b * b) / (a * a);
}






template <typename T>
inline bool pj_ell_init_ellps(srs::detail::proj4_parameters const& params, T &a, T &b)
{

    std::string name = pj_get_param_s(params, "ellps");
    if (! name.empty())
    {
        const pj_ellps_type<T>* pj_ellps = pj_get_ellps<T>().first;
        const int n = pj_get_ellps<T>().second;
        int index = -1;
        for (int i = 0; i < n && index == -1; i++)
        {
            if(pj_ellps[i].id == name)
            {
                index = i;
            }
        }

        if (index == -1) {
            ::boost::throw_exception(projection_exception(error_unknown_ellp_param), ::boost::source_location("deps/3rd/usr/local/oceanbase/deps/devel/include/boost/geometry/srs/projections/impl/pj_ell_set.hpp", 104, __PRETTY_FUNCTION__));
        }

        pj_ellps_type<T> const& pj_ellp = pj_ellps[index];
        a = pj_ellp.a;
        b = pj_ellp.b;

        return true;
    }

    return false;
}

template <typename T>
inline bool pj_ell_init_ellps(srs::dpar::parameters<T> const& params, T &a, T &b)
{

    typename srs::dpar::parameters<T>::const_iterator
        it = pj_param_find(params, srs::dpar::ellps);
    if (it != params.end())
    {
        if (it->template is_value_set<int>())
        {
            const pj_ellps_type<T>* pj_ellps = pj_get_ellps<T>().first;
            const int n = pj_get_ellps<T>().second;
            int i = it->template get_value<int>();

            if (i < 0 || i >= n) {
                ::boost::throw_exception(projection_exception(error_unknown_ellp_param), ::boost::source_location("deps/3rd/usr/local/oceanbase/deps/devel/include/boost/geometry/srs/projections/impl/pj_ell_set.hpp", 132, __PRETTY_FUNCTION__));
            }

            pj_ellps_type<T> const& pj_ellp = pj_ellps[i];
            a = pj_ellp.a;
            b = pj_ellp.b;
        }
        else if (it->template is_value_set<T>())
        {
            a = it->template get_value<T>();
            b = a;
        }
        else if (it->template is_value_set<srs::spheroid<T> >())
        {
            srs::spheroid<T> const& s = it->template get_value<srs::spheroid<T> >();
            a = geometry::get_radius<0>(s);
            b = geometry::get_radius<2>(s);
        }
        else
        {
            ::boost::throw_exception(projection_exception(error_unknown_ellp_param), ::boost::source_location("deps/3rd/usr/local/oceanbase/deps/devel/include/boost/geometry/srs/projections/impl/pj_ell_set.hpp", 152, __PRETTY_FUNCTION__));
        }

        return true;
    }

    return false;
}

