  for (int i = node->start() + 1; i < node->finish(); ++i) {
    (static_cast<void> (0));
  }
  int count = node->count();
  if (!node->leaf()) {
    for (int i = node->start(); i <= node->finish(); ++i) {
      (static_cast<void> (0));
      (static_cast<void> (0));
      (static_cast<void> (0));
