    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 4, "src/oblib/lib/container/ob_2d_array.h", 252, __FUNCTION__, ret, "failed to add block", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
    free_block(blk);
    blk = __null;
  } else {
    capacity_ += block_capacity;
  }
