            scalar_type const c = cos<scalar_type>(angle);
            scalar_type const x2 = x*x;
            scalar_type const y2 = y*y;
            scalar_type const z2 = z*z;
            scalar_type const xy = x*y;
            scalar_type const xz = x*z;
            scalar_type const yz = y*z;
