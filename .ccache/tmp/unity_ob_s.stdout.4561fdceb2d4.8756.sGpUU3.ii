  }
  void insert(ObStackHeader *);
  void erase(ObStackHeader *);
private:
  ObStackHeader *begin() { return dummy_.next_; }
  ObStackHeader *end() { return &dummy_; }
private:
  common::ObLatch rwlock_;
  ObStackHeader dummy_;
};

