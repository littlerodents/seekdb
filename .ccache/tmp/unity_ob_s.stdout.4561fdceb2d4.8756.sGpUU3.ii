  int finish(ObIWkbGeomMultiLineString *geo) override { ((void)(geo)); parent_.pop_back(); return OB_SUCCESS; }
  int finish(ObIWkbGeogMultiPolygon *geo) override { ((void)(geo)); parent_.pop_back(); return OB_SUCCESS; }
  int finish(ObIWkbGeomMultiPolygon *geo) override { ((void)(geo)); parent_.pop_back(); return OB_SUCCESS; }
  int finish(ObIWkbGeogCollection *geo) override { ((void)(geo)); parent_.pop_back(); return OB_SUCCESS; }
  int finish(ObIWkbGeomCollection *geo) override { ((void)(geo)); parent_.pop_back(); return OB_SUCCESS; }


private:
