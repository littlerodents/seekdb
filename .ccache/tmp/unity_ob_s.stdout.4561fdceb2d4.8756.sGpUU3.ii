const uint64_t OB_MIN_LS_INNER_TABLE_ID = 49400;
const uint64_t OB_MAX_LS_INNER_TABLE_ID = 49500;

const uint64_t OB_MIN_CTE_TABLE_ID = 49500;
const uint64_t OB_MAX_CTE_TABLE_ID = 49999;


const uint64_t OB_MIN_SYS_LOB_META_TABLE_ID = 50000;
const uint64_t OB_MAX_CORE_LOB_META_TABLE_ID = 50100;
const uint64_t OB_MAX_SCHEMA_FETCH_DEP_LOB_META_TABLE_ID = 51000;
const uint64_t OB_MIN_SYS_LOB_PIECE_TABLE_ID = 60000;
const uint64_t OB_MAX_CORE_LOB_PIECE_TABLE_ID = 60100;
const uint64_t OB_MAX_SCHEMA_FETCH_DEP_LOB_PIECE_TABLE_ID = 61000;
const uint64_t OB_MAX_SYS_LOB_PIECE_TABLE_ID = 70000;


const uint64_t OB_MIN_SYS_TABLE_INDEX_ID = 100000;
const uint64_t OB_MAX_CORE_TABLE_INDEX_ID = 101000;
const uint64_t OB_MAX_SCHEMA_FETCH_DEP_TABLE_INDEX_ID = 102000;
const uint64_t OB_MAX_SYS_TABLE_INDEX_ID = 200000;
const uint64_t OB_MAX_INNER_TABLE_ID = 200000;

inline __attribute__((always_inline)) bool is_system_table(const uint64_t tid)
{
  return (tid > OB_INVALID_OBJECT_ID && tid < OB_MAX_SYS_TABLE_ID);
}


inline __attribute__((always_inline)) bool is_mysql_virtual_table(const uint64_t tid)
{
  return (tid > OB_MAX_SYS_TABLE_ID && tid < OB_MAX_MYSQL_VIRTUAL_TABLE_ID);
}


inline __attribute__((always_inline)) bool is_extended_virtual_table(const uint64_t tid)
{
  return (tid > OB_MAX_MYSQL_VIRTUAL_TABLE_ID && tid < OB_MAX_VIRTUAL_TABLE_ID);
}


inline __attribute__((always_inline)) bool is_virtual_table(const uint64_t tid)
{
  return (tid > OB_MAX_SYS_TABLE_ID && tid < OB_MAX_VIRTUAL_TABLE_ID);
}

inline __attribute__((always_inline)) bool is_mysql_sys_view_table(const uint64_t tid)
{
  return (tid > OB_MAX_VIRTUAL_TABLE_ID && tid < OB_MAX_MYSQL_SYS_VIEW_ID);
}

inline __attribute__((always_inline)) bool is_extended_sys_view_table(const uint64_t tid)
{
  return (tid > OB_MAX_MYSQL_SYS_VIEW_ID && tid < OB_MAX_SYS_VIEW_ID);
}

inline __attribute__((always_inline)) bool is_sys_view(const uint64_t tid)
{
  return (tid > OB_MAX_VIRTUAL_TABLE_ID && tid < OB_MAX_SYS_VIEW_ID);
}

inline __attribute__((always_inline)) bool is_ls_reserved_table(const uint64_t tid)
{
  return (tid > OB_MIN_LS_INNER_TABLE_ID && tid < OB_MAX_LS_INNER_TABLE_ID);
}

inline __attribute__((always_inline)) bool is_cte_table(const uint64_t tid)
{
  return (tid > OB_MIN_CTE_TABLE_ID && tid < OB_MAX_CTE_TABLE_ID);
}

inline __attribute__((always_inline)) bool is_core_lob_meta_table(const uint64_t tid)
{
  return (tid > OB_MIN_SYS_LOB_META_TABLE_ID) && (tid < OB_MAX_CORE_LOB_META_TABLE_ID);
}

inline __attribute__((always_inline)) bool is_core_lob_piece_table(const uint64_t tid)
{
  return (tid > OB_MIN_SYS_LOB_PIECE_TABLE_ID) && (tid < OB_MAX_CORE_LOB_PIECE_TABLE_ID);
}

inline __attribute__((always_inline)) bool is_core_lob_table(const uint64_t tid)
{
  return (is_core_lob_meta_table(tid) || is_core_lob_piece_table(tid));
}

inline __attribute__((always_inline)) bool is_sys_lob_meta_table(const uint64_t tid)
{
  return (tid > OB_MIN_SYS_LOB_META_TABLE_ID) && (tid < OB_MIN_SYS_LOB_PIECE_TABLE_ID);
}

inline __attribute__((always_inline)) bool is_sys_lob_piece_table(const uint64_t tid)
{
  return (tid > OB_MIN_SYS_LOB_PIECE_TABLE_ID) && (tid < OB_MAX_SYS_LOB_PIECE_TABLE_ID);
}

inline __attribute__((always_inline)) bool is_sys_lob_table(const uint64_t tid)
{
  return (is_sys_lob_meta_table(tid) || is_sys_lob_piece_table(tid));
}

inline __attribute__((always_inline)) bool is_core_index_table(const uint64_t tid)
{
  return (tid > OB_MIN_SYS_TABLE_INDEX_ID) && (tid < OB_MAX_CORE_TABLE_INDEX_ID);
}

inline __attribute__((always_inline)) bool is_sys_index_table(const uint64_t tid)
{
  return (tid > OB_MIN_SYS_TABLE_INDEX_ID) && (tid < OB_MAX_SYS_TABLE_INDEX_ID);
}


inline __attribute__((always_inline)) bool is_core_table(const uint64_t tid)
{
  return (tid > OB_INVALID_OBJECT_ID && tid < OB_MAX_CORE_TABLE_ID)
         || is_core_index_table(tid)
         || is_core_lob_table(tid);
}


inline __attribute__((always_inline)) bool is_schema_fetch_dependency_table(const uint64_t tid)
{
  return (tid > OB_INVALID_OBJECT_ID && tid < OB_MAX_SCHEMA_FETCH_DEP_TABLE_ID)
         || (tid > OB_MIN_SYS_TABLE_INDEX_ID
             && tid < OB_MAX_SCHEMA_FETCH_DEP_TABLE_INDEX_ID)
         || (tid > OB_MIN_SYS_LOB_META_TABLE_ID
             && tid < OB_MAX_SCHEMA_FETCH_DEP_LOB_META_TABLE_ID)
         || (tid > OB_MIN_SYS_LOB_PIECE_TABLE_ID
             && tid < OB_MAX_SCHEMA_FETCH_DEP_LOB_PIECE_TABLE_ID);
}


inline __attribute__((always_inline)) bool is_sys_table(const uint64_t tid)
{
  return is_system_table(tid)
         || is_sys_index_table(tid)
         || is_sys_lob_table(tid);
}

inline __attribute__((always_inline)) bool is_reserved_table_id(const uint64_t tid)
{
  return (tid > OB_MAX_SYS_VIEW_ID && tid <= OB_MIN_LS_INNER_TABLE_ID)
         || (tid > OB_MAX_SYS_LOB_PIECE_TABLE_ID && OB_MIN_SYS_TABLE_INDEX_ID);
}

inline __attribute__((always_inline)) bool is_inner_table(const uint64_t tid)
{
  return (tid > OB_INVALID_OBJECT_ID && tid < OB_MAX_INNER_TABLE_ID);
}






