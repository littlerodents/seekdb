      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = ((is_polygon_valid_simple<PyTree, MpyTree, CollTree>(&coll[i], res))))),!!0))) {
      }
    }
  }
  return ret;
}


