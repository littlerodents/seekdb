inline int64_t ObClockGenerator::getClock()
{
  int64_t ts = 0;
  if (__builtin_expect(!!(!clock_generator_.inited_),!!0)) {
    { int __ret__ = common::OB_NOT_INIT; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_STORAGE, ::oceanbase::common::OB_LOG_STORAGE::M_TRANS, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""STORAGE"".""TRANS""] ", 4, "src/oblib/lib/time/ob_clock_generator.h", 94, __FUNCTION__, ret, "clock generator not inited", "placeholder" ); } } } while (false); };
    ts = clock_generator_.get_us();
  } else {
    ts = __atomic_load_n((&clock_generator_.cur_ts_), 5);
  }

  return ts;
}

inline int64_t ObClockGenerator::getRealClock()
{
  return clock_generator_.get_us();
}

inline void ObClockGenerator::msleep(const int64_t ms)
{
  if (ms > 0) {
    struct timespec ts;
    ts.tv_sec = ms / 1000;
    ts.tv_nsec = (ms % 1000) * 1000000;
    (void)nanosleep(&ts, nullptr);
  }
}

inline void ObClockGenerator::usleep(const int64_t us)
{
  if (us > 0) {
    struct timespec ts;
    ts.tv_sec = us / 1000000;
    ts.tv_nsec = (us % 1000000) * 1000;
    (void)nanosleep(&ts, nullptr);
  }
}

inline __attribute__((always_inline)) int64_t ObClockGenerator::get_us()
{
  return common::ObTimeUtility::current_time();
}

}
