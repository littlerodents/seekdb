inline __attribute__((always_inline)) bool ob_is_empty_lob(ObObjType type, const ObDatum &datum, bool has_lob_header)
{
  bool bret = false;
  if (common::is_lob_storage(type)) {
    common::ObLobLocatorV2 loc(datum.get_string(), has_lob_header);
    bret = loc.is_empty_lob();
  }
  return bret;
}

template <typename TextVec>
inline __attribute__((always_inline)) bool ob_is_empty_lob(ObObjType type, const TextVec &vector, bool has_lob_header,
                               int64_t idx)
{
  bool bret = false;
  if (common::is_lob_storage(type)) {
    common::ObLobLocatorV2 loc(vector->get_string(idx), has_lob_header);
    bret = loc.is_empty_lob();
  }
  return bret;
}

inline __attribute__((always_inline)) bool ob_is_empty_lob(const ObObj &obj)
{
  bool bret = false;
  if (common::is_lob_storage(obj.get_type())) {
    common::ObLobLocatorV2 loc(obj.get_string(), obj.has_lob_header());
    bret = loc.is_empty_lob();
  }
  return bret;
}

