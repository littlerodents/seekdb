                    proj_parm.apa = pj_authset<T>(par.es);
                    proj_parm.qp = pj_qsfn(1.0, par.e, par.one_es);
                    par.a = par.a*sqrt(0.5*proj_parm.qp);
                    pj_calc_ellipsoid_params(par, par.a, par.es);
