  static int32_t calc_yday(const ObTime &ob_time) {
    int32_t yday = 0;
    const int32_t *parts = ob_time.parts_;
    if (__builtin_expect(!!(parts[1] <= 0 || parts[1] > 13),!!0)) {
      yday = 0;
    } else {
      yday = DAYS_UNTIL_MON[((parts[0] >= 0 && parts[0] < 10000) ? INNER_IS_LEAP_YEAR[parts[0]] : (parts[0] == 0 ? 0 : ((((parts[0]) % 4) == 0 && (((parts[0]) % 100) != 0 || ((parts[0]) % 400) == 0)) ? 1 : 0)))][parts[1] - 1] + parts[2];
    }
    return yday;
  }
