public:
  inline bool created() const
  {
    return inited(buckets_);
  }
  int create(int64_t bucket_num, _allocer *allocer, _bucket_allocer *bucket_allocer)
  {
    int ret = OB_SUCCESS;
    if (__builtin_expect(!!(0 >= bucket_num),!!0) || __builtin_expect(!!(__null == allocer),!!0)) {
      { do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/oblib/lib/hash/ob_hashtable.h", 827, __FUNCTION__, ret, "invalid param bucket_num=%ld allocer=%p", bucket_num, allocer); } } } while (false); };
      ret = OB_INVALID_ARGUMENT;
    } else if (__builtin_expect(!!(inited(buckets_)),!!0)) {
      { do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/oblib/lib/hash/ob_hashtable.h", 831, __FUNCTION__, ret, "hashtable has already been created allocer=%p bucket_num=%ld", allocer_, bucket_num_); } } } while (false); };

      ret = OB_INIT_TWICE;
