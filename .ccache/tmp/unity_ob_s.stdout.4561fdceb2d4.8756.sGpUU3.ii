template<typename PL, typename L, typename ML, typename MPL, typename GC, typename LR>
int ObPolygonTypeCast::cast(const ObGeometry &src,
                            ObGeometry &dst,
                            const ObSrsItem *srs,
                            ObGeoErrLogInfo &log_info,
                            ObIAllocator *allocator) const
