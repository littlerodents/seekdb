            typedef T scalar_type;
            static int const rows=Dim;
            static int const cols=Dim;

            template <int Row,int Col>
            static
            inline __attribute__ ((always_inline))
            scalar_type
            read_element( this_matrix const & )
                {
                static_assert(Row>=0, "Row>=0");
                static_assert(Row<Dim, "Row<Dim");
                static_assert(Col>=0, "Col>=0");
                static_assert(Col<Dim, "Col<Dim");
                return scalar_traits<scalar_type>::value(Row==Col);
                }

            static
            inline __attribute__ ((always_inline))
            scalar_type
            read_element_idx( int row, int col, this_matrix const & )
                {
                (static_cast<void> (0));
                (static_cast<void> (0));
                (static_cast<void> (0));
                (static_cast<void> (0));
                return scalar_traits<scalar_type>::value(row==col);
                }
            };

