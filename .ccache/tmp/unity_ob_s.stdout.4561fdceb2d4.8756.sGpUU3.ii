  CONTAINS,
  WITHIN,
};


enum class ObDomainOpType
{
  T_INVALID = 0,
  T_JSON_MEMBER_OF = 1,
  T_JSON_CONTAINS = 2,
  T_JSON_OVERLAPS = 3,
  T_GEO_COVERS,
  T_GEO_INTERSECTS,
  T_GEO_DWITHIN,
  T_GEO_DFULLYWITHIN,
  T_GEO_COVEREDBY,
  T_GEO_RELATE,
  T_DOMAIN_OP_END,
};

enum class ObPointLocation {
  INTERIOR = 0,
