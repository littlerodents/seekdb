template <class Iterator, class Compare>
void ob_sort(Iterator first, Iterator last, Compare comp)
{
  int ret = ({ EventTable::EN_CHECK_SORT_CMP.item_.call(); })?: OB_SUCCESS;
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ret))),!!0)) && std::is_empty<Compare>::value) {
    ret = OB_SUCCESS;
    for (Iterator iter = first; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && iter != last; ++iter) {
      if (comp(*iter, *iter)) {
        ret = common::OB_ERR_UNEXPECTED;
        { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::OB_PRINT("", 3, "src/oblib/lib/utility/ob_sort.h", 36, __FUNCTION__, ret, "check irreflexivity failed", "placeholder" ); } } } while (false); };
      }
    }
  }
  std::sort(first, last, comp);
}

template <class Iterator>
void ob_sort(Iterator first, Iterator last)
{
  using ValueType = typename std::iterator_traits<Iterator>::value_type;
  struct Compare
  {
    bool operator()(ValueType& l, ValueType& r)
    {
      return l < r;
    }
  };
  ob_sort(first, last, Compare());
}
