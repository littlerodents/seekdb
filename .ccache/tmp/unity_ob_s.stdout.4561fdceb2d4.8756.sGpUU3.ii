            template <class R>
            operator R() const
                {
                R r;
                assign(r,*this);
                return r;
                }
            };

        template <class V>
        struct vec_traits;

        template <class T,int Dim>
        struct
        vec_traits< vec<T,Dim> >
            {
            typedef vec<T,Dim> this_vector;
            typedef T scalar_type;
