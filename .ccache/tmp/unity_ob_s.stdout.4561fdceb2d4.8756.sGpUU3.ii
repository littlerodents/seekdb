namespace boost { namespace geometry
{


namespace resolve_strategy
{

template <typename Geometry1, typename Geometry2, typename Strategy>
struct distance_result
    : strategy::distance::services::return_type
        <
            Strategy,
            typename point_type<Geometry1>::type,
            typename point_type<Geometry2>::type
        >
{};

template <typename Geometry1, typename Geometry2>
struct distance_result<Geometry1, Geometry2, default_strategy>
    : distance_result
        <
            Geometry1,
            Geometry2,
            typename detail::distance::default_strategy
                <
                    Geometry1, Geometry2
                >::type
        >
{};

}


namespace resolve_variant
{

template <typename Geometry1, typename Geometry2, typename Strategy>
struct distance_result
    : resolve_strategy::distance_result
        <
            Geometry1,
            Geometry2,
            Strategy
        >
{};


template
<
    typename Geometry1,
    typename T0, typename... TN,
    typename Strategy
>
struct distance_result
    <
        Geometry1, boost::variant<T0, TN...>, Strategy
    >
{


    typedef typename util::combine_if<
        typename boost::mpl::vector1<Geometry1>,
        typename boost::variant<T0, TN...>::types,





        boost::mpl::always<boost::mpl::true_>
    >::type possible_input_types;


    typedef typename compress_variant<
        typename transform_variant<
            possible_input_types,
            resolve_strategy::distance_result<
                boost::mpl::first<boost::mpl::_>,
                boost::mpl::second<boost::mpl::_>,
                Strategy
            >,
            boost::mpl::back_inserter<boost::mpl::vector0<> >
        >::type
    >::type type;
};



template
<
    typename T0, typename... TN,
    typename Geometry2,
    typename Strategy
>
struct distance_result
    <
        boost::variant<T0, TN...>,
        Geometry2,
        Strategy
    > : public distance_result
        <
            Geometry2, boost::variant<T0, TN...>, Strategy
        >
{};


template <typename T0, typename... TN, typename Strategy>
struct distance_result
    <
        boost::variant<T0, TN...>,
        boost::variant<T0, TN...>,
        Strategy
    >
{


    typedef typename util::combine_if
        <
            typename boost::variant<T0, TN...>::types,
            typename boost::variant<T0, TN...>::types,






            boost::mpl::always<boost::mpl::true_>
        >::type possible_input_types;


    typedef typename compress_variant<
        typename transform_variant<
            possible_input_types,
            resolve_strategy::distance_result<
                boost::mpl::first<boost::mpl::_>,
                boost::mpl::second<boost::mpl::_>,
                Strategy
            >,
            boost::mpl::back_inserter<boost::mpl::vector0<> >
        >::type
    >::type type;
};

}
