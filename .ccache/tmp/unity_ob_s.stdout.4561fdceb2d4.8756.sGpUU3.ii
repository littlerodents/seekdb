  int reserve(int bytes = 128);
  int append(double val);
  int append(uint32_t val);
  int append(char val);
  int append(const char *str, const uint64_t len);
  int write(uint64_t pos, uint32_t val);
  int read(uint64_t pos, uint32_t &val);
