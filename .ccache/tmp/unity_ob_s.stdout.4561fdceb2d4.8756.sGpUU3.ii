template <class T>
T GetSurfaceIntegral(S2PointLoopSpan loop,
                     T f_tri(const S2Point&, const S2Point&, const S2Point&)) {
# 221 "/work/deps/3rd/usr/local/oceanbase/deps/devel/include/s2/s2loop_measures.h"
