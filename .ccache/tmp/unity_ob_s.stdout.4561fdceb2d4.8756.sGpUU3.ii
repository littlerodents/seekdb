      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 4, "src/share/geo/ob_geo_3d.cpp", 593, __FUNCTION__, ret, "unexpect ptr or pos to read nums value", "placeholder" ); } } } while (false);
    } else {
      ObGeoWkbByteOrder bo = geo->byteorder();
