namespace oceanbase
{
namespace common
{
using namespace oceanbase::common;

const char *ObGeometryTypeCastUtil::get_cast_name(ObGeoType type)
{
  const char *type_name = "cast_as_unknown";
  switch (type) {
    case ObGeoType::GEOMETRY:{
      type_name = "cast_as_geometry";
      break;
    }
    case ObGeoType::POINT:{
      type_name = "cast_as_point";
      break;
    }
    case ObGeoType::LINESTRING:{
      type_name = "cast_as_linestring";
      break;
    }
    case ObGeoType::POLYGON:{
      type_name = "cast_as_polygon";
      break;
    }
    case ObGeoType::MULTIPOINT:{
      type_name = "cast_as_multipoint";
      break;
    }
    case ObGeoType::MULTILINESTRING:{
      type_name = "cast_as_multilinestring";
      break;
    }
    case ObGeoType::MULTIPOLYGON:{
      type_name = "cast_as_multipolygon";
      break;
    }
    case ObGeoType::GEOMETRYCOLLECTION:{
      type_name = "cast_as_geometrycollection";
      break;
    }
    default:{
      { int __ret__ = OB_INVALID_ARGUMENT; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 4, "src/share/geo/ob_geometry_cast.cpp", 64, __FUNCTION__, ret, "unknown geometry type", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(type)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(type)))&&>::value>("type", ::oceanbase::common::check_char_array(type))); } } } while (false); };
      break;
    }
  }
  return type_name;
}

int ObGeometryTypeCastUtil::check_longitude(double val_radian,
                                            const ObSrsItem *srs,
                                            double val)
{
  int ret = OB_SUCCESS;
  double max_long_val = 0.0;
  double min_long_val = 0.0;

  if (val_radian <= -3.14159265358979323846 || val_radian > 3.14159265358979323846) {
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (srs->longtitude_convert_from_radians(-3.14159265358979323846, min_long_val)))),!!0))) {
    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (srs->longtitude_convert_from_radians(3.14159265358979323846, max_long_val)))),!!0))) {
    } else {
      ret = OB_ERR_LONGITUDE_OUT_OF_RANGE;
    }
  }

  return ret;
}

int ObGeometryTypeCastUtil::check_latitude(double val_radian,
                                           const ObSrsItem *srs,
                                           double val)
{
  int ret = OB_SUCCESS;
  double max_lat_val = 0.0;
  double min_lat_val = 0.0;

  if (val_radian < -1.57079632679489661923 || val_radian > 1.57079632679489661923) {
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (srs->latitude_convert_from_radians(-1.57079632679489661923, min_lat_val)))),!!0))) {
    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (srs->latitude_convert_from_radians(1.57079632679489661923, max_lat_val)))),!!0))) {
    } else {
      ret = OB_ERR_LATITUDE_OUT_OF_RANGE;
    }
  }

  return ret;
}

int ObGeometryTypeCastUtil::get_tree(ObIAllocator &allocator,
                                     const ObString &wkb,
                                     ObGeometry *&geo_tree,
                                     const ObSrsItem *srs,
                                     ObGeoErrLogInfo &log_info,
                                     const char *func_name)
{
  int ret = OB_SUCCESS;
  ObGeometry *geo = __null;

  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ObGeoTypeUtil::build_geometry(allocator, wkb, geo, srs, log_info)))),!!0))) {
  } else if (geo->is_tree()) {
    geo_tree = geo;
  } else {
    ObGeoToTreeVisitor visitor(&allocator);
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (geo->do_visit(visitor)))),!!0))) {
    } else {
      geo_tree = visitor.get_geometry();
      geo_tree->set_srid(geo->get_srid());
    }
  }

  return ret;
}

int ObGeometryTypeCastUtil::check_polygon_direction(ObIAllocator &allocator,
                                                    const common::ObSrsItem *srs,
                                                    ObGeometry *geo_tree)
{
  int ret = OB_SUCCESS;

  if ((__builtin_expect(!!(__null == (geo_tree)),!!0))) {
    ret = OB_INVALID_ARGUMENT;
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ObGeoTypeUtil::correct_polygon(allocator, srs, true, *geo_tree)))),!!0))) {
    ret = OB_ERR_GIS_INVALID_DATA;
  }

  return ret;
}

template<typename P>
bool ObGeometryTypeCastUtil::is_point_equal(const P &p_left, const P &p_right)
{
  bool is_equal = true;

  if ((p_left.template get<0>() != p_right.template get<0>()) ||
      (p_left.template get<1>() != p_right.template get<1>())) {
    is_equal = false;
    { int __ret__ = OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 4, "src/share/geo/ob_geometry_cast.cpp", 159, __FUNCTION__, ret, "the back and front of the linestring are not the same point", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(p_left.template get<0>())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(p_left.template get<0>())))&&>::value>("p_left.template get<0>()", ::oceanbase::common::check_char_array(p_left.template get<0>())) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(p_right.template get<0>())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(p_right.template get<0>())))&&>::value>("p_right.template get<0>()", ::oceanbase::common::check_char_array(p_right.template get<0>())) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(p_left.template get<1>())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(p_left.template get<1>())))&&>::value>("p_left.template get<1>()", ::oceanbase::common::check_char_array(p_left.template get<1>())) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(p_right.template get<1>())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(p_right.template get<1>())))&&>::value>("p_right.template get<1>()", ::oceanbase::common::check_char_array(p_right.template get<1>()))); } } } while (false); };


  }

  return is_equal;
}

template<typename L>
bool ObGeometryTypeCastUtil::is_line_can_ring(const L &line)
{
  typename L::const_iterator begin = line.begin();
  typename L::const_iterator last = line.end() - 1;

  return is_point_equal(*begin, *last);
}


int ObGeometryTypeCastFactory::alloc(ObIAllocator &alloc,
                                     ObGeoType geo_type,
                                     ObGeometryTypeCast *&geo_cast)
{
  int ret = OB_SUCCESS;
  void *buf = __null;

  switch (geo_type)
  {
    case ObGeoType::POINT: {
      if ((__builtin_expect(!!(__null == (buf = alloc.alloc(sizeof(ObPointTypeCast)))),!!0))) {
        ret = OB_ALLOCATE_MEMORY_FAILED;
      } else {
        geo_cast = new (buf) ObPointTypeCast();
      }
      break;
    }

    case ObGeoType::LINESTRING: {
      if ((__builtin_expect(!!(__null == (buf = alloc.alloc(sizeof(ObLineStringTypeCast)))),!!0))) {
        ret = OB_ALLOCATE_MEMORY_FAILED;
      } else {
        geo_cast = new (buf) ObLineStringTypeCast();
      }
      break;
    }

    case ObGeoType::POLYGON: {
      if ((__builtin_expect(!!(__null == (buf = alloc.alloc(sizeof(ObPolygonTypeCast)))),!!0))) {
        ret = OB_ALLOCATE_MEMORY_FAILED;
      } else {
        geo_cast = new (buf) ObPolygonTypeCast();
      }
      break;
    }

    case ObGeoType::MULTIPOINT: {
      if ((__builtin_expect(!!(__null == (buf = alloc.alloc(sizeof(ObMultiPointTypeCast)))),!!0))) {
        ret = OB_ALLOCATE_MEMORY_FAILED;
      } else {
        geo_cast = new (buf) ObMultiPointTypeCast();
      }
      break;
    }

    case ObGeoType::MULTILINESTRING: {
      if ((__builtin_expect(!!(__null == (buf = alloc.alloc(sizeof(ObMultiLineStringTypeCast)))),!!0))) {
        ret = OB_ALLOCATE_MEMORY_FAILED;
      } else {
        geo_cast = new (buf) ObMultiLineStringTypeCast();
      }
      break;
    }

    case ObGeoType::MULTIPOLYGON: {
      if ((__builtin_expect(!!(__null == (buf = alloc.alloc(sizeof(ObMultiPolygonTypeCast)))),!!0))) {
        ret = OB_ALLOCATE_MEMORY_FAILED;
      } else {
        geo_cast = new (buf) ObMultiPolygonTypeCast();
      }
      break;
    }

    case ObGeoType::GEOMETRYCOLLECTION: {
      if ((__builtin_expect(!!(__null == (buf = alloc.alloc(sizeof(ObGeomcollectionTypeCast)))),!!0))) {
        ret = OB_ALLOCATE_MEMORY_FAILED;
