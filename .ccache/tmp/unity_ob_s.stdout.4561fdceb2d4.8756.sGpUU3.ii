template <typename Geometry, typename Strategy>
class AreaStrategy
{



    typedef typename Strategy::template state<Geometry> state_type;


    typedef typename Strategy::template result_type<Geometry>::type return_type;

    struct check_methods
    {
        static void apply()
        {
            Strategy const* str = 0;
            state_type *st = 0;


            typename geometry::point_type<Geometry>::type const* sp = 0;
            str->apply(*sp, *sp, *st);


            return_type r = str->result(*st);

            boost::ignore_unused(r, str);
        }
    };

public :
    typedef ::boost::concepts::detail::instantiate< &::boost::concepts::requirement_<void(*)(boost::concepts::usage_requirements<AreaStrategy>)>::failed> boost_concept_check67 __attribute__((__unused__)); ~AreaStrategy()
