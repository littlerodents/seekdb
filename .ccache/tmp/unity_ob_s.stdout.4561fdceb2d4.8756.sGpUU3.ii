template<typename GeometryType>
int ObGeoBoxUtil::get_geog_line_box(const GeometryType &line, ObGeogBox &box)
{
  int ret = OB_SUCCESS;
  bool start = false;
  ObPoint3d p3d1;
  ObPoint3d p3d2;
  ObGeogBox box_tmp;

  typename GeometryType::iterator iter = line.begin();
  convert_ll_to_cartesian3d(*iter, p3d1);
  iter++;
  for ( ; iter != line.end() && (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)); iter++) {
    convert_ll_to_cartesian3d(*iter, p3d2);
    if((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (caculate_line_box(p3d1, p3d2, box_tmp)))),!!0))) {
    } else {
      if (!start) {
        start = true;
        box = box_tmp;
      } else {
        box_union(box_tmp, box);
      }
      p3d1 = p3d2;
    }
  }
  return ret;
}

