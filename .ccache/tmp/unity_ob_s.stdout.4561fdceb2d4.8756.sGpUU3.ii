  PROJECTED_SRS = 0,
  GEOGRAPHIC_SRS,
  UNKNOW_SRS
};

enum class ObAxisDirection
{
  INIT = 0,
  EAST,
  SOUTH,
  WEST,
  NORTH,
  OTHER
};

