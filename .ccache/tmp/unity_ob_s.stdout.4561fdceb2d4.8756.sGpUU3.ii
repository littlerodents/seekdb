namespace oceanbase {
namespace lib {
using GetSwitchFunc = bool& ();

template<GetSwitchFunc fn>
class ObSwitchGuard
{
public:
  ObSwitchGuard(bool newval)
  {
    oldval_ = fn();
    fn() = newval;
  }
  ~ObSwitchGuard()
  {
    fn() = oldval_;
  }
private:
  bool oldval_;
};
}
