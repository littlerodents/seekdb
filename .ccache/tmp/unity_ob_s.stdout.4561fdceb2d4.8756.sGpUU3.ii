  char *dst_ptr = __null;
  void *ptr = __null;
  char letter='\0';
  if ((__builtin_expect(!!(__null == (src_ptr)),!!0)) || __builtin_expect(!!(0 >= src_len),!!0)) {
    dst.assign(__null, 0);
  } else if (__null == (ptr = allocator.alloc(src_len))) {
