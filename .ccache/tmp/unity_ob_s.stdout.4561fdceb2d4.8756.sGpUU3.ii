      ret = OB_ALLOCATE_MEMORY_FAILED;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/container/ob_2d_array.h", 229, __FUNCTION__, ret, "no memory", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(new_capacity)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(new_capacity)))&&>::value>("new_capacity", ::oceanbase::common::check_char_array(new_capacity)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(count())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(count())))&&>::value>("count()", ::oceanbase::common::check_char_array(count())) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(get_capacity())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(get_capacity())))&&>::value>("get_capacity()", ::oceanbase::common::check_char_array(get_capacity()))); } } } while (false);
