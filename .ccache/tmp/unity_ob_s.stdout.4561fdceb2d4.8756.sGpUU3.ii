  return ret;
}

template<typename P, typename MPT, typename GC>
int ObPointTypeCast::cast(const ObGeometry &src,
                          ObGeometry &dst,
                          const ObSrsItem *srs,
                          ObGeoErrLogInfo &log_info,
                          ObIAllocator *allocator ) const
{
  ((void)(allocator));
  int ret = OB_SUCCESS;
