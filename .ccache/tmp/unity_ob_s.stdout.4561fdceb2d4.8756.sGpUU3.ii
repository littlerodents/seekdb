            if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (res.push_back(*lr)))),!!0))) {
            }


            if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
              if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ObGeometryTypeCastUtil::check_polygon_direction(*allocator, srs, &res)))),!!0))) {
              } else {
                PL *new_poly = static_cast<PL *>(&res);

                const LR *tmp_lr = (i == 0 ? &new_poly->exterior_ring() : &new_poly->inner_ring(i - 1));
                for (int32_t i = 0; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && i < line.size(); i++) {
                  if (!ObGeometryTypeCastUtil::is_point_equal(line[i], (*tmp_lr)[i])) {
