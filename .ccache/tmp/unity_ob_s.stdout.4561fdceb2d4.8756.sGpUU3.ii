  inline int internal_get(const hashbucket &bucket,
                          const _key_type &key,
                          const _value_type *&value,
                          bool &is_fake) const
  {
    int ret = OB_HASH_NOT_EXIST;
    hashnode *node = bucket.node;
    is_fake = false;
    while (__null != node) {
      abort_unless(node->check_magic_code());
