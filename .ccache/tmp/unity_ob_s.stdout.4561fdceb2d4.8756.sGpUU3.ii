template <typename ... Args>



__attribute__((noinline, cold)) void OB_PRINT(const char *mod_name, const int32_t level, const char *file, const int32_t line,

              const char *function,
              const int errcode, const char *info_string,
              const char *,
              Args const && ... args)
{
  int ret = OB_SUCCESS;

  if (3 == level) {
    ::oceanbase::common::ObLogger::get_logger().issue_dba_error(errcode, file, line, info_string);
  }

  if (__builtin_expect(!!(!::oceanbase::common::ObLogger::get_logger().get_guard()),!!1)) {
    ::oceanbase::common::ObLogger::get_logger().get_guard() = true;
    ::oceanbase::common::ObLogger::get_logger().log_message_kv(mod_name, level, file, line, function, errcode,
                             info_string, std::forward<const Args&&>(args)...);
    ::oceanbase::common::ObLogger::get_logger().get_guard() = false;
    ((void)(ret));
  }
}

