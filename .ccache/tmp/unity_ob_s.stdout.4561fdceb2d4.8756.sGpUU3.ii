                                      const common::ObString &tz_abbr_str,
                                      int32_t &offset_sec,
                                      int32_t &tz_id,
                                      int32_t &tran_type_id) const;

  inline void set_tz_id(int64_t tz_id) { tz_id_ = tz_id; }
  inline int64_t get_tz_id() const { return tz_id_; }
