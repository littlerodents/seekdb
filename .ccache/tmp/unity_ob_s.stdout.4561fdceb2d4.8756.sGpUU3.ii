        inters_info inters(range_p, range_q, umbrella_strategy, robust_policy);

        char const method = inters.d_info().how;


        TurnInfo tp = tp_model;

        bool do_only_convert = false;


        switch(method)
        {
            case 'a' :
            case 'f' :
            case 's' :
