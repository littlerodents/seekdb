using namespace oceanbase::common;
namespace bg = boost::geometry;

namespace oceanbase
{
namespace common
{

template<typename GeoType>
static int eval_length_without_strategy(const ObGeometry *g, double &result)
{
  int ret = ::oceanbase::common::OB_SUCCESS;
  const GeoType *geo_condidate = reinterpret_cast<const GeoType *>(const_cast<char *>(g->val()));
  if ((__builtin_expect(!!(__null == (geo_condidate)),!!0))) {
    ret = OB_ERR_GIS_INVALID_DATA;
  } else {
    result = bg::length(*geo_condidate);
  }
  return ret;
}

template<typename GeoType>
static int eval_length_with_strategy(
    const ObGeometry *g, const ObGeoEvalCtx &context, double &result)
{
  int ret = ::oceanbase::common::OB_SUCCESS;
  const ObSrsItem *srs = context.get_srs();
  const GeoType *geo_condidate = reinterpret_cast<const GeoType *>(const_cast<char *>(g->val()));
  if ((__builtin_expect(!!(__null == (srs)),!!0)) || (__builtin_expect(!!(__null == (geo_condidate)),!!0))) {
    ret = OB_ERR_NULL_VALUE;
  } else {
    bg::srs::spheroid<double> geog_sphere(srs->semi_major_axis(), srs->semi_minor_axis());
    bg::strategy::distance::andoyer<bg::srs::spheroid<double>> m_geographic_ll_la_aa_strategy(
        geog_sphere);
    result = bg::length(*geo_condidate, m_geographic_ll_la_aa_strategy);
  }
  return ret;
}

class ObGeoFuncLengthImpl : public ObIGeoDispatcher<double, ObGeoFuncLengthImpl>
{
public:
  ObGeoFuncLengthImpl();
  virtual ~ObGeoFuncLengthImpl() = default;

  template <typename GeometyType> struct Eval { static int eval(const common::ObGeometry *g, const ObGeoEvalCtx &context, double &result) { ((void)(g)); ((void)(context)); ((void)(result)); return OB_ERR_NOT_IMPLEMENTED_FOR_GEOGRAPHIC_SRS; } };
  template <typename GeometyType> struct EvalTree { static int eval(const common::ObGeometry *g, const ObGeoEvalCtx &context, double &result) { ((void)(g)); ((void)(context)); ((void)(result)); return OB_ERR_NOT_IMPLEMENTED_FOR_GEOGRAPHIC_SRS; } };
  template <typename GeometyType1, typename GeometyType2> struct EvalWkbBi { static int eval(const common::ObGeometry *g1, const common::ObGeometry *g2, const ObGeoEvalCtx &context, double &result) { ((void)(g1)); ((void)(g2)); ((void)(context)); ((void)(result)); return OB_ERR_NOT_IMPLEMENTED_FOR_CARTESIAN_SRS; } };
  template <typename GeometyType1, typename GeometyType2> struct EvalWkbBiGeog { static int eval(const common::ObGeometry *g1, const common::ObGeometry *g2, const ObGeoEvalCtx &context, double &result) { ((void)(g1)); ((void)(g2)); ((void)(context)); ((void)(result)); return OB_ERR_NOT_IMPLEMENTED_FOR_GEOGRAPHIC_SRS; } };
  template <typename GeometyType1, typename GeometyType2> struct EvalTreeBi { static int eval(const common::ObGeometry *g1, const common::ObGeometry *g2, const ObGeoEvalCtx &context, double &result) { ((void)(g1)); ((void)(g2)); ((void)(context)); ((void)(result)); return OB_ERR_NOT_IMPLEMENTED_FOR_CARTESIAN_SRS; } };
  template <typename GeometyType1, typename GeometyType2> struct EvalTreeBiGeog { static int eval(const common::ObGeometry *g1, const common::ObGeometry *g2, const ObGeoEvalCtx &context, double &result) { ((void)(g1)); ((void)(g2)); ((void)(context)); ((void)(result)); return OB_ERR_NOT_IMPLEMENTED_FOR_GEOGRAPHIC_SRS; } };
};

template <> struct ObGeoFuncLengthImpl::Eval<ObWkbGeomLineString> { static int eval(const common::ObGeometry *g, const ObGeoEvalCtx &context, double &result)
{
  ((void)(context));
  return eval_length_without_strategy<ObWkbGeomLineString>(g, result);
}
};

template <> struct ObGeoFuncLengthImpl::Eval<ObWkbGeomMultiLineString> { static int eval(const common::ObGeometry *g, const ObGeoEvalCtx &context, double &result)
{
  ((void)(context));
  return eval_length_without_strategy<ObWkbGeomMultiLineString>(g, result);
}
};


template <> struct ObGeoFuncLengthImpl::Eval<ObWkbGeogLineString> { static int eval(const common::ObGeometry *g, const ObGeoEvalCtx &context, double &result)
{
  return eval_length_with_strategy<ObWkbGeogLineString>(g, context, result);
}
};

template <> struct ObGeoFuncLengthImpl::Eval<ObWkbGeogMultiLineString> { static int eval(const common::ObGeometry *g, const ObGeoEvalCtx &context, double &result)
{
  return eval_length_with_strategy<ObWkbGeogMultiLineString>(g, context, result);
}
};

int ObGeoFuncLength::eval(const ObGeoEvalCtx &gis_context, double &result)
{
  return ObGeoFuncLengthImpl::eval_geo_func(gis_context, result);
}

}
