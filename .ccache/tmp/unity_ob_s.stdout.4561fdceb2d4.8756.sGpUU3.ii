inline __attribute__((always_inline)) int64_t &get_tid_cache()
{

  struct TID {
    TID() : v_(-1) {}
    int64_t v_;
  };
  thread_local TID tid;
  return (&tid)->v_;
}

inline __attribute__((always_inline)) int64_t &get_seq()
{
  thread_local int64_t seq;
  return seq;
}

inline __attribute__((always_inline)) bool &tl_need_speed_limit()
{
  thread_local bool tl_need_speed_limit;
  return tl_need_speed_limit;
}

inline __attribute__((always_inline)) uint32_t &get_writing_throttling_sleep_interval()
{
  thread_local uint32_t writing_throttling_sleep_interval;
  return writing_throttling_sleep_interval;
}


inline __attribute__((always_inline)) void reset_tid_cache()
{
  get_tid_cache() = -1;
}


inline __attribute__((always_inline)) int64_t ob_syscall_gettid()
{
# 1921 "/work/src/oblib/lib/ob_define.h"
  return static_cast<int64_t>(syscall(178));

}

inline __attribute__((always_inline)) int64_t ob_gettid()
{
  int64_t &tid = get_tid_cache();
  if (__builtin_expect(!!(tid <= 0),!!0)) {
    tid = ob_syscall_gettid();
  }
  return tid;
}


inline __attribute__((always_inline)) char* ob_get_tname()
{
  thread_local char tname[oceanbase::OB_THREAD_NAME_BUF_LEN] = {0};
  return tname;
}

inline __attribute__((always_inline)) char* ob_get_origin_thread_name()
{
  thread_local char ori_tname[oceanbase::OB_THREAD_NAME_BUF_LEN] = {0};
  return ori_tname;
}


inline __attribute__((always_inline)) bool& ob_batch_generate_schema_version()
{
  thread_local bool batch_generate_schema_version = false;
  return batch_generate_schema_version;
}

inline __attribute__((always_inline)) char* ob_get_extended_thread_name()
{
  thread_local char ext_tname[oceanbase::OB_EXTENED_THREAD_NAME_BUF_LEN] = {0};
  return ext_tname;
}

inline __attribute__((always_inline)) char* ob_get_tname_v2()
{
  char *ret_tname = ob_get_extended_thread_name();
  if ('\0' == ret_tname[0]) {
    ret_tname = ob_get_tname();
  }
  return ret_tname;
}

