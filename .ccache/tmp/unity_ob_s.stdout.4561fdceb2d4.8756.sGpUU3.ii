erase(Range & rng,
      typename boost::range_iterator<Range const>::type cfirst,
      typename boost::range_iterator<Range const>::type clast)
{
    typedef ::boost::concepts::detail::instantiate< &::boost::concepts::requirement_<void(*)( boost::RandomAccessRangeConcept<Range> )>::failed> boost_concept_check360 __attribute__((__unused__));

    typename boost::range_iterator<Range>::type
        first = boost::begin(rng)
                    + std::distance(boost::const_begin(rng), cfirst);
