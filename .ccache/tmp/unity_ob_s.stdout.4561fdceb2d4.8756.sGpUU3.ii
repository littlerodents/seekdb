  const ObString str() const { return ObString(size(), ptr()); };
  uint64_t hash() const;
  int hash(uint64_t &hash_val, uint64_t seed = 0) const;

  int64_t to_string(char *buf, const int64_t buf_len) const;

private:
  char buf_[N];
};

