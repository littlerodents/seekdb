                        if (xy_y < 0.)
                            ::boost::throw_exception(projection_exception(error_tolerance_condition), ::boost::source_location("deps/3rd/usr/local/oceanbase/deps/devel/include/boost/geometry/srs/projections/proj/aeqd.hpp", 220, __PRETTY_FUNCTION__));
                        else
                            xy_x = xy_y = 0.;
                    else {
                        xy_y = acos(xy_y);
                        xy_y /= sin(xy_y);
                        xy_x = xy_y * cosphi * sin(lp_lon);
                        xy_y *= (proj_parm.mode == equit) ? sinphi :
