  return (num_control_bytes + slot_align - 1) & (~slot_align + 1);
}


inline size_t AllocSize(size_t capacity, size_t slot_size, size_t slot_align) {
  return SlotOffset(capacity, slot_align) + capacity * slot_size;
}
