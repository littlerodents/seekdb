template <int64_t N, typename BlockAllocatorT, bool auto_free>
int ObBitSet<N, BlockAllocatorT, auto_free>::do_mask(int64_t begin_index, int64_t end_index)
{
  int64_t max_bit_count = bitset_word_array_.count() * PER_BITSETWORD_BITS;
  int ret = OB_SUCCESS;
  if (begin_index < 0 || begin_index >= max_bit_count || end_index < 0 || end_index >=max_bit_count
      || begin_index >= end_index) {
    ret = OB_INVALID_ARGUMENT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 4, "src/oblib/lib/container/ob_bit_set.h", 722, __FUNCTION__, ret, "invalid arguments", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(begin_index)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(begin_index)))&&>::value>("begin_index", ::oceanbase::common::check_char_array(begin_index)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(end_index)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(end_index)))&&>::value>("end_index", ::oceanbase::common::check_char_array(end_index)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(max_bit_count)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(max_bit_count)))&&>::value>("max_bit_count", ::oceanbase::common::check_char_array(max_bit_count)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
  } else {
    int64_t begin_word = begin_index / PER_BITSETWORD_BITS;
    int64_t end_word = end_index / PER_BITSETWORD_BITS;
    int64_t begin_pos = begin_index % PER_BITSETWORD_BITS;
    int64_t end_pos = end_index % PER_BITSETWORD_BITS;

    for (int64_t i = 0; i < begin_word; i++) {
      bitset_word_array_.at(i) = 0;
    }
    for (int64_t i = bitset_word_array_.count() - 1; i > end_word; i--) {
      bitset_word_array_.at(i) = 0;
    }

    for (int64_t i = 0; i < begin_pos; ++i) {
      bitset_word_array_.at(begin_word) &= ~((BitSetWord) 1 << i);
    }
    for (int64_t i = 1 + end_pos; i < PER_BITSETWORD_BITS; ++i) {
      bitset_word_array_.at(end_word) &= ~((BitSetWord) 1 << i);
    }
  }
  return ret;
}

