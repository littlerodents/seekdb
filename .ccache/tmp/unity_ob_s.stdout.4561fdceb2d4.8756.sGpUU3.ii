template <typename First, typename Pointer>
class ptr_pair
{
public:
    typedef First first_type;
    typedef Pointer second_type;
    ptr_pair(First const& f, Pointer s) : first(f), second(s) {}



    first_type first;
    second_type second;
};

template <typename First, typename Pointer> inline
ptr_pair<First, Pointer>
make_ptr_pair(First const& f, Pointer s)
{
    return ptr_pair<First, Pointer>(f, s);
}



template <typename First, typename Pointer>
class exclusive_ptr_pair
{
    public: exclusive_ptr_pair(exclusive_ptr_pair const &) = delete; exclusive_ptr_pair& operator=(exclusive_ptr_pair const &) = delete; public: typedef int boost_move_no_copy_constructor_or_assign; private: public: typedef int boost_move_emulation_t; private:
public:
    typedef First first_type;
    typedef Pointer second_type;
    exclusive_ptr_pair(First const& f, Pointer s) : first(f), second(s) {}


    exclusive_ptr_pair(exclusive_ptr_pair && p) : first(p.first), second(p.second) { p.second = 0; }
    exclusive_ptr_pair & operator=(exclusive_ptr_pair && p) { first = p.first; second = p.second; p.second = 0; return *this; }

    first_type first;
    second_type second;
};

template <typename First, typename Pointer> inline
exclusive_ptr_pair<First, Pointer>
make_exclusive_ptr_pair(First const& f, Pointer s)
{
    return exclusive_ptr_pair<First, Pointer>(f, s);
}

