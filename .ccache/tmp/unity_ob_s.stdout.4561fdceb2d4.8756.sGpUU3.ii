            template <typename Parameters, typename T>
            inline void setup_alsk(Parameters& par, par_mod_ster<T>& proj_parm)
            {
                static const T d2r = geometry::math::d2r<T>();

                static pj_complex<T> ABe[] = {
                    { .9945303, 0.},
                    { .0052083, -.0027404},
                    { .0072721, .0048181},
                    {-.0151089, -.1932526},
                    { .0642675, -.1381226},
                    { .3582802, -.2884586}
                };

                static pj_complex<T> ABs[] = {
                    { .9972523, 0.},
                    { .0052513, -.0041175},
                    { .0074606, .0048125},
                    {-.0153783, -.1968253},
