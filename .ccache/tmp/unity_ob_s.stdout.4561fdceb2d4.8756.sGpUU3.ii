template<typename GcType>
int ObGeoTypeUtil::simplify_multi_geo(ObGeometry *&geo, common::ObIAllocator &allocator)
{

  int ret= OB_SUCCESS;
  switch (geo->type()) {
    case ObGeoType::MULTILINESTRING: {
      typename GcType::sub_ml_type *mp = reinterpret_cast<typename GcType::sub_ml_type *>(geo);
      if ((__builtin_expect(!!(__null == (mp)),!!0))) {
        ret = OB_ERR_GIS_INVALID_DATA;
        do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::OB_PRINT("", 4, "src/share/geo/ob_geo_utils.h", 604, __FUNCTION__, ret, "invalid null pointer", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
      } else if (mp->size() == 1) {
        geo = &(mp->front());
      }
      break;
    }
    case ObGeoType::MULTIPOINT: {
      typename GcType::sub_mpt_type *mpt = reinterpret_cast<typename GcType::sub_mpt_type *>(geo);
      if ((__builtin_expect(!!(__null == (mpt)),!!0))) {
        ret = OB_ERR_GIS_INVALID_DATA;
        do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::OB_PRINT("", 4, "src/share/geo/ob_geo_utils.h", 614, __FUNCTION__, ret, "invalid null pointer", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
      } else if (mpt->size() == 1) {
        typename GcType::sub_pt_type *p = ({ typename GcType::sub_pt_type* ret = __null; if ((__builtin_expect(!!(__null != (&allocator)),!!1))) { void *_buf_ = (&allocator)->alloc(sizeof(typename GcType::sub_pt_type)); if ((__builtin_expect(!!(__null != (_buf_)),!!1))) { ret = new(_buf_) typename GcType::sub_pt_type(geo->get_srid()); } } ret; });
        if ((__builtin_expect(!!(__null == (p)),!!0))) {
          ret = OB_ERR_GIS_INVALID_DATA;
          do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::OB_PRINT("", 4, "src/share/geo/ob_geo_utils.h", 619, __FUNCTION__, ret, "invalid null pointer", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
        } else {
          p->set_data(mpt->front());
          geo = p;
        }
      }
      break;
    }
    case ObGeoType::MULTIPOLYGON: {
      typename GcType::sub_mp_type *mp = reinterpret_cast<typename GcType::sub_mp_type *>(geo);
      if ((__builtin_expect(!!(__null == (mp)),!!0))) {
        ret = OB_ERR_GIS_INVALID_DATA;
        do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::OB_PRINT("", 4, "src/share/geo/ob_geo_utils.h", 631, __FUNCTION__, ret, "invalid null pointer", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
      } else if (mp->size() == 1) {
        geo = &(mp->front());
      }
      break;
