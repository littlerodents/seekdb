        elements_type const& elements = rtree::elements(n);


        internal_stack.resize(internal_stack.size()+1);


        for ( typename elements_type::const_iterator it = elements.begin() ; it != elements.end() ; ++it )
        {


            if ( index::detail::predicates_check
                    <
