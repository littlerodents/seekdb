namespace
boost
    {
    namespace
    qvm
        {
        template <class T,int Rows,int Cols>
        struct
        mat
            {
            T a[Rows][Cols];
            template <class R>
            operator R() const
                {
                R r;
                assign(r,*this);
                return r;
                }
            };

        template <class M>
        struct mat_traits;

        template <class T,int Rows,int Cols>
        struct
        mat_traits< mat<T,Rows,Cols> >
            {
            typedef mat<T,Rows,Cols> this_matrix;
            typedef T scalar_type;
            static int const rows=Rows;
            static int const cols=Cols;

            template <int Row,int Col>
            static
            inline __attribute__ ((always_inline))
            scalar_type
            read_element( this_matrix const & x )
                {
                static_assert(Row>=0, "Row>=0");
                static_assert(Row<Rows, "Row<Rows");
                static_assert(Col>=0, "Col>=0");
                static_assert(Col<Cols, "Col<Cols");
                return x.a[Row][Col];
                }

            template <int Row,int Col>
            static
            inline __attribute__ ((always_inline))
            scalar_type &
            write_element( this_matrix & x )
                {
                static_assert(Row>=0, "Row>=0");
                static_assert(Row<Rows, "Row<Rows");
                static_assert(Col>=0, "Col>=0");
                static_assert(Col<Cols, "Col<Cols");
                return x.a[Row][Col];
                }

            static
            inline __attribute__ ((always_inline))
            scalar_type
            read_element_idx( int row, int col, this_matrix const & x )
                {
                (static_cast<void> (0));
                (static_cast<void> (0));
                (static_cast<void> (0));
                (static_cast<void> (0));
                return x.a[row][col];
                }

            static
            inline __attribute__ ((always_inline))
            scalar_type &
            write_element_idx( int row, int col, this_matrix & x )
                {
                (static_cast<void> (0));
                (static_cast<void> (0));
                (static_cast<void> (0));
                (static_cast<void> (0));
                return x.a[row][col];
                }
            };
        }
    }
