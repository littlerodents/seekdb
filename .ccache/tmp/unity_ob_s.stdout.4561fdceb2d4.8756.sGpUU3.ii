        start_idx = line_segments_->verts_.size() - 1;
      } else if (curr_dir != last_dir) {

        ObLineSegment seg;
        seg.verts = &line_segments_->verts_;
        seg.begin = start_idx;
        seg.end = line_segments_->verts_.size() - 1;

        start_idx = seg.end;
        last_dir = curr_dir;
        if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (line_segments_->segs_.push_back(seg)))),!!0))) {
        }
      }
    }
  }
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && line_segments_->verts_.size() > 0) {
    uint32_t last_idx = line_segments_->verts_.size() - 1;
    if (line_segments_->verts_[last_idx].x == end.x && line_segments_->verts_[last_idx].y == end.y) {

    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (line_segments_->verts_.push_back(end)))),!!0))) {
    }
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && start_idx < line_segments_->verts_.size() - 1) {

      ObLineSegment seg;
      seg.verts = &line_segments_->verts_;
      seg.begin = start_idx;
      seg.end = line_segments_->verts_.size() - 1;

      start_idx = seg.end;
      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (line_segments_->segs_.push_back(seg)))),!!0))) {
      }
    }
  }
  return ret;
}


