template<typename PtType>
void ObGeoAffineVisitor::affine(PtType *point)
{
  double x = point->x();
  double y = point->y();
  point->x(affine_->x_fac1 * x + affine_->y_fac1 * y + affine_->x_off);
  point->y(affine_->x_fac2 * x + affine_->y_fac2 * y + affine_->y_off);
}

