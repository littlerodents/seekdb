struct ObLink
{
  ObLink() : next_(__null) {}
  ~ObLink() { next_ = __null; }

  ObLink *next_;

  void reset() { next_ = __null; }
  bool is_deleted() const { return ((uint64_t)next_) & 1; }
};

inline bool is_last_bit_set(uint64_t x)
{
  return x & 1;
}

inline uint64_t clear_last_bit(uint64_t x)
{
  return x & ~1;
}


inline uint64_t set_last_bit(uint64_t *addr)
