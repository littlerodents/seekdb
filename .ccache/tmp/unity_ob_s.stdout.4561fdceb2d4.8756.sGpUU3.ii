template <typename RetType, typename Functype>
int ObIGeoDispatcher<RetType, Functype>::eval_tree_binary(const common::ObGeometry *g1,
                                                          const common::ObGeometry *g2,
                                                          const ObGeoEvalCtx &context,
                                                          RetType &result)
{
  int ret = ::oceanbase::common::OB_SUCCESS;
  if (g1->crs() != g2->crs()) {
    ret = OB_ERR_GIS_DIFFERENT_SRIDS;
    do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::OB_PRINT("", 4, "src/share/geo/ob_geo_dispatcher.h", 1115, __FUNCTION__, ret, "invalid different srids", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(g1->crs())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(g1->crs())))&&>::value>("g1->crs()", ::oceanbase::common::check_char_array(g1->crs())) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(g2->crs())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(g2->crs())))&&>::value>("g2->crs()", ::oceanbase::common::check_char_array(g2->crs()))); } } } while (false);
  } else {
    switch (g1->crs()) {
    case common::ObGeoCRS::Cartesian:
      ret = eval_tree_binary_cart(g1, g2, context, result);
      break;
    case common::ObGeoCRS::Geographic:
      ret = eval_tree_binary_geog(g1, g2, context, result);
      break;
    default:
      ret = OB_ERR_GIS_INVALID_DATA;
      break;
    }
  }
  return ret;
}

