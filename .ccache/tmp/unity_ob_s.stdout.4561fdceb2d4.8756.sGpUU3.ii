template <class T>
struct BitPattern {
  typedef typename std::make_unsigned<T>::type U;
  static constexpr U half_ones = (static_cast<U>(1) << (sizeof(U) * 4)) - 1;
  static constexpr U l =
      (sizeof(U) == 1) ? 1 : (half_ones / 0xff * (half_ones + 2));
  static constexpr U h = ~(l * 0x7f);
};





