  } else {
    const int64_t need_blocks = (new_size - 1) / BLOCK_CAPACITY + 1;
    int64_t left_count = new_size;
    for (int64_t i = 0; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && i < need_blocks; ++i) {
      if (i != need_blocks - 1) {
