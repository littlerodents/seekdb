          remain = 0;
          remain.items_[0] = static_cast<uint64_t>(num);
        }
        if (r_neg != l_neg) {
            unary_minus<IgnoreOverFlow>(quotient, quotient);
        }
        if (l_neg) {
          unary_minus<IgnoreOverFlow>(remain, remain);
        }
