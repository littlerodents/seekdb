        static bool const same_point_order
            = point_order<Geometry1>::value == point_order<Geometry2>::value;
        struct ASSIGN_IS_NOT_SUPPORTED_FOR_DIFFERENT_POINT_ORDER; typedef struct ASSIGN_IS_NOT_SUPPORTED_FOR_DIFFERENT_POINT_ORDER241 : boost::mpl::assert_ { static boost::mpl::failed ************ (ASSIGN_IS_NOT_SUPPORTED_FOR_DIFFERENT_POINT_ORDER::************ assert_arg()) (types<Geometry1, Geometry2>) { return 0; } } mpl_assert_arg241; enum { mpl_assertion_in_line_241 = sizeof( boost::mpl::assertion_failed<((same_point_order))>( mpl_assert_arg241::assert_arg() ) ) };





        static bool const same_closure
            = closure<Geometry1>::value == closure<Geometry2>::value;
        struct ASSIGN_IS_NOT_SUPPORTED_FOR_DIFFERENT_CLOSURE; typedef struct ASSIGN_IS_NOT_SUPPORTED_FOR_DIFFERENT_CLOSURE249 : boost::mpl::assert_ { static boost::mpl::failed ************ (ASSIGN_IS_NOT_SUPPORTED_FOR_DIFFERENT_CLOSURE::************ assert_arg()) (types<Geometry1, Geometry2>) { return 0; } } mpl_assert_arg249; enum { mpl_assertion_in_line_249 = sizeof( boost::mpl::assertion_failed<((same_closure))>( mpl_assert_arg249::assert_arg() ) ) };






        dispatch::convert<Geometry2, Geometry1>::apply(geometry2, geometry1);
