  bool is_end(ObIWkbGeomLineString *geo) override { ((void)(geo)); return true; }
  bool is_end(ObIWkbGeogMultiPoint *geo) override { ((void)(geo)); return true; }
  bool is_end(ObIWkbGeomMultiPoint *geo) override { ((void)(geo)); return true; }
