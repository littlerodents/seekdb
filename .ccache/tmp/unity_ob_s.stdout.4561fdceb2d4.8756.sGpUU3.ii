        typedef ::boost::concepts::detail::instantiate< &::boost::concepts::requirement_<void(*)(concepts::ConstPoint<Point>)>::failed> boost_concept_check116 __attribute__((__unused__));
        typedef ::boost::concepts::detail::instantiate< &::boost::concepts::requirement_<void(*)(concepts::ConstPoint<typename point_type<Box>::type>)>::failed> boost_concept_check118 __attribute__((__unused__));





        assert_dimension_equal<Point, Box>();

        typename calculation_type<Point, Box>::type result(0);

        detail::compute_pythagoras_point_box
            <
                dimension<Point>::value
            >::apply(point, box, result);

        return result;
    }
};

