template <typename T, int max_block_size,
          typename BlockAllocatorT, bool auto_free,
          typename BlockPointerArrayT,
          bool use_trivial_ctor, bool need_construct_items>
inline T *Ob2DArray<T, max_block_size, BlockAllocatorT, auto_free,
                    BlockPointerArrayT, use_trivial_ctor, need_construct_items>::get_obj_pos(int64_t i) const
{
  do{ if(__builtin_expect(!!(!(i >= 0)),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/oblib/lib/container/ob_2d_array.h", 267, __FUNCTION__, ret, "assert fail, exp=%s", "i >= 0"); } } } while (false); }; do { if (__builtin_expect(!!(1),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/oblib/lib/container/ob_2d_array.h", 267, __FUNCTION__, ret, "assert fail" " BACKTRACE:%s", oceanbase::common::lbt()); } } } while (false); }; } } while (false); ob_abort(); } } while(false);
  do{ if(__builtin_expect(!!(!(i < capacity_)),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/oblib/lib/container/ob_2d_array.h", 268, __FUNCTION__, ret, "assert fail, exp=%s", "i < capacity_"); } } } while (false); }; do { if (__builtin_expect(!!(1),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/oblib/lib/container/ob_2d_array.h", 268, __FUNCTION__, ret, "assert fail" " BACKTRACE:%s", oceanbase::common::lbt()); } } } while (false); }; } } while (false); ob_abort(); } } while(false);
  T *block = blocks_.at(i / BLOCK_CAPACITY);
  T *obj_buf = block + (i % BLOCK_CAPACITY);
  return obj_buf;
}

template <typename T, int max_block_size,
          typename BlockAllocatorT, bool auto_free,
          typename BlockPointerArrayT,
          bool use_trivial_ctor, bool need_construct_items>
void Ob2DArray<T, max_block_size, BlockAllocatorT, auto_free,
                    BlockPointerArrayT, use_trivial_ctor, need_construct_items>::construct_items(T *ptr, int64_t cnt)
{
  if (!use_trivial_ctor) {
    MyOp::array_construct(ptr, cnt);
  } else {
    memset(static_cast<void *> (ptr), 0, sizeof(T) * cnt);
  }
}

