namespace oceanbase {
namespace common {

int ObGeoMvtEncodeVisitor::visit(ObIWkbGeomPoint *geo)
{
  int ret = OB_SUCCESS;
  int32_t x = static_cast<int32_t>(geo->x()) - curr_x_;
  int32_t y = static_cast<int32_t>(geo->y()) - curr_y_;
  if (type_ == ObMVTType::MVT_POINT) {
    if (point_idx_ == 0 && (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (encode_buffer_.push_back(encode_command(ObMVTCommand::CMD_MOVE_TO, point_num_ == 0 ? 1 : point_num_))))),!!0))) {
    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (encode_buffer_.push_back(encode_param(x))))),!!0))) {
    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (encode_buffer_.push_back(encode_param(y))))),!!0))) {
    } else {
      curr_x_ = static_cast<int32_t>(geo->x());
      curr_y_ = static_cast<int32_t>(geo->y());
    }
  } else if (type_ == ObMVTType::MVT_LINE || type_ == ObMVTType::MVT_RING) {
    if (type_ == ObMVTType::MVT_RING && point_idx_ + 1 == point_num_) {
      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (encode_buffer_.push_back(encode_command(ObMVTCommand::CMD_CLOSE_PATH, 1))))),!!0))) {
      }
    } else {
      if (value_offset_ < line_to_offset_) {
        encode_buffer_[value_offset_++] = encode_param(x);
        encode_buffer_[value_offset_++] = encode_param(y);
      } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (encode_buffer_.push_back(encode_param(x))))),!!0))) {
      } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (encode_buffer_.push_back(encode_param(y))))),!!0))) {
      }
      curr_x_ = static_cast<int32_t>(geo->x());
      curr_y_ = static_cast<int32_t>(geo->y());
    }
  }
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
    point_idx_++;
  }
  return ret;
}
int ObGeoMvtEncodeVisitor::visit(ObIWkbGeomMultiPoint *geo)
{
  int ret = OB_SUCCESS;
  type_ = ObMVTType::MVT_POINT;
  point_num_ = geo->size();
  return ret;
}
int ObGeoMvtEncodeVisitor::visit(ObIWkbGeomLineString *geo)
{
  int ret = OB_SUCCESS;
  point_num_ = geo->size();
  type_ = ObMVTType::MVT_LINE;
  move_to_offset_ = encode_buffer_.size();
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (encode_buffer_.push_back(encode_command(ObMVTCommand::CMD_MOVE_TO, 1))))),!!0))) {
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (encode_buffer_.push_back((4294967295U))))),!!0))) {
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (encode_buffer_.push_back((4294967295U))))),!!0))) {
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (encode_buffer_.push_back(encode_command(ObMVTCommand::CMD_LINE_TO, point_num_ - 1))))),!!0))) {
  } else {
    line_to_offset_ = encode_buffer_.size() - 1;
    value_offset_ = move_to_offset_ + 1;
    point_idx_ = 0;
  }
  return ret;
}

int ObGeoMvtEncodeVisitor::visit(ObIWkbGeomLinearRing *geo)
{
  int ret = OB_SUCCESS;
  type_ = ObMVTType::MVT_RING;
  point_num_ = geo->size();
  move_to_offset_ = encode_buffer_.size();
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (encode_buffer_.push_back(encode_command(ObMVTCommand::CMD_MOVE_TO, 1))))),!!0))) {
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (encode_buffer_.push_back((4294967295U))))),!!0))) {
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (encode_buffer_.push_back((4294967295U))))),!!0))) {
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (encode_buffer_.push_back(encode_command(ObMVTCommand::CMD_LINE_TO, point_num_ - 2))))),!!0))) {
  } else {
    line_to_offset_ = encode_buffer_.size() - 1;
    value_offset_ = move_to_offset_ + 1;
    point_idx_ = 0;
  }
  return ret;
}

}
