                        if (xy_y <= epsilon10) {
                            ::boost::throw_exception(projection_exception(error_tolerance_condition), ::boost::source_location("deps/3rd/usr/local/oceanbase/deps/devel/include/boost/geometry/srs/projections/proj/stere.hpp", 229, __PRETTY_FUNCTION__));
                        }
