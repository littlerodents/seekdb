  }
  if (OB_SUCCESS == ret) {
    if (buf_len < (tmp_pos + (int64_t)sizeof(uint32_t) * desc.len_)) {
      ret = OB_BUF_NOT_ENOUGH;
    } else {
      if (0 < desc.len_) {
        memcpy(buf + tmp_pos, digits, sizeof(uint32_t) * desc.len_);
        tmp_pos += (sizeof(uint32_t) * desc.len_);
      }
    }
  }
  if (OB_SUCCESS == ret) {
    pos = tmp_pos;
  }
  return ret;
}

