                {
                static_assert(I>=0, "I>=0");
                static_assert(I<dim, "I<dim");
                return x.a[I];
                }

            static
            inline __attribute__ ((always_inline))
            scalar_type
            read_element_idx( int i, this_vector const & x )
                {
                (static_cast<void> (0));
