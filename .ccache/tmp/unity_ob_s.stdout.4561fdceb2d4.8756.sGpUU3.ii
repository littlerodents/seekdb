inline int ObLogger::check_log_end(ObPLogItem &log_item, int64_t pos)
{
  int ret = OB_SUCCESS;
  const int64_t buf_size = log_item.get_buf_size();
  if (buf_size > 0) {
    if (pos > buf_size - 2) {
      pos = buf_size - 2;
      ret = OB_SIZE_OVERFLOW;
    }

    char *data = log_item.get_buf();
    if (pos > 0 && data[pos - 1] != '\n') {
      data[pos++] = '\n';
    }
    data[pos] = '\0';
    log_item.set_data_len(pos);
  }
  return ret;
}

template<typename Function>
void ObLogger::log_it(const char *mod_name,
            const char *dba_event,
            const int32_t level,
            const char *file,
            const int32_t line,
            const char *function,
            const int errcode,
            Function &&log_data_func)
{
# 1011 "/work/src/oblib/lib/oblog/ob_log.h"
    int ret = OB_SUCCESS;
    if (__builtin_expect(!!(level <= 6),!!1)
        && __builtin_expect(!!(level >= 0),!!1)
        && __builtin_expect(!!(is_enable_logging()),!!1)
        && (__builtin_expect(!!(__null != (mod_name)),!!1)) && (__builtin_expect(!!(__null != (file)),!!1)) && (__builtin_expect(!!(__null != (function)),!!1))
        && (__builtin_expect(!!(__null != (function)),!!1))) {
      if (is_trace_mode()) {
        TraceBuffer *tb = nullptr;
        if ((__builtin_expect(!!(__null != (tb = get_trace_buffer())),!!1))) {

          while (true) {
            char *buf = tb->buffer_;
            int64_t buf_len = tb->get_cap();
            int64_t &pos = tb->get_pos();
            int64_t orig_pos = pos;
            int64_t ts = (oceanbase::common::ObTscTimestamp::get_instance()).current_time();
            ret = log_head(ts, mod_name, dba_event, level, file, line, function, errcode, buf, buf_len, pos);
            if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
              ret = log_data_func(buf, buf_len, pos);
            }
            if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
              ret = log_tail(level, buf, buf_len, pos);
            }
            if (OB_SIZE_OVERFLOW == ret && orig_pos > 0) {

              tb->set_pos(orig_pos);
              print_trace_buffer(mod_name, level, file, line, function);

              continue;
            }
            break;
          }
        }
      } else {
        do_log_message(is_async_log_used(), mod_name, dba_event, level, file, line, function, true,
                       errcode, log_data_func);
      }
    }
    ((void)(ret));
}

__attribute__((noinline, cold))
inline void ObLogger::log_message_fmt(const char *mod_name,
                 const int32_t level,
                 const char *file,
                 const int32_t line,
                 const char *function,
                 const int errcode,
                 const char *fmt, ...)
{
  if ((__builtin_expect(!!(__null != (fmt)),!!1))) {
    va_list args;
    __builtin_va_start(args, fmt);
    auto defer_varname1064 = common::MakeScopedLambda([&]() mutable { __builtin_va_end(args); });
    log_message_va(mod_name, level, file, line, function, errcode, fmt, args);
  }
}

inline void ObLogger::log_message_va(const char *mod_name,
                 const int32_t level,
                 const char *file,
                 const int32_t line,
                 const char *function,
                 const int errcode,
                 const char *fmt,
                 va_list args)
{
  if ((__builtin_expect(!!(__null != (fmt)),!!1))) {
    auto &&log_data_func = [&](char *buf, const int64_t buf_len, int64_t &pos) {
      va_list args_cpy;
      __builtin_va_copy(args_cpy, args);
      auto defer_varname1082 = common::MakeScopedLambda([&]() mutable { __builtin_va_end(args_cpy); });
      return logdata_vprintf(buf, buf_len, pos, fmt, args_cpy);
    };
    log_it(mod_name, nullptr, level, file, line, function, errcode, log_data_func);
  }
}

inline int32_t ObLogger::get_log_level() const
{
  int8_t cur_level = 4;
  if (enable_perf_mode_) {
    cur_level = 0;
  } else {
    cur_level = id_level_map_.get_level();

    if (! disable_thread_log_level_) {
      const ObLogIdLevelMap *session_id_level_map = ObThreadLogLevelUtils::get();
      int8_t thread_level = ObThreadLogLevelUtils::get_level();
      if (__null != session_id_level_map) {
        cur_level = session_id_level_map->get_level();
      } else if (7 != thread_level) {
        cur_level = thread_level;
      }
    }
  }
  return cur_level;
}

inline int32_t ObLogger::get_log_level(const uint64_t par_mod_id) const
{
  int8_t cur_level = 4;
  if (enable_perf_mode_) {
    cur_level = 0;
  } else {
    cur_level = id_level_map_.get_level(par_mod_id);

    if (! disable_thread_log_level_) {
      const ObLogIdLevelMap *session_id_level_map = ObThreadLogLevelUtils::get();
      int8_t thread_level = ObThreadLogLevelUtils::get_level();
      if (__null != session_id_level_map) {
        cur_level = session_id_level_map->get_level(par_mod_id);
      } else if (7 != thread_level) {
        cur_level = thread_level;
      }
    }
  }
  return cur_level;
}

inline int32_t ObLogger::get_log_level(const uint64_t par_mod_id, const uint64_t sub_mod_id) const
{
  int8_t cur_level = 4;
  if (enable_perf_mode_) {
    cur_level = 0;
  } else {
    cur_level = id_level_map_.get_level(par_mod_id, sub_mod_id);

    if (! disable_thread_log_level_) {
      const ObLogIdLevelMap *session_id_level_map = ObThreadLogLevelUtils::get();
      int8_t thread_level = ObThreadLogLevelUtils::get_level();
      if (__null != session_id_level_map) {
        cur_level = session_id_level_map->get_level(par_mod_id, sub_mod_id);
      } else if (7 != thread_level) {
        cur_level = thread_level;
      }
    }
  }
  return cur_level;
}

inline int ObLogger::set_mod_log_levels(const char *level_str, int64_t version)
{
  return parse_set(level_str, static_cast<int32_t>(std::strlen(level_str)), version);
}

extern void __attribute__ ((noinline)) on_probe_abort();

inline void ObLogger::check_probe(
      const char* file,
      int32_t line,
      bool& force_bt,
      bool& disable)
{
  force_bt = false;
  disable = false;
  for (int i = 0; i < probe_cnt_; i++) {
    auto &probe = probes_[i];
    if (line == probe.line_ &&
        ProbeAction::PROBE_NONE != probe.action_) {
      const char *filename = __null;
      if (__null == (filename = strrchr(file, '/'))) {
        filename = file;
      } else {
        filename++;
      }
      if (0 == strncmp(filename, probe.file_, sizeof probe.file_)) {
        switch (probe.action_) {
          case ProbeAction::PROBE_BT: {
            force_bt = true;
            break;
          }
          case ProbeAction::PROBE_ABORT: {
            on_probe_abort();
            break;
          }
          case ProbeAction::PROBE_DISABLE: {
            disable = true;
            break;
          }
          default: {

            break;
          }
        }
        break;
      }
    }
  }
}

