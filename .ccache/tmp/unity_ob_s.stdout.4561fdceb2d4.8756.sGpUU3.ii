inline constexpr bool operator==(S1Angle x, S1Angle y) {
  return x.radians() == y.radians();
}

inline constexpr bool operator!=(S1Angle x, S1Angle y) {
  return x.radians() != y.radians();
}

inline constexpr bool operator<(S1Angle x, S1Angle y) {
  return x.radians() < y.radians();
}

inline constexpr bool operator>(S1Angle x, S1Angle y) {
  return x.radians() > y.radians();
}

inline constexpr bool operator<=(S1Angle x, S1Angle y) {
  return x.radians() <= y.radians();
}

inline constexpr bool operator>=(S1Angle x, S1Angle y) {
  return x.radians() >= y.radians();
}

inline constexpr S1Angle operator-(S1Angle a) {
  return S1Angle::Radians(-a.radians());
}

