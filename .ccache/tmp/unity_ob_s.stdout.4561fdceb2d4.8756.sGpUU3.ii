        template <typename Params, typename T, typename Parameters> struct aeqd_entry : projections::detail::factory_entry<Params, T, Parameters> { projections::detail::dynamic_wrapper_b<T, Parameters>* create_new(Params const& params, Parameters const& parameters) const
        {
