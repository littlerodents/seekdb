  MAX_VEC_TC
};

inline bool ob_is_double_type(ObObjType);
inline bool ob_is_decimal_int(ObObjType);

inline __attribute__((always_inline)) VecValueTypeClass get_vec_value_tc(const ObObjType type, const int16_t scale,
                                             const int16_t precision)
{
  ((void)(precision));
  const static VecValueTypeClass maps[] = {
    VEC_TC_NULL,
    VEC_TC_INTEGER,
    VEC_TC_INTEGER,
