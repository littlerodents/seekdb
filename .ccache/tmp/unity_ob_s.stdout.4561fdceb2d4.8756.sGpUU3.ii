        base::traverse(*this, n);

        base::recalculate_aabb_if_necessary(n);
    }

    inline void operator()(leaf & n)
    {
        (static_cast<void> (0));

        (static_cast<void> (0));



        rtree::elements(n).push_back(base::m_element);

        base::handle_possible_reinsert_or_split_of_root(n);

        base::recalculate_aabb_if_necessary(n);
    }
