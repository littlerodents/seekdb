enum ObBoxPosition {
  INVALID = 0,
  INSIDE = 1,
  OUTSIDE = 2,
  LEFT_EDGE = 4,
  RIGHT_EDGE = 8,
  TOP_EDGE = 16,
  BOTTOM_EDGE = 32,
  TOPLEFT_CORNER = TOP_EDGE | LEFT_EDGE,
  TOPRIGHT_CORNER = TOP_EDGE | RIGHT_EDGE,
  BOTTOMLEFT_CORNER = BOTTOM_EDGE | LEFT_EDGE,
  BOTTOMRIGHT_CORNER = BOTTOM_EDGE | RIGHT_EDGE,
};

