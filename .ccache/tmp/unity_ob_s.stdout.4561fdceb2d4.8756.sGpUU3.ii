template <typename Geometry, int Dimensions>
inline void assert_dimension()
{
    static_assert(( static_cast<int>(dimension<Geometry>::value) == Dimensions ), "( static_cast<int>(dimension<Geometry>::value) == Dimensions )");
}





template <typename Geometry, int Dimensions>
inline void assert_dimension_less_equal()
{
    static_assert(( static_cast<int>(dimension<Geometry>::type::value) <= Dimensions ), "( static_cast<int>(dimension<Geometry>::type::value) <= Dimensions )");
}

template <typename Geometry, int Dimensions>
inline void assert_dimension_greater_equal()
{
    static_assert(( static_cast<int>(dimension<Geometry>::type::value) >= Dimensions ), "( static_cast<int>(dimension<Geometry>::type::value) >= Dimensions )");
}





template <typename G1, typename G2>
inline void assert_dimension_equal()
{
    static_assert(( static_cast<size_t>(dimension<G1>::type::value) == static_cast<size_t>(dimension<G2>::type::value) ), "( static_cast<size_t>(dimension<G1>::type::value) == static_cast<size_t>(dimension<G2>::type::value) )");
}

