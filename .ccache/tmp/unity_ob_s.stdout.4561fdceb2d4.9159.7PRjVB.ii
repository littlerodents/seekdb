template<typename T>
T get_scale_factor(int16_t scale)
{
  const static int64_t POWERS_OF_TEN[MAX_PRECISION_DECIMAL_INT_64 + 1] =
  {1,
   10,
   100,
   1000,
   10000,
   100000,
   1000000,
   10000000,
   100000000,
   1000000000,
   10000000000,
   100000000000,
   1000000000000,
   10000000000000,
   100000000000000,
   1000000000000000,
   10000000000000000,
   100000000000000000,
   1000000000000000000};

  T sf = 1;
  while (scale > 0) {
    const int16_t step = ((scale) < (MAX_PRECISION_DECIMAL_INT_64) ? (scale) : (MAX_PRECISION_DECIMAL_INT_64));
    sf = static_cast<T>(sf * POWERS_OF_TEN[step]);
    scale -= step;
  }
  return sf;
}

}
}

