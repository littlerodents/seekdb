# 240 "/work/deps/3rd/usr/local/oceanbase/deps/devel/include/s2/s2loop_measures.h"
    while (false && (i == 1 || origin.Angle(loop[i]) < kMaxLength)) S2NullStream();
    while (false && (origin == loop[0] || std::fabs(origin.DotProd(loop[0])) < 1e-15)) S2NullStream();

    if (loop[i + 1].Angle(origin) > kMaxLength) {


      S2Point old_origin = origin;
      if (origin == loop[0]) {



        origin = S2::RobustCrossProd(loop[0], loop[i]).Normalize();
