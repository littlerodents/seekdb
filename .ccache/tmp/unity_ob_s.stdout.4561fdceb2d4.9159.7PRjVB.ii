      : error_on_overlap_time_(false), tz_map_wrap_(), tz_id_(common::OB_INVALID_TZ_ID), offset_(0)
  {}
  virtual ~ObTimeZoneInfo() {}
  int assign(const ObTimeZoneInfo &src);
