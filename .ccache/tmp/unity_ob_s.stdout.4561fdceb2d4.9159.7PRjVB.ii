template <typename Value>
ObResourceValueStore<Value>::ObResourceValueStore()
  : ptr_(__null), ref_cnt_(0)
{
}

template <typename Value>
ObResourceValueStore<Value>::~ObResourceValueStore()
{
}

template <typename Value>
int ObResourceValueStore<Value>::inc_ref_cnt()
{
  int ret = common::OB_SUCCESS;
  do { (void) ({ ((void)(0)); ; __sync_add_and_fetch(((&ref_cnt_)), (1)); }); } while (0);
  return ret;
}

template <typename Value>
int ObResourceValueStore<Value>::dec_ref_cnt(int64_t &ref_cnt)
{
  int ret = common::OB_SUCCESS;
  bool finished = false;
  int64_t old_val = __atomic_load_n((&ref_cnt_), 5);
  int64_t new_val = 0;
  while (!finished) {
    new_val = old_val - 1;
    ref_cnt = new_val;
    finished = (old_val == (new_val = ({ ((void)(0)); ; __sync_val_compare_and_swap((&ref_cnt_), (old_val), (new_val)); })));
    old_val = new_val;
  }
  return ret;
}

template <typename Value>
int64_t ObResourceValueStore<Value>::get_ref_cnt() const
{
  return __atomic_load_n((&ref_cnt_), 5);
}

template <typename Value>
