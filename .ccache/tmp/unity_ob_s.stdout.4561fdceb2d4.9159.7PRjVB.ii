  {
    cb_busy_cnt = 0;
    near_to_gts_cnt = 0;
    other_error_cnt = 0;
    submit_succ_cnt = 0;
  }

  int64_t cb_busy_cnt;
  int64_t near_to_gts_cnt;
  int64_t other_error_cnt;
  int64_t submit_succ_cnt;
  KeepAliveLsInfo stat_keepalive_info_;

private:

};


