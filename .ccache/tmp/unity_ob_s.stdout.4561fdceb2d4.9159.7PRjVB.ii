    ret_bool = true;
  } else if (first & SHARE) {
    if ((second & EXCLUSIVE) || (second & ROW_EXCLUSIVE)) {

    } else {
      ret_bool = true;
    }
  } else if (first & ROW_EXCLUSIVE) {
    if ((second & SHARE) || (second & EXCLUSIVE)) {

    } else {
      ret_bool = true;
    }
  } else if (first & ROW_SHARE) {
    if ((second & SHARE)
        || (second & EXCLUSIVE)
        || (second & ROW_EXCLUSIVE)) {

    } else {
      ret_bool = true;
    }
  }
  return ret_bool;
}

