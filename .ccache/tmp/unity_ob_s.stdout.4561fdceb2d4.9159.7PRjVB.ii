inline __attribute__((always_inline)) int64_t popcount64(uint64_t v)
{
  int64_t cnt = 0;





  if (0 != v) {
    v = v - ((v >> 1) & 0x5555555555555555UL);
    v = (v & 0x3333333333333333UL) + ((v >> 2) & 0x3333333333333333UL);
    cnt = (((v + (v >> 4)) & 0xF0F0F0F0F0F0F0FUL) * 0x101010101010101UL) >> 56;
  }

  return cnt;
}

inline __attribute__((always_inline)) uint64_t blsr64(uint64_t mask)
{



    return mask & (mask-1);

}



inline __attribute__((always_inline)) uint64_t countr_zero64(uint64_t mask)
{
  return __builtin_ffsll(mask) - 1;
}


inline __attribute__((always_inline)) uint64_t countl_zero64(uint64_t mask)
{
  return __builtin_clzll(mask);
}


