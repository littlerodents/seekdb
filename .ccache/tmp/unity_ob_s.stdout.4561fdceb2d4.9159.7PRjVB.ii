    { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_tc_factory.h", 198, __FUNCTION__, ret, "invalid class type id", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(type_id)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(type_id)))&&>::value>("type_id", ::oceanbase::common::check_char_array(type_id))); } } } while (false); };
  } else {
