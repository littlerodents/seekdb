    }
    return_node = tmp_node;
    return return_node;
  }

  inline __attribute__((always_inline)) T *get_last(T *root) const
  {
    T *tmp_node = __null;
    T *return_node = __null;
    return_node = root;
    tmp_node = return_node;
    while ((__builtin_expect(!!(__null != ((return_node = get_right(return_node)))),!!1))) {
      tmp_node = return_node;
    }
    return_node = tmp_node;
    return return_node;
  }

  inline __attribute__((always_inline)) void rotate_left(T *node, T *&return_node)
  {
    return_node = get_right(node);
    set_right(node, get_left(return_node));
    set_left(return_node, node);
  }

  inline __attribute__((always_inline)) void rotate_right(T *node, T *&return_node)
  {
    return_node = get_left(node);
    set_left(node, get_right(return_node));
    set_right(return_node, node);
  }

