  databuff_printf(buf, buf_len, pos, k_);
  databuff_printf(buf, buf_len, pos, ", ");
  databuff_printf(buf, buf_len, pos, "v:");
  databuff_printf(buf, buf_len, pos, v_);
  databuff_printf(buf, buf_len, pos, "}");
  return pos;
}

