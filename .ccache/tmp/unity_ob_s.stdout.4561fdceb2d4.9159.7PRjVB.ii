  {
    if (common::OB_SUCCESS == last_ret_) {
      ObNumber tmp;
      if (common::OB_SUCCESS == (last_ret_ = tmp.from(v, allocator_))) {
        last_ret_ = res_.mul(tmp, res_, allocator_);
      }
    }
    return *this;
  }

  ObNumberCalc &add(const ObNumber &v)
  {
    if (common::OB_SUCCESS == last_ret_) {
      last_ret_ = res_.add(v, res_, allocator_);
    }
    return *this;
