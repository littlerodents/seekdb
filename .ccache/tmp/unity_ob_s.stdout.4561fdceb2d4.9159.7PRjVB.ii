template <typename Key, typename Value, typename MemMgrTag>
int ObLinearHashMap<Key, Value, MemMgrTag>::Cnter::init(HashMapMemMgr<MemMgrTag> &mem_mgr)
{
  int ret = OB_SUCCESS;
  if (__null != cnter_) {
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/hash/ob_linear_hash_map.h", 765, __FUNCTION__, ret, "init twice", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(cnter_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(cnter_)))&&>::value>("cnter_", ::oceanbase::common::check_char_array(cnter_))); } } } while (false);
    ret = OB_INIT_TWICE;
  } else {
    mem_mgr_ = &mem_mgr;
    int64_t sz = static_cast<int64_t>(CNTER_CNT * sizeof(Counter));
    if (__null == (cnter_ = static_cast<Counter*>(mem_mgr_->get_cnter_alloc().alloc(sz)))) {
      ret = OB_ALLOCATE_MEMORY_FAILED;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/hash/ob_linear_hash_map.h", 772, __FUNCTION__, ret, "failed to alloc counter", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(sz)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(sz)))&&>::value>("sz", ::oceanbase::common::check_char_array(sz))); } } } while (false);
    } else {
      for (int64_t idx = 0; idx < CNTER_CNT; ++idx) {
        Counter &cnter = cnter_[idx];
        cnter.cnt_ = 0;
        cnter.op_cnt_ = 0;
      }
    }
  }
  return ret;
}

template <typename Key, typename Value, typename MemMgrTag>
int ObLinearHashMap<Key, Value, MemMgrTag>::Cnter::destroy()
{

  if (__null != mem_mgr_ && __null != cnter_) {
    mem_mgr_->get_cnter_alloc().free(cnter_);
  }

  cnter_ = __null;
  mem_mgr_ = __null;
  return OB_SUCCESS;
}

template <typename Key, typename Value, typename MemMgrTag>
void ObLinearHashMap<Key, Value, MemMgrTag>::Cnter::add(const int64_t cnt,
                                               const int64_t th_id)
{
