    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 4, "src/data_plane/api/data_plane/scheduler/ob_dag_scheduler.h", 1430, __FUNCTION__, ret, "failed to alloc dag", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
  } else {
    ObIDag *new_dag = new (buf) T();
    if (new_dag->uses_reserved_allocator() != use_reserved_allocator) {
      ret = OB_ERR_UNEXPECTED;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 4, "src/data_plane/api/data_plane/scheduler/ob_dag_scheduler.h", 1435, __FUNCTION__, ret, "dag allocator class does not match", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::ObLogPrintPointerCnt<__typeof__(new_dag)>(new_dag)), std::is_rvalue_reference<decltype((::oceanbase::common::ObLogPrintPointerCnt<__typeof__(new_dag)>(new_dag)))&&>::value>("new_dag", ::oceanbase::common::ObLogPrintPointerCnt<__typeof__(new_dag)>(new_dag)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(use_reserved_allocator)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(use_reserved_allocator)))&&>::value>("use_reserved_allocator", ::oceanbase::common::check_char_array(use_reserved_allocator))); } } } while (false);
    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (new_dag->basic_init(allocator)))),!!0))) {
