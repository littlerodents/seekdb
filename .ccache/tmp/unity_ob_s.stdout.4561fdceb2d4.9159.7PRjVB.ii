inline __attribute__((always_inline)) void ObRowBuffer::reset()
{
  if (buf_ != local_buffer_) {
    if (nullptr != buf_) {
      common::ob_free(buf_);
    }
    buf_ = local_buffer_;
    buf_size_ = INIT_ROW_BUFFER_SIZE;
  }
}

