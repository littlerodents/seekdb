struct DefaultUniqueGuardAllocator : public ObIAllocator {
  void *alloc(const int64_t size) override {



    static lib::ObMemAttr attr("ObGuard");
    return ob_malloc(size, attr);
  }
  void* alloc(const int64_t size, const ObMemAttr &attr) override
  {
    ((void)(attr));
    return alloc(size);
  }
  void free(void *ptr) override {



    ob_free(ptr);
  }



  static DefaultUniqueGuardAllocator &get_default_allocator() {
    static DefaultUniqueGuardAllocator default_allocator;
    return default_allocator;
  }
};

template <typename T>
struct UniqueGuardFriend {
  static inline ObUniqueGuard<T> create_unique(T *data, ObIAllocator &alloc) {
    ObUniqueGuard<T> ptr;
    ptr.data_ = data;
    ptr.allocator_ = &alloc;
    return ptr;
  }
};

}



template <typename T>
class ObUniqueGuard
{
  friend class unittest::TestObGuard;
  template <typename T2>
  friend struct guard::UniqueGuardFriend;
  template <typename T3>
  friend class ObSharedGuard;
public:

  ObUniqueGuard() : data_(nullptr), allocator_(nullptr), deleter_(nullptr) {}


  ObUniqueGuard(const ObUniqueGuard<T> &rhs) :
  data_(nullptr), allocator_(nullptr), deleter_(nullptr) { swap_(rhs); }

  ~ObUniqueGuard() { reset(); }


  ObUniqueGuard<T> &operator=(const ObUniqueGuard<T> &rhs) {
    (void) assign(rhs);
    return *this;
  }


  int assign(const ObUniqueGuard<T> &rhs) {
    if (&rhs != this) {
      reset();
      swap_(rhs);
    }
    return OB_SUCCESS;
  }


  template <typename FUNC>
  int assign(T *data, FUNC &&deleter, ObIAllocator &alloc = guard::DefaultUniqueGuardAllocator::get_default_allocator()) {
    int ret = OB_SUCCESS;
    if ((__builtin_expect(!!(__null == (data)),!!0))) {
      ret = OB_INVALID_ARGUMENT;
    } else {
      ObFunction<void(T*)>* temp_ptr =
                            (ObFunction<void(T*)>*)alloc.alloc(sizeof(ObFunction<void(T*)>));
      if (__builtin_expect(!!(nullptr != temp_ptr),!!1)) {
        temp_ptr = new (temp_ptr)ObFunction<void(T*)>(alloc);

        ret = temp_ptr->assign(std::forward<FUNC>(deleter));
        if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
          reset();
          data_ = data;
          allocator_ = &alloc;
          deleter_ = temp_ptr;
        } else {
          alloc.free(temp_ptr);
        }
      } else {
        ret = OB_ALLOCATE_MEMORY_FAILED;
      }
    }
    return ret;
  }


  void reset() {
    if ((!(__builtin_expect(!!(__null == (data_)),!!0))) && (!(__builtin_expect(!!(__null == (allocator_)),!!0)))) {
      if ((!(__builtin_expect(!!(__null == (deleter_)),!!0))) && __builtin_expect(!!(deleter_->is_valid()),!!1)) {
        (*deleter_)(data_);
        allocator_->free(deleter_);
      } else {
        data_->~T();
