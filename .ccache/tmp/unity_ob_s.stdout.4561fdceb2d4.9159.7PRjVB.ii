    if (BITS_PER_WORD > pos) {
      ret = popcnt64(words_[0], pos);
    } else {
      int64_t wc_before = which_word(pos);
      for (int64_t i = 0; i < wc_before; ++i) {




        ret += __builtin_popcountll(words_[i]);
      }
      ret += popcnt64(words_[wc_before], pos - wc_before * BITS_PER_WORD);
    }
    return ret;
  }

  inline static int64_t count_before(const uint64_t *words, const int64_t pos)
  {
    int64_t ret = 0;
    if (BITS_PER_WORD > pos) {
      ret = popcnt64(words[0], pos);
    } else {
      int64_t wc_before = which_word(pos);
      for (int64_t i = 0; i < wc_before; ++i) {

        ret += __builtin_popcountll(words[i]);
      }
      ret += popcnt64(words[wc_before], pos - wc_before * BITS_PER_WORD);
    }
    return ret;
  }

  inline static int64_t popcnt64(const uint64_t word, const int64_t pos)
  {



    return (0 == pos) ? 0 : __builtin_popcountll(word << (BITS_PER_WORD - pos));
  }

private:
  uint64_t *words_;
  int64_t words_num_;

  BitSet(const BitSet&); void operator=(const BitSet&);
};

static const int64_t EXT_VALUE_BITS = 2;
inline __attribute__((always_inline)) static int64_t get_ext_size(const int64_t count)
{
  return (count * EXT_VALUE_BITS + 8 - 1) / 8;
}

struct ObBitMapMetaHeader
{
  uint8_t ext_offset_;
  uint8_t index_offset_;
  uint8_t data_offset_;
  union
  {
    uint8_t bit_packing_len_;
    uint8_t fix_data_cnt_;
    uint8_t index_byte_;
  };

  inline int64_t get_var_cnt() const
  {
    return (data_offset_ - index_offset_) / index_byte_ + 1;
  }

  inline bool has_ext_val() const
  {
    return (index_offset_ - ext_offset_) > 0;
  }

  inline bool is_var_exc() const
  {
    return (data_offset_ - index_offset_) > 0;
  }

  inline int64_t get_fix_data_size(const int64_t len) const
  {
    return len / fix_data_cnt_;
  }

  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"ext_offset", ::oceanbase::common::check_char_array(ext_offset_), "index_offset", ::oceanbase::common::check_char_array(index_offset_), "data_offset", ::oceanbase::common::check_char_array(data_offset_), "bit_packing_len", ::oceanbase::common::check_char_array(bit_packing_len_), "fix_data_cnt", ::oceanbase::common::check_char_array(fix_data_cnt_), "index_byte", ::oceanbase::common::check_char_array(index_byte_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };


}__attribute__((packed));

class ObBitMapMetaBaseWriter
{
public:
  ObBitMapMetaBaseWriter() { reset(); }

  int init(
      const common::ObIArray<int64_t> *exc_row_ids,
      const ObColDatums *col_datums,
      const common::ObObjMeta type);
  void reset() { memset(this, 0, sizeof(*this)); }
  int64_t size() const;
  inline bool is_bit_packing() const { return bit_packing_; }

protected:
  common::ObObjMeta type_;
  const ObColDatums *col_datums_;
  const common::ObIArray<int64_t> *exc_row_ids_;
  BitSet bitset_;
  ObBitStream ext_bs_;
  ObIntegerArrayGenerator index_gen_;
  ObBitStream packing_bs_;
  ObBitMapMetaHeader meta_;
  int64_t exc_total_size_;
  int64_t exc_fix_size_;
  int64_t index_byte_;
  uint64_t max_integer_;
  bool bit_packing_;
  bool has_ext_val_;
  bool is_inited_;
  bool var_store_;

private:
  ObBitMapMetaBaseWriter(const ObBitMapMetaBaseWriter&); void operator=(const ObBitMapMetaBaseWriter&);
};

template <ObObjTypeStoreClass StoreClass>
class ObBitMapMetaWriter : public ObBitMapMetaBaseWriter
{
public:
  ObBitMapMetaWriter() {}
  int traverse_exc(bool &suitable);
  int write(char *buf);

private:
  inline __attribute__((always_inline)) void process_cell(const common::ObDatum &datum);
  inline __attribute__((always_inline)) void fill_meta_header(bool &suitable);
  inline __attribute__((always_inline)) void fill_param();
  int write_bit_packing_data(char *buf);
  int write_fix_data(char *buf);
  int write_var_data(char *buf);
  inline __attribute__((always_inline)) static void write_cell(
      char *buf,
      int64_t &offset,
      const common::ObDatum &datum,
      const int64_t len);

private:
  ObBitMapMetaWriter(const ObBitMapMetaWriter&); void operator=(const ObBitMapMetaWriter&);
};

template <ObObjTypeStoreClass StoreClass>
int ObBitMapMetaWriter<StoreClass>::traverse_exc(bool &suitable)
{
  int ret = common::OB_SUCCESS;
  if (__builtin_expect(!!(!is_inited_),!!0)) {
    ret = common::OB_NOT_INIT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_STORAGE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""STORAGE""] ", 4, "src/storage/blocksstable/encoding/ob_encoding_bitset.h", 279, __FUNCTION__, ret, "not inited", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
  } else {
    exc_total_size_ = 0;
    var_store_ = false;
    exc_fix_size_ = -1;
    max_integer_ = 0;

    for (int64_t i = 0; i < exc_row_ids_->count(); ++i) {
      const int64_t row_id = exc_row_ids_->at(i);
      const common::ObDatum &datum = col_datums_->at(row_id);
      if (datum.is_null() || datum.is_nop()) {
        has_ext_val_ = true;
      } else {
        process_cell(datum);
      }
    }

    fill_param();
    fill_meta_header(suitable);
  }
  return ret;
}

template <ObObjTypeStoreClass StoreClass>
inline __attribute__((always_inline)) void ObBitMapMetaWriter<StoreClass>::fill_param()
{
  if (0 > exc_fix_size_) {
    if (exc_total_size_ <= (255)) {
      index_byte_ = 1;
    } else if (exc_total_size_ <= (65535)) {
      index_byte_ = 2;
    } else if (exc_total_size_ <= (4294967295U)) {
      index_byte_ = 4;
    } else {
      index_byte_ = 8;
    }
  } else {
    exc_total_size_ = exc_fix_size_ * exc_row_ids_->count();
  }
}

template <>
inline __attribute__((always_inline)) void ObBitMapMetaWriter<ObIntSC>::fill_param()
{
  exc_fix_size_ = get_packing_size(bit_packing_, max_integer_);
  exc_total_size_ = exc_fix_size_ * exc_row_ids_->count();
  exc_total_size_ = bit_packing_ ? (exc_total_size_ + 8 - 1) / 8 : exc_total_size_;
}

template <>
inline __attribute__((always_inline)) void ObBitMapMetaWriter<ObUIntSC>::fill_param()
{
  exc_fix_size_ = get_packing_size(bit_packing_, max_integer_);
  exc_total_size_ = exc_fix_size_ * exc_row_ids_->count();
  exc_total_size_ = bit_packing_ ? (exc_total_size_ + 8 - 1) / 8 : exc_total_size_;
}

template <ObObjTypeStoreClass StoreClass>
inline __attribute__((always_inline)) void ObBitMapMetaWriter<StoreClass>::fill_meta_header(bool &suitable)
{
  const int64_t bs_exc_cnt = has_ext_val_ ? exc_row_ids_->count() : 0;
  const int64_t ext_len = BitSet::get_words_num(col_datums_->count()) * BitSet::BYTE_PER_WORD;
  const int64_t bs_len = get_ext_size(bs_exc_cnt);
  const int64_t index_len = exc_fix_size_ < 0 ? (exc_row_ids_->count() - 1) * index_byte_ : 0;

  if ((255) < (ext_len + bs_len + index_len)) {
    suitable = false;
  } else {
    meta_.ext_offset_ = static_cast<uint8_t>(ext_len);
    meta_.index_offset_ = static_cast<uint8_t>(ext_len + bs_len);
    meta_.data_offset_ = static_cast<uint8_t>(ext_len + bs_len + index_len);
    if (bit_packing_) {
      meta_.bit_packing_len_ = static_cast<uint8_t>(exc_fix_size_);
    } else if (0 > exc_fix_size_) {
      meta_.index_byte_ = static_cast<uint8_t>(index_byte_);
    } else {
      meta_.fix_data_cnt_ = static_cast<uint8_t>(exc_row_ids_->count());
    }
  }
}

template <ObObjTypeStoreClass StoreClass>
inline __attribute__((always_inline)) void ObBitMapMetaWriter<StoreClass>::process_cell(const common::ObDatum &datum)
{
  const int64_t len = datum.len_;
  exc_total_size_ += len;
  if (!var_store_) {
    if (exc_fix_size_ < 0) {
      exc_fix_size_ = len;
    } else if (len != exc_fix_size_) {
      exc_fix_size_ = -1;
      var_store_ = true;
    }
  }
}

template <>
inline __attribute__((always_inline)) void ObBitMapMetaWriter<ObIntSC>::process_cell(const common::ObDatum &datum)
{
  const uint64_t integer_mask = INTEGER_MASK_TABLE[get_type_size_map()[type_.get_type()]];
  const uint64_t v = datum.get_uint64() & integer_mask;
  if (v > max_integer_) {
    max_integer_ = v;
  }
}

template <>
inline __attribute__((always_inline)) void ObBitMapMetaWriter<ObUIntSC>::process_cell(const common::ObDatum &datum)
{
  const uint64_t integer_mask = INTEGER_MASK_TABLE[get_type_size_map()[type_.get_type()]];
  const uint64_t v = datum.get_uint64() & integer_mask;
  if (v > max_integer_) {
    max_integer_ = v;
  }
}


