public:
  void set_exiting() { is_exiting_ = true; }
  bool is_exiting() const { return is_exiting_; }
  int64_t get_trans_expired_time() const { return trans_expired_time_; }

  const ObTransID &get_trans_id() const { return trans_id_; }
