template <int64_t N, typename BlockAllocatorT, bool auto_free>
typename ObBitSet<N, BlockAllocatorT, auto_free>::BitSetWord ObBitSet<N, BlockAllocatorT, auto_free>::get_bitset_word(
    int64_t index) const
