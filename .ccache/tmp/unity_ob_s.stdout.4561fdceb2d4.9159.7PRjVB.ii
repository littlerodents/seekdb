      {
      }
  ObIndexSSTableEstimateContext(
      const ObITableReadInfo &index_read_info,
      const common::ObQueryFlag &query_flag)
      : index_read_info_(index_read_info),
      tablet_handle_(nullptr),
      query_flag_(query_flag)
      {}
  ~ObIndexSSTableEstimateContext() {}
  inline __attribute__((always_inline)) bool is_valid() const
  {
    return tablet_handle_ == nullptr || tablet_handle_->is_valid();
  }

  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"tablet_handle", ::oceanbase::common::check_char_array(tablet_handle_), "query_flag", ::oceanbase::common::check_char_array(query_flag_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
  const ObITableReadInfo &index_read_info_;
