protected:
  void *tracked_alloc(const int64_t size,
                      const ObMemAttr &attr,
                      MemoryUsageTracker *tracker)
  {
    void *ptr = nullptr;
    if (__null == allocator_) {
      ObMalloc fallback_allocator(attr);
