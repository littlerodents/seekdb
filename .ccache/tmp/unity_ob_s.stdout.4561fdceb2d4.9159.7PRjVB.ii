template<typename BtreeKey, typename BtreeVal>
int BtreeIterator<BtreeKey, BtreeVal>::scan_batch()
{
  int ret = OB_SUCCESS;
  if (is_iter_end_) {
    ret = OB_ITER_END;
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (iter_->set_key_range(start_key_, start_exclude_, end_key_, end_exclude_)))),!!0))) {




  } else {
