    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (construct_assign(buffer[count_], obj)))),!!0))) {
    } else {
      ++count_;
    }
  }
  return ret;
}

template<typename T, int64_t LOCAL_ARRAY_SIZE>
int ObFastArray<T, LOCAL_ARRAY_SIZE>::push_back_when_full(const T &obj)
{
  int ret = OB_SUCCESS;
  T* source = get_buffer();
