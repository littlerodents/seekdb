template <typename FakeAllocator, typename... Args>
template <typename ALLOCATOR>
bool ObShareResourceThrottleTool<FakeAllocator, Args...>::exceeded_resource_limit(const int64_t alloc_size)
{
  ObThrottleUnit<FakeAllocator> &share_throttle_unit = module_throttle_tuple_.template element<ModuleThrottleTool<FakeAllocator>>().module_throttle_unit_;;
  ObThrottleUnit<ALLOCATOR> &module_throttle_unit = module_throttle_tuple_.template element<ModuleThrottleTool<ALLOCATOR>>().module_throttle_unit_; ALLOCATOR *allocator = module_throttle_tuple_.template element<ModuleThrottleTool<ALLOCATOR>>().allocator_;;

  int64_t module_hold = allocator->hold();
  SumModuleHoldResourceFunctor sum_hold_func;
  (void)module_throttle_tuple_.for_each(sum_hold_func);

  bool share_exceeded = share_throttle_unit.exceeded_resource_limit(sum_hold_func.sum_, alloc_size);
