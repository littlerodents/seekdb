  ObCheckpointDList new_create_list_;
  ObCheckpointDList active_list_;
  ObCheckpointDList prepare_list_;


  ObCheckpointDList ls_frozen_list_;

  struct ObCheckpointLock
  {
    common::SpinRWLock ls_frozen_list_lock_;
    common::SpinRWLock new_create_list_lock_;
    common::SpinRWLock active_list_lock_;
    common::SpinRWLock prepare_list_lock_;
  } lock_;

  bool ls_freeze_finished_;

  static __thread bool is_global_freeze_for_flush_;
  static __thread ObFreezeSourceFlag freeze_source_;
};







class ObCheckpointLockGuard
{
public:
  ObCheckpointLockGuard(ObDataCheckpoint &data_checkpoint,
      uint8_t flag,
      const char *owner = "unknown",
      const int64_t warn_threshold = 50 * 1000 )
  : time_guard_(owner, warn_threshold),
    lock_(data_checkpoint.lock_),
    flag_(flag)
  {
    if (0 != (flag & LS_FROZEN)) {
      lock(flag, lock_.ls_frozen_list_lock_);
    }
    if (0 != (flag & NEW_CREATE)) {
      lock(flag, lock_.new_create_list_lock_);
    }
    if (0 != (flag & ACTIVE)) {
      lock(flag, lock_.active_list_lock_);
    }
    if (0 != (flag & PREPARE)) {
      lock(flag, lock_.prepare_list_lock_);
    }
  }

  ~ObCheckpointLockGuard()
  {
    if (0 != (flag_ & PREPARE)) {
      unlock(flag_, lock_.prepare_list_lock_);
    }
    if (0 != (flag_ & ACTIVE)) {
      unlock(flag_, lock_.active_list_lock_);
    }
    if (0 != (flag_ & NEW_CREATE)) {
      unlock(flag_, lock_.new_create_list_lock_);
    }
    if (0 != (flag_ & LS_FROZEN)) {
      unlock(flag_, lock_.ls_frozen_list_lock_);
    }
  }

  static void lock(uint8_t flag, common::SpinRWLock &lock)
  {
    int ret = OB_SUCCESS;
    do {
      if (0 != (flag & 0x80)) {
        ret = lock.wrlock();
      } else {
        ret = lock.rdlock();
      }
      if (OB_SUCCESS != ret) {
        do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_STORAGE, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""STORAGE""] ", 3, "src/storage/checkpoint/ob_data_checkpoint.h", 286, __FUNCTION__, ret, "failed to lock checkpoint lock", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(ret), std::is_rvalue_reference<decltype((ret))&&>::value>("ret", ret) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(common::ob_error_name(ret)), std::is_rvalue_reference<decltype((common::ob_error_name(ret)))&&>::value>("ret", common::ob_error_name(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(flag)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(flag)))&&>::value>("flag", ::oceanbase::common::check_char_array(flag))); } } } while (false);
        usleep(100);
      }
    } while (OB_SUCCESS != ret);
  }

  static void unlock(uint8_t flag, common::SpinRWLock &lock)
  {
    if (0 != (flag & 0x80)) {
      lock.wrunlock();
    } else {
      lock.rdunlock();
    }
  }

  void click(const char *mod = __null) { time_guard_.click(mod); }
private:
  ObTimeGuard time_guard_;
  ObDataCheckpoint::ObCheckpointLock &lock_;
  uint8_t flag_;
};

static const ObTabletID LS_DATA_CHECKPOINT_TABLET(ObDataCheckpoint::LS_DATA_CHECKPOINT_TABLET_ID);

}
}
