const char *ObRoleMgr::get_state_str() const
{
  switch (state_) {
    case ERROR:
      return "ERROR";
    case INIT:
      return "INIT";
    case NOTSYNC:
      return "NOTSYNC";
    case ACTIVE:
      return "ACTIVE";
    case SWITCHING:
      return "SWITCHING";
    case STOP:
      return "STOP";
    case HOLD:
      return "HOLD";
    case BOOTOK:
      return "BOOTOK";
    default:
      return "UNKNOWN";
  }
}

}
}
