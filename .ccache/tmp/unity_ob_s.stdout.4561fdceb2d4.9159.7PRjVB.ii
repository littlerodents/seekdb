inline __attribute__((always_inline)) int ObPushdownOperator::filter_row_outside(const ObExprPtrIArray &exprs, const sql::ObBitVector &skip_bit, bool &filtered)
{
  int ret = common::OB_SUCCESS;
  ((void)(skip_bit));
  ret = ObOperator::filter_row(eval_ctx_, exprs, filtered);






  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
    clear_datum_eval_flag();
  }
  return ret;
}

