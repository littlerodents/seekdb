      bool need_break = false;
      if (op_.do_flush_scn_ >= mds_node.redo_scn_ && op_.do_flush_scn_ < mds_node.end_scn_) {
        need_break = true;
        op_.do_flush_scn_ = std::min(op_.do_flush_scn_, share::SCN::minus(mds_node.redo_scn_, 1));
