inline __attribute__((always_inline)) int ObBitStream::get(const unsigned char *buf,
    const int64_t offset, const int64_t cnt, int64_t &value)
{
  int ret = common::OB_SUCCESS;
  int64_t index = offset;
  int64_t done = 0;
  uint64_t v = 0;
