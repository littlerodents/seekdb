namespace oceanbase
{
namespace share
{
struct ObScnRange
{
  public: int serialize(char *buf, const int64_t buf_len, int64_t &pos) const ; int serialize_(char *buf, const int64_t buf_len, int64_t &pos) const; int deserialize(const char *buf, const int64_t data_len, int64_t &pos) ; int deserialize_(const char *buf, const int64_t data_len, int64_t &pos); int64_t get_serialize_size() const ; int64_t get_serialize_size_() const;; private: const static int64_t UNIS_VERSION = 1;
public:
  static const SCN MIN_SCN;
  static const SCN MAX_SCN;

  ObScnRange();
  int64_t hash() const;

  inline __attribute__((always_inline)) void reset()
  {
    start_scn_ = MIN_SCN;
    end_scn_ = MIN_SCN;
  }

  inline __attribute__((always_inline)) bool is_valid() const
  {
    return start_scn_.is_valid() && end_scn_.is_valid() && end_scn_ >= start_scn_;
  }

  inline __attribute__((always_inline)) bool is_empty() const
  {
    return end_scn_ == start_scn_;
  }

  inline __attribute__((always_inline)) bool operator == (const ObScnRange &range) const
  {
    return start_scn_ == range.start_scn_
        && end_scn_ == range.end_scn_;
  }

  inline __attribute__((always_inline)) bool operator != (const ObScnRange &range) const
  {
    return !this->operator==(range);
  }

  inline __attribute__((always_inline)) bool contain(const SCN &scn) const
  {
    return is_valid() && start_scn_ < scn
      && end_scn_ >= scn;
  }
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"start_scn", ::oceanbase::common::check_char_array(start_scn_), "end_scn", ::oceanbase::common::check_char_array(end_scn_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };

public:
  SCN start_scn_;
  SCN end_scn_;
};


}
