        MAX_CACHE_SIZE / lib::ACHUNK_SIZE
        + 2 * (ObKVCacheStore::WASH_THREAD_RETIRE_LIMIT
               + ObKVCacheStore::RETIRE_LIMIT * OB_MAX_THREAD_NUM);

