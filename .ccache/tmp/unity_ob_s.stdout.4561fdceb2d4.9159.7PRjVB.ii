private:
  inline __attribute__((always_inline)) int is_datum_equal(
      const common::ObDatum &left,
      const common::ObDatum &right,
      bool &equal) const;

  int64_t ref_col_idx_;
  common::ObArray<int64_t> exc_row_ids_;
  ObObjTypeStoreClass store_class_;
