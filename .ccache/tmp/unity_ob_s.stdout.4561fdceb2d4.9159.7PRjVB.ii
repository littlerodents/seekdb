  } else if (__builtin_expect(!!(index >= bit_count()),!!0)) {

  } else {
    bool_ret = ((bitset_word_array_[index >> PER_BITSETWORD_MOD_BITS]
                 & ((BitSetWord) 1 << (index & PER_BITSETWORD_MASK))) != 0);
