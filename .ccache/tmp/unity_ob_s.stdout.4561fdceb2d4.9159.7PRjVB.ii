  } else if (c == FormatConversionCharInternal::c) { return "c"[0]; } else if (c == FormatConversionCharInternal::s) { return "s"[0]; } else if (c == FormatConversionCharInternal::d) { return "d"[0]; } else if (c == FormatConversionCharInternal::i) { return "i"[0]; } else if (c == FormatConversionCharInternal::o) { return "o"[0]; } else if (c == FormatConversionCharInternal::u) { return "u"[0]; } else if (c == FormatConversionCharInternal::x) { return "x"[0]; } else if (c == FormatConversionCharInternal::X) { return "X"[0]; } else if (c == FormatConversionCharInternal::f) { return "f"[0]; } else if (c == FormatConversionCharInternal::F) { return "F"[0]; } else if (c == FormatConversionCharInternal::e) { return "e"[0]; } else if (c == FormatConversionCharInternal::E) { return "E"[0]; } else if (c == FormatConversionCharInternal::g) { return "g"[0]; } else if (c == FormatConversionCharInternal::G) { return "G"[0]; } else if (c == FormatConversionCharInternal::a) { return "a"[0]; } else if (c == FormatConversionCharInternal::A) { return "A"[0]; } else if (c == FormatConversionCharInternal::n) { return "n"[0]; } else if (c == FormatConversionCharInternal::p) { return "p"[0];

  } else {
