    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_STORAGE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""STORAGE""] ", 4, "src/storage/blocksstable/encoding/ob_bit_stream.h", 168, __FUNCTION__, ret, "not init", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
