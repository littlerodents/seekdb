};

inline __attribute__((always_inline)) ObIndexBlockTreeCursor::TreeType *get_index_tree_type_map()
{
  static ObIndexBlockTreeCursor::TreeType tree_type_map[] = {
      ObIndexBlockTreeCursor::DATA_MACRO_META,
      ObIndexBlockTreeCursor::TREE_TYPE_MAX
  };
  static_assert(static_cast<int64_t>(sizeof(tree_type_map)/sizeof(tree_type_map[0])) == ObMacroBlockMetaType::MAX + 1, "tree type map count mismatch with macro block meta type count");

  return tree_type_map;
};

}
