      ret = OB_ALLOCATE_MEMORY_FAILED;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_MDS, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""MDS""] ", 4, "src/storage/tablet/ob_i_tablet_mds_interface.ipp", 108, __FUNCTION__, ret, "fail to alloc memory", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(key_size)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(key_size)))&&>::value>("key_size", ::oceanbase::common::check_char_array(key_size))); } } } while (false);
    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (key.mds_serialize(buffer, key_size, pos)))),!!0))) {
    } else {
      key_str.assign_ptr(buffer, key_size);
