static const char *to_str_tx_state(ObTxState state)
{
  const char *str = "INVALID";
  switch (state) {
    case ObTxState::UNKNOWN: str = "UNKNOWN"; break;
    case ObTxState::INIT: str = "INIT"; break;
    case ObTxState::REDO_COMPLETE: str = "REDO_COMPLETE"; break;
    case ObTxState::PREPARE: str = "PREPARE"; break;
    case ObTxState::PRE_COMMIT: str = "PRE_COMMIT"; break;
    case ObTxState::COMMIT: str = "COMMIT"; break;
    case ObTxState::ABORT: str = "ABORT"; break;
    case ObTxState::CLEAR: str = "CLEAR"; break;
    case ObTxState::MAX: str = "MAX"; break;
  };
  return str;
}
