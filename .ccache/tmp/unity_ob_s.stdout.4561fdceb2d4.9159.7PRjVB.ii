inline bool MdsTableHandle::is_valid() const
{
  uint8_t mds_table_id = __atomic_load_n((&mds_table_id_), 5);
  return mds_table_id >= MDS_TABLE_ID_OFFSET
      && mds_table_id < MDS_TABLE_ID_OFFSET + MdsTableTypeTuple::get_element_size();
}

