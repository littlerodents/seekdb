                 share::SCN &trans_version,
                 const int64_t read_seq = 0) const;
  template <typename T, typename OP, typename std::enable_if< ::oceanbase::common::meta::is_function_like<typename std::decay<OP>::type, int(const T&)>::value, bool>::type = true>
  int get_latest_committed(OP &&read_op) const;
