  {
    uint32_t pack_;
    struct
    {
      uint32_t col_idx_ : 24;
      uint32_t col_type_ : 8;
    };
  };
};

enum ObSkipIndexUpperStoreSize {
  SKIP_INDEX_NULL_UPPER_SIZE = 0,
  SKIP_INDEX_8BYTE_UPPER_SIZE = 8,
  SKIP_INDEX_2BYTE_LEN_DATA_UPPER_SIZE = 10,
  SKIP_INDEX_4BYTE_LEN_DATA_UPPER_SIZE = 12,
  SKIP_INDEX_VAR_LENGTH_UPPER_SIZE = ObSkipIndexColMeta::MAX_SKIP_INDEX_COL_LENGTH,
};

inline __attribute__((always_inline)) static int get_skip_index_store_upper_size(
    const ObObjDatumMapType type,
    const int16_t precision,
    uint32_t &upper_size)
{
  static const uint32_t OBOBJ_DATUM_MAP_TYPE_TO_AGG_UPPER_SIZE_MAP[] = {
    SKIP_INDEX_NULL_UPPER_SIZE,
    SKIP_INDEX_VAR_LENGTH_UPPER_SIZE,
    SKIP_INDEX_VAR_LENGTH_UPPER_SIZE,
    SKIP_INDEX_8BYTE_UPPER_SIZE,
    SKIP_INDEX_8BYTE_UPPER_SIZE,
    SKIP_INDEX_8BYTE_UPPER_SIZE,
    SKIP_INDEX_4BYTE_LEN_DATA_UPPER_SIZE,
    SKIP_INDEX_2BYTE_LEN_DATA_UPPER_SIZE,
    SKIP_INDEX_8BYTE_UPPER_SIZE,
    SKIP_INDEX_VAR_LENGTH_UPPER_SIZE,
  };
  static_assert(sizeof(OBOBJ_DATUM_MAP_TYPE_TO_AGG_UPPER_SIZE_MAP)
                / sizeof(OBOBJ_DATUM_MAP_TYPE_TO_AGG_UPPER_SIZE_MAP[0]) == OBJ_DATUM_MAPPING_MAX,
      "new added ObObjDatumMapType should extend this map");
  static const uint32_t OBOBJ_DECIMAL_INT_TO_AGG_UPPER_SIZE_MAP[] =
  {
    sizeof(int32_t),
    sizeof(int64_t),
    sizeof(int128_t),
    sizeof(int256_t),
    sizeof(int512_t),
  };
  int ret = OB_SUCCESS;
  upper_size = 0;
  if (__builtin_expect(!!(type >= OBJ_DATUM_MAPPING_MAX),!!0)) {
    ret = OB_ERR_UNEXPECTED;
    { int __ret__ = OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_STORAGE, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""STORAGE""] ", 3, "src/storage/blocksstable/index_block/ob_index_block_util.h", 156, __FUNCTION__, ret, "invalid obj type", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(type)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(type)))&&>::value>("type", ::oceanbase::common::check_char_array(type))); } } } while (false); };
  } else if (OBJ_DATUM_DECIMALINT == type) {
    if (__builtin_expect(!!(precision < 0 || precision > OB_MAX_DECIMAL_PRECISION),!!0)) {
      ret = OB_ERR_UNEXPECTED;
      { int __ret__ = OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_STORAGE, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""STORAGE""] ", 3, "src/storage/blocksstable/index_block/ob_index_block_util.h", 161, __FUNCTION__, ret, "invalid decimal int precision", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(type)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(type)))&&>::value>("type", ::oceanbase::common::check_char_array(type)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(precision)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(precision)))&&>::value>("precision", ::oceanbase::common::check_char_array(precision))); } } } while (false); };

    } else {
      const ObDecimalIntWideType decimalint_type = get_decimalint_type(precision);
      upper_size = OBOBJ_DECIMAL_INT_TO_AGG_UPPER_SIZE_MAP[decimalint_type];
    }
  } else {
    upper_size = OBOBJ_DATUM_MAP_TYPE_TO_AGG_UPPER_SIZE_MAP[type];
  }
  return ret;
}

inline __attribute__((always_inline)) static bool is_skip_index_black_list_type(const ObObjType &obj_type)
{
  return ObNullType == obj_type || ob_is_json_tc(obj_type) || ob_is_geometry_tc(obj_type)
      || ob_is_collection_sql_type(obj_type);
}

inline __attribute__((always_inline)) static bool is_skip_index_while_list_type(const ObObjType &obj_type)
{
  const ObObjTypeClass tc = ob_obj_type_class(obj_type);
  return (ObIntTC <= tc && tc <= ObLobTC) || ObDecimalIntTC == tc || ObMySQLDateTC == tc
         || ObMySQLDateTimeTC == tc;
}

inline __attribute__((always_inline)) static bool can_agg_sum(const ObObjType &obj_type)
{
  return is_skip_index_while_list_type(obj_type) && ob_is_numeric_type(obj_type)
      && ob_obj_type_class(obj_type) != ObObjTypeClass::ObBitTC;
}

inline __attribute__((always_inline)) static int get_sum_store_size(const ObObjType &obj_type, uint32_t &sum_size)
{
  int ret = OB_SUCCESS;
  if (__builtin_expect(!!(ObNullType > obj_type || ObMaxType < obj_type || !can_agg_sum(obj_type)),!!0)) {
    ret = OB_ERR_UNEXPECTED;
    { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_STORAGE, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""STORAGE""] ", 3, "src/storage/blocksstable/index_block/ob_index_block_util.h", 196, __FUNCTION__, ret, "invalid type from sum", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(obj_type)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(obj_type)))&&>::value>("obj_type", ::oceanbase::common::check_char_array(obj_type))); } } } while (false); };
  } else {
    switch(ob_obj_type_class(obj_type)) {
      case ObObjTypeClass::ObIntTC:
      case ObObjTypeClass::ObUIntTC:
      case ObObjTypeClass::ObDecimalIntTC:
      case ObObjTypeClass::ObNumberTC:
        sum_size = common::OBJ_DATUM_NUMBER_RES_SIZE;
        break;
      case ObObjTypeClass::ObFloatTC: {
        sum_size = sizeof(float);
        break;
      }
      case ObObjTypeClass::ObDoubleTC: {
        sum_size = sizeof(double);
        break;
      }
      default: {
      ret = OB_ERR_UNEXPECTED;
      { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_STORAGE, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""STORAGE""] ", 3, "src/storage/blocksstable/index_block/ob_index_block_util.h", 215, __FUNCTION__, ret, "invalid type from sum", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(obj_type)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(obj_type)))&&>::value>("obj_type", ::oceanbase::common::check_char_array(obj_type))); } } } while (false); };
    }
    }
  }
  return ret;
}

inline __attribute__((always_inline)) static bool non_baseline_enabled_agg_type(const ObSkipIndexColType &col_type)
{
  return ObSkipIndexColType::SK_IDX_BM25_MAX_SCORE_TOKEN_FREQ == col_type
      || ObSkipIndexColType::SK_IDX_BM25_MAX_SCORE_DOC_LEN == col_type
      || ObSkipIndexColType::SK_IDX_MIN == col_type
      || ObSkipIndexColType::SK_IDX_MAX == col_type;
}

int get_prefix_for_string_tc_datum(
    const ObDatum &orig_datum,
    const ObObjType obj_type,
    const ObCollationType collation_type,
    const int64_t max_prefix_byte_len,
