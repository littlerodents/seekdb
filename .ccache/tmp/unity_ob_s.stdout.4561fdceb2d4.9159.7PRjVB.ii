  {
    case(PERIOD_FREEZE_MODE): return "PERIOD_FREEZE_MODE";
    case(FEEDBACK_FREEZE_MODE): return "FEEDBACK_FREEZE_MODE";

    default:
      return "Invalid Mode";
  }

