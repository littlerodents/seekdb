template <typename K, typename V>
template <typename OP>
int ObRecycleMultiKVCache<K, V>::for_each(const K &key, OP &&op) const
{
  int ret = OB_SUCCESS;
  KVNode<K, V> **_1;
  KVNode<K, V> *_2;
  ObSpinLockGuard lg(lock_);
  KVNode<K, V> *list = hash_bkt_.find_list(key, _1, _2);
