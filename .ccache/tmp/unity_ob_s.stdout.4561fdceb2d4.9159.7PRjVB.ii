  }
  inline __attribute__((always_inline)) int get(const int64_t offset, const int64_t cnt, int64_t &value) const;
  inline __attribute__((always_inline)) int get(const int64_t offset, const int64_t cnt, uint64_t &value) const
  {
    return get(offset, cnt, *reinterpret_cast<int64_t *>(&value));
  }

  enum ObBitStreamUnpackType
  {
    PACKED_LEN_LESS_THAN_10 = 0,
    PACKED_LEN_LESS_THAN_26,
    DEFAULT,
  };

  template <ObBitStreamUnpackType type>
  inline __attribute__((always_inline)) static int get(
      const unsigned char *buf,
      const int64_t offset,
      const int64_t cnt,
      const int64_t bs_len,
      int64_t &value);

  template <ObBitStreamUnpackType type>
