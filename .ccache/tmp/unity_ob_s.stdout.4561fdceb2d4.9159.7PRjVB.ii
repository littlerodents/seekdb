template <typename T>
int ObTxOp::init(ObTxOpCode op_code, share::SCN op_scn, T* op_val, int64_t val_size)
{
  int ret = OB_SUCCESS;
  if (op_code == ObTxOpCode::INVALID || !op_scn.is_valid() || (__builtin_expect(!!(__null == (op_val)),!!0)) || val_size < 0) {
    ret = OB_INVALID_ARGUMENT;
  }







  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && op_code_ == ObTxOpCode::MDS_OP && !(std::is_same<T, transaction::ObTxBufferNodeWrapper>::value)) { ret = OB_INVALID_ARGUMENT; } if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && op_code_ == ObTxOpCode::LOCK_OP && !(std::is_same<T, transaction::tablelock::ObTableLockOp>::value)) { ret = OB_INVALID_ARGUMENT; } if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && op_code_ == ObTxOpCode::ABORT_OP && !(std::is_same<T, ObTxDummyOp>::value)) { ret = OB_INVALID_ARGUMENT; };


  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
    op_code_ = op_code;
    op_scn_ = op_scn;
    op_val_ = op_val;
    val_size_ = val_size;
  }
  return ret;
}

template <typename T>
T* ObTxOp::get()
{
  T* val = nullptr;







  if (std::is_same<T, transaction::ObTxBufferNodeWrapper>::value) { val = (T*)op_val_; } if (std::is_same<T, transaction::tablelock::ObTableLockOp>::value) { val = (T*)op_val_; } if (std::is_same<T, ObTxDummyOp>::value) { val = (T*)op_val_; };



  return val;
}


}
