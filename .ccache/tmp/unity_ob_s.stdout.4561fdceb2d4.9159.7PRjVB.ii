};

inline __attribute__((always_inline)) void ObDagWarningInfo::reset()
{
  task_id_.reset();
  dag_type_ = share::ObDagType::DAG_TYPE_MAX;
  info_param_ = __null;
  dag_ret_ = OB_SUCCESS;
  dag_status_ = ODS_MAX;
  gmt_create_ = 0;
  gmt_modified_ = 0;
  retry_cnt_ = 0;
  hash_ = 0;
  location_.reset();
}





