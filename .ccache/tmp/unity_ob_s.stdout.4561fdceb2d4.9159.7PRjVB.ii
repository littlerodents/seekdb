  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (scan_batch()))),!!0))) {

  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (kv_queue_.pop(item)))),!!0))) {

  }
  if (OB_SUCCESS == ret) {
