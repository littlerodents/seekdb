    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (init_basic_info(player_cnt)))),!!0))) {
    } else {
      is_inited_ = true;
    }
  }

  if (!(__builtin_expect(!!(is_inited_),!!1))) {
    reset();
  }
  return ret;
}

