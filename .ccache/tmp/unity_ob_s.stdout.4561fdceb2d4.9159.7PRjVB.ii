class ObStorageDatumWrapper final
{
public:
  ObStorageDatumWrapper(const ObStorageDatum &datum, bool for_dump)
    : datum_(datum),
      for_dump_(for_dump)
  {}
  ~ObStorageDatumWrapper() = default;
  inline __attribute__((always_inline)) int64_t to_string(char *buf, const int64_t buf_len) const
  {
    int64_t pos = 0;
    if (nullptr != buf && buf_len > 0) {
      pos = datum_.storage_to_string(buf, buf_len - 1, for_dump_);
      if (pos >= 0 && pos < buf_len) {
        buf[pos] = '\0';
      }
    }
    return pos;
  }
private:
  ObStorageDatumWrapper(const ObStorageDatumWrapper &) = delete; ObStorageDatumWrapper &operator=(const ObStorageDatumWrapper &) = delete;
  const ObStorageDatum &datum_;
  const bool for_dump_;
};

}
