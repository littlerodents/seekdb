      }
      return ret;
    }

    ObBitSet<>& bit_set_;
  };

  HazardDomain();
  ~HazardDomain() { HazptrTLCache::get_instance().flush(); }
  HazardDomain(const HazardDomain &) = delete; HazardDomain &operator=(const HazardDomain &) = delete;


  ObMemAttr bit_set_attr_;
  ObMemAttr hazptr_attr_;
  FixedTinyAllocator<HazardPointer> hazptr_allocator_;
  ObBitSet<> bit_set_;
  lib::ObMutex bit_set_mu_;
  ObLink* retire_list_;
  int64_t retired_memory_size_;
};

template <typename T>
FixedTinyAllocator<T>::~FixedTinyAllocator()
{
  while (!blocks_.is_empty()) {
    Block* block = blocks_.pop();



    ob_free(block);
  }
}

template <typename T>
int FixedTinyAllocator<T>::alloc(SList<T>& list, int64_t num)
{
  int ret = OB_SUCCESS;

  if (list.get_size() > 0 || num <= 0) {
    ret = OB_INVALID_ARGUMENT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 4, "src/share/cache/ob_kvcache_hazard_domain.h", 229, __FUNCTION__, ret, "head or tail is not null", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(list)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(list)))&&>::value>("list", ::oceanbase::common::check_char_array(list)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(num)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(num)))&&>::value>("num", ::oceanbase::common::check_char_array(num))); } } } while (false);
  } else {
    do {
      list = avai_list_.pop_ts(num);
    } while (__builtin_expect(!!(list.get_size() == 0),!!0) && (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (prepare_block()))),!!1)));
  }

  return ret;
}

template <typename T>
void FixedTinyAllocator<T>::free_slow(SList<T>& list)
{
  choose_and_free(list, list.get_size());
}

template<typename T>
void FixedTinyAllocator<T>::choose_and_free(SList<T>& list, int64_t num_to_free)
{
  SList<T> to_block;
  T* top;
  int64_t num_freed = 0;
  int64_t size = list.get_size();
  if (list.get_size() < num_to_free) {
    num_to_free = list.get_size();
  } else {
    while (num_freed < num_to_free && !list.is_empty()) {
      top = list.top();
      Block& block = Block::get_block(*top);
      to_block.push(list.pop());
      for (typename SList<T>::ErasableIterator iter = list.begin();
           iter != list.end() && num_freed < num_to_free;) {
        if (&block == &Block::get_block(*iter)) {
          to_block.push(list.erase(iter));
          ++num_freed;
        } else {
          ++iter;
        }
      }
      block.list_.push_ts(to_block);
    }
  }
}

template <typename T>
char* FixedTinyAllocator<T>::print_info(char* buffer, int64_t len) const
{
  return buffer + snprintf(buffer,
                      len,
                      "blocks size: %ld, free list size: %ld, memory_efficiency: %lf",
                      blocks_.get_size_ts(),
                      avai_list_.get_size_ts(),
                      memory_efficiency_);
}

template <typename T>
void FixedTinyAllocator<T>::wash()
{
  int ret = OB_SUCCESS;
  Block* block;
  int64_t start_time_us = ObTimeUtility::current_time_us();
  int64_t freed_blocks_num = 0;
  int64_t unused_obj_num = 0;
  SList<T> objs;
  lib::ObMutexGuard blocks_guard(blocks_mu_);
  BlockList blocks = blocks_.pop_all_ts();
  for (typename BlockList::ErasableIterator iter = blocks.begin(); iter != blocks.end();) {
    int64_t list_size = iter->list_.get_size_ts();
    if (Block::MAX_NUM == list_size) {
      Block* block = blocks.erase(iter);

      ob_free(block);
      ++freed_blocks_num;
    } else {
      unused_obj_num += list_size;
      if (RESERVE_THRESHOLD > list_size) {
        objs = iter->list_.pop_all_ts();
        avai_list_.push_ts(objs);
      }
      ++iter;
    }
  }
  blocks_.push_ts(blocks);

  int64_t last_wash_time_us_ = ObTimeUtility::current_time_us();
  int64_t wash_time_us = last_wash_time_us_ - start_time_us;
  memory_efficiency_ =
      (blocks_.get_size_ts() * Block::MAX_NUM - unused_obj_num) / double(blocks_.get_size_ts() * Block::MAX_NUM);
  do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 2)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 2, "src/share/cache/ob_kvcache_hazard_domain.h", 317, __FUNCTION__, 0, "allocator wash time ", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(wash_time_us)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(wash_time_us)))&&>::value>("wash_time_us", ::oceanbase::common::check_char_array(wash_time_us)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(freed_blocks_num)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(freed_blocks_num)))&&>::value>("freed_blocks_num", ::oceanbase::common::check_char_array(freed_blocks_num)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(memory_efficiency_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(memory_efficiency_)))&&>::value>("memory_efficiency", ::oceanbase::common::check_char_array(memory_efficiency_))); } } } while (false);
}

template <typename T>
template <typename F>
int FixedTinyAllocator<T>::for_each(F& func)
{
  int ret = OB_SUCCESS;
  lib::ObMutexGuard blocks_guard(blocks_mu_);
  for (__typeof__(((blocks_)).begin()) iter = ((blocks_)).begin(); (true) && (iter != ((blocks_)).end()); ++iter)
  {
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (iter->for_each(func)))),!!0))) {
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 4, "src/share/cache/ob_kvcache_hazard_domain.h", 329, __FUNCTION__, ret, "failed to call func", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(typeid(F).name())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(typeid(F).name())))&&>::value>("typeid(F).name()", ::oceanbase::common::check_char_array(typeid(F).name()))); } } } while (false);
      break;
    }
  }
  return ret;
}

template<typename T>
FixedTinyAllocator<T>::Block::Block(): next_(nullptr)
{
  for (int i = 0; i < MAX_NUM; ++i) {
    new (&all_objs_[i].obj_) T();
    list_.push(&all_objs_[i].obj_);
    all_objs_[i].block_ = this;
  }
  allocated_time_us_ = ObTimeUtil::current_time_us();
}

template <typename T>
int FixedTinyAllocator<T>::prepare_block()
{
  int ret = OB_SUCCESS;
  Block *new_block = nullptr;
  SList<T> list;

  if ((__builtin_expect(!!(__null == (new_block = (Block*)ob_malloc(OB_MALLOC_NORMAL_BLOCK_SIZE, attr_))),!!0))) {
    ret = OB_ALLOCATE_MEMORY_FAILED;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 4, "src/share/cache/ob_kvcache_hazard_domain.h", 356, __FUNCTION__, ret, "failed to allocate new block", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(attr_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(attr_)))&&>::value>("attr_", ::oceanbase::common::check_char_array(attr_))); } } } while (false);
  } else {

    new (new_block) Block();
    list = new_block->list_;
    new_block->list_.reset();
    blocks_.push_front_ts(new_block);
    this->avai_list_.push_ts(list);
  }

  return ret;
}

template<typename F>
int HazardDomain::reclaim(F func)
{
  int ret = OB_SUCCESS;
  ObLink *reclaim_list, *prev, *curr, *next, *retire_list;
  ObKVMemBlockHandle* mb_handle;
  uint64_t reclaimed_memory_size = 0, retired_memory_size = __atomic_load_n((&retired_memory_size_), 0);


