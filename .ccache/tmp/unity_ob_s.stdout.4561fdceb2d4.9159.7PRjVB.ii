  static uint32_t block_alloc_offset_bits() { return __builtin_offsetof(Ob2DArray, block_alloc_) * 8; }
  static uint32_t blocks_offset_bits() { return __builtin_offsetof(Ob2DArray, blocks_) * 8; }
  static uint32_t count_offset_bits() { return __builtin_offsetof(Ob2DArray, count_) * 8; }
  static uint32_t capacity_offset_bits() { return __builtin_offsetof(Ob2DArray, capacity_) * 8; }

