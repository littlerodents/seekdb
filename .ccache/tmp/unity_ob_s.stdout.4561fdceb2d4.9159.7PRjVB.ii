  static const int64_t RETIRE_LIMIT = 2;
  static const int64_t WASH_THREAD_RETIRE_LIMIT = 64;
  static const int64_t SUPPLY_MB_NUM_ONCE = 128;
  constexpr static const double WASH_OUT_SCORE_THRESHOLD = 1e-6;

public:
