MdsDumpNode::MdsDumpNode()
  : mds_table_id_((255)),
    mds_unit_id_((255)),
    crc_check_number_((4294967295U)),
    status_(),
    allocator_(nullptr),
    writer_id_(INVALID_VALUE),
    seq_no_(),
    redo_scn_(),
    end_scn_(),
    trans_version_(),
    user_data_()
{
}

void MdsDumpNode::swap(MdsDumpNode &other) noexcept
{
  meta::swap(*this, other,
             mds_table_id_,
             mds_unit_id_,
             crc_check_number_,
             status_,
             allocator_,
             writer_id_,
             seq_no_,
             redo_scn_,
             end_scn_,
             trans_version_,
             user_data_);
}

bool MdsDumpNode::is_valid() const
{
  return mds_table_id_ != (255) && mds_unit_id_ != (255);
}

void MdsDumpNode::reset() {
  auto __time_guard__ = oceanbase::common::occam::TimeGuardFactory:: make_guard(1_ms, oceanbase::common::occam::get_file_name_without_dir("src/storage/multi_data_source/adapter_define/mds_dump_node.cpp"), __PRETTY_FUNCTION__, 123, "[""MDS""] ");
  if ((__builtin_expect(!!(__null != (allocator_)),!!1))) {
    if ((__builtin_expect(!!(__null != (user_data_.ptr())),!!1))) {
      allocator_->free(user_data_.ptr());
    }
    allocator_ = nullptr;
  }
  user_data_.reset();
  new (this) MdsDumpNode();
}

