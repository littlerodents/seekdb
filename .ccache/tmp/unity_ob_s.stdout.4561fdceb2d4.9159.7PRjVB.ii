    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (creator(false , new_insert_key, val)))),!!0))) {
    } else {
      new_node_1->insert_into_node(0, new_insert_key, val);
      inserted = true;
    }
  } else if (this->path_.get_is_found()) {
    val = old_node->get_val(pos, index);
    BtreeKey &exist_key = old_node->get_key(pos, index);
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (creator(true , exist_key, val)))),!!0))) {
    }
  } else {
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (creator(false , new_insert_key, val)))),!!0))) {
    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (insert_into_node(old_node, pos, new_insert_key, val, new_node_1, new_node_2)))),!!0))) {

    } else {
      inserted = true;
    }
  }
  while (OB_SUCCESS == ret && (__builtin_expect(!!(__null != (new_node_1)),!!1))) {
    if ((__builtin_expect(!!(__null == (new_node_2)),!!0))) {
      if (OB_SUCCESS != this->path_.pop(old_node, pos)) {
        new_root = new_node_1;
        new_node_1 = nullptr;
      } else if (pos < 0) {
        ret = replace_child_and_key(old_node, 0, new_node_1->get_key(0, index), new_node_1, new_node_1);
      } else {
        ret = replace_child(old_node, pos, (BtreeVal)new_node_1);
        new_node_1 = nullptr;
      }
    } else {
      if (OB_SUCCESS != this->path_.pop(old_node, pos)) {
        ret = this->make_new_root(new_root,
                                  new_node_1->get_key(0, index),
                                  new_node_1,
                                  new_node_2->get_key(0),
                                  new_node_2,
                                  (int16_t)(new_node_1->get_level() + 1));
        new_node_1 = nullptr;
        new_node_2 = nullptr;
      } else {
        ret = split_child(old_node,
                          std::max(0, pos),
                          new_node_1->get_key(0, index),
                          (BtreeVal)new_node_1,
                          new_node_2->get_key(0, index),
                          (BtreeVal)new_node_2,
                          new_node_1,
                          new_node_2);
      }
    }
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
int WriteHandle<BtreeKey, BtreeVal>::insert_into_node(BtreeNode *old_node, int pos, BtreeKey key, BtreeVal val, BtreeNode *&new_node_1, BtreeNode *&new_node_2)
{
  int ret = OB_SUCCESS;
  int tmp_pos = -1;
  int count = 0;
  BtreeNode * tmp_node = nullptr;
  new_node_2 = nullptr;
  if ((__builtin_expect(!!(__null == (old_node)),!!0))) {
    ret = OB_INVALID_ARGUMENT;
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (try_wrlock(old_node)))),!!0))) {

  } else if ((count = old_node->size()) != this->index_.size()) {

    ret = OB_EAGAIN;
  } else if (pos < 0
             || old_node->is_overflow(1, &this->index_)) {

    BtreeKey dummy_key;
    ret = split_child(old_node, pos, pos < 0 ? dummy_key : old_node->get_key(pos, &this->index_),
                      pos < 0 ? nullptr : old_node->get_val(pos, &this->index_),
                      key, val, new_node_1, new_node_2);
  } else {
    old_node->set_spin();
    old_node->set_key_value(count, key, val);
    old_node->get_index().free_insert(pos + 1, count);

    ((void)(retire_list_.pop()));
    old_node->wrunlock();
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
int WriteHandle<BtreeKey, BtreeVal>::try_wrlock(BtreeNode *node)
{
  int ret = OB_SUCCESS;
  uint16_t uid = (uint16_t)(get_itid() + 1);
  if ((__builtin_expect(!!(__null == (node)),!!0))) {
    ret = OB_INVALID_ARGUMENT;
  } else if (node->is_hold_wrlock(uid)) {

  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (node->try_wrlock(uid)))),!!0))) {

  } else {
    retire_list_.push(node);
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
int WriteHandle<BtreeKey, BtreeVal>::replace_child_by_copy(BtreeNode *old_node, const int pos, BtreeVal val, BtreeNode*& new_node)
{
  int ret = OB_SUCCESS;
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (try_wrlock(old_node)))),!!0))) {

  } else if (old_node->is_leaf() && old_node->size() != this->index_.size()) {
    ret = OB_EAGAIN;
  } else if ((__builtin_expect(!!(__null == (new_node = alloc_node())),!!0))) {
    ret = OB_ALLOCATE_MEMORY_FAILED;
  } else {
    old_node->replace_child(new_node, pos, (BtreeNode*)val);
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
int WriteHandle<BtreeKey, BtreeVal>::replace_child(BtreeNode *old_node, const int pos, BtreeVal val)
{
  int ret = OB_SUCCESS;
  if ((__builtin_expect(!!(__null == (old_node)),!!0))) {
    ret = OB_INVALID_ARGUMENT;
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (old_node->try_rdlock()))),!!0))) {
    ret = OB_EAGAIN;
  } else {
    old_node->set_val(pos, val, &this->index_);
    old_node->rdunlock();
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
int WriteHandle<BtreeKey, BtreeVal>::replace_child_and_key(BtreeNode *old_node,
                                                           const int pos,
                                                           BtreeKey key,
                                                           BtreeNode *child,
                                                           BtreeNode *&new_node)
{
  int ret = OB_SUCCESS;
  if ((__builtin_expect(!!(__null == (old_node)),!!0)) || (__builtin_expect(!!(__null == (child)),!!0))) {
    ret = OB_INVALID_ARGUMENT;
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (try_wrlock(old_node)))),!!0))) {

  } else if (old_node->is_leaf() && old_node->size() != this->index_.size()) {
    ret = OB_EAGAIN;
  } else if ((__builtin_expect(!!(__null == (new_node = alloc_node())),!!0))) {
    ret = OB_ALLOCATE_MEMORY_FAILED;
  } else {
    old_node->replace_child_and_key(new_node, pos, key, child);
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
int WriteHandle<BtreeKey, BtreeVal>::make_new_root(BtreeNode *&root,
                                                   BtreeKey key1,
                                                   BtreeNode *node_1,
                                                   BtreeKey key2,
                                                   BtreeNode *node_2,
                                                   int16_t level)
{
  int ret = OB_SUCCESS;
  if ((__builtin_expect(!!(__null == (node_1)),!!0)) || (__builtin_expect(!!(__null == (node_2)),!!0))) {
    ret = OB_INVALID_ARGUMENT;
  } else if ((__builtin_expect(!!(__null == (root = alloc_node())),!!0))) {
    ret = OB_ALLOCATE_MEMORY_FAILED;
  } else {
    ret = root->make_new_root(key1, node_1, key2, node_2, level);
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
int WriteHandle<BtreeKey, BtreeVal>::split_child(BtreeNode *old_node,
                                                 const int pos,
                                                 BtreeKey key_1, BtreeVal val_1,
                                                 BtreeKey key_2, BtreeVal val_2,
                                                 BtreeNode *&new_node_1,
                                                 BtreeNode *&new_node_2)
{
  int ret = OB_SUCCESS;
  new_node_2 = nullptr;
  if ((__builtin_expect(!!(__null == (old_node)),!!0))) {
    ret = OB_INVALID_ARGUMENT;
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (try_wrlock(old_node)))),!!0))) {

  } else if (old_node->is_overflow(1)) {
    if ((__builtin_expect(!!(__null == (new_node_1 = alloc_node())),!!0)) || (__builtin_expect(!!(__null == (new_node_2 = alloc_node())),!!0))) {
      ret = OB_ALLOCATE_MEMORY_FAILED;
    } else {
      old_node->split_child_cause_recursive_split(new_node_1, new_node_2, pos, key_1, val_1, key_2, val_2);
    }
  } else if ((__builtin_expect(!!(__null == (new_node_1 = alloc_node())),!!0))) {
    ret = OB_ALLOCATE_MEMORY_FAILED;
  } else {
    old_node->split_child_no_overflow(new_node_1, pos, key_1, val_1, key_2, val_2);
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
void Iterator<BtreeKey, BtreeVal>::reset()
{
  scan_handle_.reset();
  jump_key_ = nullptr;
  cmp_result_ = 0;
  new(&start_key_)BtreeKey();
  new(&end_key_)BtreeKey();
  start_exclude_ = false;
  end_exclude_ = false;
  scan_backward_ = false;
  is_iter_end_ = false;
  iter_count_ = 0;
}

template<typename BtreeKey, typename BtreeVal>
int Iterator<BtreeKey, BtreeVal>::set_key_range(const BtreeKey min_key,
                                                const bool start_exclude,
                                                const BtreeKey max_key,
                                                const bool end_exclude)
{
  int ret = OB_SUCCESS;
  int cmp = 0;
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (scan_handle_.acquire_ref()))),!!0))) {
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (scan_handle_.find_path(__atomic_load_n((&btree_.root_), 5), min_key)))),!!0))) {

  } else {
    ret = comp_.compare(max_key, min_key, cmp);
    scan_backward_ = (cmp < 0);
    start_key_ = min_key;
    end_key_ = max_key;
    start_exclude_ = start_exclude;
    end_exclude_ = end_exclude;
    jump_key_ = nullptr;
    cmp_result_ = 0;
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
int Iterator<BtreeKey, BtreeVal>::get_next(BtreeKey &key, BtreeVal &value)
{
  int ret = OB_SUCCESS;
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (iter_next(key, value)))),!!0))){

  } else if (0 == iter_count_) {
    int cmp = 0;
    ret = scan_backward_ ? comp_.compare(start_key_, key, cmp) : comp_.compare(key, start_key_, cmp);
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && (cmp < 0 || (start_exclude_ && 0 == cmp))) {
      ret = iter_next(key, value);
    }
  }
  if (OB_SUCCESS == ret) {
    iter_count_++;
  } else {
    scan_handle_.release_ref();
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
int Iterator<BtreeKey, BtreeVal>::next_on_level(const int64_t level, BtreeKey& key, BtreeVal& value)
{
  int ret = OB_SUCCESS;
  BtreeKey* jump_key = nullptr;
  if (is_iter_end_) {
    ret = OB_ITER_END;
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (scan_handle_.pop_level_node(level)))),!!0))) {

  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (scan_handle_.get(key, value, scan_backward_, jump_key)))),!!0))) {

  } else {
    int cmp = 0;
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (comp(key, jump_key, cmp)))),!!0))) {

    } else if (cmp < 0) {
      ret = OB_ITER_END;
    } else if (cmp > 0) {
      if (OB_SUCCESS != (scan_backward_ ? scan_handle_.scan_backward(level) :
                            scan_handle_.scan_forward(level))) {
        is_iter_end_ = true;
      }
    } else if (cmp == 0) {
      is_iter_end_ = true;
    }
  }
  if (OB_SUCCESS != ret) {
    is_iter_end_ = true;
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
int Iterator<BtreeKey, BtreeVal>::estimate_one_level(const int64_t level,
                                                     const int64_t start_batch_count,
                                                     const int64_t end_batch_count,
                                                     const int64_t max_node_count,
                                                     int64_t &level_physical_row_count,
                                                     int64_t &level_element_count,
                                                     int64_t &node_count)
{
  int ret = OB_SUCCESS;
  node_count = 0;
  level_physical_row_count = 0;
  level_element_count = 0;
  int64_t batch_physical_row_count= 0;
  int64_t batch_element_count = 0;
  int64_t batch_count = start_batch_count;

  while (node_count < max_node_count
      && (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (iter_next_batch_level_node(batch_physical_row_count, batch_count, level, batch_element_count)))),!!1))) {



    level_physical_row_count += batch_physical_row_count;
    level_element_count += batch_element_count;
    node_count += batch_count;
    batch_count = batch_count * 2 >= end_batch_count ? end_batch_count : batch_count * 2;
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
int Iterator<BtreeKey, BtreeVal>::estimate_element_count(int64_t &physical_row_count, int64_t &element_count)
{
  int ret = OB_SUCCESS;
  static const int64_t MAX_SAMPLE_LEAF_COUNT = 500;
  int64_t node_count = 0;
  int64_t avg_element_count_per_leaf = 0;
  int64_t level_element_count = 0;
  int64_t level_physical_row_count = 0;
  physical_row_count = 0;
  element_count = 0;
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (estimate_one_level(0, 1, 1024, MAX_SAMPLE_LEAF_COUNT, level_physical_row_count, level_element_count, node_count)))),!!0))) {






    if (OB_ITER_END != ret) {
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_STORAGE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""STORAGE""] ", 4, "src/storage/memtable/mvcc/ob_keybtree.cpp", 971, __FUNCTION__, ret, "failed to estimate level 0", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
    }
  }
  physical_row_count += level_physical_row_count;
  element_count += level_element_count;
  if (OB_SUCCESS == ret && node_count >= MAX_SAMPLE_LEAF_COUNT) {
    avg_element_count_per_leaf = ((std::lround(static_cast<double>(level_element_count) / static_cast<double>(node_count))) > (1) ? (std::lround(static_cast<double>(level_element_count) / static_cast<double>(node_count))) : (1));
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (estimate_one_level(1, 64, 1024, (9223372036854775807L), level_physical_row_count, level_element_count, node_count)))),!!0))) {






      if (OB_ITER_END != ret) {
        do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_STORAGE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""STORAGE""] ", 4, "src/storage/memtable/mvcc/ob_keybtree.cpp", 986, __FUNCTION__, ret, "failed to estimate level 1", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
      }
    }
    physical_row_count += level_physical_row_count * avg_element_count_per_leaf;
    element_count += level_element_count * avg_element_count_per_leaf;
  }
  if (OB_SUCCESS != ret) {
    scan_handle_.release_ref();
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
int Iterator<BtreeKey, BtreeVal>::iter_next(BtreeKey &key, BtreeVal &value)
{
  int ret = OB_SUCCESS;

  BtreeKey* jump_key = nullptr;
  if (is_iter_end_) {
    ret = OB_ITER_END;
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (scan_handle_.get(key, value, scan_backward_, jump_key)))),!!0))) {

  } else {
    int cmp = 0;
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (comp(key, jump_key, cmp)))),!!0))) {

    } else if (cmp < 0) {
      ret = OB_ITER_END;
    } else if (cmp > 0) {
      if (OB_SUCCESS != (scan_backward_ ?
                         scan_handle_.scan_backward() :
                         scan_handle_.scan_forward())) {
        is_iter_end_ = true;
      }
    } else if (cmp == 0) {
      is_iter_end_ = true;
      if (0 != end_exclude_) {
        ret = OB_ITER_END;
      }
    }
  }
  if (OB_SUCCESS != ret) {
    is_iter_end_ = true;
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
int Iterator<BtreeKey, BtreeVal>::iter_next_batch_level_node(int64_t &element_count,
                                                             const int64_t batch_count,
                                                             const int64_t level,
                                                             int64_t &phy_element_count)
{
  int ret = OB_SUCCESS;
  BtreeKey* jump_key = nullptr;
  int64_t cur_level_count = 0;
  int cmp = 0;
  element_count = 0;
  phy_element_count = 0;
  if (is_iter_end_) {
    ret = OB_ITER_END;
  } else {
    while (OB_SUCCESS == ret && cur_level_count < batch_count && !is_iter_end_) {
      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (scan_handle_.pop_level_node(scan_backward_, level, element_count, phy_element_count, jump_key)))),!!0))) {




      } else {

        if (++cur_level_count == batch_count) {
          ret = comp(*jump_key, jump_key, cmp);
        } else {
          cmp = 1;

        }
        if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ret))),!!0))) {

        } else if (cmp < 0) {
          is_iter_end_ = true;
          element_count /= 2;

          phy_element_count /= 2;
        } else if (cmp > 0) {

          if (OB_SUCCESS != (scan_backward_ ?
                             scan_handle_.scan_backward(level) :
                             scan_handle_.scan_forward(level))) {
            is_iter_end_ = true;
          }
        } else if (cmp == 0) {

          is_iter_end_ = true;
        }
      }
    }
  }
  if (OB_SUCCESS != ret) {
    is_iter_end_ = true;
  }
  return ret;
}


template<typename BtreeKey, typename BtreeVal>
int Iterator<BtreeKey, BtreeVal>::comp(BtreeKey& cur_key, BtreeKey* jump_key, int &cmp)
{
  int ret = OB_SUCCESS;
  cmp = 0;
  if ((__builtin_expect(!!(__null == (jump_key)),!!0))) {

  } else if (jump_key_ == jump_key) {
    cmp = cmp_result_;
  } else {
    ret = scan_backward_? comp_.compare(*jump_key, end_key_, cmp_result_) : comp_.compare(end_key_, *jump_key, cmp_result_);
    jump_key_ = jump_key;
    cmp = cmp_result_;
  }
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && cmp <= 0) {
    ret = scan_backward_? comp_.compare(cur_key, end_key_, cmp) : comp_.compare(end_key_, cur_key, cmp);
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
void BtreeIterator<BtreeKey, BtreeVal>::KVQueue::reset()
{
  push_ = 0;
  pop_ = 0;
}

template<typename BtreeKey, typename BtreeVal>
int BtreeIterator<BtreeKey, BtreeVal>::KVQueue::push(const BtreeKV &data)
{
  int ret = 0;
  if (push_ >= pop_ + capacity) {
    ret = OB_EAGAIN;
  } else {
    items_[idx(push_++)] = data;
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
int BtreeIterator<BtreeKey, BtreeVal>::KVQueue::pop(BtreeKV &data)
{
  int ret = 0;
  if (pop_ >= push_) {
    ret = OB_EAGAIN;
  } else {
    data = items_[idx(pop_++)];
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
int BtreeIterator<BtreeKey, BtreeVal>::init(const ObKeyBtree &btree)
{
  int ret = OB_SUCCESS;
  if ((__builtin_expect(!!(__null != (iter_)),!!1))) {
    ret = OB_INIT_TWICE;
  } else {
    iter_ = new(buf_) Iterator(btree);
  }
  return ret;
}

template<typename BtreeKey, typename BtreeVal>
void BtreeIterator<BtreeKey, BtreeVal>::reset()
{
  kv_queue_.reset();
  is_iter_end_ = false;
  end_exclude_ = false;
  start_exclude_ = false;
  new(&end_key_)BtreeKey();
  new(&start_key_)BtreeKey();
  scan_backward_ = false;
  if ((__builtin_expect(!!(__null != (iter_)),!!1))) {
    iter_->reset();
    iter_ = nullptr;
  }
}

template<typename BtreeKey, typename BtreeVal>
int BtreeIterator<BtreeKey, BtreeVal>::set_key_range(const BtreeKey min_key,
                                                     const bool start_exclude,
                                                     const BtreeKey max_key,
                                                     const bool end_exclude)
{
  int ret = OB_SUCCESS;
  int cmp = 0;
  ret = iter_->get_comp().compare(max_key, min_key, cmp);
  scan_backward_ = (cmp < 0);
  start_key_ = min_key;
  end_key_ = max_key;
  start_exclude_ = start_exclude;
  end_exclude_ = end_exclude;
  is_iter_end_ = false;
  return ret;
}

