  inline __attribute__((always_inline)) bool operator==(const ObStorageDatum &other) const;
  inline __attribute__((always_inline)) bool operator==(const common::ObObj &other) const;


  int32_t reserved_;

  char buf_[common::OBJ_DATUM_NUMBER_RES_SIZE];
};

