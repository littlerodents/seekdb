  ObNumberCalc &sub(const ObNumber &v)
  {
    if (common::OB_SUCCESS == last_ret_) {
      last_ret_ = res_.sub(v, res_, allocator_);
    }
    return *this;
  }
  ObNumberCalc &mul(const ObNumber &v)
  {
    if (common::OB_SUCCESS == last_ret_) {
      last_ret_ = res_.mul(v, res_, allocator_);
    }
    return *this;
  }
