      case ObUSmallIntType:
        len = 2;
        break;
      case ObMediumIntType:
      case ObUMediumIntType:
      case ObInt32Type:
      case ObUInt32Type:
      case ObFloatType:
      case ObUFloatType:
      case ObDateType:
      case ObMySQLDateType:
        len = 4;
        break;
      case ObIntType:
      case ObUInt64Type:
      case ObDoubleType:
      case ObUDoubleType:
      case ObDateTimeType:
      case ObTimestampType:
      case ObTimeType:
