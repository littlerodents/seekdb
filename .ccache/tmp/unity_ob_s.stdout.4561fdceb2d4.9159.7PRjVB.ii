protected:
  virtual int do_task_(LogIOTaskCbThreadPool *cb_thread_pool, IPalfHandleImplGuard &guard) = 0;
  virtual int after_consume_(IPalfHandleImplGuard &guard) = 0;
  virtual LogIOTaskType get_io_task_type_() const = 0;
