          int max_block_size,
          typename BlockAllocatorT, bool auto_free,
          typename BlockPointerArrayT,
          bool use_trivial_ctor,
          bool need_construct_items>
int64_t Ob2DArray<T,
                  max_block_size,
                  BlockAllocatorT,
