const char *ObRoleMgr::get_role_str() const
{
  switch (role_) {
    case MASTER:
      return "MASTER";
    case SLAVE:
      return "SLAVE";
    case STANDALONE:
      return "STANDALONE";
    default:
      return "UNKNOWN";
  }
}

bool ObRoleMgr::is_master() const
{
  return (role_ == ObRoleMgr::MASTER) && (state_ == ObRoleMgr::ACTIVE);
}


ObRoleMgr::State ObRoleMgr::get_state() const
{
  return state_;
}

