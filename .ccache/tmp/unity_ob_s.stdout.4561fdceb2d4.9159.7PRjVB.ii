      { do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/oblib/lib/hash/ob_hashtable.h", 835, __FUNCTION__, ret, "create buckets fail, ret=%d", ret); } } } while (false); };
      ret = OB_ALLOCATE_MEMORY_FAILED;
    } else {

      bucket_num_ = bucket_num;
      allocer_ = allocer;
      bucket_allocer_ = bucket_allocer;
    }
    return ret;
  }

  int destroy()
  {
    int ret = OB_SUCCESS;
    if (__builtin_expect(!!(!inited(buckets_)),!!0) || __builtin_expect(!!(__null == allocer_),!!0)) {
      { do { if (false) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(6)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 6, "src/oblib/lib/hash/ob_hashtable.h", 850, __FUNCTION__, 0, "hashtable is empty"); } } } while (false); };
    } else {
