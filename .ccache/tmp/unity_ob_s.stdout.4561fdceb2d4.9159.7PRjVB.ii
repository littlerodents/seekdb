ObVTableScanParam() :
      index_id_(OB_INVALID_ID),
      timeout_(-1),
      sql_mode_(((1ULL << 27)|(1ULL << 5))),
      reserved_cell_count_(-1),
      schema_version_(-1),
      runtime_schema_version_(-1),
      projector_size_(0),
      for_update_(false),
      for_update_wait_timeout_(-1),
      frozen_version_(-1),
      scan_allocator_(&lib::Flow::current_ctx()->get_arena_allocator()),
      fb_snapshot_(),
      is_get_(false),
      is_for_foreign_check_(false),
      output_exprs_(__null),
      calc_exprs_(__null),
      aggregate_exprs_(__null),
      op_(__null),
      op_filters_(__null),
      pd_storage_filters_(nullptr),
      pd_storage_flag_(false),
      row2exprs_projector_(__null),
      table_scan_opt_(),
      schema_guard_(__null)
  { }

  virtual ~ObVTableScanParam()
  {
    destroy_schema_guard();
  }

  virtual void destroy()
  {
    if (__builtin_expect(!!(column_ids_.get_capacity() > OB_PREALLOCATED_COL_ID_NUM),!!0)) {
      column_ids_.destroy();
    }
    if (__builtin_expect(!!(key_ranges_.get_capacity() > OB_DEFAULT_RANGE_COUNT),!!0)) {
      key_ranges_.destroy();
    }
    if (__builtin_expect(!!(range_array_pos_.get_capacity() > OB_DEFAULT_RANGE_COUNT),!!0)) {
      range_array_pos_.destroy();
    }
    destroy_schema_guard();
  }


  ObTabletID tablet_id_;

  ObColumnIdArray column_ids_;

  uint64_t index_id_;

  ObRangeArray key_ranges_;
  ObMbrFilterArray mbr_filters_;

  ObPosArray range_array_pos_;
