template <typename K, typename V>
int ObRecycleMultiKVCache<K, V>::recycle_one_()
{
  int ret = OB_SUCCESS;
  KVNode<K, V> *cur = (KVNode<K, V> *)&buffer_[offset_can_write_end_ % buffer_len_];
  if (offset_can_write_end_ - offset_next_to_appended_ == buffer_len_) {
    ret = OB_BUF_NOT_ENOUGH;
  } else {
    offset_can_write_end_ += sizeof(KVNode<K, V>) + cur->extre_buffer_size_;
    if (offset_can_write_end_ == offset_reserved_) {
      offset_can_write_end_ = round_end_(offset_can_write_end_);
    }
    do{ if(__builtin_expect(!!(!(offset_can_write_end_ - offset_next_to_appended_ <= buffer_len_)),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/share/cache/ob_recycle_multi_kvcache.ipp", 240, __FUNCTION__, ret, "assert fail, exp=%s", "offset_can_write_end_ - offset_next_to_appended_ <= buffer_len_"); } } } while (false); }; do { if (__builtin_expect(!!(1),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/share/cache/ob_recycle_multi_kvcache.ipp", 240, __FUNCTION__, ret, "assert fail" " BACKTRACE:%s", oceanbase::common::lbt()); } } } while (false); }; } } while (false); ob_abort(); } } while(false);
    hash_bkt_.remove(cur);
    inner_mock_allocator_.set_can_free_area((char *)cur + sizeof(KVNode<K, V>), cur->extre_buffer_size_);
    cur->~KVNode<K, V>();
    ++recycle_number_;
  }
  return ret;
}

