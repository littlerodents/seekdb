int ObMdsSerializeUtil::mds_key_serialize(const int64_t key, char *buf,
                                          const int64_t buf_len, int64_t &pos)
{
  int ret = OB_SUCCESS;
  int64_t tmp = key;
  if (pos >= buf_len) {
    ret = OB_BUF_NOT_ENOUGH;
  } else {
    for (int64_t idx = 0; idx < 8 && (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)); ++idx) {
      if (pos >= buf_len) {
        ret = OB_BUF_NOT_ENOUGH;
      } else {
        buf[pos++] = ((tmp >> (56 - 8 * idx)) & 0x00000000000000FF);
      }
    }
  }
  return ret;
}

int ObMdsSerializeUtil::mds_key_deserialize(const char *buf, const int64_t buf_len,
                               int64_t &pos, int64_t &key)
{
  int ret = OB_SUCCESS;
  int64_t tmp = 0;
  for (int64_t idx = 0; idx < 8 && (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)); ++idx) {
    if (pos >= buf_len) {
      ret = OB_BUF_NOT_ENOUGH;
    } else {
      tmp <<= 8;
      tmp |= (0x00000000000000FF & buf[pos++]);
    }
  }
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
    key = tmp;
  }
  return ret;
}

}
