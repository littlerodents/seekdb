  ObTCFactory(const ObTCFactory&); void operator=(const ObTCFactory&);
};

template <typename T, int64_t MAX_CLASS_NUM, const char *LABEL,
         int64_t MEM_LIMIT, int32_t MAX_FREE_LIST_LENGTH>
