template<typename WordType>
template <typename T>
inline __attribute__((always_inline)) void ObBitVectorImpl<WordType>::bit_calculate(const ObBitVectorImpl<WordType> &l,
                                          const ObBitVectorImpl<WordType> &r,
                                          const int64_t size,
                                          T op)
{
  const int64_t cnt = size / WORD_BITS;
  for (int64_t i = 0; i < cnt; ++i) {
    data_[i] = op(l.data_[i], r.data_[i]);
  }
