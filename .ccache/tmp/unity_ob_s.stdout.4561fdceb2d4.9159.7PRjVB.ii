extern const char *get_type_name(int type);
# 2425 "/work/src/query/api/query/parser/ob_item_type.h"
inline ObItemType get_opposite_compare_type(ObItemType src_type)
{
  ObItemType ret_type = src_type;
  switch (src_type) {
    case T_OP_LT:
