      mds::MdsTableHandle &handle,
      const bool create_if_not_exist) const
  {
    return get_mds_table_handle_(handle, create_if_not_exist);
  }
  typedef ObMetaObjGuard<ObTabletDDLKvMgr> ObDDLKvMgrHandle;
