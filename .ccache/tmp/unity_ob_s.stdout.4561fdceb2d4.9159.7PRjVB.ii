template <typename T, typename CompareFunctor>
int ObLoserTree<T, CompareFunctor>::init_basic_info(const int64_t total_player_cnt)
{
  int ret = OB_SUCCESS;
  if (total_player_cnt <= 0) {
    ret = OB_INVALID_ARGUMENT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 4, "src/oblib/lib/container/ob_loser_tree.h", 289, __FUNCTION__, ret, "total player count is invalid", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(total_player_cnt)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(total_player_cnt)))&&>::value>("total_player_cnt", ::oceanbase::common::check_char_array(total_player_cnt))); } } } while (false);
  } else {
    player_cnt_ = total_player_cnt;
    cur_free_cnt_ = player_cnt_;
    match_cnt_ = get_match_cnt(player_cnt_);
    leaf_offset_ = (match_cnt_ - 1) / 2;

    for (int64_t i = 0; i < match_cnt_; ++i) {
      matches_[i].reset();
    }
    for (int64_t i = 0; i < player_cnt_; ++i) {
      free_players_[i] = player_cnt_ - 1 - i;
    }
  }
  return ret;
}

template <typename T, typename CompareFunctor>
void ObLoserTree<T, CompareFunctor>::reuse()
{
  player_cnt_ = 0;
  match_cnt_ = 0;
  leaf_offset_ = 0;
  cur_free_cnt_ = 0;
  need_rebuild_ = false;
  is_unique_champion_= true;
}

template <typename T, typename CompareFunctor>
void ObLoserTree<T, CompareFunctor>::reset()
{
  if (nullptr != allocator_) {
    if (nullptr != players_) {
      allocator_->free(players_);
    }
    if (nullptr != matches_) {
      allocator_->free(matches_);
    }
    if (nullptr != free_players_) {
      allocator_->free(free_players_);
    }
  }
  max_player_cnt_ = 0;
  player_cnt_ = 0;
  match_cnt_ = 0;
  leaf_offset_ = 0;
  cur_free_cnt_ = 0;
  need_rebuild_ = false;
  is_unique_champion_= true;
  allocator_ = nullptr;
  players_ = nullptr;
  matches_ = nullptr;
  free_players_ = nullptr;
  is_inited_ = false;
}

template <typename T, typename CompareFunctor>
int ObLoserTree<T, CompareFunctor>::get_match_result(
    const int64_t offender,
    const int64_t defender,
    const int64_t match_idx)
{
  int ret = OB_SUCCESS;
  bool is_offender_win = false;
  if (offender >= player_cnt_ || defender >= player_cnt_) {
    ret = OB_ARRAY_OUT_OF_RANGE;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 4, "src/oblib/lib/container/ob_loser_tree.h", 355, __FUNCTION__, ret, "out of range", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(offender)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(offender)))&&>::value>("offender", ::oceanbase::common::check_char_array(offender)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(defender)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(defender)))&&>::value>("defender", ::oceanbase::common::check_char_array(defender)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(match_idx)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(match_idx)))&&>::value>("match_idx", ::oceanbase::common::check_char_array(match_idx))); } } } while (false);
  } else if (INVALID_IDX == offender) {
    matches_[match_idx].winner_idx_ = defender;
    matches_[match_idx].loser_idx_ = offender;
    matches_[match_idx].is_draw_ = false;
  } else if (INVALID_IDX == defender) {
    matches_[match_idx].winner_idx_ = offender;
    matches_[match_idx].loser_idx_ = defender;
    matches_[match_idx].is_draw_ = false;
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (duel(players_[offender], players_[defender], match_idx, is_offender_win)))),!!0))) {
  } else {
    matches_[match_idx].winner_idx_ = is_offender_win ? offender : defender;
    matches_[match_idx].loser_idx_ = is_offender_win ? defender : offender;
  }
  return ret;
}

template <typename T, typename CompareFunctor>
int ObLoserTree<T, CompareFunctor>::duel(
    T &offender, T &defender, const int64_t match_idx, bool &is_offender_win)
{
  int ret = OB_SUCCESS;
  int64_t cmp_ret = 0;
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (cmp_.cmp(offender, defender, cmp_ret)))),!!0))) {
  } else {
    matches_[match_idx].is_draw_ = (0 == cmp_ret);
    is_offender_win = cmp_ret < 0;
  }
  return ret;
}

template <typename T, typename CompareFunctor>
void ObLoserTree<T, CompareFunctor>::set_unique_champion()
{
  is_unique_champion_ = true;
  const int64_t champion = matches_[0].winner_idx_;
  if (champion >= 0 && champion < player_cnt_) {
    int64_t child = get_leaf(champion);
    int64_t parent = INVALID_IDX;
    while (child > 0 && is_unique_champion_) {
      parent = get_parent(child);
      if (matches_[parent].is_draw_) {
        is_unique_champion_ = false;
      }
      child = parent;
    }
  }
}

