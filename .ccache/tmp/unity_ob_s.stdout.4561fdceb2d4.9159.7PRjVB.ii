    reclaim_list = ({ ((void)(0)); ; __atomic_exchange_n((&retire_list_), (nullptr), 5); });

    if ((__builtin_expect(!!(__null == (reclaim_list)),!!0))) {
    } else {
      {
        lib::ObMutexGuard bit_set_guard(bit_set_mu_);

        bit_set_.clear_all();

        TranverseCallback callback(bit_set_);
        ret = hazptr_allocator_.for_each(callback);

        for (prev = nullptr, curr = reclaim_list; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && (__builtin_expect(!!(__null != (curr)),!!1)); curr = next) {
          next = curr->next_;
          mb_handle = ({ (ObKVMemBlockHandle *)((char *)curr - __builtin_offsetof(ObKVMemBlockHandle, retire_link_)); } );
