template <typename ... Args>



__attribute__((noinline, cold)) void OB_PRINT(const char *mod_name, const int32_t level, const char *file, const int32_t line,

              const char *function,
              const int errcode, const char *info_string,
              const char *,
              Args const && ... args)
{
  int ret = OB_SUCCESS;

