  inline int alloc(T *&item);
  inline void free(EncodingItem *item);

  EncodingItem* free_items_[MAX_FREE_ITEM_CNT];
  int64_t free_cnt_;
  common::ObPool<common::ObMalloc, common::ObNullLock> pool_;
};

