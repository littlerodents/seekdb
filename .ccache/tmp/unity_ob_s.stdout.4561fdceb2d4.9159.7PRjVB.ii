  if ((__builtin_expect(!!(__null == (instance)),!!0))) {
    { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_tc_factory.h", 176, __FUNCTION__, ret, "failed to init tc_factory", "placeholder" ); } } } while (false); };
  } else {

