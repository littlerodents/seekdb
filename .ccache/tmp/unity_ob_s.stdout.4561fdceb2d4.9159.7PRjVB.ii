  struct GetSmallBlockOp
  {
  public:
    GetSmallBlockOp(ObSharedMacroBlockMgr &shared_mgr, ObIArray<MacroBlockId> &block_ids, ObIArray<MacroBlockId> &unused_block_ids)
        : shared_mgr_(shared_mgr), block_ids(block_ids), unused_block_ids(unused_block_ids), execution_ret_(OB_SUCCESS) {}
    bool operator()(const MacroBlockId &id, const int32_t used_size)
    {
      int ret = OB_SUCCESS;
      bool bool_ret = true;
      bool is_free = false;
      if (__builtin_expect(!!(MAX_RECYCLABLE_BLOCK_CNT == block_ids.count()),!!0)) {
        bool_ret = false;
        execution_ret_ = OB_ITER_END;
      } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = ((oceanbase::blocksstable::ObServerBlockManager::get_instance()).check_macro_block_free(id, is_free)))),!!0))) {
      } else if (is_free && unused_block_ids.count() < MAX_RECYCLABLE_BLOCK_CNT) {
        if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (unused_block_ids.push_back(id)))),!!0))) {
        } else {
          bool_ret = true;
        }
      } else if (shared_mgr_.is_recyclable(id, used_size)) {
        if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (block_ids.push_back(id)))),!!0))) {
        } else {
          bool_ret = true;
        }
      }
      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ret))),!!0))) {
        bool_ret = false;
      }
      return bool_ret;
    }
    int64_t get_execution_ret() { return execution_ret_; }
  private:
    ObSharedMacroBlockMgr &shared_mgr_;
    ObIArray<MacroBlockId> &block_ids;
    ObIArray<MacroBlockId> &unused_block_ids;
    int64_t execution_ret_;
  };

private:
