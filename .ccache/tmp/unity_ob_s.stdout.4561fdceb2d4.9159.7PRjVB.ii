  }
};





static const int64_t OB_DEFAULT_SE_ARRAY_COUNT = 64;
template <typename T,
          int64_t LOCAL_ARRAY_SIZE,
          typename BlockAllocatorT = ModulePageAllocator,
          bool auto_free = false>
class ObSEArrayImpl : public ObIArray<T>
{
  static_assert(std::is_constructible<BlockAllocatorT>::value || !auto_free,
                "BlockAllocatorT can not be constructed.");
public:

  using ObIArray<T>::count;
  using ObIArray<T>::at;

  typedef array::ObSEArrayIterator<T,
                                   LOCAL_ARRAY_SIZE,
                                   BlockAllocatorT,
                                   auto_free> iterator;
  typedef array::ObSEArrayIterator<T,
                                   LOCAL_ARRAY_SIZE,
                                   BlockAllocatorT,
                                   auto_free> const_iterator;
  explicit ObSEArrayImpl(int64_t block_size = OB_MALLOC_NORMAL_BLOCK_SIZE,
            const BlockAllocatorT &alloc = BlockAllocatorT(ObModIds::OB_SE_ARRAY));
  ObSEArrayImpl(const lib::ObLabel &label, int64_t block_size);
  virtual ~ObSEArrayImpl();


  explicit ObSEArrayImpl(const ObSEArrayImpl &other);
  inline void set_attr(const lib::ObMemAttr &attr) { block_allocator_.set_attr(attr); }
  inline void set_label(const lib::ObLabel &label) { block_allocator_.set_label(label); }

  inline void set_block_size(const int64_t block_size) { block_size_ = block_size; }
  inline int64_t get_block_size() const { return block_size_; }
  inline void set_block_allocator(const BlockAllocatorT &alloc) { block_allocator_ = alloc; }
  inline const BlockAllocatorT &get_block_allocator() const {return block_allocator_;}
  ObSEArrayImpl &operator=(const ObSEArrayImpl &other);
  int assign(const ObIArray<T> &other);

  int push_back(const T &obj);
  int push_back(const ObIArray<T> &other);
  void pop_back();
  int pop_back(T &obj);
  int remove(int64_t idx);

  inline int at(int64_t idx, T &obj) const
  {
    int ret = OB_SUCCESS;
    if (__builtin_expect(!!(0 > idx || idx >= count_),!!0)) {
      ret = OB_ARRAY_OUT_OF_RANGE;
    } else {
      using MyOp = ObClassOp<T, std::is_trivial<T>::value>;
      ret = MyOp::assign(data_[idx], obj);
    }
    return ret;
  }
  void extra_access_check(void ) const override { do{ if(__builtin_expect(!!(!(OB_SUCCESS == error_)),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/oblib/lib/container/ob_array.h", 321, __FUNCTION__, ret, "assert fail, exp=%s", "OB_SUCCESS == error_"); } } } while (false); }; do { if (__builtin_expect(!!(1),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/oblib/lib/container/ob_array.h", 321, __FUNCTION__, ret, "assert fail" " BACKTRACE:%s", oceanbase::common::lbt()); } } } while (false); }; } } while (false); ob_abort(); } } while(false); }

  inline T &operator[](int64_t idx)
  {
    if (__builtin_expect(!!(0 > idx || idx >= count_),!!0)) {
      { int __ret__ = OB_ARRAY_OUT_OF_RANGE; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/container/ob_array.h", 326, __FUNCTION__, ret, "idx out of range", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(idx)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(idx)))&&>::value>("idx", ::oceanbase::common::check_char_array(idx)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(count_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(count_)))&&>::value>("count_", ::oceanbase::common::check_char_array(count_))); } } } while (false); };
    }
    return data_[idx];
  }
  inline const T &operator[](int64_t idx) const
  {
    if (__builtin_expect(!!(0 > idx || idx >= count_),!!0)) {
      { int __ret__ = OB_ARRAY_OUT_OF_RANGE; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/container/ob_array.h", 333, __FUNCTION__, ret, "idx out of range", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(idx)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(idx)))&&>::value>("idx", ::oceanbase::common::check_char_array(idx)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(count_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(count_)))&&>::value>("count_", ::oceanbase::common::check_char_array(count_))); } } } while (false); };
    }
    return data_[idx];
  }
  T *alloc_place_holder();

  inline int set_max_print_count(const int64_t max_print_count)
  {
    int ret = OB_SUCCESS;

    if (max_print_count < 0) {
      ret = OB_INVALID_ARGUMENT;
    } else {
      max_print_count_ = max_print_count;
    }

    return ret;
  }

  void reuse()
  {
    if (is_destructor_safe()) {
    } else {
      for (int64_t i = 0; i < count_; i++) {
        data_[i].~T();
      }
    }
    count_ = 0;
    error_ = OB_SUCCESS;
  }
  inline void reset() { destroy(); }
  void destroy();
  inline int reserve(int64_t capacity)
  {
    int ret = OB_SUCCESS;
    if (capacity > capacity_) {

      int64_t new_size = capacity * sizeof(T);
      int64_t plus = new_size % block_size_;
      new_size += (0 == plus) ? 0 : (block_size_ - plus);
      T *new_data = reinterpret_cast<T*>(internal_malloc_(new_size));
      if ((__builtin_expect(!!(__null != (new_data)),!!1))) {
        using MyOp = ObClassOp<T, std::is_trivial<T>::value>;
        ret = MyOp::array_expand(data_, new_data, count_);
        if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
          if (reinterpret_cast<T *>(local_data_buf_) != data_) {
            internal_free_(data_);
          }
          data_ = new_data;
          capacity_ = new_size / sizeof(T);
        } else {


          internal_free_(new_data);
        }
      } else {
        ret = OB_ALLOCATE_MEMORY_FAILED;
        do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/container/ob_array.h", 390, __FUNCTION__, ret, "no memory", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(new_size)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(new_size)))&&>::value>("new_size", ::oceanbase::common::check_char_array(new_size)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(block_size_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(block_size_)))&&>::value>("block_size_", ::oceanbase::common::check_char_array(block_size_)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(count_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(count_)))&&>::value>("count_", ::oceanbase::common::check_char_array(count_)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(capacity_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(capacity_)))&&>::value>("capacity_", ::oceanbase::common::check_char_array(capacity_))); } } } while (false);
      }
    }
    return ret;
  }

  int prepare_allocate(int64_t capacity);
  template<typename ... Args>
  inline int prepare_allocate(int64_t capacity, Args && ... args)
  {
    return inner_prepare_allocate(capacity, false, args...);
  }

  template<typename ... Args>
  inline int prepare_allocate_and_keep_count(int64_t capacity, Args && ... args)
  {
    return inner_prepare_allocate(capacity, true, args...);
  }
  int64_t to_string(char *buffer, int64_t length) const;
  inline int64_t get_data_size() const
  {
    int64_t data_size = capacity_ * sizeof(T);
    if (capacity_ > LOCAL_ARRAY_SIZE) {
      int64_t plus = data_size % block_size_;
      data_size += (0 == plus) ? 0 : (block_size_ - plus);
    }
    return data_size;
  }
  inline bool error() const {return error_ != OB_SUCCESS;}
  inline int get_copy_assign_ret() const { return error_;}
  inline int64_t get_capacity() const
  {
    return capacity_;
  }
  inline int64_t size() const { return count_; }
  int serialize(char* buf, const int64_t buf_len, int64_t& pos) const; int deserialize(const char* buf, const int64_t data_len, int64_t& pos); int64_t get_serialize_size(void) const;

  static uint32_t local_data_offset_bits() { return __builtin_offsetof(ObSEArrayImpl, data_) * 8; }
  static uint32_t local_data_buf_offset_bits() { return __builtin_offsetof(ObSEArrayImpl, local_data_buf_) * 8; }
  static uint32_t block_size_offset_bits() { return __builtin_offsetof(ObSEArrayImpl, block_size_) * 8; }
  static uint32_t count_offset_bits() { return __builtin_offsetof(ObSEArrayImpl, count_) * 8; }
  static uint32_t capacity_offset_bits() { return __builtin_offsetof(ObSEArrayImpl, capacity_) * 8; }
  static uint32_t max_print_count_offset_bits() { return __builtin_offsetof(ObSEArrayImpl, max_print_count_) * 8; }
  static uint32_t error_offset_bits() { return __builtin_offsetof(ObSEArrayImpl, error_) * 8; }
  static uint32_t allocator_offset_bits() { return __builtin_offsetof(ObSEArrayImpl, block_allocator_) * 8; }
  static uint32_t has_alloc_offset_bits() { return __builtin_offsetof(ObSEArrayImpl, has_alloc_) * 8; }
  static uint32_t mem_context_offset_bits() { return __builtin_offsetof(ObSEArrayImpl, mem_context_) * 8; }
public:
  iterator begin();
  iterator end();
  const_iterator begin() const;
  const_iterator end() const;

private:

  static const int64_t DEFAULT_MAX_PRINT_COUNT = 32;
private:
  template<typename ... Args>
  inline int inner_prepare_allocate(int64_t capacity,
                                    const bool keep_count,
                                    Args && ... args)
  {
    int ret = OB_SUCCESS;
    if (__builtin_expect(!!(capacity_ < capacity),!!0)) {
      ret = reserve(capacity);
    }
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
      if (is_memcpy_safe()) {
        if (capacity > count_) {
          memset((void *)(data_ + count_), 0, sizeof(T) * (capacity - count_));
        }
      } else {
        for (int64_t i = count_; i < capacity; ++i) {
          new(&data_[i]) T(args...);
        }
      }
      if (!keep_count) {
        count_ = (capacity > count_) ? capacity : count_;
      }
    }
    return ret;
  }


  inline bool is_memcpy_safe() const
  {

    return std::is_trivial<T>::value;
  }
  inline bool is_destructor_safe() const
  {

    return std::is_trivially_destructible<T>::value;
  }
  void *internal_malloc_(int64_t size)
  {
    if (__builtin_expect(!!(!has_alloc_),!!0)) {
      if (auto_free) {
        mem_context_ = lib::Flow::current_ctx();
        init_block_allocator(mem_context_, block_allocator_);
      }
      has_alloc_ = true;
    } else {



    }
    return block_allocator_.alloc(size);
  }

  void internal_free_(void *p) {



    return block_allocator_.free(p);
  }

protected:
  using ObIArray<T>::data_;
  using ObIArray<T>::count_;
private:
  char local_data_buf_[ObSEArrayLocalSize<LOCAL_ARRAY_SIZE, T>::buf_len];
  int64_t block_size_;
  int64_t capacity_;
  int64_t max_print_count_;
  int error_;
  BlockAllocatorT block_allocator_;
  bool has_alloc_;
  lib::MemoryContext mem_context_;
};

template<typename T, int64_t LOCAL_ARRAY_SIZE, typename BlockAllocatorT, bool auto_free>
int ObSEArrayImpl<T, LOCAL_ARRAY_SIZE, BlockAllocatorT, auto_free>::serialize(
    char *buf, const int64_t buf_len, int64_t &pos) const
{
  int ret = OB_SUCCESS;
  if (OB_SUCCESS != (ret = serialization::encode_vi64(buf, buf_len, pos, count()))) {
  }
  for (int64_t i = 0; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && i < count(); i ++) {
    if (OB_SUCCESS != (ret = serialization::encode(buf, buf_len, pos, at(i)))) {
    }
  }
  return ret;
}

template<typename T, int64_t LOCAL_ARRAY_SIZE, typename BlockAllocatorT, bool auto_free>
int ObSEArrayImpl<T, LOCAL_ARRAY_SIZE, BlockAllocatorT, auto_free>::deserialize(
    const char *buf, int64_t data_len, int64_t &pos)
{
  int ret = OB_SUCCESS;
  int64_t count = 0;
  reset();
  if (OB_SUCCESS != (ret = serialization::decode_vi64(buf, data_len, pos, &count))) {
  } else if (OB_SUCCESS != (ret = prepare_allocate(count))) {
  }
  for (int64_t i = 0; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && i < count; i ++) {
    T &item = at(i);
    if (OB_SUCCESS != (ret = serialization::decode(buf, data_len, pos, item))) {
    }
  }
  return ret;
}

template<typename T, int64_t LOCAL_ARRAY_SIZE, typename BlockAllocatorT, bool auto_free>
int64_t ObSEArrayImpl<T, LOCAL_ARRAY_SIZE, BlockAllocatorT, auto_free>::get_serialize_size()
const
{
  int64_t size = 0;
  size += serialization::encoded_length_vi64(count());
  for (int64_t i = 0; i < count(); i ++) {
    size += serialization::encoded_length(at(i));
  }
  return size;
}

template<typename T, int64_t LOCAL_ARRAY_SIZE, typename BlockAllocatorT, bool auto_free>
ObSEArrayImpl<T, LOCAL_ARRAY_SIZE, BlockAllocatorT, auto_free>::ObSEArrayImpl(
    int64_t block_size, const BlockAllocatorT &alloc)
    : ObIArray<T>(reinterpret_cast<T *>(local_data_buf_), 0),
      block_size_(block_size),
      capacity_(LOCAL_ARRAY_SIZE),
      max_print_count_(DEFAULT_MAX_PRINT_COUNT),
      error_(OB_SUCCESS),
      block_allocator_(alloc),
      has_alloc_(false),
      mem_context_(nullptr)
{
  static_assert(LOCAL_ARRAY_SIZE >= 0, "se local array size invalid");
  block_size_ = std::max(static_cast<int64_t>(sizeof(T)), block_size);
}

template<typename T, int64_t LOCAL_ARRAY_SIZE, typename BlockAllocatorT, bool auto_free>
ObSEArrayImpl<T, LOCAL_ARRAY_SIZE, BlockAllocatorT, auto_free>::ObSEArrayImpl(
    const lib::ObLabel &label, int64_t block_size)
    : ObIArray<T>(reinterpret_cast<T *>(local_data_buf_), 0),
      block_size_(block_size),
      capacity_(LOCAL_ARRAY_SIZE),
      max_print_count_(DEFAULT_MAX_PRINT_COUNT),
      error_(OB_SUCCESS),
      block_allocator_(label),
      has_alloc_(false),
      mem_context_(nullptr)
{
  static_assert(LOCAL_ARRAY_SIZE >= 0, "se local array size invalid");
  block_size_ = std::max(static_cast<int64_t>(sizeof(T)), block_size);
}

template<typename T, int64_t LOCAL_ARRAY_SIZE, typename BlockAllocatorT, bool auto_free>
ObSEArrayImpl<T, LOCAL_ARRAY_SIZE, BlockAllocatorT, auto_free>::~ObSEArrayImpl()
{
  destroy();
}

template<typename T, int64_t LOCAL_ARRAY_SIZE, typename BlockAllocatorT, bool auto_free>
int ObSEArrayImpl<T, LOCAL_ARRAY_SIZE, BlockAllocatorT, auto_free>::push_back(
    const T &obj)
{
  int ret = OB_SUCCESS;

  if (__builtin_expect(!!(count_ == capacity_),!!0)) {
    int64_t new_capacity = 2 * capacity_;
    if (new_capacity == 0) {
      new_capacity = 1;
    }
    ret = reserve(new_capacity);
  }

  using MyOp = ObClassOp<T, std::is_trivial<T>::value>;
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (MyOp::construct_and_assign(obj, data_[count_])))),!!1))) {
    count_++;
  }

  return ret;
}

template<typename T, int64_t LOCAL_ARRAY_SIZE, typename BlockAllocatorT, bool auto_free>
int ObSEArrayImpl<T, LOCAL_ARRAY_SIZE, BlockAllocatorT, auto_free>::push_back(
    const ObIArray<T> &other)
{
  int ret = OB_SUCCESS;
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
    for (int64_t i = 0; i < other.count(); i++) {
      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (push_back(other.at(i))))),!!0))) {
        do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 4, "src/oblib/lib/container/ob_array.h", 633, __FUNCTION__, ret, "fail to push back", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(i)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(i)))&&>::value>("i", ::oceanbase::common::check_char_array(i)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(other.count())), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(other.count())))&&>::value>("other.count()", ::oceanbase::common::check_char_array(other.count()))); } } } while (false);
        break;
      }
    }
  }

  return ret;
}

template<typename T, int64_t LOCAL_ARRAY_SIZE, typename BlockAllocatorT, bool auto_free>
void ObSEArrayImpl<T, LOCAL_ARRAY_SIZE, BlockAllocatorT, auto_free>::pop_back()
{
  if (__builtin_expect(!!(count_ <= 0),!!0)) {
  } else {
    using MyOp = ObClassOp<T, std::is_trivial<T>::value>;
    MyOp::default_destruct(data_[--count_]);
  }
}

template<typename T, int64_t LOCAL_ARRAY_SIZE, typename BlockAllocatorT, bool auto_free>
int ObSEArrayImpl<T, LOCAL_ARRAY_SIZE, BlockAllocatorT, auto_free>::pop_back(
    T &obj)
{
  int ret = OB_SUCCESS;
  if (__builtin_expect(!!(count_ <= 0),!!0)) {
    ret = OB_ENTRY_NOT_EXIST;
  } else {
    using MyOp = ObClassOp<T, std::is_trivial<T>::value>;
    ret = MyOp::assign_and_destruct(data_[--count_], obj);
  }
  return ret;
}

