inline __attribute__((always_inline)) bool ObStoreRow::is_valid() const
{
  bool bool_ret = true;
  if (scan_index_ < 0) {
    bool_ret = false;
  } else if (capacity_ < 0) {
    bool_ret = false;
  } else if (flag_.is_valid()) {
    if (flag_.is_delete()
        || flag_.is_not_exist()
        || row_val_.is_valid()) {
      if ((is_sparse_row_ && __null == column_ids_)
          || (row_type_flag_.is_uncommitted_row() && !trans_id_.is_valid())
          || (!row_type_flag_.is_uncommitted_row() && trans_id_.is_valid())) {
        bool_ret = false;
      } else {
        bool_ret = true;
      }
    } else {
      bool_ret = false;
    }
  } else {
    bool_ret = false;
  }

  return bool_ret;
}

}
