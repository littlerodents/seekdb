                                  !std::is_copy_assignable<T>::value &&
                                  std::is_copy_constructible<T>::value, bool>::type = true>
inline int copy_or_assign(const T &src,
                          T &dst,
                          ObIAllocator &alloc = DummyAllocator::get_instance())
{
  ((void)(alloc));
  new (&dst) T (src);
  return common::OB_SUCCESS;
}


template <typename T,
          typename std::enable_if<!::oceanbase::common::meta::has_assign<typename std::decay<T>::type, int(ObIAllocator &, const T &)>::value &&
                                  !::oceanbase::common::meta::has_assign<typename std::decay<T>::type, int(const T &)>::value &&
