                     const UserMdsNode<K, V> &node,
                     const char *file = __builtin_FILE(),
                     const uint32_t line = __builtin_LINE(),
                     const char *function_name = __builtin_FUNCTION()) const;
public:

  struct ForwardWrapper
  {
