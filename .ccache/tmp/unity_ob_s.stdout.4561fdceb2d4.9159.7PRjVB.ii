  template<typename F>
  int reclaim(F func);
  static HazardDomain& get_instance();
  void print_info() const;
  void wash();

private:
  friend class ObKVGlobalCache;

  struct TranverseCallback {
    TranverseCallback(ObBitSet<>& bit_set) : bit_set_(bit_set)
    {}
    int operator()(HazardPointer& hazptr)
    {
