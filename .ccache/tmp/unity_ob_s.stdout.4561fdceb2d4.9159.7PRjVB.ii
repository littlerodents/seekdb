template<typename T, typename... Args>
int ObIOAllocator::alloc(T *&instance, Args &...args)
{
  int ret = OB_SUCCESS;
  instance = nullptr;
  void *buf = nullptr;
  if (__builtin_expect(!!(!is_inited_),!!0)) {
    ret = OB_NOT_INIT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 4, "src/share/io/ob_io_struct.h", 598, __FUNCTION__, ret, "io allocator not init", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(is_inited_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(is_inited_)))&&>::value>("is_inited_", ::oceanbase::common::check_char_array(is_inited_))); } } } while (false);
