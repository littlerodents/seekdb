  for (; p < end; p += 2) {
    *(p - 1) = map_[*d >> (8 / 2)];
    *p = map_[*d & 0xF];
    d++;
  }
  pos_ = (d - data_) * 2;
  if (p == end) {
    unpack(*(p - 1));
  }
}

