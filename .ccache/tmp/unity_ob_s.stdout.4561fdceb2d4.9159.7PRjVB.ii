        row_id = offset + pd_filter_info.start_;
        if (value_cmp_t<RefType, CMP_TYPE>(ref_arr[row_id], casted_dict_ref)) {
          result.set(offset);
        }
      }
    } else {
      for (int64_t offset = 0; offset < pd_filter_info.count_; ++offset) {
        row_id = offset + pd_filter_info.start_;
