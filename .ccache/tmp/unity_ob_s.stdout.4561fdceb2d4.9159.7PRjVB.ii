namespace oceanbase
{
namespace common
{
class ObIAllocator;
}

namespace storage
{

class ObFullTabletCreator final
{
public:
  ObFullTabletCreator();
  ~ObFullTabletCreator() = default;
public:
  int init();
  void reset();
  int create_tablet(ObTabletHandle &tablet_handle);

  int throttle_tablet_creation();
  void free_tablet(ObTablet *tablet);
  inline __attribute__((always_inline)) int64_t total() const {
      return tiny_allocator_.total() + (nullptr == mstx_mem_ctx_ ? 0 : mstx_mem_ctx_->hold()); }
  inline __attribute__((always_inline)) int64_t used() const {
      return tiny_allocator_.used() + (nullptr == mstx_mem_ctx_ ? 0 : mstx_mem_ctx_->used()); }
  inline __attribute__((always_inline)) int64_t get_used_obj_cnt() const { return __atomic_load_n((&created_tablets_cnt_), 5); }
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"tiny_allocator_.used()", ::oceanbase::common::check_char_array(tiny_allocator_.used()), "tiny_allocator_.total()", ::oceanbase::common::check_char_array(tiny_allocator_.total()), "full allocator used", used(), "full allocator total", total()); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };

private:
  common::ObIAllocator &get_allocator() { return mstx_mem_ctx_->get_malloc_allocator(); }
private:
  bool is_inited_;
  common::ObFIFOAllocator tiny_allocator_;
  int64_t wait_create_tablets_cnt_;
  int64_t created_tablets_cnt_;
  lib::MemoryContext mstx_mem_ctx_;
  ObFullTabletCreator(const ObFullTabletCreator&); void operator=(const ObFullTabletCreator&);
};
}
