  int get_tablet_addr(const ObTabletMapKey &key, ObMetaDiskAddr &addr);
  int has_tablet(
      const common::ObTabletID &tablet_id,
      bool &b_exist);
  int create_inner_tablet(
      const common::ObTabletID &tablet_id,
      const common::ObTabletID &data_tablet_id,
