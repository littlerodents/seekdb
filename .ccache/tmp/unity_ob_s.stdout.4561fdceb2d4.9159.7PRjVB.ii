template <bool calc_date>
int ObTimeConverter::mdatetime_to_ob_time(const ObMySQLDateTime &value, ObTime &ob_time)
{
  int ret = OB_SUCCESS;
  int32_t *parts = ob_time.parts_;
  if (__builtin_expect(!!(MYSQL_ZERO_DATETIME == value.datetime_),!!0)) {
    memset(ob_time.parts_, 0, sizeof(*parts) * ((3 + 4) + 4));
    parts[7] = ZERO_DATE;
  } else {
    parts[0] = value.year();
    parts[1] = value.month();
    parts[2] = value.day_;
    parts[3] = value.hour_;
    parts[4] = value.minute_;
    parts[5] = value.second_;
    parts[6] = value.microseconds_;
    parts[7] = 0;
    if (calc_date) {
      parts[7] = ob_time_to_date(ob_time);
    }
  }
  return ret;
}

template <bool calc_date>
int ObTimeConverter::mdate_to_ob_time(ObMySQLDate value, ObTime &ob_time)
{
  int ret = OB_SUCCESS;
  int32_t *parts = ob_time.parts_;
  if (__builtin_expect(!!(MYSQL_ZERO_DATE == value.date_),!!0)) {
    memset(parts, 0, sizeof(*parts) * (3 + 4));
    parts[7] = ZERO_DATE;
  } else {
    parts[0] = value.year_;
    parts[1] = value.month_;
    parts[2] = value.day_;
    parts[7] = 0;
    if (calc_date) {
      parts[7] = ob_time_to_date(ob_time);
    }
  }
  return ret;
}
# 806 "/work/src/oblib/common/timezone/ob_time_convert.h"
inline __attribute__((always_inline)) void ObTimeConverter::days_to_year(DateType days, YearType &year)
{
  int64_t date = days + 719528;
  int64_t x = (date * 3762951 - 1374417852) >> 37;
  year = ((date + (x) - (x >> 2)) * 2939745) >> 30;
}





inline __attribute__((always_inline)) void ObTimeConverter::days_to_year_ydays(DateType days, YearType &year, DateType &dt_yday)
{

  int64_t date = days + 719528;
  int64_t x = (date * 3762951 - 1374417852) >> 37;
  int64_t half_leap = (x) - (x >> 2);
  year = ((date + half_leap) * 2939745) >> 30;

  dt_yday = date - year*365 - ((year - !!year) >> 2) + half_leap;
}
# 836 "/work/src/oblib/common/timezone/ob_time_convert.h"
inline __attribute__((always_inline)) void ObTimeConverter::ydays_to_month_mdays(
    YearType year, DateType dt_yday,
    MonthType &month, DateType &dt_mday)
{
  bool is_leap = ((year >= 0 && year < 10000) ? INNER_IS_LEAP_YEAR[year] : (year == 0 ? 0 : ((((year) % 4) == 0 && (((year) % 100) != 0 || ((year) % 400) == 0)) ? 1 : 0)));

  month = 1 + ((dt_yday - 1) >> 5);
  if (__builtin_expect(!!(dt_yday > DAYS_UNTIL_MON[is_leap][month]),!!0)) {
    ++ month;
  }

  dt_mday = dt_yday - DAYS_UNTIL_MON[is_leap][month-1];
}



inline __attribute__((always_inline)) void ObTimeConverter::to_week(
    ObDTMode mode, YearType year, DateType dt_yday, DateType dt_wday,
    WeekType &week, int8_t &delta)
{
  week = 0;
  int32_t is_sun_begin = (((1UL << 5) & (mode)) ? 1 : 0);
  int32_t is_zero_begin = (((1UL << 6) & (mode)) ? 1 : 0);
  int32_t is_ge_4_begin = (((1UL << 7) & (mode)) ? 1 : 0);
  if (dt_yday > 365 - 3 && is_ge_4_begin && !is_zero_begin) {
    int32_t days_cur_year = DAYS_PER_YEAR[((year >= 0 && year < 10000) ? INNER_IS_LEAP_YEAR[year] : (year == 0 ? 0 : ((((year) % 4) == 0 && (((year) % 100) != 0 || ((year) % 400) == 0)) ? 1 : 0)))];
    int32_t wday_next_yday1 = WDAY_OFFSET[days_cur_year - dt_yday + 1][dt_wday];
    int32_t yday_next_week1 = YDAY_WEEK1[wday_next_yday1][is_sun_begin][is_ge_4_begin];
    if (dt_yday >= days_cur_year + yday_next_week1) {
      week = 1;
      delta = 1;
    }
  }
  if (0 == week) {
    int32_t wday_cur_yday1 = WDAY_OFFSET[(1 - dt_yday) % 7][dt_wday];
    int32_t yday_cur_week1 = YDAY_WEEK1[wday_cur_yday1][is_sun_begin][is_ge_4_begin];
    if (dt_yday < yday_cur_week1 && !is_zero_begin) {
      int32_t days_prev_year = DAYS_PER_YEAR[((year - 1 >= 0 && year - 1 < 10000) ? INNER_IS_LEAP_YEAR[year - 1] : (year - 1 == 0 ? 0 : ((((year - 1) % 4) == 0 && (((year - 1) % 100) != 0 || ((year - 1) % 400) == 0)) ? 1 : 0)))];
      int32_t wday_prev_yday1 = WDAY_OFFSET[(1 - days_prev_year - dt_yday) % 7][dt_wday];
      int32_t yday_prev_week1 = YDAY_WEEK1[wday_prev_yday1][is_sun_begin][is_ge_4_begin];
      week = (days_prev_year + dt_yday - yday_prev_week1 + 7) / 7;
      delta = -1;
    } else {
      week = (dt_yday - yday_cur_week1 + 7) / 7;
      delta = 0;
    }
  }
}


template<>
inline __attribute__((always_inline)) int ObTimeConverter::parse_date_usec(
    DateType value ,
    int64_t tz_offset, bool preserve_zero_datetime,
    DateType &date, UsecType &usec)
{
  int ret = OB_SUCCESS;
  date = value;
  usec = 0;
  return ret;
}
template<>
inline __attribute__((always_inline)) int ObTimeConverter::parse_date_usec(
    DateTimeType value ,
    int64_t tz_offset, bool preserve_zero_datetime,
    DateType &date, UsecType &usec)
{
  int ret = OB_SUCCESS;
  usec = value;
  if (__builtin_expect(!!(ObTimeConverter::ZERO_DATETIME == usec),!!0) && !preserve_zero_datetime) {
    date = ObTimeConverter::ZERO_DATE;
    usec = 0;
  } else {
    usec += tz_offset;
    date = static_cast<int32_t>(usec / USECS_PER_DAY);
    usec %= USECS_PER_DAY;
    if (__builtin_expect(!!(usec < 0),!!0)) {
      --date;
      usec += USECS_PER_DAY;
    }
  }
  return ret;
}

template<>
inline __attribute__((always_inline)) int ObTimeConverter::parse_date_usec(
    ObMySQLDate value,
    int64_t tz_offset, bool preserve_zero_datetime,
    DateType &date, UsecType &usec)
{
  int ret = OB_SUCCESS;
  date = calc_date(value);
  usec = 0;
  return ret;
}

template<>
inline __attribute__((always_inline)) int ObTimeConverter::parse_date_usec(
    ObMySQLDateTime value,
    int64_t tz_offset, bool preserve_zero_datetime,
    DateType &date, UsecType &usec)
{
  int ret = OB_SUCCESS;
  if (__builtin_expect(!!(ObTimeConverter::MYSQL_ZERO_DATETIME == value.datetime_),!!0)) {
    date = ObTimeConverter::ZERO_DATE;
    usec = 0;
  } else {
    date = calc_date(value.year(), value.month(), value.day_);
    usec = ((value.hour_ * DT_PART_BASE[4] + value.minute_) * DT_PART_BASE[5] + value.second_) * DT_PART_BASE[6]
            + value.microseconds_;
  }
  return ret;
}

template<>
inline __attribute__((always_inline)) int ObTimeConverter::parse_ob_time(ObMySQLDate value, ObTime &ob_time, bool calc_date)
{
  int ret = OB_SUCCESS;
  if (calc_date) {
    ret = mdate_to_ob_time<true>(value, ob_time);
  } else {
    ret = mdate_to_ob_time<false>(value, ob_time);
  }
  return ret;
}

template<>
inline __attribute__((always_inline)) int ObTimeConverter::parse_ob_time(ObMySQLDateTime value, ObTime &ob_time, bool calc_date)
{
  int ret = OB_SUCCESS;
  if (calc_date) {
    ret = mdatetime_to_ob_time<true>(value, ob_time);
  } else {
    ret = mdatetime_to_ob_time<false>(value, ob_time);
  }
  return ret;
}

}
