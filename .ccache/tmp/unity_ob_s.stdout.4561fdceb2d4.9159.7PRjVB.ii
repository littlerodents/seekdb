template<typename ValueType>
inline __attribute__((always_inline)) void ObFixedLengthFormat<ValueType>::get_payload(const int64_t idx, bool &is_null,
                                                            const char *&payload,
                                                            ObLength &length) const
{
  is_null = nulls_->at(idx);
  if (!is_null) {
    payload = reinterpret_cast<const char *>(data_ + sizeof(ValueType) * idx);
    length = type_size();
  }
}

template<typename ValueType>
inline __attribute__((always_inline)) void ObFixedLengthFormat<ValueType>::get_payload(const int64_t idx,
                                                            const char *&payload,
                                                            ObLength &length) const
{
  payload = reinterpret_cast<const char *>(data_ + sizeof(ValueType) * idx);
  length = type_size();
}

template<typename ValueType>
inline __attribute__((always_inline)) const char *ObFixedLengthFormat<ValueType>::get_payload(const int64_t idx) const
{
  return reinterpret_cast<const char *>(data_ + sizeof(ValueType) * idx);
}

