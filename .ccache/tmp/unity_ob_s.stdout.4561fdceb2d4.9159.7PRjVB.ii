struct RetryParam {
  RetryParam():
  start_ts_(0),
  last_print_ts_(0),
  timeout_ts_(0),
  retry_cnt_(0),
  print_interval_(0) {}
  RetryParam(int64_t lock_timeout_us, int64_t print_interval = 500_ms) :
  start_ts_(ObClockGenerator::getClock()),
  last_print_ts_(0),

  timeout_ts_(start_ts_ > ((9223372036854775807L) - lock_timeout_us) ? (9223372036854775807L) : start_ts_ + lock_timeout_us),
  retry_cnt_(0),
  print_interval_(print_interval) {}
  RetryParam &operator++() { ++retry_cnt_; return *this; }
  bool check_reach_print_interval_and_update() const {
    int64_t current_ts = ObClockGenerator::getClock();
    bool ret = ObClockGenerator::getClock() > (last_print_ts_ + print_interval_);
    if (ret) {
      last_print_ts_ = current_ts;
    }
    return ret;
  }
  bool check_timeout() const { return ObClockGenerator::getClock() > timeout_ts_; }
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"start_ts", common::ObTime2Str::ob_timestamp_str(start_ts_), "last_print_ts", common::ObTime2Str::ob_timestamp_str(last_print_ts_), "timeout_ts", common::ObTime2Str::ob_timestamp_str(timeout_ts_), "retry_cnt", ::oceanbase::common::check_char_array(retry_cnt_), "print_interval", ::oceanbase::common::check_char_array(print_interval_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
  int64_t start_ts_;
  mutable int64_t last_print_ts_;
  int64_t timeout_ts_;
  int64_t retry_cnt_;
  int64_t print_interval_;
};

enum class LockMode {
  READ = 1,
  WRITE = 2,
};

template <LockMode MODE>
struct LockModeGuard;

template <>
struct LockModeGuard<LockMode::READ> { using type = MdsRLockGuard; };

template <>
struct LockModeGuard<LockMode::WRITE> { using type = MdsWLockGuard; };

template <LockMode MODE, typename OP>
int retry_release_lock_with_op_until_timeout(const MdsLock &lock,
                                             RetryParam &retry_param,
                                             OP &&op) {
  int ret = OB_SUCCESS;
  auto __time_guard__ = oceanbase::common::occam::TimeGuardFactory:: make_guard(10_ms, oceanbase::common::occam::get_file_name_without_dir("src/storage/multi_data_source/runtime_utility/mds_retry_control.h"), __PRETTY_FUNCTION__, 84, "[""MDS""] ");
  do {
    int64_t current_ts = ObClockGenerator::getClock();
    {
      typename LockModeGuard<MODE>::type lg(lock);
      if (((({ static_assert(89 >= 0 && 89 <= (65535), "line num greater than 65535"); (__time_guard__.click(89));}), (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (op()))),!!0))))) {
        if (__builtin_expect(!!(OB_EAGAIN == ret),!!1)) {
          if (retry_param.check_timeout()) {
            ret = OB_TIMEOUT;
          }
        }
      }
    }
  } while (OB_EAGAIN == ret && ({ ob_usleep(10_ms); ++retry_param; true; }));
  return ret;

};

}
}
