const uint64_t OB_MOCK_TRIGGER_PACKAGE_ID_MASK = 0x4000000000000000;

const uint64_t OB_MOCK_OBJECT_PACAKGE_ID_MASK = 0x2000000000000000;

const uint64_t OB_MOCK_PACKAGE_BODY_ID_MASK = 0x8000000000000000;



inline __attribute__((always_inline)) uint64_t extract_package_id(uint64_t global_type_id)
{
  uint64_t mask = OB_MOCK_PACKAGE_BODY_ID_MASK |
                  OB_MOCK_TRIGGER_PACKAGE_ID_MASK |
                  OB_MOCK_OBJECT_PACAKGE_ID_MASK;
  uint64_t mock_val = global_type_id & (mask >> 40);
  uint64_t package_id = ((int64_t)global_type_id >> 24) |
                        (mock_val << 40);
  return package_id;
}

inline __attribute__((always_inline)) int64_t extract_type_id(uint64_t global_type_id)
{
  return global_type_id & (~((18446744073709551615UL) << (24 - 4)));
}

inline __attribute__((always_inline)) uint64_t combine_pl_type_id(uint64_t package_id, int64_t type_idx)
{
  uint64_t mask = OB_MOCK_PACKAGE_BODY_ID_MASK |
                  OB_MOCK_TRIGGER_PACKAGE_ID_MASK |
                  OB_MOCK_OBJECT_PACAKGE_ID_MASK;
  type_idx |= ((uint64_t)(package_id & mask) >> 40);
  return (package_id << 24 | type_idx);
}
