void ObMicroBlockReaderHelper::reset()
{
  if (nullptr != allocator_) {
    if (nullptr != flat_reader_) {
      flat_reader_->~ObMicroBlockReader();
      allocator_->free(flat_reader_);
    }
    if (nullptr != decoder_) {
