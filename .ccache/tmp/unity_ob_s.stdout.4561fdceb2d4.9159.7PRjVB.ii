    array_err_ = ret;
  }
}

template <int64_t STACK_QUEUE_SIZE>
void MdsTableOrderFlusher<STACK_QUEUE_SIZE, true>::record_mds_table(FlushKey key) {
  int ret = OB_SUCCESS;
  FlushKey eliminated_key;
