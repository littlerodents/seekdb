template <typename T, typename CompareFunctor>
int ObLoserTree<T, CompareFunctor>::inner_rebuild()
{
  int ret = OB_SUCCESS;
  int64_t l_player = INVALID_IDX;
  int64_t r_player = INVALID_IDX;
  int64_t old_winner = INVALID_IDX;
  for (int64_t j = leaf_offset_ - 1; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && j >= 0; --j) {
