template<typename Key, typename Handle>
class ObHandleCacheNode : public common::ObDLinkBase<ObHandleCacheNode<Key, Handle>>
{
public:
  ObHandleCacheNode() : bucket_idx_(-1) {}
  virtual ~ObHandleCacheNode() { reset(); }

  void reset()
  {
    ObDLinkBase<ObHandleCacheNode<Key, Handle>>::reset();
    handle_.reset();
    bucket_idx_ = -1;
  }

  Handle handle_;
  Key key_;
  int16_t bucket_idx_;
};

template<typename Key, typename Handle, int64_t N>
class ObHandleCache
{
  typedef ObHandleCacheNode<Key, Handle> CacheNode;
  typedef common::ObDList<CacheNode> LRUList;
public:
  ObHandleCache()
  {
    static_assert(N <= 8192, "number of bucket is larger than 8192");
    reset();
  }

  virtual ~ObHandleCache() {}

  void reset()
  {
    lru_list_.reset();
    for (int64_t i = 0; i < N; ++i) {
      nodes_[i].reset();
    }
    memset(buckets_, -1, sizeof(buckets_));
    memset(chain_, -1, sizeof(chain_));
    hold_size_ = 0;
  }

  int get_handle(const Key &key, Handle &handle)
  {
    int ret = common::OB_SUCCESS;
    int16_t idx = buckets_[key.hash() & MASK];
    while (-1 < idx) {
      if (nodes_[idx].key_ == key) {
        handle = nodes_[idx].handle_;
        break;
      } else {
        idx = chain_[idx];
      }
    }
    if (-1 == idx) {
      ret = common::OB_ENTRY_NOT_EXIST;
    } else {
      lru_list_.remove(&nodes_[idx]);
      lru_list_.add_first(&nodes_[idx]);
    }
    return ret;
  }

  int put_handle(const Key &key, Handle &handle)
  {
    int ret = common::OB_SUCCESS;
    CacheNode *node = lru_list_.get_size() >= N ? lru_list_.remove_last() : nodes_ + lru_list_.get_size();
    const int16_t node_idx = static_cast<int16_t>(node - nodes_);
    int16_t *idx_ptr = __null;
    int16_t idx = 0;
    if (-1 < node->bucket_idx_) {
      idx_ptr = &buckets_[node->bucket_idx_];
      idx = buckets_[node->bucket_idx_];
      while (__builtin_expect(!!(-1 < idx),!!1) && (node_idx != idx)) {
        idx_ptr = &chain_[idx];
        idx = chain_[idx];
      }
      if (__builtin_expect(!!(-1 == idx),!!0)) {
        ret = common::OB_ERR_UNEXPECTED;
        lru_list_.add_last(node);
        do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_STORAGE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""STORAGE""] ", 4, "src/storage/ob_handle_cache.h", 111, __FUNCTION__, ret, "idx can not be -1, the entry must exist", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(key)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(key)))&&>::value>("key", ::oceanbase::common::check_char_array(key)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(node->bucket_idx_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(node->bucket_idx_)))&&>::value>("node->bucket_idx_", ::oceanbase::common::check_char_array(node->bucket_idx_))); } } } while (false);
      } else {
        *idx_ptr = chain_[idx];
        chain_[idx] = -1;
      }
    }
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
      hold_size_ += handle.get_handle_size() - node->handle_.get_handle_size();
      node->reset();
      node->key_ = key;
      node->handle_ = handle;
      node->bucket_idx_ = key.hash() & MASK;
      idx_ptr = &buckets_[node->bucket_idx_];
      chain_[node_idx] = *idx_ptr;
      *idx_ptr = node_idx;
      lru_list_.add_first(node);
    }
    return ret;
  }
  inline __attribute__((always_inline)) int64_t hold() const { return hold_size_; }
private:
  static const uint64_t BUCKET_SIZE = common::next_pow2(N * 2);
  static const uint64_t MASK = BUCKET_SIZE - 1;
  CacheNode nodes_[N];
  int16_t buckets_[BUCKET_SIZE];
  int16_t chain_[N];
  LRUList lru_list_;
  int64_t hold_size_;
};


}
