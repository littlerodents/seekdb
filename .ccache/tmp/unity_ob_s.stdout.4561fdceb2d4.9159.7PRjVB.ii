void ObWkbUtils::get_sub_addr_common(const T& obj,
                                    typename T::const_pointer last_addr,
                                    typename T::index_type last_idx,
                                    typename T::index_type cur_idx,
                                    ObWkbIterOffsetArray *&offsets,
                                    typename T::pointer& data)
