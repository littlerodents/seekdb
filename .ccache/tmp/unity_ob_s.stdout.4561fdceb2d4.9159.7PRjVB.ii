class ObWhiteFilterSmallHashSet
{
public:
  ObWhiteFilterSmallHashSet() : set_(), hash_func_(nullptr), access_ctx_(nullptr) {}
  ~ObWhiteFilterSmallHashSet()
  {
    destroy();
  }
  void destroy()
  {
    set_.destroy();
  }
  inline bool created() const
  {
    return set_.inited();
  }
  inline int create(int param_num,
                    const ObExprHashFuncType hash_func,
                    const ObDatumAccessContext *access_ctx)
  {
    hash_func_ = hash_func;
    access_ctx_ = access_ctx;
    return set_.init(param_num);
  }
  inline int64_t count() const
  {
    return set_.size();
  }
  inline int insert_datum(const ObDatum &datum)
  {
    int ret = OB_SUCCESS;
    uint64_t hash_val;
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (hash_func_(datum, 0, hash_val, access_ctx_)))),!!0))) {
    } else {
      ret = set_.insert_hash(hash_val);
    }
    return ret;
  }
  inline int exist_datum(const ObDatum &datum, bool &is_exist) const
  {
    int ret = OB_SUCCESS;
    uint64_t hash_val;
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (hash_func_(datum, 0, hash_val, access_ctx_)))),!!0))) {
    } else {
      is_exist = set_.test_hash(hash_val);
    }
    return ret;
  }
private:
  ObSmallHashSet<true> set_;
  ObExprHashFuncType hash_func_;
  const ObDatumAccessContext *access_ctx_;

};

