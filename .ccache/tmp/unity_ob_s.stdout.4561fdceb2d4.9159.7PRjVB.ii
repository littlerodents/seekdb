namespace oceanbase
{
namespace common
{
namespace meta
{

template <typename T, typename std::enable_if<(::oceanbase::common::meta::has_less_operator<typename std::decay<T>::type>::value && ::oceanbase::common::meta::has_equal_operator<typename std::decay<T>::type>::value), bool>::type = true>
int compare(const T &lhs, const T&rhs, int &result)
{
  int ret = OB_SUCCESS;
  result = 0;
  if (lhs < rhs) {
    result = -1;
  } else if (lhs == rhs) {
    result = 0;
  } else {
    result = 1;
  }
  return ret;
}

template <typename T,
          typename std::enable_if<!(::oceanbase::common::meta::has_less_operator<typename std::decay<T>::type>::value && ::oceanbase::common::meta::has_equal_operator<typename std::decay<T>::type>::value) && ::oceanbase::common::meta::has_compare<typename std::decay<T>::type, int(const T &)>::value, bool>::type = true>

int compare(const T &lhs, const T&rhs, int &result)
{
  return lhs.compare(rhs, result);
}

template <typename T,
          typename std::enable_if<!(::oceanbase::common::meta::has_less_operator<typename std::decay<T>::type>::value && ::oceanbase::common::meta::has_equal_operator<typename std::decay<T>::type>::value) && !::oceanbase::common::meta::has_compare<typename std::decay<T>::type, int(const T &)>::value, bool>::type = true>

int compare(const T &lhs, const T&rhs, int &result)
{
  static_assert(!(!(::oceanbase::common::meta::has_less_operator<typename std::decay<T>::type>::value && ::oceanbase::common::meta::has_equal_operator<typename std::decay<T>::type>::value) &&
                !::oceanbase::common::meta::has_compare<typename std::decay<T>::type, int(const T &)>::value),
                "your type NEITHER has opertor< and operator== "
                "NOR has int T::comapre(cosnt T&)");
  return OB_NOT_SUPPORTED;
}

}
}
