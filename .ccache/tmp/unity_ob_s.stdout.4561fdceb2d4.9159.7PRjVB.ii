      is_add = test_bit(first_byte, OB_FLOAT_OPERATION_BIT_POS);
    }
  }
  return ret;
}

inline int64_t encoded_length_datetime(int64_t value)
{
  int64_t len = 0;
  uint64_t tmp_value = safe_int64_abs(value);
  if (tmp_value <= OB_MAX_4B) {
    len = 5;
  } else if (tmp_value <= OB_MAX_6B) {
    len = 7;
  } else {
    len = 9;
  }
  return len;
}

