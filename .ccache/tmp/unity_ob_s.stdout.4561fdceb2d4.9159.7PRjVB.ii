  } else if (count <= 0 || nullptr == label) {
    ret = common::OB_INVALID_ARGUMENT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE""] ", 4, "src/share/cache/ob_cache_utils.h", 420, __FUNCTION__, ret, "invalid arguments", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(count)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(count)))&&>::value>("count", ::oceanbase::common::check_char_array(count)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(label)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(label)))&&>::value>("label", ::oceanbase::common::check_char_array(label))); } } } while (false);
  } else {
    allocator_.set_label(label);
    buf_ = static_cast<T *>(allocator_.alloc(sizeof(T) * count));
    if (__null == buf_) {
      ret = common::OB_ALLOCATE_MEMORY_FAILED;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE""] ", 4, "src/share/cache/ob_cache_utils.h", 426, __FUNCTION__, ret, "alloc memory failed", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(count)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(count)))&&>::value>("count", ::oceanbase::common::check_char_array(count))); } } } while (false);
    } else {
      for (int64_t i = 0; i < count; ++i) {
        new (&buf_[i]) T();
      }
      free_cnt_ = count;
      total_cnt_ = count;
      inited_ = true;
    }
  }
  return ret;
}

template <typename T>
void ObFreeHeap<T>::destroy()
{
  if (inited_) {
    for (int64_t i = 0; i < total_cnt_; ++i) {
      buf_[i].~T();
    }
    free_cnt_ = 0;
    total_cnt_ = 0;
    allocator_.free(buf_);
    buf_ = __null;
    inited_ = false;
  }
}

template <typename T>
int ObFreeHeap<T>::sbrk(T *&buf)
{
  const int64_t count = 1;
  return sbrk(count, buf);
}

