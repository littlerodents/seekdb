public:
  template <ScanRowOrder SCAN_ROW_ORDER,
            ScanNodeOrder SCAN_NODE_ORDER,
            typename DUMP_OP,
            typename std::enable_if<!::oceanbase::common::meta::is_function_like<typename std::decay<DUMP_OP>::type, int(const MdsDumpKV &)>::value, bool>::type = true>
  int scan_all_nodes_to_dump(DUMP_OP &&for_each_op,
