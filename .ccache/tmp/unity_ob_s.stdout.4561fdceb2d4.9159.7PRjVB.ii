        if (TPKM_NEW_NO_PK == mode.pk_mode_) { ret_str = "QUEUING""|NEW_NO_PK_MODE"; } else if (TOM_HEAP_ORGANIZED == mode.pk_exists_) { ret_str = "QUEUING""|HEAP_ORGANIZED_TABLE"; } else if (TOM_INDEX_ORGANIZED == mode.pk_exists_) { ret_str = "QUEUING""|INDEX_ORGANIZED_TABLE"; } else { ret_str = "QUEUING"; };
      } else if (TABLE_MODE_QUEUING_MODERATE == mode.mode_flag_) {
        if (TPKM_NEW_NO_PK == mode.pk_mode_) { ret_str = "MODERATE""|NEW_NO_PK_MODE"; } else if (TOM_HEAP_ORGANIZED == mode.pk_exists_) { ret_str = "MODERATE""|HEAP_ORGANIZED_TABLE"; } else if (TOM_INDEX_ORGANIZED == mode.pk_exists_) { ret_str = "MODERATE""|INDEX_ORGANIZED_TABLE"; } else { ret_str = "MODERATE"; };
      } else if (TABLE_MODE_QUEUING_SUPER == mode.mode_flag_) {
        if (TPKM_NEW_NO_PK == mode.pk_mode_) { ret_str = "SUPER""|NEW_NO_PK_MODE"; } else if (TOM_HEAP_ORGANIZED == mode.pk_exists_) { ret_str = "SUPER""|HEAP_ORGANIZED_TABLE"; } else if (TOM_INDEX_ORGANIZED == mode.pk_exists_) { ret_str = "SUPER""|INDEX_ORGANIZED_TABLE"; } else { ret_str = "SUPER"; };
      } else if (TABLE_MODE_QUEUING_EXTREME == mode.mode_flag_) {
        if (TPKM_NEW_NO_PK == mode.pk_mode_) { ret_str = "EXTREME""|NEW_NO_PK_MODE"; } else if (TOM_HEAP_ORGANIZED == mode.pk_exists_) { ret_str = "EXTREME""|HEAP_ORGANIZED_TABLE"; } else if (TOM_INDEX_ORGANIZED == mode.pk_exists_) { ret_str = "EXTREME""|INDEX_ORGANIZED_TABLE"; } else { ret_str = "EXTREME"; };
      }
    } else if (TPKM_NEW_NO_PK == mode.pk_mode_) {
      ret_str = "NEW_NO_PK_MODE";
    } else if (TOM_HEAP_ORGANIZED == mode.pk_exists_) {
      ret_str = "HEAP_ORGANIZED_TABLE";
    } else if (TOM_INDEX_ORGANIZED == mode.pk_exists_) {
      ret_str = "INDEX_ORGANIZED_TABLE";
    }
    return ret_str;
  }

  static int get_table_mode(const common::ObString str, ObTableMode &ret_mode, uint64_t data_format_version) {
    int ret = common::OB_SUCCESS;
    ret_mode.reset();
    char * flag = nullptr;
    const char *delim = "|";
    char *save_ptr = __null;
    char table_mode_str[str.length() + 1] ;
    memset(table_mode_str, '\0', str.length() + 1);
    std::strncpy(table_mode_str, str.ptr(), str.length());
    flag = strtok_r(table_mode_str, delim, &save_ptr);
    while ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && (__builtin_expect(!!(__null != (flag)),!!1)))
    {
      common::ObString flag_str(0, static_cast<int32_t>(strlen(flag)), flag);
       if (0 == flag_str.case_compare("normal")) {

       } else if (0 == flag_str.case_compare("queuing")) {
         ret_mode.mode_flag_ = TABLE_MODE_QUEUING;
       } else if (0 == flag_str.case_compare("moderate")) {
         ret_mode.mode_flag_ = TABLE_MODE_QUEUING_MODERATE;
       } else if (0 == flag_str.case_compare("super")) {
         ret_mode.mode_flag_ = TABLE_MODE_QUEUING_SUPER;
       } else if (0 == flag_str.case_compare("extreme")) {
         ret_mode.mode_flag_ = TABLE_MODE_QUEUING_EXTREME;
       } else if (0 == flag_str.case_compare("new_no_pk_mode")) {
         ret_mode.pk_mode_ = TPKM_NEW_NO_PK;
       } else if (0 == flag_str.case_compare("heap_organized_table")) {
         ret_mode.pk_exists_ = TOM_HEAP_ORGANIZED;
         ret_mode.pk_mode_ = TPKM_TABLET_SEQ_PK;
       } else if (0 == flag_str.case_compare("index_organized_table")) {
         ret_mode.pk_exists_ = TOM_INDEX_ORGANIZED;
       } else {
         ret = common::OB_ERR_PARSER_SYNTAX;
       }

       flag = strtok_r(__null, delim, &save_ptr);
    }
    return ret;
  }
};



struct ObColumnDefaultChecksum
{
  ObColumnDefaultChecksum()
      : column_id_(common::OB_INVALID_ID), default_checksum_(0)
  {}
  ObColumnDefaultChecksum(const uint64_t column_id, const int64_t default_checksum)
      : column_id_(column_id), default_checksum_(default_checksum)
  {}

  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"column_id", ::oceanbase::common::check_char_array(column_id_), "default_checksum", ::oceanbase::common::check_char_array(default_checksum_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };

  uint64_t column_id_;
  int64_t default_checksum_;
};


