typedef common::ObCurTraceId::TraceId DDLTraceId;
class ObDDLEventInfo final
{
public:
  explicit ObDDLEventInfo(const common::ObAddr &addr);
  ObDDLEventInfo(const common::ObAddr &addr, const int32_t sub_id);
  ~ObDDLEventInfo() = default;
  void record_in_guard();
  void init_sub_trace_id(const int32_t sub_id);
  void set_inner_sql_id(const int64_t inner_sql_id);
  const DDLTraceId &get_trace_id() const { return trace_id_; }
  const DDLTraceId &get_parent_trace_id() const { return parent_trace_id_; }
  int set_trace_id(const DDLTraceId &trace_id) { return trace_id_.set(trace_id.get()); }
  void reset();
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"addr_", ::oceanbase::common::check_char_array(addr_), "event_ts_", ::oceanbase::common::check_char_array(event_ts_), "sub_id_", ::oceanbase::common::check_char_array(sub_id_), "trace_id_", ::oceanbase::common::check_char_array(trace_id_), "parent_trace_id_", ::oceanbase::common::check_char_array(parent_trace_id_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };

public:
  ObAddr addr_;
  int32_t sub_id_;
  int64_t event_ts_;
  DDLTraceId parent_trace_id_;
  DDLTraceId trace_id_;
};


}
