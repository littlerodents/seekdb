      enable_offset_info = false;
    }
  } else {
    if (!enable_offset_info || offsets->count() < last_idx) {
      scan_ptr = obj.ptr();
      offset = obj.data_offset();
      et = obj.et(cur_idx);
      need_do_scan = true;
    } else {
      scan_ptr = obj.ptr();
      offset = offsets->operator[](obj.et(cur_idx));
