  void inc_max_length() { ++max_length_; }
  void set_max_length(int32_t max_length) { max_length_ = max_length; }

  int32_t get_low_water() const { return low_water_; }
  void reset_low_water() { low_water_ = list_.get_size(); }

  int32_t get_overlimit_times() const { return overlimit_times_; }
  void set_overlimit_times(int32_t times) { overlimit_times_ = times; }
  void inc_overlimit_times() { ++overlimit_times_; }
private:

  int32_t magic_;
  int32_t max_length_;
  int32_t low_water_;
  int32_t overlimit_times_;
  common::ObDList<T> list_;
private:
  ObTCFreeList(const ObTCFreeList&); void operator=(const ObTCFreeList&);
};

template <typename T>
void ob_tc_factory_callback_on_put(T *obj, BoolType<true>)
{
  if ((__builtin_expect(!!(__null == (obj)),!!0))) {
    { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_tc_factory.h", 94, __FUNCTION__, ret, "obj is NULL", "placeholder" ); } } } while (false); };
  } else {
    obj->reset();
  }
}

template <typename T>
void ob_tc_factory_callback_on_put(T *obj, BoolType<false>)
{
  ((void)(obj));
}


template < typename T,
           int64_t MAX_CLASS_NUM,
           const char *LABEL,
           int64_t MEM_LIMIT = 1 << 24 ,
           int32_t MAX_FREE_LIST_LENGTH = 1024 >
class ObTCFactory
{
public:
  static ObTCFactory *get_instance();

  T *get(int32_t type_id);
  void put(T *ptr);

  void stat();
  void set_mem_limit(const int64_t mem_limit) { mem_limit_ = mem_limit; }
public:

  ObTCFactory();
  virtual ~ObTCFactory() {}
