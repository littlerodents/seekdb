inline struct timespec KernelTimeout::MakeAbsTimespec() {
  int64_t n = ns_;
  static const int64_t kNanosPerSecond = 1000 * 1000 * 1000;
  if (n == 0) {
    do { constexpr const char* absl_raw_logging_internal_basename = ::absl::raw_logging_internal::Basename("deps/3rd/usr/local/oceanbase/deps/devel/include/absl/synchronization/internal/kernel_timeout.h", sizeof("deps/3rd/usr/local/oceanbase/deps/devel/include/absl/synchronization/internal/kernel_timeout.h") - 1); ::absl::raw_logging_internal::RawLog(::absl::LogSeverity::kError, absl_raw_logging_internal_basename, 133, "Tried to create a timespec from a non-timeout; never do this."); } while (0);


    n = (std::numeric_limits<int64_t>::max)();
  }





  if (n < 0) n = 0;

  struct timespec abstime;
  int64_t seconds = (std::min)(n / kNanosPerSecond,
                               int64_t{(std::numeric_limits<time_t>::max)()});
  abstime.tv_sec = static_cast<time_t>(seconds);
  abstime.tv_nsec = static_cast<decltype(abstime.tv_nsec)>(n % kNanosPerSecond);
  return abstime;
}

}
