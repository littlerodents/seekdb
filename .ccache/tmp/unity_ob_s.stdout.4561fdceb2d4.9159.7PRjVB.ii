    } else {
      ObRecursiveMutexGuard guard(lock_);
      if (num == num_to_move) {
        if (next_cache_line_ > 0) {
          range.push_range(objs_cache_[--next_cache_line_]);
        } else {

          ret = create_objs(num, obj_size, creator, range);
        }
      } else {

        ret = create_objs(num, obj_size, creator, range);
      }
    }
    return ret;
