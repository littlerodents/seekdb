template <typename K, typename V>
template <int N>
void MdsRow<K, V>::report_event_(const char (&event_str)[N],
                                 const UserMdsNode<K, V> &node,
                                 const char *file,
                                 const uint32_t line,
                                 const char *function_name) const
{
  int ret = OB_SUCCESS;
  constexpr int64_t buffer_size = 1_KB;
  char stack_buffer[buffer_size] = { 0 };
  MdsEvent event;
  if (nullptr == MdsRowBase<K, V>::p_mds_unit_ ||
      nullptr == MdsRowBase<K, V>::p_mds_unit_->p_mds_table_) {
    ret = OB_ERR_UNEXPECTED;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_MDS, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""MDS""] ", 3, "src/storage/multi_data_source/mds_row.ipp", 829, __FUNCTION__, ret, "not expected ptr", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(*this)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(*this)))&&>::value>("*this", ::oceanbase::common::check_char_array(*this))); } } } while (false);
  } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (node.fill_event_(event, event_str, stack_buffer, buffer_size)))),!!0))) {
  } else {
    MdsEventKey key(MdsRowBase<K, V>::p_mds_unit_->p_mds_table_->tablet_id_);
    ObMdsEventBuffer::append(key, event, MdsRowBase<K, V>::p_mds_unit_->p_mds_table_, file, line, function_name);
  }
}

}
}
