  static const int64_t DEFAULT_MAX_DAG_NET_CNT = 500000;
  static const int64_t STOP_ADD_DAG_PERCENT = 70;
  static const int64_t PRINT_SLOW_DAG_NET_THREASHOLD = 30 * 60 * 1000 * 1000L;
  static const int64_t SLOW_COMPACTION_DAG_NET_THREASHOLD = 6L * 60 * 60 * 1000 * 1000;
  static const int64_t LOOP_PRINT_LOG_INTERVAL = 30 * 1000 * 1000L;

private:
  ObIAllocator* allocator_;
  ObIAllocator* reserved_allocator_;
