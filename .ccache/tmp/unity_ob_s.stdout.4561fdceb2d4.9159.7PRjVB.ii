{
public:
  explicit ObMallocHookAttrGuard(const ObMemAttr& attr);
  ~ObMallocHookAttrGuard();
  static ObMemAttr &get_tl_mem_attr()
  {
    static thread_local ObMemAttr tl_mem_attr("glibc_malloc",
                                              ObCtxIds::GLIBC);
    return tl_mem_attr;
  }
private:
