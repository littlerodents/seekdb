            case 6: d = p1 / 100000; p1 %= 100000; break;
            case 5: d = p1 / 10000; p1 %= 10000; break;
            case 4: d = p1 / 1000; p1 %= 1000; break;
            case 3: d = p1 / 100; p1 %= 100; break;
            case 2: d = p1 / 10; p1 %= 10; break;
