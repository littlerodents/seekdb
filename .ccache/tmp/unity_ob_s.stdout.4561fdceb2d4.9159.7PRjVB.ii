  inline bool name_equal(const ObColumnSchemaWrapper &other) const
  {
    ObSchemaNameComparator name_cmp;
    return (0 == name_cmp.compare(column_name_, other.column_name_));
  }
  inline bool all_equal(const ObColumnSchemaWrapper &other) const
  {
    ObSchemaNameComparator name_cmp;
    return (0 == name_cmp.compare(column_name_, other.column_name_))
           && prefix_len_ == other.prefix_len_;
  }
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"column_name", ::oceanbase::common::check_char_array(column_name_), "prefix_len", ::oceanbase::common::check_char_array(prefix_len_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };

  common::ObString column_name_;
  int32_t prefix_len_;
};
