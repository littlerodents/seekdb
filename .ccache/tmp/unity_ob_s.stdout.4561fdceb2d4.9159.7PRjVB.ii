  inline __attribute__((always_inline)) void reuse() { ptr_ = buf_; reserved_ = 0; pack_ = 0; }
  inline __attribute__((always_inline)) void set_ext_value(const int64_t ext_value)
  { reuse(); set_ext(); no_cv(extend_obj_)->set_ext(ext_value); }
  inline __attribute__((always_inline)) void set_nop() { set_ext_value(ObActionFlag::OP_NOP); }
  inline __attribute__((always_inline)) void set_min() { set_ext_value(common::ObObj::MIN_OBJECT_VALUE); }
  inline __attribute__((always_inline)) void set_max() { set_ext_value(common::ObObj::MAX_OBJECT_VALUE); }
  inline __attribute__((always_inline)) bool is_nop_value() const { return is_nop(); }

  inline __attribute__((always_inline)) bool is_local_buf() const { return ptr_ == buf_; }
