namespace oceanbase
{
namespace common
{
namespace meta
{


template <typename T, typename std::enable_if< ::oceanbase::common::meta::has_assign<typename std::decay<T>::type, int(ObIAllocator &, const T &)>::value, bool>::type = true>
inline int copy_or_assign(const T &src,
                          T &dst,
                          ObIAllocator &alloc = DummyAllocator::get_instance())
{
  return dst.assign(alloc, src);
}


template <typename T, typename std::enable_if<!::oceanbase::common::meta::has_assign<typename std::decay<T>::type, int(ObIAllocator &, const T &)>::value &&
                                              ::oceanbase::common::meta::has_assign<typename std::decay<T>::type, int(const T &)>::value, bool>::type = true>
