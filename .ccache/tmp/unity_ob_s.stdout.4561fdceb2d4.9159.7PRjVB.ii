# 37 "/work/src/oblib/lib/thread/ob_thread_lease.h"
class ObThreadLease
{
public:
  typedef enum { IDLE = 0, READY = 1, HANDLING = 2 } StatusType;

public:
  ObThreadLease() : status_(IDLE) {}
  ~ObThreadLease() { status_ = IDLE; }


  StatusType value() const { return status_; }

  void reset()
  {
    status_ = IDLE;
  }

public:
  bool is_idle() const
  {
    return IDLE == __atomic_load_n((&status_), 5);
  }
  bool acquire()
  {
    bool bool_ret = false;
    bool done = false;
    StatusType st = status_;

    while (! done) {
      switch (st) {
        case IDLE:

          st = ({ ((void)(0)); ; __sync_val_compare_and_swap(((&status_)), ((IDLE)), ((HANDLING))); });
          done = (IDLE == st);
          bool_ret = done;
          break;


        case HANDLING:
          st = ({ ((void)(0)); ; __sync_val_compare_and_swap(((&status_)), ((HANDLING)), ((READY))); });
          done = (HANDLING == st);
          break;


        case READY:
          done = true;
          break;


        default:
          done = true;
          bool_ret = false;
      }
    }
    return bool_ret;
  }

  bool revoke()
  {
    bool bool_ret = false;
    bool done = false;
    StatusType st = status_;

    while (! done) {
      switch (st) {

        case HANDLING:
          st = ({ ((void)(0)); ; __sync_val_compare_and_swap(((&status_)), ((HANDLING)), ((IDLE))); });
          done = (HANDLING == st);
          bool_ret = done;
          break;


        case READY:
          st = ({ ((void)(0)); ; __sync_val_compare_and_swap(((&status_)), ((READY)), ((HANDLING))); });
          done = (READY == st);
          break;


        default:
          done = true;
          bool_ret = true;
      }
    }
    return bool_ret;
  }

private:
  StatusType status_;
};

}
}
