inline __attribute__((always_inline)) int ObObjCmpFuncs::get_cmp_func(const ObObjTypeClass tc1,
                                          const ObObjTypeClass tc2,
                                          ObCmpOp cmp_op,
                                          obj_cmp_func &func)
{
  func = cmp_funcs[tc1][tc2][cmp_op];
  return OB_SUCCESS;
}

inline __attribute__((always_inline)) bool ObObjCmpFuncs::can_cmp_without_cast(const ObObjMeta& meta1,
                                                   const ObObjMeta& meta2,
                                                   ObCmpOp cmp_op,
                                                   obj_cmp_func &cmp_func)
{
  int ret = OB_SUCCESS;
  const ObObjType type1 = meta1.get_type();
  const ObObjType type2 = meta2.get_type();
  cmp_func = __null;
  bool need_no_cast = false;
  if (__builtin_expect(!!(is_datetime_timestamp_cmp(type1, type2)),!!0)) {
    need_no_cast = false;
  } else if (__builtin_expect(!!(ob_is_string_type(type1) && ob_is_string_type(type2) && ((meta1.get_collation_type() != meta2.get_collation_type()))),!!0)) {


    need_no_cast = false;
  } else {
    const ObObjTypeClass tc1 = meta1.get_type_class();
    const ObObjTypeClass tc2 = meta2.get_type_class();
    cmp_func = cmp_funcs[tc1][tc2][cmp_op];
    need_no_cast = (cmp_func != __null);
  }
  return need_no_cast;
}

}
