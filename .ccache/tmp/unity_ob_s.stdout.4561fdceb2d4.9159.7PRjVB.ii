  } else {
    int64_t pos = index >> PER_BITSETWORD_MOD_BITS;
    BitSetWord &word = bitset_word_array_[pos];
    word |= ((BitSetWord) 1 << (index & PER_BITSETWORD_MASK));
  }
  return ret;
}
template <int64_t N>
int ObFixedBitSet<N>::del_member(int64_t index)
{
  int ret = OB_SUCCESS;
  if (__builtin_expect(!!(index < 0),!!0) || __builtin_expect(!!(index >= N),!!0)) {
    ret = OB_INVALID_ARGUMENT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 4, "src/oblib/lib/container/ob_bit_set.h", 252, __FUNCTION__, ret, "negative bitmapset member not allowed", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(index)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(index)))&&>::value>("index", ::oceanbase::common::check_char_array(index))); } } } while (false);
  } else {
    int64_t pos = index >> PER_BITSETWORD_MOD_BITS;
    BitSetWord &word = bitset_word_array_[pos];
    word &= ~((BitSetWord) 1 << (index & PER_BITSETWORD_MASK));
  }
  return ret;
}

template <int64_t N>
inline int ObFixedBitSet<N>::add_members(const ObFixedBitSet &other)
{
  int ret = OB_SUCCESS;

  for (int64_t i = 0; i < MAX_BITSETWORD; ++i) {
    bitset_word_array_[i] |= other.bitset_word_array_[i];
  }
  return ret;
}

template <int64_t N>
