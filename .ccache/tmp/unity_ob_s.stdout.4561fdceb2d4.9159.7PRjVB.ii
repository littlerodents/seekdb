            }
            reclaimed_memory_size += mb_handle->mem_block_->get_hold_size();
            func(mb_handle);
          } else {
            prev = curr;
          }
        }
      }

      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && nullptr != prev) {

        ObLink*& tail = prev;
        retire_list = __atomic_load_n((&retire_list_), 5);
        do {
          tail->next_ = retire_list;
        } while (tail->next_ != (retire_list = ({ ((void)(0)); ; __sync_val_compare_and_swap((&retire_list_), (retire_list), (reclaim_list)); })));
      }
      ({ ((void)(0)); ; __sync_sub_and_fetch((&retired_memory_size_), (reclaimed_memory_size)); });
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 2)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 2, "src/share/cache/ob_kvcache_hazard_domain.h", 417, __FUNCTION__, 0, "[KV_CACHE_HAZARD_DOMAIN] finish reclaim", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(retired_memory_size_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(retired_memory_size_)))&&>::value>("retired_memory_size_", ::oceanbase::common::check_char_array(retired_memory_size_)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(reclaimed_memory_size)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(reclaimed_memory_size)))&&>::value>("reclaimed_memory_size", ::oceanbase::common::check_char_array(reclaimed_memory_size))); } } } while (false);
    }
  }

  return ret;
}

