  inline __attribute__((always_inline)) T *iter_rbtree(Rbtree *rbtree, T *start,
                  T * (*cb)(Rbtree *, T *, void *), void *arg)
  {
    T *r_node = __null;
    if ((__builtin_expect(!!(__null == (cb)),!!0))) {
      r_node = __null;
