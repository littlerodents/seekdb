enum class LogIOTaskType
{
  FLUSH_LOG_TYPE = 1,
  FLUSH_META_TYPE = 2,
  TRUNCATE_PREFIX_TYPE = 3,
  PURGE_THROTTLING_TYPE = 6,
};

inline __attribute__((always_inline)) const char *log_io_task_type_str(const LogIOTaskType type)
{

  const char *str = nullptr;
  switch (type) {
    case LogIOTaskType::FLUSH_LOG_TYPE: { str = "FLUSH_LOG_TYPE"; } break;
    case LogIOTaskType::FLUSH_META_TYPE: { str = "FLUSH_META_TYPE"; } break;
    case LogIOTaskType::TRUNCATE_PREFIX_TYPE: { str = "TRUNCATE_PREFIX_TYPE"; } break;
    case LogIOTaskType::PURGE_THROTTLING_TYPE: { str = "PURGE_THROTTLING_TYPE"; } break;
    default: str = "UNKNOWN_TYPE";
  }
  return str;

}

class IPalfHandleImplGuard;
class LogIOTask;

int push_task_into_cb_thread_pool(LogIOTaskCbThreadPool *cb_thread_pool, LogIOTask *io_task);

