}

inline bool ObSimpleTableSchemaV2::is_normal_index() const
{
  return INDEX_TYPE_NORMAL_LOCAL == index_type_
         || INDEX_TYPE_NORMAL_GLOBAL == index_type_
         || INDEX_TYPE_NORMAL_GLOBAL_LOCAL_STORAGE == index_type_;
}

inline bool ObSimpleTableSchemaV2::is_unique_index() const
{
  return is_unique_index(index_type_);
}

inline bool ObSimpleTableSchemaV2::is_unique_index(ObIndexType index_type)
{
  return INDEX_TYPE_UNIQUE_LOCAL == index_type
         || INDEX_TYPE_UNIQUE_GLOBAL == index_type
         || INDEX_TYPE_UNIQUE_GLOBAL_LOCAL_STORAGE == index_type
         || INDEX_TYPE_UNIQUE_MULTIVALUE_LOCAL == index_type
         || INDEX_TYPE_HEAP_ORGANIZED_TABLE_PRIMARY == index_type;
}

inline bool ObSimpleTableSchemaV2::is_domain_index() const
{
  return is_domain_index(index_type_);
}

inline bool ObSimpleTableSchemaV2::is_domain_index(const ObIndexType index_type)
{
  return is_spatial_index(index_type) ||
         share::schema::is_fts_index_aux(index_type) ||
         share::schema::is_fts_doc_word_aux(index_type) ||
         share::schema::is_multivalue_index_aux(index_type) ||
         share::schema::is_vec_index_id_type(index_type) ||
         share::schema::is_vec_delta_buffer_type(index_type) ||
         share::schema::is_vec_index_snapshot_data_type(index_type) ||
         share::schema::is_vec_ivfpq_pq_centroid_index(index_type) ||
         share::schema::is_vec_ivfsq8_meta_index(index_type) ||
         share::schema::is_vec_ivfflat_centroid_index(index_type) ||
         share::schema::is_vec_ivfpq_centroid_index(index_type) ||
         share::schema::is_vec_ivfsq8_centroid_index(index_type) ||
         share::schema::is_vec_dim_docid_value_type(index_type) ||
         share::schema::is_hybrid_vec_index(index_type);
}

inline bool ObSimpleTableSchemaV2::is_fts_or_multivalue_index() const
{
  return share::schema::is_fts_or_multivalue_index(index_type_);
}

inline bool ObSimpleTableSchemaV2::should_not_validate_data_index_ckm() const
{






  return is_domain_index();
}

inline bool ObSimpleTableSchemaV2::should_check_major_merge_progress() const
{


  return is_normal_schema() && (is_sys_table()
          || is_user_table()
          || is_tmp_table()
          || is_aux_lob_table());
}

inline int64_t ObTableSchema::get_id_hash_array_mem_size(const int64_t column_cnt) const
{
  return common::max(IdHashArray::MIN_HASH_ARRAY_ITEM_COUNT,
    column_cnt * 2) * sizeof(void*) + sizeof(IdHashArray);
}

inline int64_t ObTableSchema::get_name_hash_array_mem_size(const int64_t column_cnt) const
{
  return common::max(NameHashArray::MIN_HASH_ARRAY_ITEM_COUNT,
    column_cnt * 2) * sizeof(void *) + sizeof(NameHashArray);
}

template <typename ArrayType>
int64_t ObTableSchema::get_hash_array_mem_size(const int64_t element_cnt) const
{
  return common::max(NameHashArray::MIN_HASH_ARRAY_ITEM_COUNT,
    element_cnt * 2) * sizeof(void *) + sizeof(ArrayType);
}

template <typename Allocator>
int ObTableSchema::build_index_table_name(Allocator &allocator,
                                          const uint64_t data_table_id,
                                          const common::ObString &index_name,
                                          common::ObString &index_table_name)
{
  int ret = common::OB_SUCCESS;
  int nwrite = 0;
  const int64_t buf_size = 64;
  char buf[buf_size];
  if ((nwrite = snprintf(buf, buf_size, "%lu", data_table_id)) >= buf_size || nwrite < 0) {
    ret = common::OB_BUF_NOT_ENOUGH;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 4, "src/share/schema/ob_table_schema.h", 2064, __FUNCTION__, ret, "buf is not large enough", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(buf_size)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(buf_size)))&&>::value>("buf_size", ::oceanbase::common::check_char_array(buf_size)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(data_table_id)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(data_table_id)))&&>::value>("data_table_id", ::oceanbase::common::check_char_array(data_table_id)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
  } else {
    common::ObString table_id_str = common::ObString::make_string(buf);
    int32_t src_len = table_id_str.length() + index_name.length()
        + static_cast<int32_t>(strlen(common::OB_INDEX_PREFIX)) + 1;
    char *ptr = __null;

    if (__builtin_expect(!!(0 >= src_len),!!0)) {
      index_table_name.assign(__null, 0);
    } else if (__null == (ptr = static_cast<char *>(allocator.alloc(src_len)))) {
      ret = common::OB_ALLOCATE_MEMORY_FAILED;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 4, "src/share/schema/ob_table_schema.h", 2075, __FUNCTION__, ret, "alloc memory failed", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(src_len), std::is_rvalue_reference<decltype((src_len))&&>::value>("size", src_len)); } } } while (false);
    } else {
      int64_t pos = 0;
      memcpy(ptr + pos, common::OB_INDEX_PREFIX, strlen(common::OB_INDEX_PREFIX));
      pos += strlen(common::OB_INDEX_PREFIX);
      memcpy(ptr + pos, table_id_str.ptr(), table_id_str.length());
      pos += table_id_str.length();
      memcpy(ptr + pos, "_", 1);
      pos += 1;
      memcpy(ptr + pos, index_name.ptr(), index_name.length());
      pos += index_name.length();
      if (pos == src_len) {
        index_table_name.assign_ptr(ptr, src_len);
      } else {
        ret = common::OB_ERR_UNEXPECTED;
        do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 4, "src/share/schema/ob_table_schema.h", 2090, __FUNCTION__, ret, "length mismatch", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
      }
    }
  }
  return ret;
}

template <typename Allocator>
int ObSimpleTableSchemaV2::get_index_name(Allocator &allocator, uint64_t table_id,
    const common::ObString &src, common::ObString &dst)
{
  int ret = common::OB_SUCCESS;
  common::ObString::obstr_size_t dst_len = 0;
  char *ptr = __null;
  common::ObString::obstr_size_t pos = 0;
  const int64_t BUF_SIZE = 64;
  char table_id_buf[BUF_SIZE] = {'\0'};
  if (common::OB_INVALID_ID == table_id || src.empty()) {
    ret = common::OB_INVALID_ARGUMENT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 4, "src/share/schema/ob_table_schema.h", 2109, __FUNCTION__, ret, "invalid argument", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(table_id)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(table_id)))&&>::value>("table_id", ::oceanbase::common::check_char_array(table_id)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(src)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(src)))&&>::value>("src", ::oceanbase::common::check_char_array(src))); } } } while (false);
  } else {
    int64_t n = snprintf(table_id_buf, BUF_SIZE, "%lu", table_id);
    if (n < 0 || n >= BUF_SIZE) {
      ret = common::OB_BUF_NOT_ENOUGH;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 4, "src/share/schema/ob_table_schema.h", 2114, __FUNCTION__, ret, "buffer not enough", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(n)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(n)))&&>::value>("n", ::oceanbase::common::check_char_array(n)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(static_cast<__typeof__(BUF_SIZE)>(BUF_SIZE)), std::is_rvalue_reference<decltype((static_cast<__typeof__(BUF_SIZE)>(BUF_SIZE)))&&>::value>("BUF_SIZE", static_cast<__typeof__(BUF_SIZE)>(BUF_SIZE))); } } } while (false);
    } else {
      common::ObString table_id_str = common::ObString::make_string(table_id_buf);
      pos += static_cast<int32_t>(strlen(common::OB_INDEX_PREFIX));
      pos += table_id_str.length();
      pos += 1;
      dst_len = src.length() - pos;
      if (__builtin_expect(!!(0 >= dst_len),!!0)) {
        dst.assign(__null, 0);
      } else if (__null == (ptr = static_cast<char *>(allocator.alloc(dst_len)))) {
        ret = common::OB_ALLOCATE_MEMORY_FAILED;
        do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 4, "src/share/schema/ob_table_schema.h", 2125, __FUNCTION__, ret, "alloc memory failed", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(dst_len), std::is_rvalue_reference<decltype((dst_len))&&>::value>("size", dst_len)); } } } while (false);
      } else {
        memcpy(ptr, src.ptr() + pos, dst_len);
        dst.assign_ptr(ptr, dst_len);
      }
    }
  }
  return ret;
}

template<typename ColumnType>
int ObTableSchema::add_column(const ColumnType &column)
{
  using namespace common;
  int ret = common::OB_SUCCESS;
  char *buf = __null;
  ColumnType *local_column = __null;
  const char* thread_name = ob_get_origin_thread_name();
  const bool in_replay_thread = (__builtin_expect(!!(__null != (thread_name)),!!1))
                                && 0 == strcmp(thread_name, REPLAY_SERVICE_THREAD_NAME);

  if (!column.is_valid()) {
    ret = common::OB_INVALID_ARGUMENT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 4, "src/share/schema/ob_table_schema.h", 2148, __FUNCTION__, ret, "The column is not valid", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(ret), std::is_rvalue_reference<decltype((ret))&&>::value>("ret", ret) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(common::ob_error_name(ret)), std::is_rvalue_reference<decltype((common::ob_error_name(ret)))&&>::value>("ret", common::ob_error_name(ret))); } } } while (false);
  } else if (is_user_table() && column_cnt_ > common::OB_USER_ROW_MAX_COLUMNS_COUNT) {
    ret = common::OB_ERR_TOO_MANY_COLUMNS;
  } else if (column.is_autoincrement() && (autoinc_column_id_ != 0)
             && (autoinc_column_id_ != column.get_column_id())) {
    ret = common::OB_ERR_WRONG_AUTO_KEY;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 4, "src/share/schema/ob_table_schema.h", 2154, __FUNCTION__, ret, "Only one auto increment row is allowed", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(ret), std::is_rvalue_reference<decltype((ret))&&>::value>("ret", ret) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(common::ob_error_name(ret)), std::is_rvalue_reference<decltype((common::ob_error_name(ret)))&&>::value>("ret", common::ob_error_name(ret))); } } } while (false);
  } else if (__null == (buf = static_cast<char*>(alloc(sizeof(ColumnType))))) {
    ret = common::OB_ALLOCATE_MEMORY_FAILED;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, ::oceanbase::common::OB_LOG_SHARE::M_SCHEMA, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE"".""SCHEMA""] ", 3, "src/share/schema/ob_table_schema.h", 2157, __FUNCTION__, ret, "Fail to allocate memory", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(ret), std::is_rvalue_reference<decltype((ret))&&>::value>("ret", ret) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(common::ob_error_name(ret)), std::is_rvalue_reference<decltype((common::ob_error_name(ret)))&&>::value>("ret", common::ob_error_name(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(sizeof(ColumnType)), std::is_rvalue_reference<decltype((sizeof(ColumnType)))&&>::value>("size", sizeof(ColumnType))); } } } while (false);
  }
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ret))),!!0))) {
  } else if (!is_view_table()
            && (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (check_row_length(__null, &column)))),!!0))) {
