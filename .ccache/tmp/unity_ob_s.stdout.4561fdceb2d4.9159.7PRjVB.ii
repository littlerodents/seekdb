template <typename T, int64_t MAX_CLASS_NUM, const char *LABEL,
         int64_t MEM_LIMIT, int32_t MAX_FREE_LIST_LENGTH>
         T *ObTCFactory<T, MAX_CLASS_NUM, LABEL, MEM_LIMIT, MAX_FREE_LIST_LENGTH>::get_from_global_factory(
             int32_t type_id, int32_t obj_size)
{
  T *ptr_ret = __null;
  freelist_t &list = freelists_[type_id];
  if (__builtin_expect(!!(false == list.is_empty()),!!0)) {
    { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_tc_factory.h", 229, __FUNCTION__, ret, "list is not empty", "placeholder" ); } } } while (false); };
  } else {
    global_factory_t *gfactory = global_factory_t::get_instance();
    if ((__builtin_expect(!!(__null == (gfactory)),!!0))) {
      { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_tc_factory.h", 233, __FUNCTION__, ret, "gfactory is NULL", "placeholder" ); } } } while (false); };
    } else {
      const int32_t batch_count = gfactory->get_batch_count(type_id);
      const int32_t move_num = std::min(batch_count, list.get_max_length());
      common::ObDList<T> range;
      int ret = OB_SUCCESS;
      if (__builtin_expect(!!(batch_count <= 0),!!0)) {
        do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_tc_factory.h", 240, __FUNCTION__, ret, "batch_count must not be 0!", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(gfactory)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(gfactory)))&&>::value>("gfactory", ::oceanbase::common::check_char_array(gfactory))); } } } while (false);
        ptr_ret = __null;
      } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (gfactory->get_objs(type_id, move_num, range)))),!!0))) {
        do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 4, "src/oblib/lib/objectpool/ob_tc_factory.h", 243, __FUNCTION__, ret, "global factory get_objs failed", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(type_id)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(type_id)))&&>::value>("type_id", ::oceanbase::common::check_char_array(type_id)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(move_num)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(move_num)))&&>::value>("move_num", ::oceanbase::common::check_char_array(move_num))); } } } while (false);
        ptr_ret = __null;
      } else {
        ptr_ret = static_cast<T *>(range.remove_last());
        if (range.get_size() > 0) {
          mem_size_ += range.get_size() * obj_size;
          list.push_range(range);
        } else {}

        if (list.get_max_length() < batch_count) {
          list.inc_max_length();
        } else {
          int32_t new_length = std::min(list.get_max_length() + batch_count, MAX_FREE_LIST_LENGTH);
          new_length -= new_length % batch_count;
          if (__builtin_expect(!!(0 != (new_length % batch_count)),!!0)) {
            do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_tc_factory.h", 258, __FUNCTION__, ret, "new_length mod batch_count != 0", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(new_length)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(new_length)))&&>::value>("new_length", ::oceanbase::common::check_char_array(new_length)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(batch_count)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(batch_count)))&&>::value>("batch_count", ::oceanbase::common::check_char_array(batch_count))); } } } while (false);
          } else {
            list.set_max_length(new_length);
          }
        }
      }
    }
  }
  return ptr_ret;
}

template <typename T, int64_t MAX_CLASS_NUM, const char *LABEL,
int64_t MEM_LIMIT, int32_t MAX_FREE_LIST_LENGTH>
void ObTCFactory<T, MAX_CLASS_NUM, LABEL, MEM_LIMIT, MAX_FREE_LIST_LENGTH>::put(
    T *ptr)
{
  if (__builtin_expect(!!(__null != ptr),!!1)) {
    global_factory_t *gfactory = global_factory_t::get_instance();
    if ((__builtin_expect(!!(__null == (gfactory)),!!0))) {
      { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_tc_factory.h", 277, __FUNCTION__, ret, "gfactory is NULL", "placeholder" ); } } } while (false); };
    } else {
      const int32_t type_id = static_cast<const int32_t>(ptr->get_type());
      const int32_t obj_size = gfactory->get_obj_size(type_id);

      freelist_t &list = freelists_[type_id];
      ob_tc_factory_callback_on_put(ptr, BoolType<oceanbase::common::__has_reset__<T>::value>());
      list.push(ptr);
      mem_size_ += obj_size;
      if (list.get_length() > list.get_max_length()) {

        list_too_long(list, type_id, obj_size);
      } else {}
      if (mem_size_ > mem_limit_) {

        garbage_collect();
      } else {}
      ++put_count_[type_id];
    }
  }
}

template <typename T, int64_t MAX_CLASS_NUM, const char *LABEL,
         int64_t MEM_LIMIT, int32_t MAX_FREE_LIST_LENGTH>
void ObTCFactory<T, MAX_CLASS_NUM, LABEL, MEM_LIMIT, MAX_FREE_LIST_LENGTH>::list_too_long(
    freelist_t &list, int32_t type_id, int32_t obj_size)
{
  global_factory_t *gfactory = global_factory_t::get_instance();
  if ((__builtin_expect(!!(__null == (gfactory)),!!0))) {
    { int __ret__ = common::OB_ERR_UNEXPECTED; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_tc_factory.h", 306, __FUNCTION__, ret, "gfactory is NULL", "placeholder" ); } } } while (false); };
  } else {
    const int32_t batch_count = gfactory->get_batch_count(type_id);

    common::ObDList<T> range;
    list.pop_range(batch_count, range);
    mem_size_ -= obj_size * range.get_size();
    gfactory->put_objs(type_id, range);

    if (list.get_max_length() < batch_count) {
      list.inc_max_length();
    } else if (list.get_max_length() > batch_count) {

      list.inc_overlimit_times();
      if (list.get_overlimit_times() >= MAX_OVERLIMIT_TIMES) {
        list.set_max_length(list.get_max_length() - batch_count);
        list.set_overlimit_times(0);
      } else {}
    }
  }
}

template <typename T, int64_t MAX_CLASS_NUM, const char *LABEL,
int64_t MEM_LIMIT, int32_t MAX_FREE_LIST_LENGTH>
void ObTCFactory<T, MAX_CLASS_NUM, LABEL, MEM_LIMIT, MAX_FREE_LIST_LENGTH>::garbage_collect()
{
  int ret = OB_SUCCESS;
  global_factory_t *gfactory = global_factory_t::get_instance();
  if ((__builtin_expect(!!(__null == (gfactory)),!!0))) {
    ret = OB_INVALID_ARGUMENT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 3, "src/oblib/lib/objectpool/ob_tc_factory.h", 336, __FUNCTION__, ret, "gfactory is NULL", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
  } else {
    common::ObDList<T> range;
    for (int32_t type_id = 0; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && type_id < MAX_CLASS_NUM; ++type_id) {
      const int32_t obj_size = gfactory->get_obj_size(type_id);
      if (0 >= obj_size) {

        continue;
      } else {}
      freelist_t &list = freelists_[type_id];
      const int32_t low_water = list.get_low_water();
      if (0 < low_water) {
        const int32_t drop_num = (low_water > 1) ? (low_water / 2) : 1;


        const int32_t batch_count = gfactory->get_batch_count(type_id);
        range.reset();
        list.pop_range(drop_num, range);
        mem_size_ -= obj_size * range.get_size();
        gfactory->put_objs(type_id, range);


        if (list.get_max_length() > batch_count) {
          list.set_max_length(list.get_max_length() - batch_count);
        } else {}
      } else {}
      list.reset_low_water();
    }
  }
}

template <typename T, int64_t MAX_CLASS_NUM, const char *LABEL,
int64_t MEM_LIMIT, int32_t MAX_FREE_LIST_LENGTH>
void ObTCFactory<T, MAX_CLASS_NUM, LABEL, MEM_LIMIT, MAX_FREE_LIST_LENGTH>::stat()
{
  int ret = OB_SUCCESS;
  self_t *tc_factory = const_cast<self_t *>(TC_FACTORY_LIST_HEAD);
  int32_t i = 0;
  int64_t total_mem_size = 0;
  int64_t total_length = 0;
  int64_t total_max_length = 0;
  int32_t length = 0;
  int32_t max_length = 0;
  int32_t low_water = 0;
  int32_t overlimit_times = 0;
  int64_t class_total_length[MAX_CLASS_NUM];
  int64_t class_total_max_length[MAX_CLASS_NUM];
  int64_t allocated_count[MAX_CLASS_NUM];
  memset(class_total_length, 0, sizeof(class_total_length));
  memset(class_total_max_length, 0, sizeof(class_total_max_length));
  memset(allocated_count, 0, sizeof(allocated_count));
  while (__null != tc_factory && (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 2)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 2, "src/oblib/lib/objectpool/ob_tc_factory.h", 388, __FUNCTION__, 0, "[TCFACTORY_STAT] type_id=ALL", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(i), std::is_rvalue_reference<decltype((i))&&>::value>("thread", i) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(tc_factory->mem_size_), std::is_rvalue_reference<decltype((tc_factory->mem_size_))&&>::value>("mem_size", tc_factory->mem_size_)); } } } while (false);
    total_mem_size += tc_factory->mem_size_;
    for (int32_t type_id = 0; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && type_id < MAX_CLASS_NUM; ++type_id) {
      length = tc_factory->freelists_[type_id].get_length();
      max_length = tc_factory->freelists_[type_id].get_max_length();
      low_water = tc_factory->freelists_[type_id].get_low_water();
      overlimit_times = tc_factory->freelists_[type_id].get_overlimit_times();

      total_length += length;
      total_max_length += max_length;

      class_total_length[type_id] += length;
      class_total_max_length[type_id] += max_length;

      allocated_count[type_id] += tc_factory->get_count_[type_id] - tc_factory->put_count_[type_id];
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 2)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 2, "src/oblib/lib/objectpool/ob_tc_factory.h", 406, __FUNCTION__, 0, "[TCFACTORY_STAT]", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(i), std::is_rvalue_reference<decltype((i))&&>::value>("thread", i) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(type_id)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(type_id)))&&>::value>("type_id", ::oceanbase::common::check_char_array(type_id)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(length)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(length)))&&>::value>("length", ::oceanbase::common::check_char_array(length)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(max_length)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(max_length)))&&>::value>("max_length", ::oceanbase::common::check_char_array(max_length)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(low_water)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(low_water)))&&>::value>("low_water", ::oceanbase::common::check_char_array(low_water)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(overlimit_times)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(overlimit_times)))&&>::value>("overlimit_times", ::oceanbase::common::check_char_array(overlimit_times)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(tc_factory->get_count_[type_id]), std::is_rvalue_reference<decltype((tc_factory->get_count_[type_id]))&&>::value>("get_count", tc_factory->get_count_[type_id]) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(tc_factory->put_count_[type_id]), std::is_rvalue_reference<decltype((tc_factory->put_count_[type_id]))&&>::value>("put_count", tc_factory->put_count_[type_id])); } } } while (false);



    }
    tc_factory = const_cast<self_t *>(tc_factory->next_);
    ++i;
