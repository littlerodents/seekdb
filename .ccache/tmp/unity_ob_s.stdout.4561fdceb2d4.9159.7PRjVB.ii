        }
      }
      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1))) {

        memcpy(&block_list_[pos][size_ % BLOCK_ITEM_CNT], &v, sizeof(v));
        ++size_;
      }
    }
    return ret;
  }
  void reuse() { size_ = 0; }
  void destroy()
  {
    reuse();
    for (int64_t i = 0; i < MAX_BLOCK_CNT; ++i) {
      if (__null == block_list_[i]) {
        break;
      } else {
