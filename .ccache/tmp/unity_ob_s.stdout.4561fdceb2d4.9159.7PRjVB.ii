    hash_bkt_[idx] = nullptr;
  }
}

template <typename K, typename V>
ObRecycleMultiKVCache<K, V>::HashBkt::~HashBkt() {
  new (this) HashBkt();
}

template <typename K, typename V>
void ObRecycleMultiKVCache<K, V>::HashBkt::insert(KVNode<K, V> *node) {
