inline __attribute__((always_inline)) void ObDatumRange::change_boundary(const ObDatumRowkey &rowkey, bool is_reverse, bool is_closed)
{
  if (is_reverse) {
    end_key_ = rowkey;
    if (is_closed) {
      border_flag_.set_inclusive_end();
    } else {
      border_flag_.unset_inclusive_end();
    }
  } else {
    start_key_ = rowkey;
    if (is_closed) {
      border_flag_.set_inclusive_start();
    } else {
      border_flag_.unset_inclusive_start();
    }
  }
}

