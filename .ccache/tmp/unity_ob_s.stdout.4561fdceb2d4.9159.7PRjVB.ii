  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"piece_id", ::oceanbase::common::check_char_array(piece_id_), "len", ::oceanbase::common::check_char_array(len_), "macro_id", ::oceanbase::common::check_char_array(macro_id_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
};

