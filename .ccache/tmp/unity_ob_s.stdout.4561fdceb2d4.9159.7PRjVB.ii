inline int64_t ObDatum::checksum(const int64_t current) const
{
  int64_t result = ob_crc64_sse42(current, &pack_, sizeof(pack_));
  if (len_ > 0) {
    result = ob_crc64_sse42(result, ptr_, len_);
  }
  return result;
}

