class BitSet
{
public:
  static const int64_t BYTE_PER_WORD = sizeof(uint64_t);
  static const int64_t BITS_PER_WORD = BYTE_PER_WORD * 8;

  BitSet() : words_(__null), words_num_(0) {}

  inline int init(uint64_t *words, const int64_t bits_num)
  {
    int ret = common::OB_SUCCESS;
    if (__null == words || 0 > bits_num) {
      ret = common::OB_INVALID_ARGUMENT;
