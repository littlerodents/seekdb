namespace oceanbase {
namespace storage {
class ObLS;
class ObTabletHandle;
namespace mds {
class MdsTableFreezeGuard;
class MdsTableBase;

class RemovedMdsTableRecorder
{
public:
  RemovedMdsTableRecorder() = default;
  void record(MdsTableBase *mds_table);
  void del(MdsTableBase *mds_table);
  bool check_is_list_head(MdsTableBase *mds_table) {
    SpinRLockGuard guard(lock_);
    return removed_mds_table_list_.list_head_ == (ListNodeBase *)mds_table;
  }
  template <typename OP>
  void for_each(OP &&op) {
    SpinRLockGuard guard(lock_);
    removed_mds_table_list_.for_each_node_from_head_to_tail_until_true(op);
  }
private:
  SpinRWLock lock_;
  mds::List<MdsTableBase> removed_mds_table_list_;
};

class ObMdsTableMgr final : public checkpoint::ObCommonCheckpoint
{
  friend MdsTableFreezeGuard;
public:
  ObMdsTableMgr()
      : is_inited_(false),
        is_freezing_(false),
        freezing_scn_(share::SCN::min_scn()),
        ref_cnt_(0),
        ls_(nullptr),
        mds_table_map_(),
        removed_mds_table_recorder_() {}
  ~ObMdsTableMgr() { destroy(); }
  int64_t to_string(char* buf, const int64_t buf_len) const;

  int init(ObLS *ls);
  int reset();
  void offline();
  void destroy();
  int register_to_mds_table_mgr(MdsTableBase *p_mds_table);
  int unregister_from_mds_table_mgr(MdsTableBase *p_mds_table);
  void unregister_from_removed_mds_table_recorder(MdsTableBase *p_mds_table);
  template <typename OP, typename std::enable_if< ::oceanbase::common::meta::is_function_like<typename std::decay<OP>::type, int(MdsTableBase &)>::value, bool>::type = true>
  int for_each_removed_mds_table(OP &&op) {
    int ret = OB_SUCCESS;
    auto op_wrapper = [&op, &ret](const MdsTableBase &mds_table) -> bool {
      bool break_flag = false;
      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (op(const_cast<MdsTableBase &>(mds_table))))),!!0))) {
        break_flag = true;
      }
      return break_flag;
    };
    removed_mds_table_recorder_.for_each(op_wrapper);
    return ret;
  }
  template <typename OP>
  struct OpWrapper {
    template <typename T>
    OpWrapper(T &&op) : op_(op) {}
    bool operator()(const common::ObTabletID &k, MdsTableBase* &v) {
      bool keep_iterating = true;
      int ret = OB_SUCCESS;
      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (op_(*v)))),!!0))) {
        keep_iterating = false;
      }
      return keep_iterating;
    }
    OP op_;
  };
  template <typename OP, typename std::enable_if< ::oceanbase::common::meta::is_function_like<typename std::decay<OP>::type, int(MdsTableBase &)>::value, bool>::type = true>
  int for_each_in_t3m_mds_table(OP &&op) {
