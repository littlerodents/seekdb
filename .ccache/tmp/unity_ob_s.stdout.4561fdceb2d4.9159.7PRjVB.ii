};

inline __attribute__((always_inline)) bool is_string_encoding_valid(const ObObjTypeStoreClass sc)
{
  return sc == ObStringSC || sc == ObTextSC || sc == ObJsonSC || sc == ObGeometrySC;
}

inline __attribute__((always_inline)) bool store_class_might_contain_lob_locator(const ObObjTypeStoreClass sc)
{
  return sc == ObTextSC || sc == ObLobSC || sc == ObJsonSC || sc == ObGeometrySC;
}

inline __attribute__((always_inline)) bool is_var_length_type(const ObObjTypeStoreClass sc)
{
  return sc == ObNumberSC || sc == ObDecimalIntSC || sc == ObStringSC || sc == ObTextSC
      || sc == ObLobSC || sc == ObJsonSC || sc == ObGeometrySC;
}

