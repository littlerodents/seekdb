enum ObWhiteFilterOperatorType
{
  WHITE_OP_EQ = 0,
  WHITE_OP_LE,
  WHITE_OP_LT,
  WHITE_OP_GE,
  WHITE_OP_GT,
  WHITE_OP_NE,
  WHITE_OP_BT,
  WHITE_OP_IN,
  WHITE_OP_NU,
  WHITE_OP_NN,

  WHITE_OP_MAX,
};
class ObPushdownWhiteFilterNode : public ObPushdownFilterNode
{
  public: virtual int serialize(char *buf, const int64_t buf_len, int64_t &pos) const ; int serialize_(char *buf, const int64_t buf_len, int64_t &pos) const; virtual int deserialize(const char *buf, const int64_t data_len, int64_t &pos) ; int deserialize_(const char *buf, const int64_t data_len, int64_t &pos); virtual int64_t get_serialize_size() const ; int64_t get_serialize_size_() const;; private: const static int64_t UNIS_VERSION = 1;
public:
  ObPushdownWhiteFilterNode(common::ObIAllocator &alloc)
      : ObPushdownFilterNode(alloc, PushdownFilterType::WHITE_FILTER),
      expr_(nullptr), op_type_(WHITE_OP_MAX) , column_exprs_(alloc)
  {}
  ~ObPushdownWhiteFilterNode() {}
  virtual inline __attribute__((always_inline)) int set_op_type(const ObRawExpr &raw_expr);
  inline __attribute__((always_inline)) ObWhiteFilterOperatorType get_op_type() const { return op_type_; }
  virtual int get_filter_val_meta(common::ObObjMeta &obj_meta) const;
  int get_filter_in_val_meta(int64_t arg_idx, common::ObObjMeta &obj_meta) const;
  inline virtual ObObjType get_filter_arg_obj_type(int64_t arg_idx) const
  {
    const ObExpr *expr = WHITE_OP_IN == op_type_ ? expr_->args_[1] : expr_;
    return expr->args_[arg_idx]->obj_meta_.get_type();
  }


  static const common::ObCmpOp WHITE_OP_TO_CMP_OP[WHITE_OP_MAX];
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"%s", ("ObPushdownWhiteFilterNode")); ::oceanbase::common::databuff_printf(buf, buf_len, pos,":"); pos += ObPushdownFilterNode::to_string(buf + pos, buf_len - pos); ::oceanbase::common::databuff_printf(buf, buf_len, pos,", "); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"expr", ::oceanbase::common::ObLogPrintPointerCnt<__typeof__(expr_)>(expr_), "op_type", ::oceanbase::common::check_char_array(op_type_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };

public:
  ObExpr *expr_;
protected:
  ObWhiteFilterOperatorType op_type_;
public:
  ExprFixedArray column_exprs_;
};

class ObPushdownDynamicFilterNode : public ObPushdownWhiteFilterNode
{
  public: virtual int serialize(char *buf, const int64_t buf_len, int64_t &pos) const ; int serialize_(char *buf, const int64_t buf_len, int64_t &pos) const; virtual int deserialize(const char *buf, const int64_t data_len, int64_t &pos) ; int deserialize_(const char *buf, const int64_t data_len, int64_t &pos); virtual int64_t get_serialize_size() const ; int64_t get_serialize_size_() const;; private: const static int64_t UNIS_VERSION = 1;
public:
  ObPushdownDynamicFilterNode(common::ObIAllocator &alloc)
      : ObPushdownWhiteFilterNode(alloc), col_idx_(0), is_first_child_(false),
        is_last_child_(false), val_meta_(),
        dynamic_filter_type_(DynamicFilterType::MAX_DYNAMIC_FILTER_TYPE)
  {
    type_ = PushdownFilterType::DYNAMIC_FILTER;
  }
  ~ObPushdownDynamicFilterNode() {}
  int set_op_type(const ObRawExpr &raw_expr) override;

  inline void set_op_type(const ObWhiteFilterOperatorType &op_type) { op_type_ = op_type; }
  inline int64_t get_col_idx() const
  {
    return col_idx_;
  }
  inline void set_col_idx(int col_idx) { col_idx_ = col_idx; }
