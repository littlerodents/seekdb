    do{ if(__builtin_expect(!!(!((__builtin_expect(!!(__null != (node->hash_bkt_prev_next_ptr_)),!!1)))),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/share/cache/ob_recycle_multi_kvcache.ipp", 88, __FUNCTION__, ret, "assert fail, exp=%s", "OB_NOT_NULL(node->hash_bkt_prev_next_ptr_)"); } } } while (false); }; do { if (__builtin_expect(!!(1),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/share/cache/ob_recycle_multi_kvcache.ipp", 88, __FUNCTION__, ret, "assert fail" " BACKTRACE:%s", oceanbase::common::lbt()); } } } while (false); }; } } while (false); ob_abort(); } } while(false);
