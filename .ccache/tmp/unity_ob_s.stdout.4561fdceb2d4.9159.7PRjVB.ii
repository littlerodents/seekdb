  const ObLobChunkIndex& chunk_index(int chunk_idx) const { return partial_data_->index_[chunk_idx]; }
  ObLobChunkData& chunk_data(int chunk_idx) { return partial_data_->data_[partial_data_->index_[chunk_idx].data_idx_]; }
