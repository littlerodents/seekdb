  (false ? static_cast<void>(bytes_remaining_ > 0 && "Attempted to iterate past `end()`") : static_cast<void>(0));

  (static_cast<void> (0));
  bytes_remaining_ -= current_chunk_.size();
  if (bytes_remaining_ > 0) {
    return btree_reader_ ? AdvanceBtree() : AdvanceStack();
  } else {
    current_chunk_ = {};
  }
  return *this;
}

