enum class TxCtxSource
{
  UNKNOWN = 0,
  MVCC_WRITE = 1,
  REGISTER_MDS = 2,
  REPLAY = 3,
  RECOVER = 4,
};

static const char * to_str_ctx_source(const TxCtxSource & ctx_src)
{
  const char * str = "INVALID";
  switch(ctx_src)
  {
    case TxCtxSource::UNKNOWN: str = "UNKNOWN"; break;;
    case TxCtxSource::MVCC_WRITE: str = "MVCC_WRITE"; break;;
    case TxCtxSource::REGISTER_MDS: str = "REGISTER_MDS"; break;;
    case TxCtxSource::REPLAY: str = "REPLAY"; break;;
    case TxCtxSource::RECOVER: str = "RECOVER"; break;;
  }
  return str;
}


