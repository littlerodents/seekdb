struct ObMicroBlockInfo
{
  static const int64_t SF_BIT_OFFSET = 24;
  static const int64_t MAX_OFFSET = (1 << (SF_BIT_OFFSET - 1)) - 1;
  static const int64_t SF_BIT_SIZE = 24;
  static const int64_t MAX_SIZE = (1 << (SF_BIT_SIZE - 1)) - 1;
  static const int64_t SF_BIT_MARK_DELETION = 1;
  static const uint64_t MAX_MARK_DELETION = (1 << (SF_BIT_MARK_DELETION)) - 1;
  static const int64_t SF_BIT_RESERVED = 15;

  struct
  {
    int32_t offset_ : SF_BIT_OFFSET;
    int32_t size_ : SF_BIT_SIZE;
    bool mark_deletion_ : SF_BIT_MARK_DELETION;
    uint16_t reserved_: SF_BIT_RESERVED;
  };
  ObLogicMicroBlockId logic_micro_id_;
  int64_t data_checksum_;
  ObMicroBlockInfo() : offset_(0), size_(0), mark_deletion_(false), reserved_(0), logic_micro_id_(), data_checksum_(0) {}

  int64_t get_block_size() const
  { return size_; }
  int64_t get_block_offset() const
  { return offset_; }
  void reset() { offset_ = 0; size_ = 0; mark_deletion_ = false; reserved_ = 0; logic_micro_id_.reset(); data_checksum_ = 0; }
  int set(const int32_t offset, const int32_t size, const ObLogicMicroBlockId &logic_micro_id, const int64_t data_checksum, bool mark_deletion = false)
  {
    int ret = common::OB_SUCCESS;
    if (!is_offset_valid(offset) || !is_size_valid(size)) {
      ret = common::OB_INVALID_ARGUMENT;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_STORAGE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""STORAGE""] ", 4, "src/storage/blocksstable/ob_micro_block_info.h", 59, __FUNCTION__, ret, "Setting invalid value, it may be caused by overflow when converting type", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(offset)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(offset)))&&>::value>("offset", ::oceanbase::common::check_char_array(offset)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(size)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(size)))&&>::value>("size", ::oceanbase::common::check_char_array(size))); } } } while (false);

    } else {
      offset_ = offset & MAX_OFFSET;
      size_ = size & MAX_SIZE;
      mark_deletion_ = mark_deletion & MAX_MARK_DELETION;
      logic_micro_id_ = logic_micro_id;
      data_checksum_ = data_checksum;
    }
    return ret;
  }
  bool is_offset_valid(const int32_t offset) const
  {
    return offset >= 0 && offset <= MAX_OFFSET;
  }
  bool is_size_valid(const int32_t size) const
  {
    return size > 0 && size <= MAX_SIZE;
  }
  bool is_valid() const { return offset_ >=0 && size_ > 0; }
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"offset", ::oceanbase::common::check_char_array(offset_), "size", ::oceanbase::common::check_char_array(size_), "mark_deletion", ::oceanbase::common::check_char_array(mark_deletion_), "logic_micro_id", ::oceanbase::common::check_char_array(logic_micro_id_), "data_checksum", ::oceanbase::common::check_char_array(data_checksum_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
};
