          r_node = iter_recurse(rbtree, get_right(node), cb, arg);
      }
    }
    return r_node;
  }

  T *iter_start(Rbtree *rbtree, T *start, T *node,
                        T * (*cb)(Rbtree *, T *, void *), void *arg)
