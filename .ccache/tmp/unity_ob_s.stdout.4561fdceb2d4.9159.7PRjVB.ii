  int64_t rows_;
  int64_t width_;
  PxOpSizeFactor px_est_size_factor_;
  int64_t plan_depth_;
  int64_t max_batch_size_;
  bool need_check_output_datum_;
  ObCompressorType compress_type_;

private:
  ObOpSpec(const ObOpSpec&); void operator=(const ObOpSpec&);
};

