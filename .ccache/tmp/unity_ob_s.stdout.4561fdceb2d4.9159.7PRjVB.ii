  } else {
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (databuff_printf(buf, buf_len, pos, "[")))),!!0))) {
    } else {}
    for (int64_t i = 0; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && i < size; ++i) {
      if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (databuff_print_obj(buf, buf_len, pos, obj[i])))),!!0))) {
      } else if (i != size - 1) {
