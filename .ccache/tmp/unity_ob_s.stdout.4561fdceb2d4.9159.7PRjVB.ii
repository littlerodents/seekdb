class ObSnapshotGcScnRenewalState
{
public:
  ObSnapshotGcScnRenewalState() : renew_target_scn_(0) {}
  ~ObSnapshotGcScnRenewalState() = default;

  void update_target_scn(const int64_t target_scn)
  {
    if (target_scn > 0 && (9223372036854775807L) != target_scn) {
      int64_t old_scn = __atomic_load_n((&renew_target_scn_), 5);
      while (old_scn < target_scn) {
        const int64_t actual_scn = ({ ((void)(0)); ; __sync_val_compare_and_swap((&renew_target_scn_), (old_scn), (target_scn)); });

        if (old_scn == actual_scn) {
          break;
        } else {
          old_scn = actual_scn;
        }
      }
    }
  }
  int64_t get_target_scn() const { return __atomic_load_n((&renew_target_scn_), 5); }

private:
  int64_t renew_target_scn_;

private:
  ObSnapshotGcScnRenewalState(const ObSnapshotGcScnRenewalState&); void operator=(const ObSnapshotGcScnRenewalState&);
};

}
