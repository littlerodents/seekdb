namespace oceanbase
{
namespace common
{

typedef uint16_t ObEventID;

template <typename EventType, int64_t EVENT_COUNT, int64_t INFO_BUFFER_SIZE>
struct ObSeqEventRecorder
{
  ObSeqEventRecorder()
      :next_idx_(0),
       buffer_pos_(0),
       dropped_events_(0)
  {
    static_assert(INFO_BUFFER_SIZE<(32767), "INFO_BUFFER_SIZE too large");
  }
  int assign(const ObSeqEventRecorder &other)
  {
    next_idx_ = (EVENT_COUNT < other.next_idx_) ? EVENT_COUNT : other.next_idx_;
    memcpy(this->events_, other.events_, sizeof(EventType)*next_idx_);
    memcpy(this->buffer_, other.buffer_, other.buffer_pos_);
    buffer_pos_ = other.buffer_pos_;
    dropped_events_ = other.dropped_events_;
    return OB_SUCCESS;
  }
  EventType &add_event(bool &overflow)
  {
    if (0 > next_idx_) {
      { int __ret__ = OB_ERROR; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 3, "src/oblib/lib/trace/ob_seq_event_recorder.h", 52, __FUNCTION__, ret, "fatal: next_idx illegal", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(next_idx_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(next_idx_)))&&>::value>("next_idx", ::oceanbase::common::check_char_array(next_idx_))); } } } while (false); };
      dropped_events_++;
      overflow = true;
      return events_[EVENT_COUNT-1];
    } else if (next_idx_ >= EVENT_COUNT) {
      dropped_events_++;
      overflow = true;
      return events_[EVENT_COUNT-1];
    } else {
      int64_t idx = __sync_fetch_and_add(&next_idx_, 1);
      return (idx < EVENT_COUNT) ?
          events_[idx] :
          (dropped_events_++, (overflow = true), events_[EVENT_COUNT-1]);
    }
  }
  EventType &add_event()
  {
    if (0 > next_idx_) {
      { int __ret__ = OB_ERROR; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_COMMON, 3)),!!0)) { ::oceanbase::common::OB_PRINT("[""COMMON""] ", 3, "src/oblib/lib/trace/ob_seq_event_recorder.h", 70, __FUNCTION__, ret, "fatal: next_idx illegal", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(next_idx_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(next_idx_)))&&>::value>("next_idx", ::oceanbase::common::check_char_array(next_idx_))); } } } while (false); };
      dropped_events_++;
      return events_[EVENT_COUNT-1];
    } else if (next_idx_ >= EVENT_COUNT) {
      dropped_events_++;
      return events_[EVENT_COUNT-1];
    } else {
      int64_t idx = __sync_fetch_and_add(&next_idx_, 1);
      return (idx < EVENT_COUNT) ?
          events_[idx] :
          (dropped_events_++, events_[EVENT_COUNT-1]);
    }
  }
  const EventType &get_event(int64_t idx) const { return events_[idx]; }
  int64_t count() const { return (EVENT_COUNT < next_idx_) ? EVENT_COUNT : next_idx_; }
  void reset() { next_idx_ = 0; buffer_pos_ = 0; dropped_events_ = 0; }
  char *get_buffer() { return buffer_;}
  int64_t &get_buffer_pos() { return buffer_pos_; }

  EventType* get_events_array() { return events_; }
  const EventType* get_events_array() const { return events_; }
  void set_count(int64_t count) { next_idx_ = count; }
public:
  static const int64_t MAX_EVENT_COUNT = EVENT_COUNT;
  static const int64_t MAX_INFO_BUFFER_SIZE = INFO_BUFFER_SIZE;
