  ObCollectionBasicType *elem_type = dynamic_cast<ObCollectionBasicType *>(dynamic_cast<const ObCollectionArrayType*>(this->get_array_type())->element_type_);
  if (__builtin_expect(!!(idx >= this->length_),!!0)) {
    ret = OB_ERR_UNEXPECTED;
    do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::OB_PRINT("", 4, "src/oblib/common/udt/ob_array_fixed_size.ipp", 402, __FUNCTION__, ret, "idx >= this->length_", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(idx)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(idx)))&&>::value>("idx", ::oceanbase::common::check_char_array(idx)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(this->length_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(this->length_)))&&>::value>("this->length_", ::oceanbase::common::check_char_array(this->length_))); } } } while (false);
  } else {
    switch (elem_type->basic_meta_.get_obj_type()) {
    case ObTinyIntType: {
      elem_obj.set_tinyint(data_[idx]);
      break;
    }
    case ObSmallIntType: {
      elem_obj.set_smallint(data_[idx]);
      break;
    }
    case ObInt32Type: {
      elem_obj.set_int32(data_[idx]);
      break;
    } case ObIntType: {
      elem_obj.set_int(data_[idx]);
      break;
    }
    case ObUTinyIntType: {
      elem_obj.set_utinyint(data_[idx]);
      break;
    }
    case ObUSmallIntType: {
      elem_obj.set_usmallint(data_[idx]);
