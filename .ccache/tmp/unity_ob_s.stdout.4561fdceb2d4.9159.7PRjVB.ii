enum ObBoolMaskType
{
  PROBABILISTIC = 0,
  ALWAYS_TRUE,
  ALWAYS_FALSE
};

enum DynamicFilterAction
{
  DO_FILTER = 0,
  FILTER_ALL,
  PASS_ALL,
};

enum DynamicFilterType
{
  JOIN_RUNTIME_FILTER= 0,
  PD_TOPN_FILTER = 1,
  MAX_DYNAMIC_FILTER_TYPE
};

struct ObBoolMask
{
  ObBoolMask()
    : bmt_(ObBoolMaskType::PROBABILISTIC) {};
  ObBoolMask(ObBoolMaskType bmt)
    : bmt_(bmt) {};
  inline __attribute__((always_inline)) ObBoolMask operator &(const ObBoolMask &m) const
  {
    if (m.bmt_ == ObBoolMaskType::ALWAYS_TRUE) {
      return {bmt_};
    } else if (bmt_ == ObBoolMaskType::ALWAYS_TRUE) {
      return {m.bmt_};
    } else if (m.bmt_ == ObBoolMaskType::ALWAYS_FALSE
                || bmt_ == ObBoolMaskType::ALWAYS_FALSE) {
      return {ObBoolMaskType::ALWAYS_FALSE};
    } else {
      return {ObBoolMaskType::PROBABILISTIC};
    }
  }
  inline __attribute__((always_inline)) ObBoolMask operator |(const ObBoolMask &m) const
  {
    if (m.bmt_ == ObBoolMaskType::ALWAYS_FALSE) {
      return {bmt_};
    } else if (bmt_ == ObBoolMaskType::ALWAYS_FALSE) {
      return {m.bmt_};
    } else if (m.bmt_ == ObBoolMaskType::ALWAYS_TRUE
                || bmt_ == ObBoolMaskType::ALWAYS_TRUE) {
      return {ObBoolMaskType::ALWAYS_TRUE};
    } else {
      return {ObBoolMaskType::PROBABILISTIC};
    }
  }
  inline __attribute__((always_inline)) bool is_always_true() const
  {
    return ObBoolMaskType::ALWAYS_TRUE == bmt_;
  }
  inline __attribute__((always_inline)) bool is_always_false() const
  {
    return ObBoolMaskType::ALWAYS_FALSE == bmt_;
  }
  inline __attribute__((always_inline)) bool is_uncertain() const
  {
    return ObBoolMaskType::PROBABILISTIC == bmt_;
  }
  inline __attribute__((always_inline)) bool is_constant() const
  {
    return ObBoolMaskType::ALWAYS_TRUE == bmt_ ||
        ObBoolMaskType::ALWAYS_FALSE == bmt_;
  }
  inline __attribute__((always_inline)) void set_always_true()
  {
    bmt_ = ObBoolMaskType::ALWAYS_TRUE;
  }
  inline __attribute__((always_inline)) void set_always_false()
  {
    bmt_ = ObBoolMaskType::ALWAYS_FALSE;
  }
  inline __attribute__((always_inline)) void set_uncertain()
  {
    bmt_ = ObBoolMaskType::PROBABILISTIC;
  }
  inline __attribute__((always_inline)) void set(ObBoolMaskType bmt)
  {
    bmt_ = bmt;
  }
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"bmt", ::oceanbase::common::check_char_array(bmt_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };

  ObBoolMaskType bmt_;
};

struct ObStoragePushdownFlag
{
public:
  ObStoragePushdownFlag() : pd_flag_(0) {};
  ObStoragePushdownFlag(const int32_t flag) : pd_flag_(flag) {}
  ~ObStoragePushdownFlag() = default;
  const ObStoragePushdownFlag &operator =(const ObStoragePushdownFlag &other) {
    if (this != &other) {
      this->pd_flag_ = other.pd_flag_;
    }
    return *this;
  }

  inline __attribute__((always_inline)) void set_blockscan_pushdown(const bool block_scan) { pd_blockscan_ = block_scan; }
  inline __attribute__((always_inline)) void set_filter_pushdown(const bool filter) { pd_filter_ = filter; }
  inline __attribute__((always_inline)) void set_aggregate_pushdown(const bool aggregate) { pd_aggregate_ = aggregate; }
  inline __attribute__((always_inline)) void set_group_by_pushdown(const bool groupby) { pd_group_by_ = groupby; }
  inline __attribute__((always_inline)) void set_filter_reorder(const bool filter_reorder) { pd_filter_reorder_ = filter_reorder; }
  inline __attribute__((always_inline)) void set_enable_skip_index(const bool skip_index) { enable_skip_index_ = skip_index; }
  inline __attribute__((always_inline)) void set_use_stmt_iter_pool(const bool use_pool) { use_stmt_iter_pool_ = use_pool; }
  inline __attribute__((always_inline)) void set_enable_prefetch_limiting(const bool enable_limit) { enable_prefetch_limiting_ = enable_limit; }
  inline __attribute__((always_inline)) void set_use_global_iter_pool(const bool use_iter_mgr) { use_global_iter_pool_ = use_iter_mgr; }
  inline __attribute__((always_inline)) void set_flags(const bool block_scan, const bool filter, const bool skip_index,
                           const bool enable_limit, const bool filter_reorder = false)
  {
    set_blockscan_pushdown(block_scan);
    set_filter_pushdown(filter);
    set_filter_reorder(filter_reorder);
    set_enable_skip_index(skip_index);
    set_enable_prefetch_limiting(enable_limit);
  }

  inline __attribute__((always_inline)) bool is_blockscan_pushdown() const { return pd_blockscan_; }
  inline __attribute__((always_inline)) bool is_filter_pushdown() const { return pd_filter_; }
  inline __attribute__((always_inline)) bool is_aggregate_pushdown() const { return pd_aggregate_; }
  inline __attribute__((always_inline)) bool is_group_by_pushdown() const { return pd_group_by_; }
  inline __attribute__((always_inline)) bool is_filter_reorder() const { return pd_filter_reorder_; }
  inline __attribute__((always_inline)) bool is_apply_skip_index() const { return enable_skip_index_; }
  inline __attribute__((always_inline)) bool is_use_stmt_iter_pool() const { return use_stmt_iter_pool_; }
  inline __attribute__((always_inline)) bool is_enable_prefetch_limiting() const { return enable_prefetch_limiting_; }
  inline __attribute__((always_inline)) bool is_use_global_iter_pool() const { return use_global_iter_pool_; }
  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"pd_flag", ::oceanbase::common::check_char_array(pd_flag_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };

  union {
    struct {
      int32_t pd_blockscan_ : 1;
      int32_t pd_filter_ : 1;
      int32_t pd_aggregate_ : 1;
      int32_t pd_group_by_ : 1;
      int32_t pd_filter_reorder_ : 1;
      int32_t enable_skip_index_ : 1;
      int32_t use_stmt_iter_pool_:1;
      int32_t reserved_1_:1;
      int32_t enable_prefetch_limiting_ : 1;
      int32_t use_global_iter_pool_:1;
      int32_t reserved_ : 22;
    };
    int32_t pd_flag_;
  };
};

class ObPushdownFilterUtils
{
public:
  inline __attribute__((always_inline)) static bool is_blockscan_pushdown_enabled(int32_t pd_level)
  { return pd_level > 0; }
  inline __attribute__((always_inline)) static bool is_filter_pushdown_enabled(int32_t pd_level)
  { return pd_level > 1; }
  inline __attribute__((always_inline)) static bool is_aggregate_pushdown_enabled(int32_t pd_level)
  { return pd_level > 2; }
  inline __attribute__((always_inline)) static bool is_group_by_pushdown_enabled(int32_t pd_level)
  { return pd_level > 3; }
};

class ObPushdownFilterNode
{
  public: virtual int serialize(char *buf, const int64_t buf_len, int64_t &pos) const ; int serialize_(char *buf, const int64_t buf_len, int64_t &pos) const; virtual int deserialize(const char *buf, const int64_t data_len, int64_t &pos) ; int deserialize_(const char *buf, const int64_t data_len, int64_t &pos); virtual int64_t get_serialize_size() const ; int64_t get_serialize_size_() const;; private: const static int64_t UNIS_VERSION = 1;
public:
  ObPushdownFilterNode(common::ObIAllocator &alloc,
                       PushdownFilterType type = PushdownFilterType::MAX_FILTER_TYPE)
      : alloc_(alloc), type_(type), n_child_(0), childs_(nullptr),
      col_ids_(alloc)
  {}
  virtual ~ObPushdownFilterNode() {}
  PushdownFilterType get_type() const { return type_; }
  common::ObIArray<uint64_t> &get_col_ids() { return col_ids_; }
  void set_type(PushdownFilterType type) { type_ = type; }
  virtual int merge(common::ObIArray<ObPushdownFilterNode*> &merged_node)
  {
    ((void)(merged_node));
    return common::OB_SUCCESS;
  }
  virtual int postprocess() { return common::OB_SUCCESS; }
  virtual bool is_semistruct_filter_node() const { return false; }
  virtual bool is_topn_filter() const { return false; }
  inline __attribute__((always_inline)) bool is_logic_op_node() const
  {
    return AND_FILTER == type_ || OR_FILTER == type_;
  }
  int check_filter_info(const storage::ObITableReadInfo &read_info,
                        bool &is_safe_filter_with_di);

  virtual int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"type", ::oceanbase::common::check_char_array(type_), "n_child", ::oceanbase::common::check_char_array(n_child_), "col_ids", ::oceanbase::common::check_char_array(col_ids_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };
public:
  common::ObIAllocator &alloc_;
  PushdownFilterType type_;
  uint32_t n_child_;
  ObPushdownFilterNode **childs_;
  common::ObFixedArray<uint64_t, common::ObIAllocator> col_ids_;
};

