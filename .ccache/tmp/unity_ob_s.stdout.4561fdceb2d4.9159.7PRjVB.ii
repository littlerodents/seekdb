    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE""] ", 4, "src/share/cache/ob_cache_utils.h", 470, __FUNCTION__, ret, "invalid arguments", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(count)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(count)))&&>::value>("count", ::oceanbase::common::check_char_array(count))); } } } while (false);
  } else if (free_cnt_ < count) {
    ret = common::OB_BUF_NOT_ENOUGH;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_SHARE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""SHARE""] ", 4, "src/share/cache/ob_cache_utils.h", 473, __FUNCTION__, ret, "buffer not enough", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(free_cnt_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(free_cnt_)))&&>::value>("free_cnt", ::oceanbase::common::check_char_array(free_cnt_)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(count)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(count)))&&>::value>("count", ::oceanbase::common::check_char_array(count))); } } } while (false);
  } else {
