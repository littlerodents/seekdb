class ObRowBitmap
{
public:
  explicit ObRowBitmap(common::ObIAllocator &allocator)
      : bitmap_(allocator), start_row_id_(-1)
  {}
  ~ObRowBitmap() = default;

  int init(const uint64_t count) { return bitmap_.init(count); }
  int switch_context(const uint64_t count)
  {
    start_row_id_ = -1;
    return bitmap_.reserve(count);
  }
  void reuse(const int64_t start_row_id, const bool is_all_true = false)
  {
    start_row_id_ = start_row_id;
    bitmap_.reuse(is_all_true);
  }
  common::ObBitmap *get_inner_bitmap() { return &bitmap_; }
  int64_t get_start_id() const { return start_row_id_; }
  int set(const int64_t row_idx, const bool value = true)
  {
    do{ if(__builtin_expect(!!(!(row_idx >= start_row_id_)),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/storage/ob_row_bitmap.h", 49, __FUNCTION__, ret, "assert fail, exp=%s", "row_idx >= start_row_id_"); } } } while (false); }; do { if (__builtin_expect(!!(1),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/storage/ob_row_bitmap.h", 49, __FUNCTION__, ret, "assert fail" " BACKTRACE:%s", oceanbase::common::lbt()); } } } while (false); }; } } while (false); ob_abort(); } } while(false);
    return bitmap_.set(row_idx - start_row_id_, value);
  }
