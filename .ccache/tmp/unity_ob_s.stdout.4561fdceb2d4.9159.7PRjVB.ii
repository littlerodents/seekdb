template<typename Handle, typename Key, int64_t N>
class ObHandleMgr
{
public:
  ObHandleMgr()
    : is_inited_(false),
      is_multi_(false),
      is_ordered_(false),
      last_handle_(__null),
      handle_cache_(__null)
  {}
  virtual ~ObHandleMgr() { reset(); }
  void reset()
  {
    is_multi_ = false;
    is_ordered_ = false;
    if (__null != last_handle_) {
      last_handle_->~Handle();
      last_handle_ = __null;
    }
    if (__null != handle_cache_) {
      handle_cache_->~ObHandleCache();
      handle_cache_ = __null;
    }
    is_inited_ = false;
  }
  int init(const bool is_multi, const bool is_ordered, common::ObIAllocator &allocator)
  {
    int ret = common::OB_SUCCESS;
    void *buf = __null;
    if (__builtin_expect(!!(is_inited_),!!0)) {
      ret = common::OB_INIT_TWICE;
      do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_STORAGE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""STORAGE""] ", 4, "src/storage/ob_handle_mgr.h", 59, __FUNCTION__, ret, "handle mgr is inited twice", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret))); } } } while (false);
    } else if (is_multi) {
      if (is_ordered) {
        if ((__builtin_expect(!!(__null == (buf = allocator.alloc(sizeof(Handle)))),!!0))) {
          ret = common::OB_ALLOCATE_MEMORY_FAILED;
          do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_STORAGE, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""STORAGE""] ", 4, "src/storage/ob_handle_mgr.h", 64, __FUNCTION__, ret, "failed to allocate last handle", "placeholder" ); } } } while (false);
        } else {
          last_handle_ = new (buf) Handle();
        }
      } else {
