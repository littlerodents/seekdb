  array_.at(index) = tmp;
  if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (cmp_.get_error_code()))),!!1))) {
    if (index == get_root()) {




      root_cmp_index_cache_ = picked_child;
    } else {

      reset_root_cmp_cache();
    }
    record_index(index);
  }
  return ret;
}

