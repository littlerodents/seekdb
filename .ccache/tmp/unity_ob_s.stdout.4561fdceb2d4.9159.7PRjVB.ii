static int16_t get_type_fixed_length(ObObjType type) {
  int16_t len = 0;
  ObObjTypeClass tc = ob_obj_type_class(type);
  do{ if(__builtin_expect(!!(!(tc >= ObNullTC && tc < ObMaxTC)),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/query/api/query/ob_sql_define.h", 722, __FUNCTION__, ret, "assert fail, exp=%s", "tc >= ObNullTC && tc < ObMaxTC"); } } } while (false); }; do { if (__builtin_expect(!!(1),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/query/api/query/ob_sql_define.h", 722, __FUNCTION__, ret, "assert fail" " BACKTRACE:%s", oceanbase::common::lbt()); } } } while (false); }; } } while (false); ob_abort(); } } while(false);
  switch (tc)
  {
    case ObUIntTC:
    case ObIntTC:
    case ObDoubleTC:
    case ObDateTimeTC:
    case ObMySQLDateTimeTC:
    case ObTimeTC:
    case ObBitTC:
    case ObEnumSetTC:
    {
      len = 8;
      break;
    }
    case ObDateTC:
    case ObMySQLDateTC:
    case ObFloatTC:
    {
      len = 4;
      break;
    }
    case ObYearTC:
    {
      len = 1;
      break;
    }
    case ObOTimestampTC: {
      len = 10;
      break;
    }
    default:
      break;
  }
  return len;
}

