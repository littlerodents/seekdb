static bool is_fixed_length_storage(ObObjType type) {
  bool is_fixed = true;
  ObObjTypeClass tc = ob_obj_type_class(type);
  do{ if(__builtin_expect(!!(!(tc >= ObNullTC && tc < ObMaxTC)),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/query/api/query/ob_sql_define.h", 680, __FUNCTION__, ret, "assert fail, exp=%s", "tc >= ObNullTC && tc < ObMaxTC"); } } } while (false); }; do { if (__builtin_expect(!!(1),!!0)) { { int __ret__ = oceanbase::common::OB_ERROR; int ret = __ret__; do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(3)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 3, "src/query/api/query/ob_sql_define.h", 680, __FUNCTION__, ret, "assert fail" " BACKTRACE:%s", oceanbase::common::lbt()); } } } while (false); }; } } while (false); ob_abort(); } } while(false);
  if (ObNumberTC == tc
      || ObExtendTC == tc
      || ObTextTC == tc
      || ObEnumSetInnerTC == tc
      || ObRawTC == tc
      || ObRowIDTC == tc
      || ObLobTC == tc
      || ObJsonTC == tc
      || ObGeometryTC == tc
      || ObUserDefinedSQLTC == tc
      || ObDecimalIntTC == tc) {
    is_fixed = false;
  }
  return is_fixed;
}

