      const unsigned char *buf,
      const int64_t offset,
      const int64_t cnt,
      const int64_t bs_len,
      int64_t &value);


  inline __attribute__((always_inline)) static bitstream_unpack get_unpack_func(const int64_t packing_len);

  inline __attribute__((always_inline)) static int get(const unsigned char *buf, const int64_t offset, const int64_t cnt, int64_t &value);

  inline __attribute__((always_inline)) static int get(const unsigned char *buf, const int64_t offset, const int64_t cnt, uint64_t &value)
  {
    return get(buf, offset, cnt, *reinterpret_cast<int64_t *>(&value));
  }

  bool is_init() const { return __null != data_; }

  const static BS_WORD bit_mask_table_[BS_WORD_BIT + 1];




  inline __attribute__((always_inline)) static void memory_safe_set(unsigned char *buf, const int64_t word_off,
      const bool overflow, const uint64_t v)
  {
    *reinterpret_cast<uint64_t *>(buf) |= (v << word_off);
    if (overflow) {
      *(buf + sizeof(v)) |= static_cast<BS_WORD>(
          bit_mask_table_[word_off] & (v >> (sizeof(v) * BS_WORD_BIT - word_off)));
    }
  }


  inline __attribute__((always_inline)) static void memory_safe_set(unsigned char *buf,
      const int64_t pos, const int64_t len, const uint64_t v)
  {
    const int64_t off = pos / 8;
    const int64_t word_off = pos % 8;
    const bool overflow = (word_off + len) > 64;
    memory_safe_set(buf + off, word_off, overflow, v);
  }



  inline __attribute__((always_inline)) static void memory_safe_set(unsigned char *buf,
      const int64_t pos, const uint64_t v)
  {
    const int64_t off = pos / 8;
    const int64_t word_off = pos % 8;
    memory_safe_set(buf + off, word_off, false, v);
  }

  inline __attribute__((always_inline)) static uint64_t get_mask(const int64_t len);

  int64_t to_string(char* buf, const int64_t buf_len) const { int64_t pos = 0; ::oceanbase::common::databuff_printf(buf, buf_len, pos,"{"); ::oceanbase::common::databuff_print_kv(buf, buf_len, pos,"data", reinterpret_cast<const void*>(data_), "bit_len", ::oceanbase::common::check_char_array(bit_len_)); ::oceanbase::common::databuff_printf(buf, buf_len, pos,"}"); return pos; };

  void update_pointer(int64_t offset)
  {
    if (__null != data_) {
      data_ += offset;
    }
  }
private:
  BS_WORD *data_;
  int64_t bit_len_;

  ObBitStream(const ObBitStream&); void operator=(const ObBitStream&);
