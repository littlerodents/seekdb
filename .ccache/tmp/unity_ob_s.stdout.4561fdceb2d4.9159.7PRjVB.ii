    v.version_ = version;
    return v.is_final_minor_ != 0;
  }

  static ObVersion get_version_with_max_minor(const int64_t version)
  {
    ObVersion v;
    v.version_ = version;
    v.minor_ = (32767);
    return v;
  }

  static ObVersion get_version_with_min_minor(const int64_t version)
  {
