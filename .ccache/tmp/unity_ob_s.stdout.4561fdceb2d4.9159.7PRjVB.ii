    uint64_t cur_bkt_idx = bkt_idx + (L0_bkt_n_ << cur_L);
    ret = do_foreach_scan_(cur_bkt_idx, cur_L + 1, fn, op);
  }
  unload_access_bkt_(bkt, bkt_seg);
  return ret;
}

