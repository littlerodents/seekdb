template <typename K, typename V>
struct FindKeyOp {
  FindKeyOp(const K &key, KvPair<K, Row<K, V>> *&p_kv)
  : ret_(OB_SUCCESS), key_(key), p_kv_(p_kv) {}
  bool operator()(const KvPair<K, Row<K, V>> &kv_pair) {
    int compare_result = 0;
    if (OB_SUCCESS != (ret_ = compare_binary_key(kv_pair.k_, key_, compare_result))) {
      { int __ret__ = ret_; int ret = __ret__; do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_MDS, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""MDS""] ", 4, "src/storage/multi_data_source/mds_unit.ipp", 227, __FUNCTION__, ret, "fail to compare binary key", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(kv_pair)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(kv_pair)))&&>::value>("kv_pair", ::oceanbase::common::check_char_array(kv_pair)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(key_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(key_)))&&>::value>("key_", ::oceanbase::common::check_char_array(key_))); } } } while (false); };
    } else if (compare_result == 0) {
      p_kv_ = &const_cast<KvPair<K, Row<K, V>> &>(kv_pair);
    }
    return (OB_SUCCESS != ret_) || (nullptr != p_kv_);
  }
  int ret_;
  const K &key_;
  KvPair<K, Row<K, V>> *&p_kv_;
};
template <typename K, typename V>
int MdsUnit<K, V>::get_row_from_list_(const K &key, KvPair<K, Row<K, V>> *&p_kv) const
{
  FindKeyOp<K, V> op(key, p_kv);
  multi_row_list_.for_each_node_from_head_to_tail_until_true(op);
  return op.ret_;
}

