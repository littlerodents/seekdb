inline void format_i64(const int64_t value, int16_t &check_sum)
{
  int i = 0;
  while (i < 4) {
    check_sum = static_cast<int16_t>(check_sum ^ ((value >> i * 16) & 0xFFFF));
    ++i;
  }
}

inline void format_i32(const int32_t value, int16_t &check_sum)
{
  int i = 0;
  while (i < 2) {
    check_sum = static_cast<int16_t>(check_sum ^ ((value >> i * 16) & 0xFFFF));
    ++i;
  }
}

