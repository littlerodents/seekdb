  ObBitStream(unsigned char *data, const int64_t len) : data_(data), bit_len_(len * BS_WORD_BIT)
  {
  }

  inline __attribute__((always_inline)) int init(unsigned char *data, const int64_t length);
  inline __attribute__((always_inline)) int set(const int64_t offset, const int64_t cnt, const int64_t value);
