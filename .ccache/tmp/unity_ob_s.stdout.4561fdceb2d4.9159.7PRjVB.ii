  {
    log_cb_ = nullptr;
    base_scn_.set_invalid();
    replay_hint_ = 0;
    replay_barrier_type_ = logservice::ObReplayBarrierType::NO_NEED_BARRIER;
    suggested_buf_size_ = 0;
    hold_tx_ctx_ref_ = 0;
  }
