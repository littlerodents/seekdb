  static const ObNumber &get_positive_zero_dot_five();
  static const ObNumber &get_zero();
  static const ObNumber &get_pi();
public:
  ObNumber() : d_(0), digits_(0)
  {
    d_.sign_ = POSITIVE;
  }
  ObNumber(const uint32_t desc, uint32_t *digits)
    : d_(desc), digits_(digits) {}
  ObNumber(const number::ObCompactNumber &num)
    : d_(num.desc_.desc_), digits_(const_cast<uint32_t *>(&(num.digits_[0]))) {}

  int serialize(char* buf, const int64_t buf_len, int64_t& pos) const; int deserialize(const char* buf, const int64_t data_len, int64_t& pos); int64_t get_serialize_size(void) const;
public:




  int sanity_check()
  {
    int ret = OB_SUCCESS;
    if (d_.len_ > OB_MAX_DECIMAL_DIGIT) {
      ret = OB_ERR_UNEXPECTED;
      do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/oblib/common/number/ob_number_v2.h", 210, __FUNCTION__, ret, "Invalid digit len %u", d_.len_); } } } while (false);
    } else if (d_.len_ > 0 && digits_ != nullptr) {
      for (auto i = 0; (__builtin_expect(!!(::oceanbase::common::OB_SUCCESS == (ret = (ret))),!!1)) && i < d_.len_; i++) {
        if (digits_[i] >= BASE) {
          ret = OB_ERR_UNEXPECTED;
          do { if (true) { if ((__builtin_expect(!!(::oceanbase::common::need_to_print(4)),!!0))) { ::oceanbase::common::ObLogger::get_logger().log_message_fmt("", 4, "src/oblib/common/number/ob_number_v2.h", 215, __FUNCTION__, ret, "Invalid value %u", digits_[i]); } } } while (false);
        } else {
        }
      }
    }
    return ret;
  }
