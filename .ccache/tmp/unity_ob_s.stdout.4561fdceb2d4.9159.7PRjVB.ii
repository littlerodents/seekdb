        } else {}
      } else {}
    }
    if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (ret))),!!0))) {
    } else if ((__builtin_expect(!!(::oceanbase::common::OB_SUCCESS != (ret = (databuff_printf(buf, buf_len, pos, "]")))),!!0))) {
    } else {}
  }
  return ret;
}

