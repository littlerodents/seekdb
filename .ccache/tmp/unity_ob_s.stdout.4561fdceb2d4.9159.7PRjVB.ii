  } else if (__builtin_expect(!!(total_player_cnt > max_player_cnt_),!!0)) {
    ret = OB_INVALID_ARGUMENT;
    do { if (true) { if (__builtin_expect(!!(::oceanbase::common::need_to_print(::oceanbase::common::OB_LOG_ROOT::M_LIB, 4)),!!0)) { ::oceanbase::common::OB_PRINT("[""LIB""] ", 4, "src/oblib/lib/container/ob_loser_tree.h", 277, __FUNCTION__, ret, "invalid total player count", "placeholder" , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(ret)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(ret)))&&>::value>("ret", ::oceanbase::common::check_char_array(ret)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(total_player_cnt)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(total_player_cnt)))&&>::value>("total_player_cnt", ::oceanbase::common::check_char_array(total_player_cnt)) , (::oceanbase::common::ObILogKV&&)::oceanbase::common::ObLogKV<decltype(::oceanbase::common::check_char_array(max_player_cnt_)), std::is_rvalue_reference<decltype((::oceanbase::common::check_char_array(max_player_cnt_)))&&>::value>("max_player_cnt", ::oceanbase::common::check_char_array(max_player_cnt_))); } } } while (false);
